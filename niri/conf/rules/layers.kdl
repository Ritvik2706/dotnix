// rules/layers.kdl — layer-shell surfaces: the island, bars, the wallpaper.

// The lumen island asks for its own blur, shaped to the pill/card
// (ext-background-effect): only xray off here, so the expanded card frosts
// the real windows it drops over, not just the wallpaper.
layer-rule {
    match namespace="^lumen$"
    background-effect {
        xray false
    }
}

// The island's surfaces marked `captures: hidden` (the recording bar):
// on the monitor, left out of every recording, screenshot and shared screen,
// with nothing in their place. That part (hide-from-capture) is patched-niri
// only, so ../../theme.kdl has it (theme/wallpaper-theme.py), not here.
layer-rule {
    match namespace="^lumen-private$"
    background-effect {
        xray false
    }
}

// Rounded display corners (scripts/screen-corners.py): plain black masks.
layer-rule {
    match namespace="^screen-corners$"
    background-effect {
        blur false
    }
}

layer-rule {
    match namespace="^(notifications|vicinae|waybar|launcher|logout_dialog)$"
    background-effect {
        blur true
        xray false
    }
}

// The wallpaper stays put under the overview's zoomed workspaces.
layer-rule {
    match namespace="^awww"
    place-within-backdrop true
}
