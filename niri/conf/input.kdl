// input.kdl — keyboard, touchpad, mouse, focus, and the lid switch.

// ─── Input (was lua/input.lua) ───────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "us"
            options "caps:swapescape"
        }
        // Quicker than niri's 600ms / 25 per second, for holding hjkl.
        repeat-delay 300
        repeat-rate 40
    }

    // macOS-feel trackpad, tuned for less finger travel and force:
    // - tap: light taps instead of pressing the glass (less tendon load).
    // - clickfinger: 1/2/3 fingers anywhere = left/right/middle, no
    //   corner-hunting for right-click.
    // - drag + drag-lock: tap-tap-hold drags; niri's drag-lock is libinput's
    //   *timeout* mode, so you can lift and re-place a finger mid-drag
    //   without dropping (no extra tap needed to release).
    // - adaptive accel nudged above default: slow moves stay precise, quick
    //   flicks cross the 1.6-scaled screen without re-placing the finger.
    // - dwt: palm/typing guard.
    touchpad {
        tap
        natural-scroll
        dwt
        dwtp
        drag true
        drag-lock
        click-method "clickfinger"
        tap-button-map "left-right-middle"
        scroll-method "two-finger"
        accel-profile "adaptive"
        accel-speed 0.2
        scroll-factor 0.45
    }

    // Real mice: raw 1:1, no acceleration (Windows' 6/11 without EPP).
    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    // Hovering focuses, but never scrolls the strip: brushing the slivers
    // of the neighbouring columns at the screen edges no longer yanks the
    // view sideways.
    focus-follows-mouse max-scroll-amount="0%"
}

// ─── Lid (was the switch:on:Lid Switch bind) ─────────────────────────────
switch-events {
    lid-close { spawn "sh" "-c" "~/.config/hypr/scripts/sleep-lock.sh lid"; }
}
