// niri — config.kdl: the index. Everything lives in conf/, by what it is.
//
// Not a replica of ../hypr: the main features carry over (the lumen island
// and its keys, screenshots, media, lock, vim navigation, the liquid-glass
// look), and the rest is done niri's way: an endless strip of columns you
// scroll through, the overview on Mod+Tab, tabbed columns, springs.
// ~/.config/niri is a symlink here (install.sh links every top-level dir).
// niri reloads on save of any of these files; `niri validate` checks them all.
//
// Where to look:
//   a key ...................... conf/binds/  windows · workspaces · apps · system
//   where an app opens, how wide conf/rules/apps.kdl
//   a dialog / popup that floats conf/rules/floating.kdl
//   opacity, glass, corners .... conf/rules/look.kdl   (layer-shell: layers.kdl)
//   gaps, borders, shadows, blur conf/layout.kdl       (colours: theme.kdl)
//   what starts at login ....... conf/startup.kdl
//   the five fixed workspaces .. conf/workspaces.kdl
//   keyboard, trackpad, lid .... conf/input.kdl
//   screens .................... conf/outputs.kdl
//   springs, open/close ........ conf/animations.kdl
//   env vars, cursor ........... conf/general.kdl
// Columns size themselves (auto-fit, patched niri, switched on in theme.kdl):
// how it reads widths is in conf/rules/apps.kdl's header.
//
// Order matters where two files set the same thing: a later window rule wins
// (look → apps → floating), a key bound twice goes to the later file, and the
// two generated files come last so they win over everything.
//
// Docs: https://niri-wm.github.io/niri/Configuration%3A-Introduction.html

include "conf/general.kdl"
include "conf/input.kdl"
include "conf/outputs.kdl"
include "conf/layout.kdl"
include "conf/animations.kdl"
include "conf/workspaces.kdl"
include "conf/startup.kdl"

include "conf/rules/look.kdl"
include "conf/rules/apps.kdl"
include "conf/rules/floating.kdl"
include "conf/rules/layers.kdl"

include "conf/binds/windows.kdl"
include "conf/binds/workspaces.kdl"
include "conf/binds/apps.kdl"
include "conf/binds/system.kdl"

// Generated, keep last. theme.kdl: the colours that follow the wallpaper
// (../theme/wallpaper-theme.py). mode.kdl: the live look toggles
// (scripts/mode.sh, Mod+F12 / Mod+Shift+Space).
include "theme.kdl"
include "mode.kdl"
