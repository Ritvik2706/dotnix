+    /// The screenshot UI's `o`: the selection's text to the clipboard
+    /// (tesseract, then wl-copy), and the UI closes.
+    pub fn screenshot_ocr(&mut self) {
+        let shot = self
+            .backend
+            .with_primary_renderer(|renderer| self.niri.screenshot_ui.capture(renderer));
+        self.close_screenshot_ui();
+        let Some(Ok((size, pixels))) = shot else {
+            warn!("error capturing the screenshot for its text");
+            return;
+        };
+        thread::spawn(move || {
+            let dir = std::env::var_os("XDG_RUNTIME_DIR")
+                .map(PathBuf::from)
+                .unwrap_or_else(std::env::temp_dir);
+            let path = dir.join(format!("niri-ocr-{}.png", std::process::id()));
+            let written = std::fs::File::create(&path)
+                .map_err(anyhow::Error::from)
+                .and_then(|f| {
+                    crate::utils::write_png_rgba8(f, size.w as u32, size.h as u32, &pixels)
+                        .map_err(anyhow::Error::from)
+                });
+            if let Err(err) = written {
+                warn!("error writing the screenshot for its text: {err:?}");
+                return;
+            }
+            let res = std::process::Command::new("sh")
+                .arg("-c")
+                .arg(r#"tesseract "$0" - --psm 6 2>/dev/null | sed -e 's/[[:space:]]*$//' | wl-copy; rm -f "$0""#)
+                .arg(&path)
+                .status();
+            if let Err(err) = res {
+                warn!("error running tesseract: {err:?}");
+            }
+        });
+    }
+
+    /// The screenshot UI's `c`: the colour under the pointer (or the drawing
+    /// cursor) to the clipboard as #rrggbb, and the UI closes.
+    pub fn screenshot_pick_color(&mut self) {
+        let color = self
+            .backend
+            .with_primary_renderer(|renderer| self.niri.screenshot_ui.pick_color(renderer))
+            .flatten();
+        self.close_screenshot_ui();
+        if let Some(color) = color {
+            thread::spawn(move || {
+                if let Err(err) = std::process::Command::new("wl-copy").arg(&color).status() {
+                    warn!("error copying the colour: {err:?}");
+                }
+            });
+        }
+    }
+
+    fn close_screenshot_ui(&mut self) {
+        self.niri.screenshot_ui.close();
+        self.niri
+            .cursor_manager
+            .set_cursor_image(CursorImageStatus::default_named());
+        self.niri.queue_redraw_all();
+    }
+
