+/// Where screenshots can go: screenshot-path's folder first, then the ones
+/// listed in ~/.config/niri/screenshot-folders (one a line), or else
+/// Desktop, Downloads and Pictures (those that exist).
+fn save_folders(config: &Config) -> Vec<PathBuf> {
+    let home = std::env::var_os("HOME")
+        .map(PathBuf::from)
+        .unwrap_or_default();
+    let first = make_screenshot_path(config)
+        .ok()
+        .flatten()
+        .and_then(|p| p.parent().map(|d| d.to_owned()))
+        .unwrap_or_else(|| home.join("Pictures/Screenshots"));
+    let listed = std::fs::read_to_string(home.join(".config/niri/screenshot-folders")).ok();
+    let rest: Vec<PathBuf> = match &listed {
+        Some(text) => text
+            .lines()
+            .map(str::trim)
+            .filter(|l| !l.is_empty() && !l.starts_with('#'))
+            .map(|l| match l.strip_prefix("~/") {
+                Some(rel) => home.join(rel),
+                None => PathBuf::from(l),
+            })
+            .collect(),
+        None => ["Desktop", "Downloads", "Pictures"]
+            .iter()
+            .map(|d| home.join(d))
+            .filter(|d| d.is_dir())
+            .collect(),
+    };
+    let mut folders = vec![first];
+    for f in rest {
+        if !folders.contains(&f) {
+            folders.push(f);
+        }
+    }
+    folders
+}
+
+/// A folder as the panel says it: ~ for home.
+fn short_path(path: &Path) -> String {
+    let home = std::env::var_os("HOME")
+        .map(PathBuf::from)
+        .unwrap_or_default();
+    match path.strip_prefix(&home) {
+        Ok(rel) if !home.as_os_str().is_empty() => format!("~/{}", rel.display()),
+        _ => path.display().to_string(),
+    }
+}
