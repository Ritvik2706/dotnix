+//! Drawing on a screenshot before it is taken: a pen, straight lines, arrows,
+//! boxes, ovals, a highlighter, text and redaction boxes, by mouse or by vim
+//! keys (hjkl move a cursor, `v` starts and ends a shape, `i` types).
+//!
+//! Marks are kept from the selection's corner in logical px, so they go with
+//! the selection, and are drawn with cairo over the frozen screen.
+
+use std::f64::consts::{FRAC_PI_2, PI, TAU};
+
+use pango::FontDescription;
+use pangocairo::cairo;
+use smithay::input::keyboard::Keysym;
+use smithay::utils::{Logical, Point, Size};
+
+/// White, black, red, orange, yellow, green, blue, purple: keys 1–8.
+pub const COLORS: [(f64, f64, f64); 8] = [
+    (0.97, 0.97, 0.98),
+    (0.07, 0.07, 0.08),
+    (1.0, 0.27, 0.29),
+    (1.0, 0.58, 0.16),
+    (1.0, 0.84, 0.20),
+    (0.24, 0.82, 0.44),
+    (0.27, 0.56, 1.0),
+    (0.70, 0.46, 1.0),
+];
+/// Stroke widths, logical px: `[` and `]` step through them.
+pub const WIDTHS: [f64; 5] = [2., 4., 6., 10., 16.];
+const TEXT_SIZES: [f64; 5] = [14., 18., 24., 32., 44.];
+const TEXT_FONT: &str = "SF Pro Display Semibold";
+
+/// Cursor steps: hjkl, with Shift, with Ctrl.
+const STEP: f64 = 10.;
+const STEP_BIG: f64 = 50.;
+const STEP_FINE: f64 = 1.;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Tool {
+    Pen,
+    Line,
+    Arrow,
+    Rect,
+    Oval,
+    Marker,
+    Text,
+    Redact,
+}
+
+impl Tool {
+    pub const ALL: [Tool; 8] = [
+        Tool::Pen,
+        Tool::Line,
+        Tool::Arrow,
+        Tool::Rect,
+        Tool::Oval,
+        Tool::Marker,
+        Tool::Text,
+        Tool::Redact,
+    ];
+
+    pub fn key(self) -> &'static str {
+        match self {
+            Tool::Pen => "p",
+            Tool::Line => "s",
+            Tool::Arrow => "a",
+            Tool::Rect => "r",
+            Tool::Oval => "o",
+            Tool::Marker => "m",
+            Tool::Text => "i",
+            Tool::Redact => "x",
+        }
+    }
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap()
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct Mark {
+    pub tool: Tool,
+    pub color: usize,
+    pub width: usize,
+    /// The pen's and highlighter's path; for the rest, from and to.
+    pub points: Vec<Point<f64, Logical>>,
+    pub text: String,
+}
+
+/// What a key did, for the screenshot UI to act on.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Outcome {
+    /// Nothing changed.
+    None,
+    /// Something to draw again.
+    Changed,
+    /// Back to selecting (marks are kept).
+    Leave,
+}
+
+pub struct Draw {
+    /// Drawing (keys and the mouse draw) rather than selecting.
+    pub active: bool,
+    pub marks: Vec<Mark>,
+    redo: Vec<Mark>,
+    pub tool: Tool,
+    pub color: usize,
+    pub width: usize,
+    /// The keyboard's cursor, from the selection's corner.
+    pub cursor: Point<f64, Logical>,
+    /// A shape on its way: from where `v` started it, or a mouse drag.
+    pub pending: Option<Mark>,
+    /// The pending shape follows the mouse (not the cursor).
+    pub mouse: bool,
+    /// Text being typed (insert mode).
+    pub typing: Option<Mark>,
+    /// One more for every change: the drawing is made again when it moves on.
+    pub version: u64,
+}
+
+impl Draw {
+    pub fn new() -> Self {
+        Self {
+            active: false,
+            marks: Vec::new(),
+            redo: Vec::new(),
+            tool: Tool::Arrow,
+            color: 2,
+            width: 2,
+            cursor: Point::from((0., 0.)),
+            pending: None,
+            mouse: false,
+            typing: None,
+            version: 0,
+        }
+    }
+
+    fn changed(&mut self) -> Outcome {
+        self.version += 1;
+        Outcome::Changed
+    }
+
+    pub fn has_marks(&self) -> bool {
+        !self.marks.is_empty() || self.typing.as_ref().is_some_and(|t| !t.text.is_empty())
+    }
+
+    fn mark(&self, at: Point<f64, Logical>) -> Mark {
+        Mark {
+            tool: self.tool,
+            color: self.color,
+            width: self.width,
+            points: vec![at, at],
+            text: String::new(),
+        }
+    }
+
+    fn push(&mut self, mark: Mark) {
+        self.marks.push(mark);
+        self.redo.clear();
+    }
+
+    fn commit_typing(&mut self) {
+        if let Some(t) = self.typing.take() {
+            if !t.text.is_empty() {
+                self.push(t);
+            }
+        }
+    }
+
+    fn commit_pending(&mut self) {
+        if let Some(p) = self.pending.take() {
+            let a = p.points[0];
+            let b = *p.points.last().unwrap();
+            // A click without a drag draws nothing (but a pen's dot).
+            if p.tool == Tool::Pen
+                || p.tool == Tool::Marker
+                || (a - b).x.abs() + (a - b).y.abs() > 2.
+            {
+                self.push(p);
+            }
+        }
+        self.mouse = false;
+    }
+
+    /// Starts typing at `at` (the text tool's `v`, `i`, or a click).
+    fn start_typing(&mut self, at: Point<f64, Logical>) {
+        self.commit_typing();
+        self.pending = None;
+        self.tool = Tool::Text;
+        let mut mark = self.mark(at);
+        mark.points.truncate(1);
+        self.typing = Some(mark);
+    }
+
+    /// Whether the screenshot UI should hand this key to the drawing (rather
+    /// than take it as save, copy or cancel).
+    pub fn wants(&self, raw: Keysym, ctrl: bool) -> bool {
+        if !self.active {
+            return false;
+        }
+        if self.typing.is_some() {
+            return true;
+        }
+        !matches!(
+            raw,
+            Keysym::Return | Keysym::KP_Enter | Keysym::space | Keysym::y | Keysym::q
+        ) && !(ctrl && raw == Keysym::c)
+    }
+
+    pub fn key(
+        &mut self,
+        raw: Keysym,
+        ch: Option<char>,
+        shift: bool,
+        ctrl: bool,
+        bounds: Size<f64, Logical>,
+    ) -> Outcome {
+        // Typing: everything is text, but Enter and Esc finish it.
+        if let Some(t) = &mut self.typing {
+            match raw {
+                Keysym::Escape | Keysym::Return | Keysym::KP_Enter => self.commit_typing(),
+                Keysym::BackSpace => {
+                    t.text.pop();
+                }
+                _ => match ch.filter(|c| !c.is_control()) {
+                    Some(c) if !ctrl => t.text.push(c),
+                    _ => return Outcome::None,
+                },
+            }
+            return self.changed();
+        }
+
+        let step = if ctrl {
+            STEP_FINE
+        } else if shift {
+            STEP_BIG
+        } else {
+            STEP
+        };
+        let mv = |dx: f64, dy: f64| Point::<f64, Logical>::from((dx * step, dy * step));
+        let delta = match raw {
+            Keysym::h | Keysym::H => Some(mv(-1., 0.)),
+            Keysym::l | Keysym::L => Some(mv(1., 0.)),
+            Keysym::k | Keysym::K => Some(mv(0., -1.)),
+            Keysym::j | Keysym::J => Some(mv(0., 1.)),
+            _ => None,
+        };
+        if let Some(d) = delta {
+            let c = self.cursor + d;
+            self.cursor = Point::from((c.x.clamp(0., bounds.w), c.y.clamp(0., bounds.h)));
+            if let Some(p) = &mut self.pending {
+                if matches!(p.tool, Tool::Pen | Tool::Marker) {
+                    p.points.push(self.cursor);
+                } else {
+                    *p.points.last_mut().unwrap() = self.cursor;
+                }
+            }
+            return self.changed();
+        }
+
+        if ctrl {
+            return match raw {
+                Keysym::r => self.redo(),
+                _ => Outcome::None,
+            };
+        }
+
+        match raw {
+            Keysym::Escape => {
+                if self.pending.take().is_some() {
+                    self.mouse = false;
+                    return self.changed();
+                }
+                self.active = false;
+                self.version += 1;
+                Outcome::Leave
+            }
+            Keysym::d => {
+                self.commit_pending();
+                self.active = false;
+                self.version += 1;
+                Outcome::Leave
+            }
+            // Start a shape at the cursor; again, finish it there.
+            Keysym::v => {
+                if self.pending.is_some() {
+                    self.commit_pending();
+                } else if self.tool == Tool::Text {
+                    self.start_typing(self.cursor);
+                } else {
+                    self.pending = Some(self.mark(self.cursor));
+                    self.mouse = false;
+                }
+                self.changed()
+            }
+            Keysym::i | Keysym::t => {
+                self.start_typing(self.cursor);
+                self.changed()
+            }
+            Keysym::u => self.undo(),
+            Keysym::bracketleft | Keysym::minus => {
+                self.width = self.width.saturating_sub(1);
+                self.restyle()
+            }
+            Keysym::bracketright | Keysym::equal | Keysym::plus => {
+                self.width = (self.width + 1).min(WIDTHS.len() - 1);
+                self.restyle()
+            }
+            _ => {
+                if let Some(tool) = Tool::ALL.into_iter().find(|t| ch == t.key().chars().next()) {
+                    self.set_tool(tool);
+                    return self.changed();
+                }
+                if let Some(n) = ch.and_then(|c| c.to_digit(10)) {
+                    if (1..=COLORS.len() as u32).contains(&n) {
+                        self.color = n as usize - 1;
+                        return self.restyle();
+                    }
+                }
+                Outcome::None
+            }
+        }
+    }
+
+    pub fn set_tool(&mut self, tool: Tool) {
+        self.commit_pending();
+        self.commit_typing();
+        self.tool = tool;
+        self.version += 1;
+    }
+
+    pub fn set_color(&mut self, color: usize) {
+        self.color = color;
+        self.restyle();
+    }
+
+    pub fn cycle_width(&mut self) {
+        self.width = (self.width + 1) % WIDTHS.len();
+        self.restyle();
+    }
+
+    /// A new colour or width also goes to what is being drawn or typed.
+    fn restyle(&mut self) -> Outcome {
+        let (color, width) = (self.color, self.width);
+        for m in self.pending.iter_mut().chain(self.typing.iter_mut()) {
+            m.color = color;
+            m.width = width;
+        }
+        self.changed()
+    }
+
+    fn undo(&mut self) -> Outcome {
+        if self.pending.take().is_some() {
+            self.mouse = false;
+            return self.changed();
+        }
+        match self.marks.pop() {
+            Some(m) => {
+                self.redo.push(m);
+                self.changed()
+            }
+            None => Outcome::None,
+        }
+    }
+
+    fn redo(&mut self) -> Outcome {
+        match self.redo.pop() {
+            Some(m) => {
+                self.marks.push(m);
+                self.changed()
+            }
+            None => Outcome::None,
+        }
+    }
+
+    /// The mouse went down at `at` inside the selection.
+    pub fn press(&mut self, at: Point<f64, Logical>) {
+        self.cursor = at;
+        if self.tool == Tool::Text {
+            self.start_typing(at);
+        } else {
+            self.commit_typing();
+            self.pending = Some(self.mark(at));
+            self.mouse = true;
+        }
+        self.version += 1;
+    }
+
+    pub fn motion(&mut self, at: Point<f64, Logical>) {
+        if !self.mouse {
+            return;
+        }
+        self.cursor = at;
+        if let Some(p) = &mut self.pending {
+            if matches!(p.tool, Tool::Pen | Tool::Marker) {
+                p.points.push(at);
+            } else {
+                *p.points.last_mut().unwrap() = at;
+            }
+            self.version += 1;
+        }
+    }
+
+    pub fn release(&mut self) {
+        if self.mouse {
+            self.commit_pending();
+            self.version += 1;
+        }
+    }
+
+    /// Draws the marks (and what is on its way) from the selection's corner,
+    /// in logical px; with `live`, the cursor and the text caret too.
+    pub fn render(&self, cr: &cairo::Context, live: bool) -> Result<(), cairo::Error> {
+        for m in &self.marks {
+            render_mark(cr, m, false)?;
+        }
+        if live {
+            if let Some(p) = &self.pending {
+                render_mark(cr, p, false)?;
+            }
+        }
+        if let Some(t) = &self.typing {
+            render_mark(cr, t, live)?;
+        }
+        if live && self.active && self.typing.is_none() && !self.mouse {
+            render_cursor(cr, self.cursor, COLORS[self.color])?;
+        }
+        Ok(())
+    }
+}
+
+impl Default for Draw {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+fn render_mark(cr: &cairo::Context, m: &Mark, caret: bool) -> Result<(), cairo::Error> {
+    let (r, g, b) = COLORS[m.color];
+    let w = WIDTHS[m.width];
+    cr.save()?;
+    cr.set_line_cap(cairo::LineCap::Round);
+    cr.set_line_join(cairo::LineJoin::Round);
+    cr.set_source_rgb(r, g, b);
+    cr.set_line_width(w);
+    let a = m.points[0];
+    let z = *m.points.last().unwrap();
+    let (x0, y0, x1, y1) = (a.x.min(z.x), a.y.min(z.y), a.x.max(z.x), a.y.max(z.y));
+    match m.tool {
+        Tool::Pen => {
+            path(cr, &m.points);
+            cr.stroke()?;
+        }
+        Tool::Marker => {
+            // See-through, and even where the stroke crosses itself.
+            cr.push_group();
+            cr.set_line_width(w * 3. + 6.);
+            cr.set_line_cap(cairo::LineCap::Square);
+            path(cr, &m.points);
+            cr.stroke()?;
+            cr.pop_group_to_source()?;
+            cr.paint_with_alpha(0.4)?;
+        }
+        Tool::Line => {
+            cr.move_to(a.x, a.y);
+            cr.line_to(z.x, z.y);
+            cr.stroke()?;
+        }
+        Tool::Arrow => {
+            let angle = (z.y - a.y).atan2(z.x - a.x);
+            let head = (w * 3. + 8.).min(((z - a).x.hypot((z - a).y)) * 0.6);
+            // The shaft stops inside the head, so its round end doesn't poke out.
+            let back = Point::<f64, Logical>::from((
+                z.x - angle.cos() * head * 0.6,
+                z.y - angle.sin() * head * 0.6,
+            ));
+            cr.move_to(a.x, a.y);
+            cr.line_to(back.x, back.y);
+            cr.stroke()?;
+            let spread = 0.45;
+            cr.move_to(z.x, z.y);
+            cr.line_to(
+                z.x - head * (angle - spread).cos(),
+                z.y - head * (angle - spread).sin(),
+            );
+            cr.line_to(
+                z.x - head * (angle + spread).cos(),
+                z.y - head * (angle + spread).sin(),
+            );
+            cr.close_path();
+            cr.fill_preserve()?;
+            cr.set_line_width(w.min(4.));
+            cr.stroke()?;
+        }
+        Tool::Rect => {
+            cr.rectangle(x0, y0, x1 - x0, y1 - y0);
+            cr.stroke()?;
+        }
+        Tool::Oval => {
+            let (cx, cy) = ((x0 + x1) / 2., (y0 + y1) / 2.);
+            let (rx, ry) = (((x1 - x0) / 2.).max(0.5), ((y1 - y0) / 2.).max(0.5));
+            cr.save()?;
+            cr.translate(cx, cy);
+            cr.scale(rx, ry);
+            cr.arc(0., 0., 1., 0., TAU);
+            cr.restore()?;
+            cr.stroke()?;
+        }
+        Tool::Redact => {
+            cr.rectangle(x0, y0, x1 - x0, y1 - y0);
+            cr.fill()?;
+        }
+        Tool::Text => {
+            let layout = pangocairo::functions::create_layout(cr);
+            let mut font = FontDescription::from_string(TEXT_FONT);
+            font.set_absolute_size(TEXT_SIZES[m.width] * f64::from(pango::SCALE));
+            layout.set_font_description(Some(&font));
+            layout.set_text(&m.text);
+            // A soft dark (or light, for dark ink) halo keeps it readable on anything.
+            let halo = if r + g + b < 0.9 { 1. } else { 0. };
+            cr.move_to(a.x, a.y);
+            pangocairo::functions::layout_path(cr, &layout);
+            cr.set_source_rgba(halo, halo, halo, 0.45);
+            cr.set_line_width(3.);
+            cr.stroke()?;
+            cr.move_to(a.x, a.y);
+            cr.set_source_rgb(r, g, b);
+            pangocairo::functions::show_layout(cr, &layout);
+            if caret {
+                let (_, logical) = layout.pixel_extents();
+                let h = TEXT_SIZES[m.width] * 1.2;
+                let line = m.text.rsplit('\n').next().unwrap_or("");
+                let x = if line.is_empty() && !m.text.is_empty() {
+                    0.
+                } else {
+                    f64::from(logical.width())
+                };
+                cr.rectangle(
+                    a.x + x + 1.,
+                    a.y + f64::from(logical.height()).max(h) - h,
+                    2.,
+                    h,
+                );
+                cr.fill()?;
+            }
+        }
+    }
+    cr.restore()
+}
+
+fn path(cr: &cairo::Context, points: &[Point<f64, Logical>]) {
+    let p = points[0];
+    cr.move_to(p.x, p.y);
+    if points.len() == 1 || points.iter().all(|q| *q == p) {
+        // A dot.
+        cr.line_to(p.x + 0.01, p.y);
+    }
+    for q in &points[1..] {
+        cr.line_to(q.x, q.y);
+    }
+}
+
+/// The keyboard's cursor: a crosshair in the colour it draws with.
+fn render_cursor(
+    cr: &cairo::Context,
+    at: Point<f64, Logical>,
+    (r, g, b): (f64, f64, f64),
+) -> Result<(), cairo::Error> {
+    cr.save()?;
+    for (width, alpha, shade) in [(3.5, 0.55, 0.), (1.5, 1., 1.)] {
+        cr.set_line_width(width);
+        if shade == 0. {
+            cr.set_source_rgba(0., 0., 0., alpha);
+        } else {
+            cr.set_source_rgb(r, g, b);
+        }
+        for k in 0..4 {
+            let a = f64::from(k) * FRAC_PI_2;
+            cr.move_to(at.x + 5. * a.cos(), at.y + 5. * a.sin());
+            cr.line_to(at.x + 12. * a.cos(), at.y + 12. * a.sin());
+        }
+        cr.stroke()?;
+    }
+    cr.arc(at.x, at.y, 2., 0., 2. * PI);
+    cr.set_source_rgb(r, g, b);
+    cr.fill()?;
+    cr.restore()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bounds() -> Size<f64, Logical> {
+        Size::from((400., 300.))
+    }
+
+    #[test]
+    fn keyboard_arrow() {
+        let mut d = Draw::new();
+        d.active = true;
+        d.set_tool(Tool::Arrow);
+        d.key(Keysym::v, Some('v'), false, false, bounds());
+        d.key(Keysym::L, Some('L'), true, false, bounds());
+        d.key(Keysym::j, Some('j'), false, false, bounds());
+        d.key(Keysym::v, Some('v'), false, false, bounds());
+        assert_eq!(d.marks.len(), 1);
+        assert_eq!(*d.marks[0].points.last().unwrap(), Point::from((50., 10.)));
+        d.key(Keysym::u, Some('u'), false, false, bounds());
+        assert!(d.marks.is_empty());
+        d.key(Keysym::r, Some('r'), false, true, bounds());
+        assert_eq!(d.marks.len(), 1);
+    }
+
+    #[test]
+    fn typing_takes_every_key() {
+        let mut d = Draw::new();
+        d.active = true;
+        d.key(Keysym::i, Some('i'), false, false, bounds());
+        assert!(d.wants(Keysym::y, false));
+        for c in "Hi y!".chars() {
+            d.key(Keysym::a, Some(c), false, false, bounds());
+        }
+        d.key(Keysym::BackSpace, None, false, false, bounds());
+        d.key(Keysym::Return, None, false, false, bounds());
+        assert_eq!(d.marks[0].text, "Hi y");
+        assert!(!d.wants(Keysym::y, false));
+        assert_eq!(
+            d.key(Keysym::Escape, None, false, false, bounds()),
+            Outcome::Leave
+        );
+    }
+
+    #[test]
+    fn tools_colours_widths() {
+        let mut d = Draw::new();
+        d.active = true;
+        d.key(Keysym::x, Some('x'), false, false, bounds());
+        assert_eq!(d.tool, Tool::Redact);
+        d.key(Keysym::_7, Some('7'), false, false, bounds());
+        assert_eq!(d.color, 6);
+        d.key(Keysym::bracketright, Some(']'), false, false, bounds());
+        assert_eq!(d.width, 3);
+        // The cursor stays on the selection.
+        for _ in 0..20 {
+            d.key(Keysym::H, Some('H'), true, false, bounds());
+        }
+        assert_eq!(d.cursor.x, 0.);
+    }
+}
