+    float aa = max(gs.a, 0.001);
+    col /= aa;   // straight colour for the grading, premultiplied again at the end
+
+    // Colour grading: vibrancy, tint, milky lift.
+    float l = dot(col, vec3(0.2126, 0.7152, 0.0722));
+    col = mix(vec3(l), col, 1.25 * saturation);
+    vec3 tint_c = mix(vec3(1.0), vec3(0.09, 0.09, 0.10), dark);
+    col = mix(col, tint_c, tint_mix);
+    col += mix(0.055, 0.020, dark);
+
+    // Depth: a soft top sheen, a darker lower inner edge, and thick glass
