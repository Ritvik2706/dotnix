+    float ty = clamp((p.y - s[0].y) / max(s[0].w, 1.0), 0.0, 1.0);
+    col += (1.0 - ty) * mix(0.040, 0.030, dark);
+    col *= 1.0 - 0.12 * exp(-t / 6.0) * clamp(g.y, 0.0, 1.0);
