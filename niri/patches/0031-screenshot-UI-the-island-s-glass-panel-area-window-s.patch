@@ -1989,10 +1989,37 @@ impl State {
             touch.unset_grab(self);
         }
 
+        // The windows on each screen, for the window mode, in physical pixels
+        // as the screenshot UI works.
+        let focus = self.niri.layout.focus().map(|w| w.id().clone());
+        let windows = self
+            .niri
+            .global_space
+            .outputs()
+            .filter_map(|output| {
+                let mon = self.niri.layout.monitor_for_output(output)?;
+                let scale = output.current_scale().fractional_scale();
+                let visible = mon.visible_windows();
+                let focused = visible
+                    .iter()
+                    .position(|(w, _)| Some(w.id()) == focus);
+                let rects = visible
+                    .into_iter()
+                    .map(|(_, r)| r.to_physical_precise_round(scale))
+                    .collect();
+                Some((output.clone(), (rects, focused)))
+            })
+            .collect();
