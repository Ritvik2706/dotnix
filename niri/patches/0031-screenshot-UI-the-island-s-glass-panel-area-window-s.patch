diff --git a/src/layout/monitor.rs b/src/layout/monitor.rs
index 216e7823..80535aed 100644
--- a/src/layout/monitor.rs
+++ b/src/layout/monitor.rs
@@ -1579,6 +1579,29 @@ impl<W: LayoutElement> Monitor<W> {
         }
     }
 
+    /// The windows on screen, topmost first, each with where it is (output-local,
+    /// cut to the output): for the screenshot UI's window mode. None in the
+    /// overview, whose windows are scaled.
+    pub fn visible_windows(&self) -> Vec<(&W, Rectangle<f64, Logical>)> {
+        if self.overview_progress.is_some() {
+            return Vec::new();
+        }
+        let output = Rectangle::from_size(self.view_size);
+        let mut windows = Vec::new();
+        for (ws, geo) in self.workspaces_with_render_geo() {
+            for (tile, pos, visible) in ws.tiles_with_render_positions() {
+                if !visible {
+                    continue;
+                }
+                let rect = Rectangle::new(geo.loc + pos + tile.window_loc(), tile.window_size());
+                if let Some(rect) = rect.intersection(output) {
+                    windows.push((tile.window(), rect));
+                }
+            }
+        }
+        windows
+    }
+
     pub fn resize_edges_under(&self, pos_within_output: Point<f64, Logical>) -> Option<ResizeEdge> {
         if self.overview_progress.is_some() {
             return None;
