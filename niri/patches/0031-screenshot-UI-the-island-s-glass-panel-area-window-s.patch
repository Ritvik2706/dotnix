+    #[test]
+    fn vim_keys() {
+        let none = ModifiersState::default();
+        let shift = ModifiersState {
+            shift: true,
+            ..Default::default()
+        };
+        assert_eq!(action(Keysym::w, none), Some(Action::ScreenshotSetMode(1)));
+        assert_eq!(action(Keysym::l, none), Some(Action::ScreenshotNudge(1, 0)));
+        assert_eq!(action(Keysym::k, none), Some(Action::ScreenshotNudge(0, -1)));
+        assert_eq!(action(Keysym::L, shift), Some(Action::ScreenshotGrow(1, 0)));
+        assert_eq!(action(Keysym::h, shift), Some(Action::ScreenshotGrow(-1, 0)));
+        assert_eq!(
+            action(Keysym::y, none),
+            Some(Action::ConfirmScreenshot {
+                write_to_disk: false
+            })
+        );
+        assert_eq!(action(Keysym::q, none), Some(Action::CancelScreenshot));
+        assert_eq!(action(Keysym::x, none), None);
+    }
+
+    #[test]
+    fn window_jumps() {
+        // Two columns side by side, the right one split in two.
+        let windows = [
+            rect(0, 0, 100, 200),
+            rect(110, 0, 100, 95),
+            rect(110, 105, 100, 95),
+        ];
+        assert_eq!(window_towards(&windows, windows[0], 1, 0), Some(1));
+        assert_eq!(window_towards(&windows, windows[1], 0, 1), Some(2));
+        assert_eq!(window_towards(&windows, windows[2], 0, -1), Some(1));
+        assert_eq!(window_towards(&windows, windows[2], -1, 0), Some(0));
+        assert_eq!(window_towards(&windows, windows[0], -1, 0), None);
+    }
