+/// lumen's continuous corner (as the glass shader and niri's windows draw it):
+/// a superellipse reaching 1.84 x the radius along each side.
+fn squircle(cr: &cairo::Context, x: f64, y: f64, w: f64, h: f64, r: f64) {
+    let half = w.min(h) / 2.;
+    let r = r.min(half);
+    let e = (r * 1.84).min(half).max(r);
+    let n = if e > 0. {
+        (-std::f64::consts::LN_2 / (1. - 0.292_893_2 * r / e).ln()).max(2.)
+    } else {
+        2.
+    };
+    let n = if n < 2.01 { 2. } else { n };
+    // Corners clockwise from the top right, each from one side to the next.
+    let corners = [
+        (x + w - e, y + e, 1., -1., true),
+        (x + w - e, y + h - e, 1., 1., false),
+        (x + e, y + h - e, -1., 1., true),
+        (x + e, y + e, -1., -1., false),
+    ];
+    const STEPS: usize = 24;
+    cr.new_sub_path();
+    for (cx, cy, sx, sy, down) in corners {
+        for k in 0..=STEPS {
+            let t = k as f64 / STEPS as f64;
+            let a = if down { 1. - t } else { t } * std::f64::consts::FRAC_PI_2;
+            let px = cx + sx * e * a.cos().powf(2. / n);
+            let py = cy + sy * e * a.sin().powf(2. / n);
+            cr.line_to(px, py);
+        }
+    }
+    cr.close_path();
+}
 
