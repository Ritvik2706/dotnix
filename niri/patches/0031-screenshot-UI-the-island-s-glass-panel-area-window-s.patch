+/// The window nearest `from` in the direction (dx, dy), as vim moves: ahead
+/// that way, the closest, preferring ones in line.
+fn window_towards(
+    windows: &[Rectangle<i32, Physical>],
+    from: Rectangle<i32, Physical>,
+    dx: i8,
+    dy: i8,
+) -> Option<usize> {
+    let centre = |r: &Rectangle<i32, Physical>| {
+        (
+            f64::from(r.loc.x) + f64::from(r.size.w) / 2.,
+            f64::from(r.loc.y) + f64::from(r.size.h) / 2.,
+        )
+    };
+    let (cx, cy) = centre(&from);
+    let (dx, dy) = (f64::from(dx.signum()), f64::from(dy.signum()));
+    windows
+        .iter()
+        .enumerate()
+        .filter(|(_, w)| **w != from)
+        .filter_map(|(i, w)| {
+            let (wx, wy) = centre(w);
+            let ahead = (wx - cx) * dx + (wy - cy) * dy;
+            let aside = ((wx - cx) * dy).abs() + ((wy - cy) * dx).abs();
+            (ahead > 1.).then_some((i, ahead + 2. * aside))
+        })
+        .min_by(|a, b| a.1.total_cmp(&b.1))
+        .map(|(i, _)| i)
+}
