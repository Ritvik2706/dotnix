From 4363a8f4523806e3c35a3ee51cb9957d25fb5739 Mon Sep 17 00:00:00 2001
From: Ritvik <ritvik2014@gmail.com>
Date: Sun, 8 Nov 2026 18:24:36 +0400
Subject: [PATCH 39/40] liquid glass: frost regions (layer 3, protocol v6) blur
 the backdrop further inside them

---
 resources/lumen-glass-v1.xml                 |  9 +++--
 src/protocols/lumen_glass.rs                 | 10 +++--
 src/render_helpers/framebuffer_effect.rs     | 13 ++++++-
 src/render_helpers/liquid_glass.rs           | 18 +++++++++
 src/render_helpers/shaders/liquid_glass.frag | 41 +++++++++++++++++++-
 src/render_helpers/shaders/mod.rs            |  2 +
 6 files changed, 85 insertions(+), 8 deletions(-)

diff --git a/resources/lumen-glass-v1.xml b/resources/lumen-glass-v1.xml
index 163ab80a..9f6e9ce7 100644
--- a/resources/lumen-glass-v1.xml
+++ b/resources/lumen-glass-v1.xml
@@ -34,7 +34,7 @@
     Private to lumen and the patched niri.
   </description>
 
-  <interface name="lumen_glass_manager_v1" version="5">
+  <interface name="lumen_glass_manager_v1" version="6">
     <description summary="glass for surfaces">
     </description>
 
@@ -58,7 +58,7 @@
     </request>
   </interface>
 
-  <interface name="lumen_glass_surface_v1" version="5">
+  <interface name="lumen_glass_surface_v1" version="6">
     <description summary="the glass of one surface">
       All state is double-buffered: it applies on the surface's next
       wl_surface.commit, together with what the client drew for that frame.
@@ -89,7 +89,10 @@
             `continuous` corners); from version 4, plus 2 x layer: 0 glass
             on what is behind the surface, 1 glass on top of that glass
             (a control on a panel), which refracts it; 2 the same, but it
-            bends the crisp backdrop under the panel instead (a button)
+            bends the crisp backdrop under the panel instead (a button);
+            from version 6, 3: not glass but a frost region, inside which
+            the backdrop of the layer 0 glass is blurred further, by
+            `refraction` px (at most 4 a surface; no rim, no merging)
           refraction: how far the backdrop is displaced at the very rim,
             fading to 0 where the edge's curve ends
           dispersion: 0..1, how much the colours separate at the rim
diff --git a/src/protocols/lumen_glass.rs b/src/protocols/lumen_glass.rs
index 0ce68c48..8a179603 100644
--- a/src/protocols/lumen_glass.rs
+++ b/src/protocols/lumen_glass.rs
@@ -14,7 +14,7 @@ use super::raw::lumen_glass::v1::server::{lumen_glass_manager_v1, lumen_glass_su
 use lumen_glass_manager_v1::LumenGlassManagerV1;
 pub use lumen_glass_surface_v1::LumenGlassSurfaceV1;
 
-const VERSION: u32 = 5;
+const VERSION: u32 = 6;
 
 /// Floats per shape in set_shapes: 13, or 16 (version 2) with lens zoom, tint
 /// and rim tint (the two can't be confused with at most 8 shapes).
@@ -260,8 +260,12 @@ where
                         radii: [v[4].max(0.), v[5].max(0.), v[6].max(0.), v[7].max(0.)],
                         // corner: continuous (0/1) + 2 x layer.
                         continuous: v[8].rem_euclid(2.) >= 0.5,
-                        layer: ((v[8] / 2.).floor() as i32).clamp(0, 1) as u8,
-                        sharp: (v[8] / 2.).floor() as i32 >= 2,
+                        // 3: a frost region (no glass of its own, see liquid_glass.rs).
+                        layer: match (v[8] / 2.).floor() as i32 {
+                            3 => 3,
+                            l => l.clamp(0, 1) as u8,
+                        },
+                        sharp: (v[8] / 2.).floor() as i32 == 2,
                         refraction: v[9].clamp(-200., 200.),
                         dispersion: v[10].clamp(0., 1.),
                         bevel: v[11].max(0.),
diff --git a/src/render_helpers/framebuffer_effect.rs b/src/render_helpers/framebuffer_effect.rs
