+++ b/src/render_helpers/framebuffer_effect.rs
@@ -55,6 +55,9 @@ pub struct GlassDraw {
     pub merge: f32,
     /// The surface's frost (0..1), the same for all its shapes.
     pub frost: f32,
+    /// Frost regions (lumen-glass layer 3, at most 4): boxes inside the glass whose backdrop is
+    /// blurred further, by a radius of their own: (x, y, w, h), (corner radius, radius px, 0, 0), …
+    pub regions: Vec<[f32; 16]>,
     /// Where the brightness behind each shape is reported (light/dark glass).
     pub measure: Option<std::sync::Arc<std::sync::Mutex<GlassMeasure>>>,
     /// Layer 0: where to leave its crisp capture for the glass on top of it.
@@ -376,7 +379,7 @@ impl FramebufferEffectElement {
         crop: Rectangle<f64, Logical>,
         transform: Transform,
         sharp_map: Option<[f32; 4]>,
-    ) -> [Uniform<'static>; 12] {
+    ) -> [Uniform<'static>; 14] {
         let (input_to_clip_geo, clip_geo_size) = self.input_to_clip_geo(crop, transform);
         [
             Uniform::new("niri_scale", self.scale),
@@ -397,6 +400,14 @@ impl FramebufferEffectElement {
             Uniform::new("tex_sharp", 1i32),
             Uniform::new("sharp_map", sharp_map.unwrap_or([1., 1., 0., 0.])),
             Uniform::new("sharp_under", if sharp_map.is_some() { 1f32 } else { 0. }),
+            Uniform {
+                name: "frost_regions".into(),
+                value: UniformValue::Matrix4x4 {
+                    matrices: if glass.regions.is_empty() { vec![[0.; 16]] } else { glass.regions.clone() },
+                    transpose: false,
