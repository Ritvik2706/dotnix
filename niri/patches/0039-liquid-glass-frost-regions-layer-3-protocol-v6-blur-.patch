     }
 
diff --git a/src/render_helpers/liquid_glass.rs b/src/render_helpers/liquid_glass.rs
index e2aebe94..922155e9 100644
--- a/src/render_helpers/liquid_glass.rs
+++ b/src/render_helpers/liquid_glass.rs
@@ -412,6 +412,24 @@ impl Glass {
                 )
                 .with_glass(GlassDraw {
                     shapes,
+                    // Frost regions (layer 3) blur layer 0's backdrop further inside them.
+                    regions: if layer == 0 {
+                        state
+                            .shapes
+                            .iter()
+                            .filter(|s| s.layer == 3)
+                            .take(4)
+                            .map(|s| {
+                                let mut m = [0.; 16];
+                                m[..4].copy_from_slice(&[s.x - x0, s.y - y0, s.w, s.h]);
+                                m[4] = s.radii[0];
+                                m[5] = s.refraction.max(0.);
+                                m
+                            })
+                            .collect()
+                    } else {
+                        Vec::new()
+                    },
                     // Controls side by side stay apart: only the panels melt.
                     merge: if layer >= 1 { 0. } else { state.merge },
                     frost: state.frost,
diff --git a/src/render_helpers/shaders/liquid_glass.frag b/src/render_helpers/shaders/liquid_glass.frag
index 17e154fe..9bba9174 100644
--- a/src/render_helpers/shaders/liquid_glass.frag
+++ b/src/render_helpers/shaders/liquid_glass.frag
@@ -225,6 +225,13 @@ float displacement(float u, float bevel, float thickness, float ior, float power
 // coordinates, and it is bent instead of the panel's glass.
 uniform vec4 sharp_map;
 uniform float sharp_under;
+// Frost regions (lumen-glass layer 3): inside each, the frosted backdrop is
+// blurred further, by its own radius. (x, y, w, h), (corner, radius px, 0, 0).
+uniform mat4 frost_regions[4];
+uniform float frost_count;
+float region_soften = 0.0;   // px, here (set in main)
+mat2 px_to_tc = mat2(0.0);   // a logical px offset in texture coordinates (set in main)
+float region_turn = 0.0;     // the taps' rotation, per pixel, so no pattern shows
 float shape_sharp = 0.0;
 // How much of the crisp backdrop shows here (0..1): all of it on a round
 // button; on a pill or a field only along its curved edge, easing into the
@@ -237,7 +244,25 @@ vec4 backdrop(vec2 c, float clear) {
         vec4 crisp = texture2D(tex_sharp, clamp(c * sharp_map.xy + sharp_map.zw, vec2(0.0005), vec2(0.9995)));
         return sharp_k >= 1.0 ? crisp : mix(texture2D(tex, c), crisp, sharp_k);
     }
-    vec4 frosted = texture2D(tex, c);
+    vec4 frosted;
+    if (region_soften > 0.5) {
+        // A disc of the frosted backdrop: the centre and three rings of 8, turned per pixel.
+        frosted = texture2D(tex, c);
+        float wsum = 1.0;
+        for (int ring = 1; ring <= 3; ring++) {
+            float rr = region_soften * float(ring) / 3.0;
+            float w = 1.0 - float(ring) * 0.22;
+            for (int k = 0; k < 8; k++) {
+                float ang = (float(k) + 0.5 * float(ring)) * 0.785398 + region_turn;
+                vec2 o = px_to_tc * (vec2(cos(ang), sin(ang)) * rr);
+                frosted += w * texture2D(tex, clamp(c + o, vec2(0.0005), vec2(0.9995)));
+                wsum += w;
+            }
+        }
+        frosted /= wsum;
+    } else {
+        frosted = texture2D(tex, c);
+    }
     return clear > 0.0 ? mix(frosted, texture2D(tex_sharp, c), clear) : frosted;
 }
 
@@ -293,6 +318,20 @@ void main() {
     mat2 a = mat2(input_to_geo[0].xy, input_to_geo[1].xy);
     float det = a[0][0] * a[1][1] - a[1][0] * a[0][1];
     mat2 inv = mat2(a[1][1], -a[0][1], -a[1][0], a[0][0]) / det;
+    px_to_tc = inv / geo_size.x * mat2(1.0, 0.0, 0.0, geo_size.x / geo_size.y);
+
+    // Inside a frost region: how much further its backdrop is blurred (its rounded box, eased in at the edge).
+    for (int i = 0; i < 4; i++) {
+        if (float(i) >= frost_count)
+            break;
+        mat4 r = frost_regions[i];
+        vec2 hs = r[0].zw * 0.5;
+        float rad = min(r[1].x, min(hs.x, hs.y));
+        vec2 q = abs(p - r[0].xy - hs) - (hs - rad);
+        float rd = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - rad;
+        region_soften = max(region_soften, r[1].y * clamp(-rd / 3.0, 0.0, 1.0));
+    }
+    region_turn = hash12(p) * 6.2832;
 
     // Soft drop shadow, only outside the glass. Not looked for where it can't
     // show: fully covered, flat or rimless glass, or too far out (the shadow's
