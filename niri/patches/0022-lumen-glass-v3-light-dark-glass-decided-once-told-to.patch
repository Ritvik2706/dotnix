+        // Light or dark, per shape, from the latest reading of what is behind.
+        let mut shapes = shapes;
+        let object = glass_object(states).filter(|o| o.version() >= 3);
+        let announce = glass.lights.len() != shapes.len();
+        if announce {
+            glass.lights = vec![ShapeLight::new(); shapes.len()];
+        }
+        let (lum, reading) = {
+            let m = glass.measure.lock().unwrap();
+            (m.lum.clone(), m.last)
+        };
+        // Decide only on a new reading (not once per frame).
+        let fresh = reading.is_some() && reading != glass.seen;
+        glass.seen = reading;
+        let now = Instant::now();
+        let mut animating = false;
+        for (i, (shape, l)) in shapes.iter_mut().zip(glass.lights.iter_mut()).enumerate() {
+            if fresh && lum.len() == glass_count(&state) {
+                if let Some(&b) = lum.get(i) {
+                    let want = if l.light { b > LIGHT_OFF } else { b > LIGHT_ON };
+                    if !l.known {
+                        // The first reading: as it is, no fade on appearing.
+                        l.known = true;
+                        l.light = want;
+                        l.from = if want { 1. } else { 0. };
+                        if let Some(o) = &object {
+                            o.appearance(i as u32, want as u32);
+                        }
+                    } else if want != l.light {
+                        l.against += 1;
+                        if l.against >= SETTLE {
