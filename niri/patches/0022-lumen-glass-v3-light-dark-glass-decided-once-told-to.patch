@@ -30,6 +32,47 @@ struct SurfaceGlass(Mutex<SurfaceGlassInner>);
 struct SurfaceGlassInner {
     effect: FramebufferEffect,
     last: Option<LumenGlassCachedState>,
+    /// The backdrop's brightness behind each shape, read back by the capture.
+    measure: Arc<Mutex<GlassMeasure>>,
+    /// Each shape's light/dark glass, as decided and as drawn (crossfading).
+    lights: Vec<ShapeLight>,
+    /// The reading the decisions were last made from (one decision per reading).
+    seen: Option<Instant>,
+}
+
+/// Light or dark glass for a shape, like iOS: decided from what is behind with
+/// hysteresis (light above LIGHT_ON, dark again only below LIGHT_OFF, so a
+/// backdrop in between never flickers), crossfaded over FADE. The client is
+/// told (lumen-glass v3 `appearance`) so the text on it switches with it.
+#[derive(Clone, Copy)]
+struct ShapeLight {
+    known: bool,
+    light: bool,
+    from: f32,
+    start: Instant,
+    /// Readings in a row that wanted the other state: it switches at SETTLE,
+    /// so glass sweeping over a bright patch (a pill expanding) never flips.
+    against: u8,
+}
+
+const SETTLE: u8 = 2;
+
+const LIGHT_ON: f32 = 0.56;
+const LIGHT_OFF: f32 = 0.40;
+const FADE: Duration = Duration::from_millis(300);
+
+impl ShapeLight {
+    fn new() -> Self {
+        Self { known: false, light: false, from: 0., start: Instant::now(), against: 0 }
+    }
+
+    /// How light it is drawn now (0 dark .. 1 light), eased.
+    fn value(&self, now: Instant) -> f32 {
+        let target = if self.light { 1. } else { 0. };
+        let t = (now.saturating_duration_since(self.start).as_secs_f32() / FADE.as_secs_f32()).clamp(0., 1.);
+        let e = t * t * (3. - 2. * t);
+        self.from + (target - self.from) * e
+    }
 }
 
