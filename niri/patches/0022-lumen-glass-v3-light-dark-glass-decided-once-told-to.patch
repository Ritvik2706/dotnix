+    /// The backdrop's brightness behind each glass shape: five pixels of the
+    /// capture (its centre twice, and +/-30% of its size each way), mapped from
+    /// the element's logical geometry through the output transform to `tex`,
+    /// which holds the framebuffer rectangle `dst_fb` at `tex_size`.
+    #[allow(clippy::too_many_arguments)]
+    fn measure_glass(
+        &self,
+        frame: &mut GlesFrame<'_, '_>,
+        tex: &GlesTexture,
+        glass: &GlassDraw,
+        dst_fb: Rectangle<i32, Physical>,
+        tex_size: Size<i32, Buffer>,
+        transform: Transform,
+        out_size: Size<i32, Physical>,
+    ) -> Result<Vec<f32>, GlesError> {
+        if dst_fb.size.w <= 0 || dst_fb.size.h <= 0 {
+            return Ok(Vec::new());
+        }
+        let scale = self.scale as f64;
+        let area = out_size.to_f64();
+        let to_tex = |x: f64, y: f64| -> (i32, i32) {
+            let phys = Point::<f64, Physical>::from(((self.geometry.loc.x + x) * scale, (self.geometry.loc.y + y) * scale));
+            let fb = transform.transform_point_in(phys, &area);
+            let tx = (fb.x - dst_fb.loc.x as f64) / dst_fb.size.w as f64 * tex_size.w as f64;
+            let ty = (fb.y - dst_fb.loc.y as f64) / dst_fb.size.h as f64 * tex_size.h as f64;
+            (
+                (tx.floor() as i32).clamp(0, tex_size.w - 1),
+                (ty.floor() as i32).clamp(0, tex_size.h - 1),
+            )
+        };
+        let mut points = Vec::new();
+        for s in &glass.shapes {
+            let (cx, cy, hx, hy) = ((s[0] + s[2] * 0.5) as f64, (s[1] + s[3] * 0.5) as f64, (s[2] * 0.3) as f64, (s[3] * 0.3) as f64);
+            for (x, y) in [(cx, cy), (cx + hx, cy), (cx - hx, cy), (cx, cy + hy), (cx, cy - hy)] {
+                points.push(to_tex(x, y));
+            }
+        }
+        let lums = frame.with_context(|gl| unsafe {
+            let mut prev = 0i32;
+            gl.GetIntegerv(ffi::READ_FRAMEBUFFER_BINDING, &mut prev as *mut _);
+            let mut fbo = 0;
+            gl.GenFramebuffers(1, &mut fbo as *mut _);
+            gl.BindFramebuffer(ffi::READ_FRAMEBUFFER, fbo);
+            gl.FramebufferTexture2D(ffi::READ_FRAMEBUFFER, ffi::COLOR_ATTACHMENT0, ffi::TEXTURE_2D, tex.tex_id(), 0);
+            let mut out = Vec::with_capacity(points.len());
+            for (x, y) in &points {
+                let mut px = [0u8; 4];
+                gl.ReadPixels(*x, *y, 1, 1, ffi::RGBA, ffi::UNSIGNED_BYTE, px.as_mut_ptr().cast());
+                let a = (px[3] as f32 / 255.).max(1e-3);
+                let l = (0.2126 * px[0] as f32 + 0.7152 * px[1] as f32 + 0.0722 * px[2] as f32) / 255. / a;
+                out.push(l.clamp(0., 1.));
+            }
+            gl.BindFramebuffer(ffi::READ_FRAMEBUFFER, prev as u32);
+            gl.DeleteFramebuffers(1, &mut fbo as *mut _);
+            out
+        })?;
+        Ok(lums
+            .chunks(5)
+            .map(|c| (c[0] * 2. + c[1] + c[2] + c[3] + c[4]) / 6.)
+            .collect())
+    }
+
     pub fn with_ring(mut self, width: f64, light: f32, shade: f32) -> Self {
         self.ring_width = width as f32;
         self.ring_light = light;
@@ -372,10 +446,7 @@ impl RenderElement<GlesRenderer> for FramebufferEffectElement {
