+                        let lum = self.measure_glass(frame, &tex, glass, dst, size, transform, out_size);
+                        let mut m = measure.lock().unwrap();
+                        m.last = Some(std::time::Instant::now());
+                        if let Ok(lum) = lum {
+                            m.lum = lum;
+                        }
+                    }
+                }
+            }
