+                            }
+                        }
+                    } else {
+                        l.against = 0;
+                    }
+                }
+            }
+            let v = l.value(now);
+            animating |= v != if l.light { 1. } else { 0. };
+            // A client that can't switch its text keeps light glass at 80%,
+            // so white text on it still reads.
+            let v = if object.is_some() { v } else { v * 0.8 };
+            // corner (0/1) + 2 x (rim tint % + 128 x light %), see the shader.
+            shape[8] += 2. * 128. * (v * 100.).round();
+        }
+        if animating {
+            glass.effect.damage();
+        }
