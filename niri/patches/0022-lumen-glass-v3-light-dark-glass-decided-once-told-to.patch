@@ -112,5 +112,19 @@
       <arg name="frost" type="fixed"/>
       <arg name="saturation" type="fixed"/>
     </request>
+
+    <event name="appearance" since="3">
+      <description summary="whether a shape's glass is light or dark">
+        The compositor decides, from what is really behind each shape (its
+        frosted backdrop's brightness, with hysteresis so it doesn't flicker),
+        whether that shape's glass is light (1) or dark (0), and draws it so,
+        crossfading over about 300 ms. Sent when a shape's decision changes,
+        and for every shape after set_shapes changes their number. Content on
+        the glass should switch with it (dark text on light glass), over the
+        same time. `shape` is the index in the last set_shapes.
+      </description>
+      <arg name="shape" type="uint"/>
+      <arg name="light" type="uint"/>
+    </event>
   </interface>
 </protocol>
