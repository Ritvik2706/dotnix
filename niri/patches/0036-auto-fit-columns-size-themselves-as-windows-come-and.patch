+#[cfg(test)]
+mod auto_fit_plan_tests {
+    use super::{AutoFitPlan, FitCol};
+
+    const D: f64 = 0.5;
+
+    fn plan(cols: &[FitCol], per_screen: usize) -> Vec<Option<f64>> {
+        let p = AutoFitPlan::new(cols.iter().copied(), D, per_screen);
+        cols.iter().map(|c| p.target(*c).map(|t| (t * 1000.).round() / 1000.)).collect()
+    }
+
+    use FitCol::{Auto, Pinned};
+
+    #[test]
+    fn empty_and_solo() {
+        assert_eq!(plan(&[], 2), vec![]);
+        assert_eq!(plan(&[Auto(D)], 2), vec![Some(1.)]);
+        assert_eq!(plan(&[Auto(2. / 3.)], 2), vec![Some(1.)]);
+        assert_eq!(plan(&[Pinned(0.42)], 2), vec![None]);
+    }
+
+    #[test]
+    fn even_shares() {
+        assert_eq!(plan(&[Auto(D), Auto(D)], 2), vec![Some(0.5), Some(0.5)]);
+        assert_eq!(plan(&[Auto(D); 3], 2), vec![Some(0.5); 3]);
+        assert_eq!(plan(&[Auto(D); 3], 3), vec![Some(0.333); 3]);
+        assert_eq!(plan(&[Auto(D); 5], 3), vec![Some(0.333); 5]);
+    }
+
+    #[test]
+    fn preferences() {
+        // Zen ⅔ + terminal.
+        assert_eq!(plan(&[Auto(2. / 3.), Auto(D)], 2), vec![Some(0.667), Some(0.333)]);
+        // Zen ⅔ + Thunar ⅓.
+        assert_eq!(plan(&[Auto(2. / 3.), Auto(1. / 3.)], 2), vec![Some(0.667), Some(0.333)]);
+        // Two that can't fit together share evenly.
+        assert_eq!(plan(&[Auto(2. / 3.), Auto(2. / 3.)], 2), vec![Some(0.5), Some(0.5)]);
+        // Zen ⅔ + two terminals: the two can't share a third, so they scroll at ½.
+        assert_eq!(
+            plan(&[Auto(2. / 3.), Auto(D), Auto(D)], 2),
+            vec![Some(0.667), Some(0.5), Some(0.5)]
+        );
+    }
+
+    #[test]
+    fn full_width_preference() {
+        // Claude beside the terminal: both full.
+        assert_eq!(plan(&[Auto(D), Auto(1.)], 2), vec![Some(1.), Some(1.)]);
+        assert_eq!(plan(&[Auto(D), Auto(D), Auto(1.)], 2), vec![Some(0.5), Some(0.5), Some(1.)]);
+    }
+
+    #[test]
+    fn pinned_columns() {
+        // Self-sized mpv beside a terminal: the terminal takes the rest.
+        assert_eq!(plan(&[Pinned(0.42), Auto(D)], 2), vec![None, Some(0.58)]);
+        // Full width for now (maximized): the other lays out as a screen of its own.
+        assert_eq!(plan(&[Pinned(1.), Auto(D)], 2), vec![None, Some(1.)]);
+        assert_eq!(plan(&[Pinned(1.), Auto(D), Auto(D)], 2), vec![None, Some(0.5), Some(0.5)]);
+        // A hand-sized 0.4: the two others can't share 0.6, so ½ each.
+        assert_eq!(plan(&[Auto(D), Pinned(0.4), Auto(D)], 2), vec![Some(0.5), None, Some(0.5)]);
+        assert_eq!(plan(&[Auto(D), Pinned(0.4)], 2), vec![Some(0.6), None]);
+        // Preference that doesn't fit next to a pinned column: share evenly.
+        assert_eq!(plan(&[Pinned(0.566), Auto(2. / 3.)], 2), vec![None, Some(0.434)]);
+    }
+
+    #[test]
+    fn never_degenerate() {
+        // Whatever comes in, targets are positive and finite.
+        let inputs = [0., 1e-9, 0.1, 0.25, 1. / 3., 0.5, 2. / 3., 0.9, 1., 1.5, 1e9];
+        for &a in &inputs {
+            for &b in &inputs {
+                for per_screen in [0, 1, 2, 3] {
+                    for cols in [
+                        vec![Auto(a), Auto(b)],
+                        vec![Auto(a), Pinned(b)],
+                        vec![Pinned(a), Pinned(b), Auto(D)],
+                    ] {
+                        for t in plan(&cols, per_screen).into_iter().flatten() {
+                            assert!(t.is_finite() && t > 0., "{cols:?} {per_screen}: {t}");
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
