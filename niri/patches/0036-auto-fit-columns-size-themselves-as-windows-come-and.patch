+// ── dotnix auto-fit ─────────────────────────────────────────────────────────
+
+fn auto_fit_options() -> Options {
+    Options {
+        layout: niri_config::Layout {
+            auto_fit_columns: true,
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+}
+
+/// Opens window `id` as a new column; `width` is what its window rule would give it (niri passes
+/// the default, ½, for a window without one; `None` is a window that sizes itself).
+fn auto_fit_add(layout: &mut Layout<TestWindow>, id: usize, width: Option<f64>) {
+    layout.add_window(
+        TestWindow::new(TestWindowParams::new(id)),
+        AddWindowTarget::Auto,
+        width.map(PresetSize::Proportion),
+        None,
+        false,
+        false,
+        ActivateWindow::default(),
+    );
+    layout.verify_invariants();
+}
+
+/// Lets every window take its requested size and every animation finish.
+fn auto_fit_settle(layout: &mut Layout<TestWindow>) {
+    for id in 0..10 {
+        Op::Communicate(id).apply(layout);
+    }
+    Op::CompleteAnimations.apply(layout);
+    layout.verify_invariants();
+}
+
+/// The width the layout asked window `id` for, as a proportion of the 1280 px test output
+/// (16 px gaps).
+fn auto_fit_width(layout: &Layout<TestWindow>, id: usize) -> f64 {
+    let (_, win) = layout.windows().find(|(_, w)| w.0.id == id).unwrap();
+    let w = f64::from(win.requested_size().unwrap().w);
+    (w + 16.) / (1280. - 16.)
+}
+
+#[track_caller]
+fn assert_width(layout: &Layout<TestWindow>, id: usize, expected: f64) {
+    let got = auto_fit_width(layout, id);
+    assert!(
+        (got - expected).abs() < 0.005,
+        "window {id}: width {got:.4}, expected {expected:.4}"
+    );
+}
+
+fn auto_fit_layout() -> Layout<TestWindow> {
+    let mut layout = Layout::with_options(Clock::with_time(Duration::ZERO), auto_fit_options());
+    Op::AddOutput(1).apply(&mut layout);
+    layout
+}
