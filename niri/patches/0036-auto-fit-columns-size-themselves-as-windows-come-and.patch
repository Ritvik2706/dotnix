+/// dotnix auto-fit: one column, as the planner sees it.
+#[derive(Debug, Clone, Copy, PartialEq)]
+enum FitCol {
+    /// Sized by auto-fit; the width its window prefers beside others.
+    Auto(f64),
+    /// Left as it is (sized by hand, sizes itself, or full width for now); its width.
+    Pinned(f64),
+}
+
+impl FitCol {
+    fn width(self) -> f64 {
+        match self {
+            FitCol::Auto(w) | FitCol::Pinned(w) => w,
+        }
+    }
+}
+
+/// Widths closer than this are the same width.
+const AUTO_FIT_TOL: f64 = 0.02;
+/// Auto-fit never makes a column narrower than this; more columns scroll instead.
+const AUTO_FIT_MIN_SHARE: f64 = 1. / 3.;
+
+/// dotnix auto-fit: the widths for a set of columns, decided in one pass over them, with
+/// nothing allocated. For each managed column:
+///
+/// - alone on its workspace: the whole width;
+/// - preferring full width (Claude): full, scrolled past, the others laid out as if it weren't
+///   there;
+/// - preferring another width (a window rule, Zen ⅔): that width, as long as those widths fit
+///   together with a share for the rest; otherwise (Zen ⅔ + Zen ⅔) everything shares evenly;
+/// - the rest share what is left, `per_screen` at a time, never under a third (then they scroll
+///   at 1 / per_screen).
+#[derive(Debug, Clone, Copy, PartialEq)]
+struct AutoFitPlan {
+    solo: bool,
+    default: f64,
+    keep_prefs: bool,
+    share: f64,
+}
+
+impl AutoFitPlan {
+    fn new(cols: impl Iterator<Item = FitCol>, default: f64, per_screen: usize) -> Self {
+        let per_screen = per_screen.max(1);
+        let (mut count, mut pinned) = (0usize, 0.);
+        let (mut fixed, mut fixed_sum, mut flex) = (0usize, 0., 0usize);
+        for col in cols {
+            count += 1;
+            match Self::sane(col, default) {
+                FitCol::Pinned(w) => pinned += w,
+                FitCol::Auto(pref) if pref >= 1. - AUTO_FIT_TOL => (),
+                FitCol::Auto(pref) if (pref - default).abs() > AUTO_FIT_TOL => {
+                    fixed += 1;
+                    fixed_sum += pref;
+                }
+                FitCol::Auto(_) => flex += 1,
+            }
+        }
+
+        let need = pinned + fixed_sum + if flex > 0 { AUTO_FIT_MIN_SHARE } else { 0. };
+        let keep_prefs = !(fixed > 0 && need > 1. + AUTO_FIT_TOL);
+        if !keep_prefs {
+            flex += fixed;
+            fixed_sum = 0.;
+        }
+
+        let mut avail = 1. - pinned - fixed_sum;
+        if avail < 1. / 3. - AUTO_FIT_TOL {
+            // The others fill a screen by themselves: these lay out as a screen of their own.
+            avail = 1.;
+        }
+        let mut share = avail / flex.clamp(1, per_screen) as f64;
+        if share < AUTO_FIT_MIN_SHARE - 1e-6 {
+            share = 1. / per_screen as f64;
+        }
+
+        Self {
+            solo: count == 1,
+            default,
+            keep_prefs,
+            share,
+        }
+    }
+
+    /// A preference that is not a usable width counts as the default.
+    fn sane(col: FitCol, default: f64) -> FitCol {
+        match col {
+            // Under 5% is not a width anyone means.
+            FitCol::Auto(pref) if !(pref.is_finite() && pref >= 0.05) => FitCol::Auto(default),
+            FitCol::Pinned(w) if !w.is_finite() => FitCol::Pinned(1.),
+            col => col,
+        }
+    }
+
+    /// The width for a column, `None` for one auto-fit leaves alone.
+    fn target(&self, col: FitCol) -> Option<f64> {
+        let FitCol::Auto(pref) = Self::sane(col, self.default) else {
+            return None;
+        };
+        Some(if self.solo || pref >= 1. - AUTO_FIT_TOL {
+            1.
+        } else if self.keep_prefs && (pref - self.default).abs() > AUTO_FIT_TOL {
+            pref
+        } else {
+            self.share
+        })
+    }
+}
