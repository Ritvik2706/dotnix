new file mode 100644
index 00000000..1030d0c2
--- /dev/null
+++ b/src/render_helpers/shaders/liquid_glass.frag
@@ -0,0 +1,191 @@
+#version 100
+
+//_DEFINES_
+
+#if defined(EXTERNAL)
+#extension GL_OES_EGL_image_external : require
+#endif
+
+// Liquid glass (lumen-glass-v1): what is behind a set of glass shapes, seen
+// through them. `tex` is the backdrop under the shapes' bounding box, as
+// composed this frame (frosted or not); each shape bends it toward its curved
+// rim like a convex glass edge, splits it into colour there, and catches light
+// along the rim. Shapes within `glass_merge` of each other melt together.
+
+precision highp float;
+#if defined(EXTERNAL)
+uniform samplerExternalOES tex;
+#else
+uniform sampler2D tex;
+#endif
+
+uniform float alpha;
+varying vec2 v_coords;
+
+#if defined(DEBUG_FLAGS)
+uniform float tint;
+#endif
+
+uniform float niri_scale;
+uniform vec2 geo_size;
+uniform mat3 input_to_geo;
+
+// Per shape, columns: (x, y, w, h), radii (tl, tr, br, bl),
+// (corner, refraction, dispersion, bevel), (specular, -, -, -).
+// Coordinates in logical px from the bounding box's top-left.
+uniform mat4 glass_shapes[8];
+uniform float glass_count;
+uniform float glass_merge;
+uniform float saturation;
+uniform float noise;
+
+#define SQUIRCLE_EXTENT 1.84
+
+// Signed distance to one shape's outline (negative inside), with lumen's
+// continuous corner where asked: the same superellipse as rounding_alpha.frag.
+float shape_sdf(vec2 p, mat4 s) {
+    vec2 size = s[0].zw;
+    vec2 q = p - s[0].xy - size * 0.5;
+    vec4 radii = s[1];
+    float r = q.x < 0.0 ? (q.y < 0.0 ? radii.x : radii.w) : (q.y < 0.0 ? radii.y : radii.z);
+    float half_side = min(size.x, size.y) * 0.5;
+    r = min(r, half_side);
+
+    if (s[2].x < 0.5 || r < 0.5) {
+        vec2 c = abs(q) - (size * 0.5 - vec2(r));
+        return length(max(c, 0.0)) + min(max(c.x, c.y), 0.0) - r;
+    }
+
+    float e = max(min(r * SQUIRCLE_EXTENT, half_side), r);
+    vec2 c = abs(q) - (size * 0.5 - vec2(e));
+    if (c.x > 0.0 && c.y > 0.0) {
+        float n = -0.6931472 / log(1.0 - 0.2928932 * r / e);
+        if (n < 2.01)
+            return length(c) - e;
+        vec2 u = max(c / e, vec2(1e-4));
+        float l = pow(pow(u.x, n) + pow(u.y, n), 1.0 / n);
+        float steep = max(length(pow(u / l, vec2(n - 1.0))), 0.5);
+        return (l - 1.0) * e / steep;
+    }
+    vec2 d = abs(q) - size * 0.5;
+    return max(d.x, d.y);
+}
+
+// The union of all shapes, melting within glass_merge; `nearest` is the index
+// of the shape whose rim this is (its settings apply).
+float glass_sdf(vec2 p, out float nearest) {
+    float d = 1e6;
+    float best = 1e6;
+    nearest = 0.0;
+    for (int i = 0; i < 8; i++) {
+        if (float(i) >= glass_count)
+            break;
+        float di = shape_sdf(p, glass_shapes[i]);
+        if (di < best) {
+            best = di;
+            nearest = float(i);
+        }
+        if (glass_merge > 0.0) {
+            float h = max(glass_merge - abs(d - di), 0.0) / glass_merge;
+            d = min(d, di) - h * h * glass_merge * 0.25;
+        } else {
+            d = min(d, di);
+        }
+    }
+    return d;
+}
+
+mat4 shape_at(float index) {
+    mat4 s = glass_shapes[0];
+    for (int i = 1; i < 8; i++) {
+        if (float(i) == index)
+            s = glass_shapes[i];
+    }
+    return s;
+}
+
+vec3 saturate(vec3 color, float sat) {
+    const vec3 w = vec3(0.2126, 0.7152, 0.0722);
+    return mix(vec3(dot(color, w)), color, sat);
+}
+
+float hash12(vec2 p) {
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+void main() {
+    vec2 p = (input_to_geo * vec3(v_coords, 1.0)).xy * geo_size;
+
+    float idx;
+    float d = glass_sdf(p, idx);
+    // Coverage, antialiased over one physical pixel.
+    float cover = clamp(0.5 - d * niri_scale, 0.0, 1.0);
+    if (cover <= 0.0) {
+        gl_FragColor = vec4(0.0);
+        return;
+    }
+
+    mat4 s = shape_at(idx);
+    float refraction = s[2].y;
+    float dispersion = s[2].z;
+    float bevel = s[2].w;
+    float specular = s[3].x;
+
+    // Outward normal of the (merged) outline.
+    float ignore;
+    float h = 0.5;
+    vec2 grad = vec2(glass_sdf(p + vec2(h, 0.0), ignore) - glass_sdf(p - vec2(h, 0.0), ignore),
+                     glass_sdf(p + vec2(0.0, h), ignore) - glass_sdf(p - vec2(0.0, h), ignore));
+    vec2 n = length(grad) > 1e-5 ? normalize(grad) : vec2(0.0);
+
+    // Across the bevel: 0 where the glass turns flat, 1 at the rim. A circular
+    // profile, so it bends gently inside and sharply at the very edge.
+    float depth = -d;
+    float t = bevel > 0.0 ? clamp(1.0 - depth / bevel, 0.0, 1.0) : 0.0;
+    float bend = 1.0 - sqrt(max(1.0 - t * t, 0.0));
+
+    // A convex edge magnifies: the rim shows what is further in.
+    vec2 off = -n * refraction * bend;
+    // From logical px to texture coordinates (inverse of input_to_geo's linear part).
+    mat2 a = mat2(input_to_geo[0].xy, input_to_geo[1].xy);
+    float det = a[0][0] * a[1][1] - a[1][0] * a[0][1];
+    mat2 inv = mat2(a[1][1], -a[0][1], -a[1][0], a[0][0]) / det;
+    vec2 dv = inv * (off / geo_size);
+
+    vec4 color;
+    if (dispersion > 0.0) {
+        vec4 g = texture2D(tex, v_coords + dv);
+        color = vec4(texture2D(tex, v_coords + dv * (1.0 + dispersion)).r, g.g,
+                     texture2D(tex, v_coords + dv * (1.0 - dispersion)).b, g.a);
+    } else {
+        color = texture2D(tex, v_coords + dv);
+    }
+#if defined(NO_ALPHA)
+    color.a = 1.0;
+#endif
+
+    if (saturation != 1.0)
+        color.rgb = saturate(color.rgb, saturation);
+    if (noise > 0.0)
+        color.rgb += (hash12(gl_FragCoord.xy) - 0.5) * noise;
+
+    // Light: a bright line right at the rim, strongest facing the key light
+    // (top-left), a fainter one opposite, and a soft sheen across the bevel.
+    vec2 key = vec2(-0.5547, -0.8321);
+    float facing = max(dot(n, key), 0.0);
+    float back = max(dot(n, -key), 0.0);
+    float rim = 1.0 - smoothstep(0.0, 1.6, depth);
+    float lit = specular * (rim * (0.35 + 0.65 * facing + 0.45 * back) + 0.3 * bend * bend * facing);
+    color.rgb = mix(color.rgb, vec3(color.a), clamp(lit, 0.0, 1.0));
+
+    color *= cover * alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
