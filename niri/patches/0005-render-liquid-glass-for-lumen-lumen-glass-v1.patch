diff --git a/src/protocols/lumen_glass.rs b/src/protocols/lumen_glass.rs
new file mode 100644
index 00000000..185f744e
--- /dev/null
+++ b/src/protocols/lumen_glass.rs
@@ -0,0 +1,249 @@
+//! lumen-glass-v1: liquid glass drawn by the compositor for lumen's surfaces.
+//!
+//! The client sends its glass as shapes (resources/lumen-glass-v1.xml); they are
+//! double-buffered in the surface's cached state, so they change in the very
+//! frame the client drew for them. Rendering is render_helpers/liquid_glass.rs.
+
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::reexports::wayland_server::{
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource, Weak,
+};
+use smithay::wayland::compositor::{with_states, Cacheable};
+
+use super::raw::lumen_glass::v1::server::{lumen_glass_manager_v1, lumen_glass_surface_v1};
+use lumen_glass_manager_v1::LumenGlassManagerV1;
+use lumen_glass_surface_v1::LumenGlassSurfaceV1;
+
+const VERSION: u32 = 1;
+
+/// Floats per shape in set_shapes.
+const SHAPE_FLOATS: usize = 13;
+pub const MAX_SHAPES: usize = 8;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct GlassShape {
+    pub x: f32,
+    pub y: f32,
+    pub w: f32,
+    pub h: f32,
+    /// top-left, top-right, bottom-right, bottom-left
+    pub radii: [f32; 4],
+    pub continuous: bool,
+    pub refraction: f32,
+    pub dispersion: f32,
+    pub bevel: f32,
+    pub specular: f32,
+}
+
+/// Double-buffered glass state of a surface.
+#[derive(Debug, Clone, PartialEq)]
+pub struct LumenGlassCachedState {
+    pub shapes: Vec<GlassShape>,
+    pub merge: f32,
+    pub frost: f32,
+    pub saturation: f32,
+}
+
+impl Default for LumenGlassCachedState {
+    fn default() -> Self {
+        Self {
+            shapes: Vec::new(),
+            merge: 0.,
+            frost: 1.,
+            saturation: 1.,
+        }
+    }
+}
+
+impl Cacheable for LumenGlassCachedState {
+    fn commit(&mut self, _dh: &DisplayHandle) -> Self {
+        self.clone()
+    }
+
+    fn merge_into(self, into: &mut Self, _dh: &DisplayHandle) {
+        *into = self;
+    }
+}
+
+/// Whether a surface has a live glass object (one per surface).
+#[derive(Default)]
+struct HasGlass(std::sync::Mutex<bool>);
+
+pub struct LumenGlassManagerState;
+
+pub struct LumenGlassManagerGlobalData {
+    filter: Box<dyn for<'c> Fn(&'c Client) -> bool + Send + Sync>,
+}
+
+impl LumenGlassManagerState {
+    pub fn new<D, F>(display: &DisplayHandle, filter: F) -> Self
+    where
+        D: GlobalDispatch<LumenGlassManagerV1, LumenGlassManagerGlobalData>,
+        D: Dispatch<LumenGlassManagerV1, ()>,
+        D: Dispatch<LumenGlassSurfaceV1, Weak<WlSurface>>,
+        D: 'static,
+        F: for<'c> Fn(&'c Client) -> bool + Send + Sync + 'static,
+    {
+        let global_data = LumenGlassManagerGlobalData {
+            filter: Box::new(filter),
+        };
+        display.create_global::<D, LumenGlassManagerV1, _>(VERSION, global_data);
+        Self
+    }
+}
+
+impl<D> GlobalDispatch<LumenGlassManagerV1, LumenGlassManagerGlobalData, D>
+    for LumenGlassManagerState
+where
+    D: GlobalDispatch<LumenGlassManagerV1, LumenGlassManagerGlobalData>,
+    D: Dispatch<LumenGlassManagerV1, ()>,
+    D: Dispatch<LumenGlassSurfaceV1, Weak<WlSurface>>,
+    D: 'static,
+{
+    fn bind(
+        _state: &mut D,
+        _handle: &DisplayHandle,
+        _client: &Client,
+        manager: New<LumenGlassManagerV1>,
+        _global_data: &LumenGlassManagerGlobalData,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        data_init.init(manager, ());
+    }
+
+    fn can_view(client: Client, global_data: &LumenGlassManagerGlobalData) -> bool {
+        (global_data.filter)(&client)
+    }
+}
+
+impl<D> Dispatch<LumenGlassManagerV1, (), D> for LumenGlassManagerState
+where
+    D: Dispatch<LumenGlassManagerV1, ()>,
+    D: Dispatch<LumenGlassSurfaceV1, Weak<WlSurface>>,
+    D: 'static,
+{
+    fn request(
+        _state: &mut D,
+        _client: &Client,
+        manager: &LumenGlassManagerV1,
+        request: lumen_glass_manager_v1::Request,
+        _data: &(),
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            lumen_glass_manager_v1::Request::Destroy => (),
+            lumen_glass_manager_v1::Request::GetGlass { id, surface } => {
+                let exists = with_states(&surface, |states| {
+                    let has = states.data_map.get_or_insert_threadsafe(HasGlass::default);
+                    std::mem::replace(&mut *has.0.lock().unwrap(), true)
+                });
+                if exists {
+                    manager.post_error(
+                        lumen_glass_manager_v1::Error::GlassExists,
+                        "the surface already has a glass object",
+                    );
+                    return;
+                }
+                data_init.init(id, surface.downgrade());
+            }
+        }
+    }
+}
+
+fn with_pending(surface: &Weak<WlSurface>, f: impl FnOnce(&mut LumenGlassCachedState)) {
+    if let Ok(surface) = surface.upgrade() {
+        with_states(&surface, |states| {
+            f(states.cached_state.get::<LumenGlassCachedState>().pending());
+        });
+    }
+}
+
+impl<D> Dispatch<LumenGlassSurfaceV1, Weak<WlSurface>, D> for LumenGlassManagerState
+where
+    D: Dispatch<LumenGlassSurfaceV1, Weak<WlSurface>>,
+    D: 'static,
+{
+    fn request(
+        _state: &mut D,
+        _client: &Client,
+        glass: &LumenGlassSurfaceV1,
+        request: lumen_glass_surface_v1::Request,
+        surface: &Weak<WlSurface>,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            lumen_glass_surface_v1::Request::Destroy => {
+                with_pending(surface, |p| *p = LumenGlassCachedState::default());
+                if let Ok(s) = surface.upgrade() {
+                    with_states(&s, |states| {
+                        if let Some(has) = states.data_map.get::<HasGlass>() {
+                            *has.0.lock().unwrap() = false;
+                        }
+                    });
+                }
+            }
+            lumen_glass_surface_v1::Request::SetShapes { shapes } => {
+                let floats = shapes.len() / 4;
+                if shapes.len() % 4 != 0 || floats % SHAPE_FLOATS != 0 {
+                    glass.post_error(
+                        lumen_glass_surface_v1::Error::InvalidShapes,
+                        "the shapes array is not a whole number of shapes",
+                    );
+                    return;
+                }
+                let f: Vec<f32> = shapes
+                    .chunks_exact(4)
+                    .map(|b| f32::from_ne_bytes([b[0], b[1], b[2], b[3]]))
+                    .collect();
+                let parsed: Vec<GlassShape> = f
+                    .chunks_exact(SHAPE_FLOATS)
+                    .take(MAX_SHAPES)
+                    .filter(|v| v.iter().all(|x| x.is_finite()) && v[2] > 0. && v[3] > 0.)
+                    .map(|v| GlassShape {
+                        x: v[0],
+                        y: v[1],
+                        w: v[2],
+                        h: v[3],
+                        radii: [v[4].max(0.), v[5].max(0.), v[6].max(0.), v[7].max(0.)],
+                        continuous: v[8] >= 0.5,
+                        refraction: v[9].clamp(-200., 200.),
+                        dispersion: v[10].clamp(0., 1.),
+                        bevel: v[11].max(0.),
+                        specular: v[12].clamp(0., 1.),
+                    })
+                    .collect();
+                with_pending(surface, |p| p.shapes = parsed);
+            }
+            lumen_glass_surface_v1::Request::SetParams {
+                merge,
+                frost,
+                saturation,
+            } => {
+                with_pending(surface, |p| {
+                    p.merge = (merge as f32).max(0.);
+                    p.frost = (frost as f32).clamp(0., 1.);
+                    p.saturation = (saturation as f32).clamp(0., 4.);
+                });
+            }
+        }
+    }
+}
+
+#[macro_export]
+macro_rules! delegate_lumen_glass {
+    ($(@<$( $lt:tt $( : $clt:tt $(+ $dlt:tt )* )? ),+>)? $ty: ty) => {
+        smithay::reexports::wayland_server::delegate_global_dispatch!($(@< $( $lt $( : $clt $(+ $dlt )* )? ),+ >)? $ty: [
+            $crate::protocols::raw::lumen_glass::v1::server::lumen_glass_manager_v1::LumenGlassManagerV1: $crate::protocols::lumen_glass::LumenGlassManagerGlobalData
+        ] => $crate::protocols::lumen_glass::LumenGlassManagerState);
+
+        smithay::reexports::wayland_server::delegate_dispatch!($(@< $( $lt $( : $clt $(+ $dlt )* )? ),+ >)? $ty: [
+            $crate::protocols::raw::lumen_glass::v1::server::lumen_glass_manager_v1::LumenGlassManagerV1: ()
+        ] => $crate::protocols::lumen_glass::LumenGlassManagerState);
+
+        smithay::reexports::wayland_server::delegate_dispatch!($(@< $( $lt $( : $clt $(+ $dlt )* )? ),+ >)? $ty: [
+            $crate::protocols::raw::lumen_glass::v1::server::lumen_glass_surface_v1::LumenGlassSurfaceV1: smithay::reexports::wayland_server::Weak<smithay::reexports::wayland_server::protocol::wl_surface::WlSurface>
+        ] => $crate::protocols::lumen_glass::LumenGlassManagerState);
+    };
+}
