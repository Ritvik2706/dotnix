index 00000000..4db0cdc2
--- /dev/null
+++ b/src/render_helpers/liquid_glass.rs
@@ -0,0 +1,131 @@
+//! Liquid glass for surfaces that asked for it with lumen-glass-v1: one
+//! framebuffer capture over the bounding box of the surface's glass shapes (what
+//! is really behind them, this frame), drawn through the liquid_glass shader.
+
+use std::sync::Mutex;
+
+use niri_config::CornerRadius;
+use smithay::backend::renderer::gles::GlesRenderer;
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::utils::{Logical, Point, Rectangle, Size};
+use smithay::wayland::compositor::with_states;
+
+use crate::protocols::lumen_glass::LumenGlassCachedState;
+use crate::render_helpers::background_effect::{BackgroundEffectElement, RenderParams};
+use crate::render_helpers::blur::BlurOptions;
+use crate::render_helpers::framebuffer_effect::{FramebufferEffect, GlassDraw};
+use crate::render_helpers::RenderCtx;
+
+/// The capture a surface's glass is drawn from, and the state it was last
+/// drawn with (a change re-renders it).
+struct SurfaceGlass(Mutex<SurfaceGlassInner>);
+
+struct SurfaceGlassInner {
+    effect: FramebufferEffect,
+    last: Option<LumenGlassCachedState>,
+}
+
+/// Renders the surface's liquid glass, if it has any; `location` is the
+/// surface's origin. Returns whether it did (then it replaces the surface's
+/// plain background effect).
+pub fn render_for_surface(
+    _ctx: RenderCtx<GlesRenderer>,
+    ns: Option<usize>,
+    location: Point<f64, Logical>,
+    scale: f64,
+    surface: &WlSurface,
+    blur_config: niri_config::Blur,
+    push: &mut dyn FnMut(BackgroundEffectElement),
+) -> bool {
+    with_states(surface, |states| {
+        if !states.cached_state.has::<LumenGlassCachedState>() {
+            return false;
+        }
+        let state = states
+            .cached_state
+            .get::<LumenGlassCachedState>()
+            .current()
+            .clone();
+        if state.shapes.is_empty() {
+            return false;
+        }
+
+        // The shapes' bounding box, a pixel wider for the antialiased rim.
+        let (mut x0, mut y0, mut x1, mut y1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+        for s in &state.shapes {
+            x0 = x0.min(s.x);
+            y0 = y0.min(s.y);
+            x1 = x1.max(s.x + s.w);
+            y1 = y1.max(s.y + s.h);
+        }
+        let (x0, y0) = ((x0 - 1.).floor(), (y0 - 1.).floor());
+        let (x1, y1) = ((x1 + 1.).ceil(), (y1 + 1.).ceil());
+        let geometry = Rectangle::new(
+            location + Point::from((x0 as f64, y0 as f64)),
+            Size::from(((x1 - x0) as f64, (y1 - y0) as f64)),
+        );
+
+        let shapes = state
+            .shapes
+            .iter()
+            .map(|s| {
+                [
+                    s.x - x0,
+                    s.y - y0,
+                    s.w,
+                    s.h,
+                    s.radii[0],
+                    s.radii[1],
+                    s.radii[2],
+                    s.radii[3],
+                    if s.continuous { 1. } else { 0. },
+                    s.refraction,
+                    s.dispersion,
+                    s.bevel,
+                    s.specular,
+                    0.,
+                    0.,
+                    0.,
+                ]
+            })
+            .collect();
+
+        let frosted = state.frost > 0. && !blur_config.off;
+        let blur = frosted.then(|| {
+            let mut options = BlurOptions::from(blur_config);
+            options.offset *= state.frost as f64;
+            options
+        });
+        let noise = if frosted { blur_config.noise as f32 } else { 0. };
+
+        let glass = states
+            .data_map
+            .get_or_insert_threadsafe(|| {
+                SurfaceGlass(Mutex::new(SurfaceGlassInner {
+                    effect: FramebufferEffect::new(),
+                    last: None,
+                }))
+            });
+        let mut glass = glass.0.lock().unwrap();
+        if glass.last.as_ref() != Some(&state) {
+            glass.effect.damage();
+            glass.last = Some(state.clone());
+        }
+
+        let params = RenderParams {
+            geometry,
+            subregion: None,
+            clip: Some((geometry, CornerRadius::default())),
+            scale,
+        };
+        let elem = glass
+            .effect
+            .render(ns, params, blur, noise, state.saturation)
+            .with_glass(GlassDraw {
+                shapes,
+                merge: state.merge,
+            });
+        push(elem.into());
+        true
+    })
+}
