+    Software is furnished to do so, subject to the following conditions:
+
+    The above copyright notice and this permission notice (including the next
+    paragraph) shall be included in all copies or substantial portions of the
+    Software.
+
+    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <description summary="liquid glass drawn by the compositor">
+    A client describes the glass on its surface as shapes; the compositor
+    draws, under the surface, what is really behind each shape seen through
+    glass: refracted toward the shape's curved edge, split into colour at
+    it, frosted, and lit along its rim. Shapes close to each other melt
+    together. Nothing is captured by the client: the compositor uses the
+    frame it is composing, so the glass is never a frame behind.
+
+    Private to lumen and the patched niri.
+  </description>
+
+  <interface name="lumen_glass_manager_v1" version="1">
+    <description summary="glass for surfaces">
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the manager">
+        Existing glass objects are not affected.
+      </description>
+    </request>
+
+    <enum name="error">
+      <entry name="glass_exists" value="0"
+             summary="the surface already has a glass object"/>
+    </enum>
+
+    <request name="get_glass">
+      <description summary="the glass of a surface">
+        At most one per surface.
+      </description>
+      <arg name="id" type="new_id" interface="lumen_glass_surface_v1"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+  </interface>
+
+  <interface name="lumen_glass_surface_v1" version="1">
+    <description summary="the glass of one surface">
+      All state is double-buffered: it applies on the surface's next
+      wl_surface.commit, together with what the client drew for that frame.
+      Initially there are no shapes, so no glass.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="remove the glass">
+        Takes effect on the next wl_surface.commit.
+      </description>
+    </request>
+
+    <enum name="error">
+      <entry name="invalid_shapes" value="0"
+             summary="the shapes array is not a whole number of shapes"/>
+    </enum>
+
+    <request name="set_shapes">
+      <description summary="the glass shapes">
+        Native-endian 32-bit floats, 13 per shape, at most 8 shapes; an empty
+        array removes all glass. Per shape, in surface-local logical pixels
+        unless noted:
+
+          x, y, width, height
+          radius top-left, top-right, bottom-right, bottom-left
+          corner: 0 circular arcs, 1 continuous (squircle, lumen's
+            `continuous` corners)
+          refraction: how far the backdrop is displaced at the very rim,
+            fading to 0 where the edge's curve ends
+          dispersion: 0..1, how much the colours separate at the rim
+          bevel: how far in from the edge the glass is curved; the middle
+            is flat and shows the backdrop undisplaced
+          specular: 0..1, the light along the rim
+      </description>
+      <arg name="shapes" type="array"/>
+    </request>
+
+    <request name="set_params">
+      <description summary="how the glass behaves as a whole">
+        merge: shapes closer than this (logical px) melt into each other.
+        frost: 0..1, 0 clear glass, 1 the compositor's full blur.
+        saturation: of what is seen through the glass (1 unchanged).
+        Defaults: merge 0, frost 1, saturation 1.
+      </description>
+      <arg name="merge" type="fixed"/>
+      <arg name="frost" type="fixed"/>
+      <arg name="saturation" type="fixed"/>
+    </request>
+  </interface>
+</protocol>
