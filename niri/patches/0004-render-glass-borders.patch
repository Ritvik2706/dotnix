diff --git a/src/render_helpers/shaders/clipped_surface.frag b/src/render_helpers/shaders/clipped_surface.frag
index e97f18c0..f90ea84a 100644
--- a/src/render_helpers/shaders/clipped_surface.frag
+++ b/src/render_helpers/shaders/clipped_surface.frag
@@ -25,6 +25,22 @@ uniform float niri_scale;
 uniform vec2 geo_size;
 uniform vec4 corner_radius;
 uniform mat3 input_to_geo;
+// Above 0: only a ring this wide along the edge is drawn (glass borders); its
+// inner edge follows the corners like a border's.
+uniform float ring_width;
+// …and how much light the ring's glass catches: what is behind it, lifted toward
+// white; below 0, glass in shadow (an unfocused window's), dimmed instead.
+uniform float ring_light;
+// …and the dark line at its outer edge (the glass's silhouette), so the ring
+// still reads over a backdrop as bright as itself.
+uniform float ring_shade;
+
+// Distance inside a rounded box (circular corners: close enough to the
+// squircle for a profile across a few pixels).
+float ring_depth(vec2 p, vec2 size, float r) {
+    vec2 q = abs(p - size * 0.5) - (size * 0.5 - vec2(r));
+    return r - (length(max(q, 0.0)) + min(max(q.x, q.y), 0.0));
+}
 
 float niri_rounding_alpha(vec2 coords, vec2 size, vec4 corner_radius);
 vec4 postprocess(vec4 color);
@@ -46,6 +62,25 @@ void main() {
     } else {
         // Apply corner rounding inside geometry.
         color = color * niri_rounding_alpha(coords_geo.xy * geo_size, geo_size, corner_radius);
+
+        if (ring_width > 0.0) {
+            // Across the ring, outside in: a dark hairline, then the lit glass.
+            vec2 p = coords_geo.xy * geo_size;
+            float r = p.x < geo_size.x * 0.5
+                ? (p.y < geo_size.y * 0.5 ? corner_radius.x : corner_radius.w)
+                : (p.y < geo_size.y * 0.5 ? corner_radius.y : corner_radius.z);
+            float depth = ring_depth(p, geo_size, r) / ring_width;
+            float edge = 1.0 - smoothstep(0.18, 0.42, depth);
+            float lift = ring_light * (1.0 - edge);
+            color.rgb = lift >= 0.0 ? mix(color.rgb, vec3(color.a), lift) : color.rgb * (1.0 + lift);
+            color.rgb *= 1.0 - ring_shade * edge;
+            vec2 inner = coords_geo.xy * geo_size - vec2(ring_width);
+            vec2 inner_size = geo_size - vec2(ring_width * 2.0);
+            if (0.0 <= inner.x && inner.x <= inner_size.x && 0.0 <= inner.y && inner.y <= inner_size.y) {
+                vec4 inner_radius = max(corner_radius - vec4(ring_width), 0.0);
+                color = color * (1.0 - niri_rounding_alpha(inner, inner_size, inner_radius));
+            }
+        }
     }
 
     // Apply final alpha and tint.
