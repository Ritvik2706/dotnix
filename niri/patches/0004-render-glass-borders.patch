 niri-config/src/lib.rs                        |  4 ++
 src/layout/focus_ring.rs                      |  8 +++
 src/layout/tile.rs                            | 68 ++++++++++++++++++-
 src/render_helpers/framebuffer_effect.rs      | 22 +++++-
 .../shaders/clipped_surface.frag              | 35 ++++++++++
 src/render_helpers/shaders/mod.rs             |  3 +
 src/render_helpers/xray.rs                    | 37 +++++++++-
 8 files changed, 199 insertions(+), 4 deletions(-)

