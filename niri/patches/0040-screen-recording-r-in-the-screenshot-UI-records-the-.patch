+    /// The screenshot UI's `r`: the UI closes and the selection is recorded,
+    /// by ~/.config/niri/scripts/record.sh (given `at WxH+X+Y` in logical
+    /// layout coordinates, as slurp gives them, or `output NAME`).
+    pub fn screenshot_record(&mut self) {
+        let target = self.niri.screenshot_ui.record_target();
+        self.close_screenshot_ui();
+        let Some((output, rect)) = target else {
+            return;
+        };
+        let what = match rect {
+            None => format!("output {}", output.name()),
+            Some(r) => {
+                let Some(geo) = self.niri.global_space.output_geometry(&output) else {
+                    return;
+                };
+                let (x, y) = (geo.loc.x as f64 + r.loc.x, geo.loc.y as f64 + r.loc.y);
+                let (w, h) = (r.size.w.round().max(1.), r.size.h.round().max(1.));
+                format!("at {w}x{h}+{}+{}", x.round(), y.round())
+            }
+        };
+        let Some(home) = std::env::var_os("HOME") else {
+            return;
+        };
+        let script = PathBuf::from(home).join(".config/niri/scripts/record.sh");
+        crate::utils::spawning::spawn(vec![script.into_os_string(), what.into()], None);
+    }
+
     fn close_screenshot_ui(&mut self) {
         self.niri.screenshot_ui.close();
         self.niri
