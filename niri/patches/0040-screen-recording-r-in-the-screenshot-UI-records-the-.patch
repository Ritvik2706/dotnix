+    /// What `r` records: the whole output when that is what is selected,
+    /// else the selection, in the output's logical coordinates.
+    pub fn record_target(&self) -> Option<(Output, Option<Rectangle<f64, Logical>>)> {
+        let Self::Open {
+            selection,
+            output_data,
+            mode,
+            ..
+        } = self
+        else {
+            return None;
+        };
+        let data = output_data.get(&selection.0)?;
+        let rect = rect_from_corner_points(selection.1, selection.2);
+        if *mode == Mode::Screen || rect.size == data.size {
+            return Some((selection.0.clone(), None));
+        }
+        Some((selection.0.clone(), Some(rect.to_f64().to_logical(data.scale))))
+    }
