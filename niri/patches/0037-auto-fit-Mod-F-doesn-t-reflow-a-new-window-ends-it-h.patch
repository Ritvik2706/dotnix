+    /// dotnix: the focused column and the one to its right (or its left, at the end of the
+    /// strip) side by side at half the screen each, both in view. With auto-fit they keep half
+    /// as their preference, so later changes on the workspace still fit around them;
+    /// without it, they are sized by hand.
+    pub fn half_and_half(&mut self) {
+        if self.columns.len() < 2 {
+            return;
+        }
+        let a = self.active_column_idx;
+        let b = if a + 1 < self.columns.len() { a + 1 } else { a - 1 };
+        if [a, b]
+            .iter()
+            .any(|&i| !self.columns[i].pending_sizing_mode().is_normal())
+        {
+            // Fullscreen or maximized: not something to split.
+            return;
+        }
+
+        let auto_fit = self.options.layout.auto_fit_columns;
+        for idx in [a, b] {
+            let col = &mut self.columns[idx];
+            cancel_resize_for_column(&mut self.interactive_resize, col);
+            if auto_fit {
+                col.is_full_width = false;
+                col.auto_fit = Some(0.5);
+                col.set_auto_fit_width(0.5);
+                // set_auto_fit_width() skips a column already at ½; full width may have just
+                // gone, so ask for the size regardless.
+                col.update_tile_sizes(true);
+            } else {
+                col.set_column_width(SizeChange::SetProportion(50.), None, true);
+            }
+        }
+
+        // Both in view, the left one at the left edge.
+        if self.view_offset.is_gesture() {
+            return;
+        }
+        let left = min(a, b);
+        let gaps = self.options.layout.gaps;
+        let before = if a > left {
+            self.columns[left].target_width() + gaps
+        } else {
+            0.
+        };
+        let new_offset = -(self.working_area.loc.x + gaps + before);
+        self.animate_view_offset(a, new_offset);
+    }
+
