+
+#[test]
+fn auto_fit_maximize_leaves_the_others_alone() {
+    let mut layout = auto_fit_layout();
+    auto_fit_add(&mut layout, 1, Some(0.5));
+    auto_fit_add(&mut layout, 2, Some(0.5));
+    // Window 2 goes full (Mod+F): window 1 doesn't move.
+    Op::MaximizeColumn.apply(&mut layout);
+    assert_width(&layout, 2, 1.);
+    assert_width(&layout, 1, 0.5);
+    // Closing window 1 while 2 is full: 2 comes back to full anyway (alone).
+    Op::MaximizeColumn.apply(&mut layout);
+    assert_width(&layout, 2, 0.5);
+    assert_width(&layout, 1, 0.5);
+}
+
+#[test]
+fn auto_fit_new_window_ends_full_width_of_the_others() {
+    // The reported case: Zen made full with Mod+F, then a browser opens beside it.
+    let mut layout = auto_fit_layout();
+    auto_fit_add(&mut layout, 1, Some(2. / 3.)); // Zen, alone: full
+    Op::MaximizeColumn.apply(&mut layout); // Mod+F
+    auto_fit_settle(&mut layout);
+    auto_fit_add(&mut layout, 2, Some(2. / 3.)); // Brave
+    assert_width(&layout, 1, 0.5);
+    assert_width(&layout, 2, 0.5);
+    // And Zen is no longer full: Mod+F on it makes it full again (not back to ½).
+    Op::FocusColumnFirst.apply(&mut layout);
+    Op::MaximizeColumn.apply(&mut layout);
+    assert_width(&layout, 1, 1.);
+}
+
+#[test]
+fn auto_fit_fullscreen_window_keeps_fullscreen_and_its_width() {
+    let mut layout = auto_fit_layout();
+    auto_fit_add(&mut layout, 1, Some(0.5));
+    auto_fit_add(&mut layout, 2, Some(0.5));
+    auto_fit_settle(&mut layout);
+    Op::FullscreenWindow(1).apply(&mut layout);
+    auto_fit_settle(&mut layout);
+    // A third window: window 1 stays fullscreen, and comes back from it at the shared width.
+    auto_fit_add(&mut layout, 3, Some(0.5));
+    auto_fit_settle(&mut layout);
+    Op::FullscreenWindow(1).apply(&mut layout);
+    auto_fit_settle(&mut layout);
+    for id in 1..=3 {
+        assert_width(&layout, id, 0.5);
+    }
+}
+
+#[test]
+fn half_and_half_with_the_right_neighbour() {
+    let mut layout = auto_fit_layout();
+    auto_fit_add(&mut layout, 1, Some(2. / 3.)); // Zen
+    auto_fit_add(&mut layout, 2, Some(0.5));
+    auto_fit_add(&mut layout, 3, Some(0.5));
+    // Zen ⅔ + two halves scrolling. Focus Zen and split it with the one on its right.
+    Op::FocusColumnFirst.apply(&mut layout);
+    Op::HalfAndHalf.apply(&mut layout);
+    layout.verify_invariants();
+    assert_width(&layout, 1, 0.5);
+    assert_width(&layout, 2, 0.5);
+    auto_fit_settle(&mut layout);
+    // Both in view: the strip starts at the left edge.
+    let ws = layout.active_workspace().unwrap();
+    assert_eq!(ws.scrolling().target_view_pos(), -16.);
+    // Still auto-fit: closing window 3 leaves the pair at ½ + ½ on one screen.
+    Op::CloseWindow(3).apply(&mut layout);
+    assert_width(&layout, 1, 0.5);
+    assert_width(&layout, 2, 0.5);
+}
+
+#[test]
+fn half_and_half_at_the_end_takes_the_left_neighbour() {
+    let mut layout = auto_fit_layout();
+    auto_fit_add(&mut layout, 1, Some(2. / 3.));
+    auto_fit_add(&mut layout, 2, Some(0.5)); // ⅔ + ⅓, focused on the last one
+    Op::HalfAndHalf.apply(&mut layout);
+    layout.verify_invariants();
+    assert_width(&layout, 1, 0.5);
+    assert_width(&layout, 2, 0.5);
+    auto_fit_settle(&mut layout);
+    let ws = layout.active_workspace().unwrap();
+    assert_eq!(ws.scrolling().target_view_pos(), -16.);
+}
+
+#[test]
+fn half_and_half_ends_full_width_and_works_without_auto_fit() {
+    let mut layout = Layout::with_options(Clock::with_time(Duration::ZERO), Options::default());
+    Op::AddOutput(1).apply(&mut layout);
+    auto_fit_add(&mut layout, 1, Some(0.5));
+    auto_fit_add(&mut layout, 2, Some(2. / 3.));
+    Op::MaximizeColumn.apply(&mut layout);
+    Op::HalfAndHalf.apply(&mut layout);
+    layout.verify_invariants();
+    assert_width(&layout, 1, 0.5);
+    assert_width(&layout, 2, 0.5);
+    // Alone on a workspace: nothing to split, nothing happens.
+    let mut layout = auto_fit_layout();
+    auto_fit_add(&mut layout, 1, Some(0.5));
+    Op::HalfAndHalf.apply(&mut layout);
+    assert_width(&layout, 1, 1.);
+}
