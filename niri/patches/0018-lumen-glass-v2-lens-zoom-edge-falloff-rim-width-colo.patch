 const SHAPE_FLOATS: usize = 13;
+const SHAPE_FLOATS_EXT: usize = 16;
 pub const MAX_SHAPES: usize = 8;
 
 #[derive(Debug, Clone, Copy, PartialEq)]
@@ -33,6 +35,12 @@ pub struct GlassShape {
     pub dispersion: f32,
     pub bevel: f32,
     pub specular: f32,
+    /// How much the middle magnifies what is behind (0 none).
+    pub magnify: f32,
+    /// How the edge's bend falls off from the rim inward: the exponent of (1 - x).
+    pub falloff: f32,
+    /// How wide the rim light is, px.
+    pub rim_width: f32,
 }
 
 /// Double-buffered glass state of a surface.
@@ -186,7 +194,12 @@ where
             }
             lumen_glass_surface_v1::Request::SetShapes { shapes } => {
                 let floats = shapes.len() / 4;
-                if shapes.len() % 4 != 0 || floats % SHAPE_FLOATS != 0 {
+                let per = if floats % SHAPE_FLOATS_EXT == 0 && floats / SHAPE_FLOATS_EXT <= MAX_SHAPES {
+                    SHAPE_FLOATS_EXT
+                } else {
+                    SHAPE_FLOATS
+                };
+                if shapes.len() % 4 != 0 || floats % per != 0 {
                     glass.post_error(
                         lumen_glass_surface_v1::Error::InvalidShapes,
                         "the shapes array is not a whole number of shapes",
@@ -198,7 +211,7 @@ where
                     .map(|b| f32::from_ne_bytes([b[0], b[1], b[2], b[3]]))
                     .collect();
                 let parsed: Vec<GlassShape> = f
-                    .chunks_exact(SHAPE_FLOATS)
+                    .chunks_exact(per)
                     .take(MAX_SHAPES)
                     .filter(|v| v.iter().all(|x| x.is_finite()) && v[2] > 0. && v[3] > 0.)
                     .map(|v| GlassShape {
@@ -212,6 +225,9 @@ where
                         dispersion: v[10].clamp(0., 1.),
                         bevel: v[11].max(0.),
                         specular: v[12].clamp(0., 1.),
+                        magnify: v.get(13).copied().unwrap_or(0.).clamp(0., 0.9),
+                        falloff: v.get(14).copied().unwrap_or(2.).clamp(0.3, 6.),
+                        rim_width: v.get(15).copied().unwrap_or(1.2).clamp(0.25, 12.),
                     })
                     .collect();
                 with_pending(surface, |p| p.shapes = parsed);
