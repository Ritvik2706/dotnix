+++ b/src/protocols/lumen_glass.rs
@@ -14,10 +14,12 @@ use super::raw::lumen_glass::v1::server::{lumen_glass_manager_v1, lumen_glass_su
 use lumen_glass_manager_v1::LumenGlassManagerV1;
 use lumen_glass_surface_v1::LumenGlassSurfaceV1;
 
-const VERSION: u32 = 1;
+const VERSION: u32 = 2;
 
-/// Floats per shape in set_shapes.
+/// Floats per shape in set_shapes: 13, or 16 with lens zoom, edge falloff and
