From ae0f27872aa9ef6a400dd9fe5c0694fd76a0d9e0 Mon Sep 17 00:00:00 2001
From: Ritvik <ritvik2014@gmail.com>
Date: Wed, 28 Oct 2026 03:08:34 +0400
Subject: [PATCH 18/38] lumen-glass v2: lens zoom, edge falloff, rim width;
 coloured rim

Version 2 of the protocol takes 16 floats per shape (13 still accepted):
magnify (the whole shape zooms what is behind toward its centre, so a
pill acts as one lens, as on iOS), falloff (exponent of the edge's bend),
rim width. The rim light now brightens the backdrop's own colour instead
of going white. Clients send 16 only when bound at version 2.
---
 resources/lumen-glass-v1.xml                 | 12 +++++--
 src/protocols/lumen_glass.rs                 | 24 ++++++++++---
 src/render_helpers/liquid_glass.rs           |  8 +++--
 src/render_helpers/shaders/liquid_glass.frag | 38 +++++++++++++-------
 4 files changed, 59 insertions(+), 23 deletions(-)

diff --git a/resources/lumen-glass-v1.xml b/resources/lumen-glass-v1.xml
index dcd670ae..507de838 100644
--- a/resources/lumen-glass-v1.xml
+++ b/resources/lumen-glass-v1.xml
@@ -34,7 +34,7 @@
     Private to lumen and the patched niri.
   </description>
 
-  <interface name="lumen_glass_manager_v1" version="1">
+  <interface name="lumen_glass_manager_v1" version="2">
     <description summary="glass for surfaces">
     </description>
 
@@ -58,7 +58,7 @@
     </request>
   </interface>
 
-  <interface name="lumen_glass_surface_v1" version="1">
+  <interface name="lumen_glass_surface_v1" version="2">
     <description summary="the glass of one surface">
       All state is double-buffered: it applies on the surface's next
       wl_surface.commit, together with what the client drew for that frame.
@@ -78,7 +78,8 @@
 
     <request name="set_shapes">
       <description summary="the glass shapes">
-        Native-endian 32-bit floats, 13 per shape, at most 8 shapes; an empty
+        Native-endian 32-bit floats, 13 per shape (16 from version 2, all
+        shapes alike), at most 8 shapes; an empty
         array removes all glass. Per shape, in surface-local logical pixels
         unless noted:
 
@@ -92,6 +93,11 @@
           bevel: how far in from the edge the glass is curved; the middle
             is flat and shows the backdrop undisplaced
           specular: 0..1, the light along the rim
+        and, with 16 per shape (version 2):
+          magnify: 0..0.9, how much the whole shape magnifies what is behind
+            toward its centre (default 0)
+          falloff: the exponent of the edge's bend fading inward (default 2)
+          rim width: how wide the rim light is, px (default 1.2)
       </description>
       <arg name="shapes" type="array"/>
     </request>
diff --git a/src/protocols/lumen_glass.rs b/src/protocols/lumen_glass.rs
