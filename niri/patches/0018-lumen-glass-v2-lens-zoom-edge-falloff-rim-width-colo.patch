@@ -148,14 +149,13 @@ float edge_slope(float u, float bevel, float thickness) {
 // How far (px, inward) the backdrop shifts at `u` px in from the edge. A ray
 // through glass of index `ior` this thick shifts about thickness * (ior - 1)
 // at the rim, capped at LENS_CAP x bevel. The shift falls off as
-// (1 - x)^LENS_POWER across the bevel. It is taken OUTWARD (see main): the
+// (1 - x)^falloff across the bevel (per shape). It is taken OUTWARD (see main): the
 // rim shows what lies just outside the glass, pulled in and squeezed, so lines
 // crossing the edge bend toward the inside of the shape, as on Apple's glass;
 // outward sampling only compresses, so it never folds into mirror images.
-#define LENS_POWER 2.0
 #define LENS_CAP 1.0
 #define LENS_TRACED 0
-float displacement(float u, float bevel, float thickness, float ior) {
+float displacement(float u, float bevel, float thickness, float ior, float power) {
     float x = clamp(u / bevel, 0.0, 1.0);
 #if LENS_TRACED
     // The physical trace: a ray straight down through the squircle surface
@@ -168,7 +168,7 @@ float displacement(float u, float bevel, float thickness, float ior) {
     return profile(max(x, 1e-3)) * thickness * tan(t1 - t2);
 #else
     float peak = min(thickness * (ior - 1.0), LENS_CAP * bevel);
-    return peak * pow(1.0 - x, LENS_POWER);
+    return peak * pow(1.0 - x, power);
 #endif
 }
 
@@ -201,6 +201,9 @@ void main() {
     float bevel = min(s[2].w, min(s[0].z, s[0].w) * 0.5);
