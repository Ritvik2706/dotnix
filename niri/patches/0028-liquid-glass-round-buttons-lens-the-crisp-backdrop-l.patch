+    /// Layer 2 as the client says it: glass on glass (layer 1) that bends the
+    /// crisp backdrop under the panel, not the panel's frosted glass — iOS
+    /// buttons, a clear lens with what is really behind stretched round its rim.
+    pub sharp: bool,
     pub refraction: f32,
     pub dispersion: f32,
     pub bevel: f32,
@@ -44,6 +50,9 @@ pub struct GlassShape {
     pub tint: f32,
