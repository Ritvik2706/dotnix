From dd307f2cc8f6e5c3068263a26c3342c019d9c930 Mon Sep 17 00:00:00 2001
From: Ritvik <ritvik2014@gmail.com>
Date: Wed, 28 Oct 2026 18:33:50 +0400
Subject: [PATCH 28/38] liquid glass: round buttons lens the crisp backdrop
 (layer 2), no meniscus frame on cards, lumen-glass v5 per-shape opacity

---
 resources/lumen-glass-v1.xml                 | 13 ++--
 src/protocols/lumen_glass.rs                 | 21 ++++++-
 src/render_helpers/framebuffer_effect.rs     | 65 +++++++++++++++++---
 src/render_helpers/liquid_glass.rs           | 32 +++++++---
 src/render_helpers/shaders/liquid_glass.frag | 29 +++++++--
 src/render_helpers/shaders/mod.rs            |  3 +
 6 files changed, 136 insertions(+), 27 deletions(-)

diff --git a/resources/lumen-glass-v1.xml b/resources/lumen-glass-v1.xml
index 2cb7f444..163ab80a 100644
--- a/resources/lumen-glass-v1.xml
+++ b/resources/lumen-glass-v1.xml
@@ -34,7 +34,7 @@
     Private to lumen and the patched niri.
   </description>
 
-  <interface name="lumen_glass_manager_v1" version="4">
+  <interface name="lumen_glass_manager_v1" version="5">
     <description summary="glass for surfaces">
     </description>
 
@@ -58,7 +58,7 @@
     </request>
   </interface>
 
-  <interface name="lumen_glass_surface_v1" version="4">
+  <interface name="lumen_glass_surface_v1" version="5">
     <description summary="the glass of one surface">
       All state is double-buffered: it applies on the surface's next
       wl_surface.commit, together with what the client drew for that frame.
@@ -78,8 +78,8 @@
 
     <request name="set_shapes">
       <description summary="the glass shapes">
-        Native-endian 32-bit floats, 13 per shape (16 from version 2, all
-        shapes alike), at most 8 shapes (48 from version 4); an empty
+        Native-endian 32-bit floats, 13 per shape (16 from version 2, 17
+        from version 5, all shapes alike), at most 8 shapes (48 from version 4); an empty
         array removes all glass. Per shape, in surface-local logical pixels
         unless noted:
 
@@ -88,7 +88,8 @@
           corner: 0 circular arcs, 1 continuous (squircle, lumen's
             `continuous` corners); from version 4, plus 2 x layer: 0 glass
             on what is behind the surface, 1 glass on top of that glass
-            (a control on a panel), which refracts it
+            (a control on a panel), which refracts it; 2 the same, but it
+            bends the crisp backdrop under the panel instead (a button)
           refraction: how far the backdrop is displaced at the very rim,
             fading to 0 where the edge's curve ends
           dispersion: 0..1, how much the colours separate at the rim
@@ -99,6 +100,8 @@
           magnify: 0..0.9, the whole shape as a gentle vertical lens (default 0)
           tint: 0..1, flat tint mixed into the glass (default 0.23)
           rim tint: 0..1, the rim white (0) or a brighter shade of the glass (1)
+        and, with 17 per shape (version 5):
+          opacity: 0..1, how much of the glass is drawn (default 1)
       </description>
       <arg name="shapes" type="array"/>
     </request>
