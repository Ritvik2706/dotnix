@@ -214,7 +223,13 @@ where
             lumen_glass_surface_v1::Request::SetShapes { shapes } => {
                 let floats = shapes.len() / 4;
                 // Version 2 clients send 16 per shape, older ones 13.
-                let per = if glass.version() >= 2 { SHAPE_FLOATS_EXT } else { SHAPE_FLOATS };
+                let per = if glass.version() >= 5 {
+                    SHAPE_FLOATS_V5
+                } else if glass.version() >= 2 {
+                    SHAPE_FLOATS_EXT
+                } else {
+                    SHAPE_FLOATS
+                };
                 if shapes.len() % 4 != 0 || floats % per != 0 {
                     glass.post_error(
                         lumen_glass_surface_v1::Error::InvalidShapes,
@@ -239,6 +254,7 @@ where
                         // corner: continuous (0/1) + 2 x layer.
                         continuous: v[8].rem_euclid(2.) >= 0.5,
                         layer: ((v[8] / 2.).floor() as i32).clamp(0, 1) as u8,
+                        sharp: (v[8] / 2.).floor() as i32 >= 2,
                         refraction: v[9].clamp(-200., 200.),
                         dispersion: v[10].clamp(0., 1.),
                         bevel: v[11].max(0.),
@@ -246,6 +262,7 @@ where
                         magnify: v.get(13).copied().unwrap_or(0.).clamp(0., 0.9),
                         tint: v.get(14).copied().unwrap_or(0.23).clamp(0., 1.),
                         rim_tint: v.get(15).copied().unwrap_or(0.).clamp(0., 1.),
+                        alpha: v.get(16).copied().unwrap_or(1.).clamp(0., 1.),
                     })
                     .collect();
                 with_pending(surface, |p| p.shapes = parsed);
