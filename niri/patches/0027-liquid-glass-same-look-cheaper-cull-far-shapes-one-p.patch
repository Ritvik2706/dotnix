+    /// Ask for the light/dark reading without waiting: the pixels go into a
+    /// pixel buffer behind a fence, collected by `measure_collect`.
+    fn measure_start(
+        frame: &mut GlesFrame<'_, '_>,
+        tex: &GlesTexture,
+        points: &[(i32, i32)],
+    ) -> Result<Option<Readback>, GlesError> {
+        frame.with_context(|gl| unsafe {
+            if !gl.FenceSync.is_loaded() || !gl.MapBufferRange.is_loaded() || points.is_empty() {
+                return None;
+            }
+            let mut prev = 0i32;
+            gl.GetIntegerv(ffi::READ_FRAMEBUFFER_BINDING, &mut prev as *mut _);
+            let mut fbo = 0;
+            gl.GenFramebuffers(1, &mut fbo as *mut _);
+            gl.BindFramebuffer(ffi::READ_FRAMEBUFFER, fbo);
+            gl.FramebufferTexture2D(ffi::READ_FRAMEBUFFER, ffi::COLOR_ATTACHMENT0, ffi::TEXTURE_2D, tex.tex_id(), 0);
+            let mut pbo = 0;
+            gl.GenBuffers(1, &mut pbo as *mut _);
+            gl.BindBuffer(ffi::PIXEL_PACK_BUFFER, pbo);
+            gl.BufferData(ffi::PIXEL_PACK_BUFFER, (points.len() * 4) as isize, std::ptr::null(), ffi::STREAM_READ);
+            for (i, (x, y)) in points.iter().enumerate() {
+                gl.ReadPixels(*x, *y, 1, 1, ffi::RGBA, ffi::UNSIGNED_BYTE, (i * 4) as *mut _);
+            }
+            gl.BindBuffer(ffi::PIXEL_PACK_BUFFER, 0);
+            gl.BindFramebuffer(ffi::READ_FRAMEBUFFER, prev as u32);
+            gl.DeleteFramebuffers(1, &mut fbo as *mut _);
+            let fence = gl.FenceSync(ffi::SYNC_GPU_COMMANDS_COMPLETE, 0);
+            Some(Readback { pbo, fence: fence as usize, points: points.len() })
+        })
+    }
+
+    /// The reading asked for by `measure_start`, if the GPU is done with it
+    /// (`Ok(None)`: not yet; ask again next frame).
+    fn measure_collect(
+        frame: &mut GlesFrame<'_, '_>,
+        r: &Readback,
+    ) -> Result<Option<Vec<f32>>, GlesError> {
+        frame.with_context(|gl| unsafe {
+            let fence = r.fence as ffi::types::GLsync;
+            let status = gl.ClientWaitSync(fence, 0, 0);
+            if status != ffi::ALREADY_SIGNALED && status != ffi::CONDITION_SATISFIED {
+                return None;
+            }
+            gl.DeleteSync(fence);
+            gl.BindBuffer(ffi::PIXEL_PACK_BUFFER, r.pbo);
+            let len = r.points * 4;
+            let ptr = gl.MapBufferRange(ffi::PIXEL_PACK_BUFFER, 0, len as isize, ffi::MAP_READ_BIT);
+            let px = (!ptr.is_null())
+                .then(|| std::slice::from_raw_parts(ptr as *const u8, len).to_vec());
+            if !ptr.is_null() {
+                gl.UnmapBuffer(ffi::PIXEL_PACK_BUFFER);
+            }
+            gl.BindBuffer(ffi::PIXEL_PACK_BUFFER, 0);
+            let mut pbo = r.pbo;
+            gl.DeleteBuffers(1, &mut pbo as *mut _);
+            Some(px.map(|px| shape_lums(&px)).unwrap_or_default())
+        })
     }
 
