+/// Five RGBA pixels per shape -> its brightness (the centre counts twice).
+fn shape_lums(px: &[u8]) -> Vec<f32> {
+    let lum = |p: &[u8]| {
+        let a = (p[3] as f32 / 255.).max(1e-3);
+        let l = (0.2126 * p[0] as f32 + 0.7152 * p[1] as f32 + 0.0722 * p[2] as f32) / 255. / a;
+        l.clamp(0., 1.)
+    };
+    px.chunks_exact(20)
+        .map(|c| {
+            let l: Vec<f32> = c.chunks_exact(4).map(lum).collect();
+            (l[0] * 2. + l[1] + l[2] + l[3] + l[4]) / 6.
+        })
+        .collect()
+}
