+// glass_sdf at four points at once (the edge's direction needs p +/- h on
+// each axis): one pass over the shapes instead of four, each shape fetched
+// once; per point the same sums as glass_sdf, so the same result.
+vec4 glass_sdf4(vec2 p0, vec2 p1, vec2 p2, vec2 p3) {
+    vec4 d = vec4(1e6);
+    vec4 best = vec4(1e6);
+    for (int i = 0; i < 32; i++) {
+        if (float(i) >= glass_count)
+            break;
+        mat4 s = glass_shapes[i];
+        vec2 c = s[0].xy + s[0].zw * 0.5;
+        vec2 hs = s[0].zw * 0.5;
+        vec4 box = vec4(length(max(abs(p0 - c) - hs, 0.0)), length(max(abs(p1 - c) - hs, 0.0)),
+                        length(max(abs(p2 - c) - hs, 0.0)), length(max(abs(p3 - c) - hs, 0.0)));
+        // Skipped only if it changes none of the four (see glass_sdf); where
+        // it changes some, applying it to the rest changes nothing there.
+        if (all(greaterThan(box, vec4(0.0))) &&
+            all(greaterThanEqual(0.9 * box, max(d + glass_merge, best))))
+            continue;
+        vec4 di = vec4(shape_sdf(p0, s), shape_sdf(p1, s), shape_sdf(p2, s), shape_sdf(p3, s));
+        best = min(best, di);
+        if (glass_merge > 0.0) {
+            vec4 h = max(glass_merge - abs(d - di), 0.0) / glass_merge;
+            d = min(d, di) - h * h * glass_merge * 0.25;
+        } else {
+            d = min(d, di);
+        }
+    }
+    return d;
+}
