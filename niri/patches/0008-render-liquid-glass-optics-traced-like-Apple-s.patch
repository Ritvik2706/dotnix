diff --git a/src/render_helpers/shaders/liquid_glass.frag b/src/render_helpers/shaders/liquid_glass.frag
index a5b46ddc..1f19973c 100644
--- a/src/render_helpers/shaders/liquid_glass.frag
+++ b/src/render_helpers/shaders/liquid_glass.frag
@@ -8,9 +8,21 @@
 
 // Liquid glass (lumen-glass-v1): what is behind a set of glass shapes, seen
 // through them. `tex` is the backdrop under the shapes' bounding box, as
-// composed this frame (frosted or not); each shape bends it toward its curved
-// rim like a convex glass edge, splits it into colour there, and catches light
-// along the rim. Shapes within `glass_merge` of each other melt together.
+// composed this frame (frosted or not). Shapes within `glass_merge` of each
+// other melt together.
+//
+// The optics follow the physically traced model the best recreations of
+// Apple's Liquid Glass use (kube.io's "Liquid Glass in CSS and SVG"): each
+// shape is a slab of glass (IOR 1.5) whose edge, across `bevel` px, rises
+// from 0 to the full `thickness` along a convex squircle, y = (1-(1-x)^4)^1/4.
+// A ray straight down through the surface refracts by Snell's law and lands
+// h * tan(θ1 - θ2) away from where it would without glass. That displacement
+// is 0 at the very edge, peaks within a pixel or two of it and falls to 0
+// where the glass turns flat: the middle shows the backdrop undistorted and
+// the rim squeezes (and, nearest the edge, mirrors) what is just inside it —
+// the lensed band that makes it read as glass. Dispersion is a different IOR
+// per channel; the light is a rim glint from a top-left key with a weaker
+// internal reflection opposite, plus a Fresnel edge glow.
 
 precision highp float;
 #if defined(EXTERNAL)
@@ -19,6 +31,9 @@ uniform samplerExternalOES tex;
 uniform sampler2D tex;
 #endif
 
+// The same backdrop unblurred: the rim lenses it crisply over a frosted middle.
+uniform sampler2D tex_sharp;
+
 uniform float alpha;
 varying vec2 v_coords;
 
@@ -115,6 +130,31 @@ float hash12(vec2 p) {
     return fract((p3.x + p3.y) * p3.z);
 }
 
+// The squircle edge profile: height (0..1) at x (0 edge .. 1 flat).
+float profile(float x) {
+    float k = 1.0 - clamp(x, 0.0, 1.0);
+    return pow(max(1.0 - k * k * k * k, 0.0), 0.25);
+}
+
+// How far (px, inward) the backdrop shifts at `u` px in from the edge, for a
+// bevel `bevel` px wide and `thickness` px tall, at refractive index `ior`.
+// Also the surface slope there (for the light).
+float displacement(float u, float bevel, float thickness, float ior, out float slope) {
+    float x = clamp(u / bevel, 1e-3, 1.0);
+    float dx = 1e-3;
+    float dy = profile(min(x + dx, 1.0)) - profile(max(x - dx, 0.0));
+    slope = dy / (2.0 * dx) * thickness / bevel;
+    float t1 = atan(slope);
+    float t2 = asin(sin(t1) / ior);
+    return profile(x) * thickness * tan(t1 - t2);
+}
+
+// The backdrop at c: frosted, or crisp by `clear` (0..1).
+vec4 backdrop(vec2 c, float clear) {
+    vec4 frosted = texture2D(tex, c);
+    return clear > 0.0 ? mix(frosted, texture2D(tex_sharp, c), clear) : frosted;
+}
+
 void main() {
     vec2 p = (input_to_geo * vec3(v_coords, 1.0)).xy * geo_size;
 
@@ -128,11 +168,11 @@ void main() {
     }
 
     mat4 s = shape_at(idx);
-    float refraction = s[2].y;
+    float thickness = max(s[2].y, 0.0);   // `refraction`: how tall the glass is
     float dispersion = s[2].z;
     float bevel = min(s[2].w, min(s[0].z, s[0].w) * 0.5);
-    float frost = clamp(s[3].y, 0.0, 1.0);
     float specular = s[3].x;
+    float frost = clamp(s[3].y, 0.0, 1.0);
 
     // Outward normal of the (merged) outline.
     float ignore;
@@ -141,69 +181,70 @@ void main() {
                      glass_sdf(p + vec2(0.0, h), ignore) - glass_sdf(p - vec2(0.0, h), ignore));
     vec2 n = length(grad) > 1e-5 ? normalize(grad) : vec2(0.0);
 
-    // Bounded slope through the bevel: the former circular profile had an
-    // infinite rim derivative and folded the sampled background over itself.
-    float depth = -d;
-    float t = bevel > 0.0 ? clamp(1.0 - depth / bevel, 0.0, 1.0) : 0.0;
-    float bend = t * t * (3.0 - 2.0 * t);
-
-    // A shallow lens spans the whole body, rather than a flat pane with
-    // only a refracting border. Its smooth radial mapping avoids the SDF
-    // normal discontinuities along the medial axes of a rounded rectangle.
-    // The exact optical centre stays fixed, but its neighbourhood magnifies.
-    vec2 half_size = max(s[0].zw * 0.5, vec2(1.0));
-    vec2 centre = s[0].xy + half_size;
-    vec2 local = p - centre;
-    vec2 unit = local / half_size;
-    float radius2 = clamp(dot(unit, unit) * 0.5, 0.0, 1.0);
-    float lens_strength = clamp(refraction / max(40.0, min(half_size.x, half_size.y) * 0.4), 0.0, 1.0);
-    float magnification = lens_strength * (0.08 + 0.02 * radius2);
-    vec2 body_off = -local * magnification;
-    // The extra rim displacement has derivative at most 0.3 along a flat
-    // edge (smoothstep peaks at 1.5). Keep the body mapping continuous rather
-    // than replacing it at the rim, which created a second visible band.
-    float edge_strength = min(max(refraction, 0.0), bevel * 0.2);
-    vec2 edge_off = -n * edge_strength * bend;
-    vec2 off = body_off + edge_off;
     // From logical px to texture coordinates (inverse of input_to_geo's linear part).
     mat2 a = mat2(input_to_geo[0].xy, input_to_geo[1].xy);
     float det = a[0][0] * a[1][1] - a[1][0] * a[0][1];
     mat2 inv = mat2(a[1][1], -a[0][1], -a[1][0], a[0][0]) / det;
-    vec2 dv = inv * (off / geo_size);
-    // Dispersion belongs to the curved rim, not the broad magnified body.
-    vec2 fringe = inv * (edge_off / geo_size) * dispersion;
 
+    float u = -d;   // px in from the edge
+    float slope = 0.0;
     vec4 color;
-    if (dispersion > 0.0) {
-        vec4 g = texture2D(tex, v_coords + dv);
-        color = vec4(texture2D(tex, v_coords + dv + fringe).r, g.g,
-                     texture2D(tex, v_coords + dv - fringe).b, g.a);
+    if (bevel > 0.5 && thickness > 0.0 && u < bevel) {
+        // Convex: rays converge, so each pixel shows what lies further in.
+        float dg = displacement(u, bevel, thickness, 1.5, slope);
+        vec2 dir = inv * (-n / geo_size);
+        // The rim is crisp, easing into the frost of the middle.
+        float e = clamp(1.0 - u / bevel, 0.0, 1.0);
+        float clear = e * e * (3.0 - 2.0 * e);
+        vec4 g = backdrop(v_coords + dir * dg, clear);
+        if (dispersion > 0.0) {
+            // Red bends less, blue more: a prism's spread of the index.
+            float spread = 0.05 * dispersion;
+            float ignore_slope;
+            float dr = displacement(u, bevel, thickness, 1.5 - spread, ignore_slope);
+            float db = displacement(u, bevel, thickness, 1.5 + spread, ignore_slope);
+            color = vec4(backdrop(v_coords + dir * dr, clear).r, g.g,
+                         backdrop(v_coords + dir * db, clear).b, g.a);
+        } else {
+            color = g;
+        }
     } else {
-        color = texture2D(tex, v_coords + dv);
+        color = texture2D(tex, v_coords);
     }
 #if defined(NO_ALPHA)
     color.a = 1.0;
 #endif
 
-    // Lumen's light foreground needs separation from bright backgrounds.
-    // Compress background brightness proportionally to its local luminance;
-    // preserve hue and leave dark areas quieter instead of adding a white veil.
+    // Lumen's light foreground needs separation from bright backgrounds:
+    // compress brightness where it is high, keep hue, add no white veil.
     float luminance = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722)) / max(color.a, 0.001);
     float contrast = frost * smoothstep(0.08, 0.8, luminance);
     color.rgb *= 1.0 - 0.55 * contrast;
 
-    if (saturation != 1.0)
-        color.rgb = saturate(color.rgb, saturation);
+    // Vibrancy: glass carries the colour behind it a little richer.
+    float sat = saturation * 1.18;
+    if (sat != 1.0)
+        color.rgb = saturate(color.rgb, sat);
     if (noise > 0.0)
         color.rgb += (hash12(gl_FragCoord.xy) - 0.5) * noise;
 
-    // Light: a bright line right at the rim, strongest facing the key light
-    // (top-left), a fainter one opposite, and a soft sheen across the bevel.
-    vec2 key = vec2(-0.5547, -0.8321);
-    float facing = max(dot(n, key), 0.0);
-    float back = max(dot(n, -key), 0.0);
-    float rim = 1.0 - smoothstep(0.0, 1.0, depth);
-    float lit = specular * (rim * (0.2 + 0.5 * facing + 0.2 * back) + 0.06 * bend * bend * facing);
+    // Light. The surface normal in 3D: tilted outward by the edge's slope.
+    vec3 normal = normalize(vec3(n * slope, 1.0));
+    vec3 view = vec3(0.0, 0.0, 1.0);
+    vec3 key = normalize(vec3(-0.45, -0.7, 0.55));   // top-left, in front
+    vec3 bounce = normalize(vec3(0.45, 0.7, 0.55));  // the internal reflection opposite
+    // Broad lobes: on a steep rim the normal is nearly flat, so a tight one
+    // would never catch the light where the edge is.
+    float glint = pow(max(dot(normal, normalize(key + 0.35 * view)), 0.0), 3.0);
+    float inner = pow(max(dot(normal, normalize(bounce + 0.35 * view)), 0.0), 3.0);
+    // Fresnel: grazing surfaces (the steep rim) reflect more.
+    float fresnel = pow(1.0 - normal.z, 2.0);
+    // A hairline right at the silhouette, so the outline reads even flat-on.
+    float hairline = 1.0 - smoothstep(0.0, 1.2, u);
+    // The glints live on the curved band (where the surface tilts), brightest
+    // where it faces the light; the hairline keeps the whole outline drawn.
+    float tilt = smoothstep(0.0, 0.35, fresnel);
+    float lit = specular * ((0.9 * glint + 0.45 * inner) * tilt + 0.45 * hairline);
     color.rgb = mix(color.rgb, vec3(color.a), clamp(lit, 0.0, 1.0));
 
     color *= cover * alpha;
diff --git a/src/render_helpers/shaders/mod.rs b/src/render_helpers/shaders/mod.rs
index f45332f7..dea3ac1b 100644
--- a/src/render_helpers/shaders/mod.rs
+++ b/src/render_helpers/shaders/mod.rs
@@ -146,6 +146,7 @@ impl Shaders {
                     UniformName::new("glass_merge", UniformType::_1f),
                     UniformName::new("saturation", UniformType::_1f),
                     UniformName::new("noise", UniformType::_1f),
+                    UniformName::new("tex_sharp", UniformType::_1i),
                 ],
             )
             .map_err(|err| {
