Subject: [PATCH 32/38] screenshots: no "Screenshot captured" notification

lumen's island already shows the shot on the clipboard.
---
 src/niri.rs      | 6 ++----
 src/utils/mod.rs | 1 +
 2 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/src/niri.rs b/src/niri.rs
index fb8e5bfd..deaa7c1f 100644
--- a/src/niri.rs
+++ b/src/niri.rs
@@ -5762,10 +5762,8 @@ impl Niri {
                 debug!("not saving screenshot to disk");
             }
 
-            #[cfg(feature = "dbus")]
-            if let Err(err) = crate::utils::show_screenshot_notification(image_path.as_deref()) {
-                warn!("error showing screenshot notification: {err:?}");
-            }
+            // No "Screenshot captured" notification: lumen's island already
+            // shows the shot on the clipboard.
 
             // Send screenshot completion event.
             let path_string = image_path
