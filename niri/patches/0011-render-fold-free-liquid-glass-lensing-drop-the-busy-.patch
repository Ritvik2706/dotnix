 // Apple's Liquid Glass use (kube.io's "Liquid Glass in CSS and SVG"): each
 // shape is a slab of glass (IOR 1.5) whose edge, across `bevel` px, rises
 // from 0 to the full `thickness` along a convex squircle, y = (1-(1-x)^4)^1/4.
-// A ray straight down through the surface refracts by Snell's law and lands
-// h * tan(θ1 - θ2) away from where it would without glass. That displacement
-// is 0 at the very edge, peaks within a pixel or two of it and falls to 0
-// where the glass turns flat: the middle shows the backdrop undistorted and
-// the rim squeezes (and, nearest the edge, mirrors) what is just inside it —
-// the lensed band that makes it read as glass. Dispersion is a different IOR
-// per channel; the light is a rim glint from a top-left key with a weaker
-// internal reflection opposite, plus a Fresnel edge glow.
+// The strict Snell trace folds the backdrop into a mirror image near the rim,
+// which over sharp content or on small shapes is a mess of jagged copies, so
+// the shift is a fold-free squeeze instead: strongest at the rim (about
+// thickness * (ior - 1), capped at FOLD_CAP x bevel), falling off as (1-x)^2
+// to nothing where the glass turns flat. The middle shows the backdrop
+// undistorted; the rim squeezes what is just inside it — the lensed band.
+// Dispersion spreads that shift per channel; the light uses the true squircle
+// slope: a top-left glint, a weaker internal reflection opposite, a hairline.
 
 precision highp float;
 #if defined(EXTERNAL)
@@ -136,17 +136,26 @@ float profile(float x) {
     return pow(max(1.0 - k * k * k * k, 0.0), 0.25);
 }
 
-// How far (px, inward) the backdrop shifts at `u` px in from the edge, for a
-// bevel `bevel` px wide and `thickness` px tall, at refractive index `ior`.
-// Also the surface slope there (for the light).
-float displacement(float u, float bevel, float thickness, float ior, out float slope) {
+// The edge's slope at `u` px in from the edge, for a bevel `bevel` px wide and
+// `thickness` px tall: the true squircle surface, which the light uses.
+float edge_slope(float u, float bevel, float thickness) {
     float x = clamp(u / bevel, 1e-3, 1.0);
     float dx = 1e-3;
     float dy = profile(min(x + dx, 1.0)) - profile(max(x - dx, 0.0));
-    slope = dy / (2.0 * dx) * thickness / bevel;
-    float t1 = atan(slope);
-    float t2 = asin(sin(t1) / ior);
-    return profile(x) * thickness * tan(t1 - t2);
+    return dy / (2.0 * dx) * thickness / bevel;
+}
+
+// How far (px, inward) the backdrop shifts at `u` px in from the edge. A ray
+// through glass of index `ior` this thick shifts at most about thickness *
+// (ior - 1) at the rim; the shift falls off as (1 - x)^2 across the bevel.
+// Capped at FOLD_CAP x bevel, so the backdrop is squeezed toward the rim but
+// never folds back into a mirror image (the strict Snell trace does, and on a
+// small shape or over a sharp edge that mirroring is a mess of jagged copies).
+#define FOLD_CAP 0.45
+float displacement(float u, float bevel, float thickness, float ior) {
+    float x = clamp(u / bevel, 0.0, 1.0);
+    float peak = min(thickness * (ior - 1.0), FOLD_CAP * bevel);
+    return peak * (1.0 - x) * (1.0 - x);
 }
 
 // The backdrop at c: frosted, or crisp by `clear` (0..1).
