From 5e42a2a5836ef451fbb0273fd836a860c06dee07 Mon Sep 17 00:00:00 2001
From: Ritvik <ritvik2014@gmail.com>
Date: Wed, 28 Oct 2026 18:40:31 +0400
Subject: [PATCH 29/38] liquid glass: pills and fields lens the crisp backdrop
 only along their edge, frosted where their words are

---
 src/render_helpers/shaders/liquid_glass.frag | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/render_helpers/shaders/liquid_glass.frag b/src/render_helpers/shaders/liquid_glass.frag
index 0a65be83..6a221894 100644
--- a/src/render_helpers/shaders/liquid_glass.frag
+++ b/src/render_helpers/shaders/liquid_glass.frag
@@ -226,11 +226,17 @@ float displacement(float u, float bevel, float thickness, float ior, float power
 uniform vec4 sharp_map;
 uniform float sharp_under;
 float shape_sharp = 0.0;
+// How much of the crisp backdrop shows here (0..1): all of it on a round
+// button; on a pill or a field only along its curved edge, easing into the
+// panel's frosted glass in the middle, where its words are.
+float sharp_k = 1.0;
 
 vec4 backdrop(vec2 c, float clear) {
     c = clamp(c, vec2(0.0005), vec2(0.9995));
-    if (sharp_under > 0.5 && shape_sharp > 0.5)
-        return texture2D(tex_sharp, clamp(c * sharp_map.xy + sharp_map.zw, vec2(0.0005), vec2(0.9995)));
+    if (sharp_under > 0.5 && shape_sharp > 0.5) {
+        vec4 crisp = texture2D(tex_sharp, clamp(c * sharp_map.xy + sharp_map.zw, vec2(0.0005), vec2(0.9995)));
+        return sharp_k >= 1.0 ? crisp : mix(texture2D(tex, c), crisp, sharp_k);
+    }
     vec4 frosted = texture2D(tex, c);
     return clear > 0.0 ? mix(frosted, texture2D(tex_sharp, c), clear) : frosted;
 }
@@ -308,6 +314,9 @@ void main() {
     }
 
 
+    if (shape_sharp > 0.5 && abs(s[0].z - s[0].w) > 1.0)
+        sharp_k = 1.0 - smoothstep(0.5 * bz, 1.3 * bz, t);
+
     // The bezel -> surface normal.
     float u = clamp(t / bz, 0.0, 1.0);
     float om = 1.0 - u;
