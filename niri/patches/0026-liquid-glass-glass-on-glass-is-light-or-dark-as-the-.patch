+/// A shape as the shader reads it, in the capture's coordinates (from x0, y0),
+/// drawn `light` light (0 dark .. 1 light).
+fn packed(s: &GlassShape, x0: f32, y0: f32, v: f32, layer: u8, frost: f32) -> [f32; 16] {
+    [
+        s.x - x0,
+        s.y - y0,
+        s.w,
+        s.h,
+        s.radii[0],
+        s.radii[1],
+        s.radii[2],
+        s.radii[3],
+        // corner (0/1) + 2 x (rim tint % + 128 x (light % + 128 x flat)),
+        // see the shader; layer 1 (controls on a panel) is flat.
+        (if s.continuous { 1. } else { 0. })
+            + 2. * ((s.rim_tint * 100.).round()
+                + 128. * ((v * 100.).round() + 128. * if layer >= 1 { 1. } else { 0. })),
+        s.refraction,
+        s.dispersion,
+        s.bevel,
+        s.specular,
+        frost,
+        s.magnify,
+        s.tint,
+    ]
+}
+
+/// The layer 0 glass a control (layer 1) sits on: the smallest one holding its
+/// centre, else the nearest.
+fn under(shapes: &[GlassShape], s: &GlassShape) -> Option<usize> {
+    let (cx, cy) = (s.x + s.w / 2., s.y + s.h / 2.);
+    let base = || shapes.iter().enumerate().filter(|(_, o)| o.layer == 0);
+    base()
+        .filter(|(_, o)| cx >= o.x && cx <= o.x + o.w && cy >= o.y && cy <= o.y + o.h)
+        .min_by(|(_, a), (_, b)| (a.w * a.h).total_cmp(&(b.w * b.h)))
+        .or_else(|| {
+            base().min_by(|(_, a), (_, b)| {
+                let d =
+                    |o: &GlassShape| (o.x + o.w / 2. - cx).powi(2) + (o.y + o.h / 2. - cy).powi(2);
+                d(a).total_cmp(&d(b))
+            })
+        })
+        .map(|(i, _)| i)
+}
