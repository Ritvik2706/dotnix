// Capture: a screenshot or a recording, of a region, the window you were in,
// or the whole screen. The card goes before anything is taken. A recording
// shows as a coral capsule beside the island, which stops it.
part Capture {
    component Target(which: number, title: text) {
        size: 112, 44
        zone box t { from: 0, 0; size: 112, 44; corner: 22 continuous; cursor: pointer; label: "{title}" }
        prop lift = 0 ~160ms
        follow lift = t.hover - t.pressed
        body {
            color: mix(chip, chip_hi, max(lift, 0)); glass: 25%; blur: 0%
            light: 4%, 0, 22; shadow: 0, 1.8 + 0.5 * lift, 7 + 2 * lift, 21%
            box { from: 0, 0; size: 112, 44; corner: 22 continuous }
        }
        //  Its symbol: a dashed frame, a window, a screen.
        group {
            show: which == 0
            box { from: 17, 15; size: 18, 14; corner: 3 continuous; stroke: 1.6; color: ink; opacity: 85% }
            box { from: 22, 13; size: 8, 18; color: chip; opacity: if(lift > 0, 0, 100%) }
            box { from: 22, 13; size: 8, 18; color: chip_hi; opacity: if(lift > 0, 100%, 0) }
            box { from: 15, 19.5; size: 22, 5; color: chip; opacity: if(lift > 0, 0, 100%) }
            box { from: 15, 19.5; size: 22, 5; color: chip_hi; opacity: if(lift > 0, 100%, 0) }
        }
        image ic_windows { at: 19, 15; size: 14, 14; tint: ink; opacity: 85%; show: which == 1 }
        group {
            show: which == 2
            box { from: 17, 14; size: 18, 13; corner: 3 continuous; stroke: 1.6; color: ink; opacity: 85% }
            box { from: 21, 29.5; size: 10, 1.6; corner: 0.8 continuous; color: ink; opacity: 85% }
        }
        text title { at: 44, 22; anchor: left center; size: 12.5; weight: 600; family: "SF Pro Display"; color: ink }
        on press t { emit cap_take(which) }
    }

    group {
        opacity: smooth(0.4, 1, on_cap)
        move: 28 * (1 - on_cap), 0

        group {
            move: ex0 + 16, 44
            zone ellipse capb { at: 16, 18; radius: 16; cursor: pointer; label: "Back" }
            body {
                color: mix(chip, chip_hi, capb.hover); glass: 25%; blur: 0%; light: 4%, 2, 16; shadow: 0, 1.2 + 0.5 * capb.hover - capb.pressed, 4.2, 21%
                ellipse { at: 16, 18; radius: 16 - 0.6 * capb.pressed }
            }
            path { at: 16, 18; stroke: 1.8; color: ink; opacity: 70% + 30% * capb.hover; move 2, -5.5; line -3, 0; line 2, 5.5 }
            text pick(cap_rec, "Screenshot", "Screen recording") { at: 42, 18; anchor: left center; size: 15; weight: 600; family: "SF Pro Display"; color: ink }
        }

        //  Screenshot or recording: a pressed-in track with a capsule of white glass that slides.
        prop seg = 0 ~260ms
        follow seg = if(cap_rec, 1, 0)
        prop seg_st = 0 ~120ms
        follow seg_st = clamp(abs(vel(seg)) / 5, 0, 1)
        group {
            move: ex0 + 16, 88
            box { from: 0, 0; size: 352, 34; corner: 17 continuous; color: well; opacity: 30% }
            body { color: well; opacity: 30%; box { from: 14, 0; size: 324, 2; corner: 1 continuous } }
            body {
                color: ink; glass: 25%; blur: 0%; light: 6%, 3, 14; shadow: 0, 1, 3, 24%; opacity: 22%
                box { at: 89 + 174 * seg, 17; size: 172 + 18 * seg_st, 28; corner: 14 continuous }
            }
            text "Screenshot" { at: 89, 17; anchor: center; size: 12.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 55% + 45% * (1 - seg) }
            text "Record" { at: 263, 17; anchor: center; size: 12.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 55% + 45% * seg }
            zone box seg_a { from: 0, 0; size: 176, 34; corner: 17 continuous; cursor: pointer; label: "Screenshot" }
            zone box seg_b { from: 176, 0; size: 176, 34; corner: 17 continuous; cursor: pointer; label: "Record" }
        }

        row {
            at: ex0 + 16, 134; gap: 8
            Target(0, "Region")
            Target(1, "Window")
            Target(2, "Screen")
        }

        //  Screenshots: also kept in Pictures (they always go to the clipboard).
        //  Recordings: where they go, and how they stop.
        group {
            move: ex0 + 16, 190
            group {
                opacity: 1 - seg
                text "Also save to Pictures" { at: 6, 14; anchor: left center; size: 12.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: 80% }
                prop sk = 1 ~240ms
                follow sk = if(cap_save, 1, 0)
                zone box save_z { from: 304, 2; size: 44, 24; corner: 12 continuous; cursor: pointer; label: "Also save to Pictures"; role: toggle; checked: cap_save; active: not cap_rec }
                body {
                    gradient: 304, 2 to 348, 26, mix(shade, mix(#b9bac4, lilac, 0.45), sk), mix(shade, mix(#9d9ea9, sunset, 0.42), sk)
                    glass: 25% * sk; blur: 0%; light: 5%, 2, 12
                    box { from: 304, 2; size: 44, 24; corner: 12 continuous }
                }
                body {
                    color: ink; glass: 25%; blur: 0%; light: 6%, 5, 9; shadow: 0, 1, 3, 26%
                    box { at: 318 + 16 * sk, 14; size: 22 + 3 * save_z.pressed, 18; corner: 9 continuous }
                }
            }
            text "Saved to Videos/Recordings · stop from the red pill" {
                at: 6, 14; anchor: left center; size: 12; weight: 500; family: "SF Pro Display"; color: ink; opacity: 55% * seg
            }
        }
    }

    on press capb { panel = home }
    on press seg_a { cap_rec = false }
    on press seg_b { cap_rec = true }
    on press save_z { toggle cap_save }
}
