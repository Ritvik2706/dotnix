// Volume and brightness: the pill itself becomes the gauge. It widens into a
// capsule of liquid light —lilac into sunset for sound, pearl into warm sun
// for the screen— that pours to the new level, leaves a fading afterimage of
// where it was, glows at its edge while it moves, and stretches like rubber
// when pushed past either end. The icon lives with it: the speaker's waves
// light one by one, a slash draws itself across on mute, and the sun grows,
// lengthens its rays and turns as the screen brightens. Hovering holds it;
// it can be dragged, scrolled, and the speaker pressed to mute.
//
// Over a fullscreen window the pill is hidden under it, so the gauge comes on
// its own instead: a capsule of the island's dark glass on a surface above
// fullscreen (surface hud in island.plm). Both draw Gauge.
part Osd {
    let is_vol = osd_kind == vol
    let is_sun = osd_kind == bright
    let is_kbd = osd_kind == kbd
    //  Where everything sits follows the pill as it is now, so a rubber-band
    //  stretch (an impulse on its width) carries the track's ends with it.
    let ol = cx - pw / 2
    let orr = cx + pw / 2
    let bead_x = ol + 19
    let tl = ol + 42
    let tr = orr - 56
    let tlen = max(0, tr - tl)
    let tcy = ph / 2

    //  The gauge in a capsule gw x gh from its corner, `shown` 0..1 as it
    //  arrives; `gl` is how light the glass under it is (its words go dark).
    component Gauge(gw: number, gh: number, shown: number, gl: number) {
        size: 340, 34
        let g_ink = mix(ink_base, ink_dark, gl)
        let g_tint = mix(g_ink, lilac, 0.45)
        let g_bead = 19
        let g_tl = 42
        let g_len = max(0, gw - 56 - g_tl)
        let g_cy = gh / 2
        let g_trh = 5 + 3 * swell + 2 * grab
        let g_fill = g_tl + g_len * lv
        group {
            opacity: smooth(0.45, 1, shown)
            move: 0, 2 * (1 - shown)

            //  The icon's bead: a small piece of the controls' glass.
            body {
                color: mix(chip, chip_hi, bead_z.hover * is_vol); material: control

                ellipse { at: g_bead, g_cy; radius: 13 - 0.6 * bead_z.pressed }
            }

            //  Sound: the speaker thumps on each change; its waves light up one by one.
            group {
                opacity: is_vol
                pivot: g_bead, g_cy
                scale: 1 + 0.9 * thump
                image ic_spk { at: g_bead - 8.5, g_cy - 8; size: 16, 16; tint: mix(g_ink, idle_c, mu) }
                image ic_w1 { at: g_bead - 8.5, g_cy - 8; size: 16, 16; tint: g_ink; opacity: smooth(0.0, 0.1, lv) * (1 - mu) }
                image ic_w2 { at: g_bead - 8.5, g_cy - 8; size: 16, 16; tint: g_ink; opacity: smooth(0.3, 0.42, lv) * (1 - mu) }
                image ic_w3 { at: g_bead - 8.5, g_cy - 8; size: 16, 16; tint: g_ink; opacity: smooth(0.63, 0.75, lv) * (1 - mu) }
                //  Muted: a slash that draws itself across, cut out of the speaker.
                group {
                    pivot: g_bead, g_cy
                    rotate: -45deg
                    box { at: g_bead, g_cy; size: 4.6, 21 * mu; corner: 2.3 continuous; color: chip; opacity: mu }
                    box { at: g_bead, g_cy; size: 2, 19 * mu; corner: 1 continuous; color: rose_ink; opacity: mu }
                }
            }

            //  The screen: a sun that grows, lengthens its rays and turns as it brightens.
            group {
                opacity: is_sun
                ellipse { at: g_bead, g_cy; radius: 3.6 + 1.6 * lv; color: mix(g_ink, amber, 0.18 * lv) }
                repeat k in 0..8 {
                    group {
                        pivot: g_bead, g_cy
                        rotate: k * 45deg + lv * 40deg
                        box { at: g_bead, g_cy - 7 - 1.3 * lv - (1.4 + 2.2 * lv) / 2; size: 1.9, 1.4 + 2.2 * lv; corner: 0.95 continuous; color: g_ink; opacity: 55% + 45% * lv }
                    }
                }
            }

            //  The keyboard: its keys light up from beneath, the light leaking
            //  out round them as it brightens.
            group {
                opacity: is_kbd
                box { at: g_bead, g_cy; size: 18, 12; corner: 3 continuous; stroke: 1.3; color: g_ink; opacity: 85% }
                repeat r in 0..2 {
                    repeat c in 0..4 {
                        body {
                            color: mix(idle_c, mix(pearl, cool, 0.35), lv)
                            shadow: 0, 0, 2.5 + 2 * lv, 70% * lv, mix(pearl, cool, 0.5)
                            box { at: g_bead - 5.25 + c * 3.5, g_cy - 3 + r * 3; size: 2.1, 1.7; corner: 0.6 continuous }
                        }
                    }
                }
                body {
                    color: mix(idle_c, mix(pearl, cool, 0.35), lv)
                    shadow: 0, 0, 2.5 + 2 * lv, 70% * lv, mix(pearl, cool, 0.5)
                    box { at: g_bead, g_cy + 3.4; size: 8, 1.7; corner: 0.85 continuous }
                }
            }

            //  The track: a groove pressed into the glass that swells while it changes.
            box { from: g_tl, g_cy - g_trh / 2; size: g_len, g_trh; corner: g_trh / 2 continuous; color: well; opacity: 26% }
            box { from: g_tl, g_cy - g_trh / 2; size: g_len, 1; corner: 0.5 continuous; color: well; opacity: 22% }
            //  The afterimage: where it was, fading as the liquid settles.
            box {
                from: g_tl + g_len * min(lv, trail), g_cy - g_trh / 2; size: g_len * abs(trail - lv), g_trh; corner: g_trh / 2 continuous
                color: mix(if(is_vol, soft_s, if(is_kbd, mix(pearl, cool, 0.62), mix(pearl, sunset, 0.52))), idle_c, mu); opacity: 30% * clamp(abs(trail - lv) * 12, 0, 1)
            }
            //  The liquid: lit along its top like the beads.
            body {
                //  Its two colours: muted, the liquid goes grey and still.
                gradient: g_tl, 0 to g_tl + g_len, 0, mix(if(is_vol, soft_l, if(is_kbd, mix(pearl, cool, 0.3), mix(pearl, amber, 0.28))), idle_c, mu), mix(if(is_vol, soft_s, if(is_kbd, mix(pearl, cool, 0.62), mix(pearl, sunset, 0.52))), idle_c, mu)
                light: 8%, g_cy - g_trh / 2, 8
                opacity: 100% - 30% * mu
                box { from: g_tl, g_cy - g_trh / 2; size: max(g_trh, g_len * lv), g_trh; corner: g_trh / 2 continuous }
            }
            //  Its edge glows while it moves, in its own colour: the faster, the brighter.
            body {
                color: mix(if(is_vol, soft_s, if(is_kbd, mix(pearl, cool, 0.62), mix(pearl, sunset, 0.52))), idle_c, mu)
                opacity: clamp(abs(vel(lv)) * 0.7, 0, 1) * (1 - mu)
                shadow: 0, 0, 9, 75%, mix(if(is_vol, soft_s, if(is_kbd, mix(pearl, cool, 0.62), mix(pearl, sunset, 0.52))), idle_c, mu)
                ellipse { at: max(g_tl + g_trh / 2, g_fill - g_trh / 2), g_cy; radius: g_trh / 2 + 1 }
            }

            //  How much, counting as it pours; or why there is nothing.
            text number(lv * 100, 0, "%") {
                at: gw - 18, g_cy; anchor: right center; size: 13; weight: 600; family: "SF Pro Display"
                color: g_ink; opacity: 100% * (1 - mu)
            }
            text "Muted" {
                at: gw - 16, g_cy; anchor: right center; size: 11.5; weight: 600; family: "SF Pro Display"
                color: g_tint; opacity: mu
            }
        }
    }

    group {
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group {
            move: ol, 0
            Gauge(pw, ph, os, gl_cs)
        }
    }

    zone box os_z { from: ol, 0; size: pw, ph; corner: pr continuous; label: "Level"; active: os > 0.9 }
    zone box track_z { from: tl - 6, tcy - 11; size: tlen + 12, 22; corner: 11 continuous; cursor: pointer; label: "Level slider"; active: os > 0.9 }
    prop grab = 0 ~200ms      // the pointer on the track: it swells a little to be taken
    follow grab = max(track_z.hover, track_z.pressed)
    zone ellipse bead_z { at: bead_x, tcy; radius: 14; cursor: pointer; label: "Mute"; active: os > 0.9 and is_vol }
}
