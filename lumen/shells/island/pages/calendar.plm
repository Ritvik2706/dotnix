// The date capsule's card (hovering the date), as macOS Tahoe's Control Center:
// modules of glass, each its own. The month (Monday first, today a bead of
// softly tinted glass; the chevrons and the wheel turn it, and it comes back to
// this one each time it opens) and what is up next. It closes once the pointer
// leaves it. (System settings live in the launcher's search: Super+D.)
part Calendar {
    component CalDay(c: record) {
        size: 40, 34
        body {
            gradient: 6, 3 to 34, 31, soft_l, soft_s
            glass: 25%; blur: 0%; light: 7%, 3, 14; shadow: 0, 1.2, 4.2, 26%; show: c.today
            ellipse { at: 20, 17; radius: 14 }
        }
        text c.d {
            at: 20, 17.5; anchor: center; size: 13; weight: 500; family: "SF Pro Display"
            color: ink; opacity: if(c.today, 0, if(c.inm, 92%, 28%))
        }
        text c.d {
            at: 20, 17.5; anchor: center; size: 13; weight: 700; family: "SF Pro Display"
            color: pearl_ink; opacity: if(c.today, 100%, 0)
        }
        //  Something on that day: a small dot under it.
        ellipse { at: 20, 29; radius: 1.6; color: if(c.today, pearl_ink, soft_l); opacity: if(c.ev, 90%, 0) }
    }

    //  One event coming: a bar of the island's light, its name, when (the first, how soon).
    component UpRow(u: record) {
        size: 268, 38
        body { gradient: 0, 4 to 0, 34, soft_l, soft_s; glass: 25%; blur: 0%; light: 6%, 4, 2; opacity: if(u.first, 100%, 45%); box { from: 0, 4; size: 3.5, 30; corner: 1.75 continuous } }
        text u.title { at: 12, 12; anchor: left center; width: 190; lines: 1; size: 12.5; weight: 600; family: "SF Pro Display"; color: ink }
        text u.time { at: 12, 28; anchor: left center; width: 250; lines: 1; size: 10.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: 55% }
        text u.when { at: 268, 12; anchor: right center; size: 9.5; weight: 700; family: "SF Pro Display"; color: tint_ink }
    }

    //  A round glass chevron, as the pages' back button.
    component CalArrow(dir: number, go: number, name: text) {
        size: 26, 26
        zone ellipse a { at: 13, 13; radius: 13; cursor: pointer; label: "{name}" }
        body {
            color: mix(chip, chip_hi, a.hover); material: control
            ellipse { at: 13, 13; radius: 13 - 0.5 * a.pressed }
        }
        path { at: 13 - 0.6 * dir, 13; stroke: 1.7; color: ink; opacity: 70% + 30% * a.hover; move 1.8 * dir, -4.5; line -2.6 * dir, 0; line 1.8 * dir, 4.5 }
        on press a { emit cal_step(go) }
    }

    let cl = cap_r - cal_w
    let tx0 = cl                          // the islands' left edge, and their width: the calendar's
    let tw0 = cal_w
    let mty = 42                          // the month, in the card the capsule grows into
    let uty = cap_y + cal_th + cal_gap    // Up Next, its own island under it

    //  The zone of all of it, the gaps between the islands too: the pointer can go from the date
    //  down to the last control without it closing.
    zone box cal_z { from: cl, cap_y; size: cal_w, cal_all; corner: 22 continuous; label: "Calendar"; active: cal }
    on press upn_z { emit cal_web }
    on leave cal_z while cal and not tmenu_open { cal = false }
    on scroll cal_z while cal and wheel.glide < 0.5 { emit cal_step(wheel) }

    //  ── the month, in the capsule grown into its card ──
    group {
        show: co > 0.01 and side_k == 0
        opacity: smooth(0.45, 1, co)
        move: 0, 8 * (1 - co)
        clip box { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous }
        line { from: cl + 16, 39; to: cap_r - 16, 39; width: 0.7; color: ink; opacity: 10% }
        text "{cal_month} {cal_year}" {
            at: cl + 20, mty + 16; anchor: left center; size: 15; weight: 600; family: "SF Pro Display"; color: ink
        }
        group {
            show: not cal_here
            zone box tod { from: cap_r - 140, mty + 4; size: 56, 24; corner: 12 continuous; cursor: pointer; label: "Today" }
            body {
                gradient: cap_r - 140, mty + 4 to cap_r - 84, mty + 28, mix(mix(chip, chip_hi, tod.hover), lilac, 0.16), mix(mix(chip, chip_hi, tod.hover), sunset, 0.13)
                material: control
                box { from: cap_r - 140, mty + 4; size: 56, 24; corner: 12 continuous }
            }
            text "Today" { at: cap_r - 112, mty + 16; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink }
            on press tod { emit cal_step(0) }
        }
        row {
            at: cap_r - 74, mty + 3; gap: 6
            CalArrow(1, -1, "Previous month")
            CalArrow(-1, 1, "Next month")
        }
        repeat i in 0..7 {
            text pick(i, "M", "T", "W", "T", "F", "S", "S") {
                at: cl + 10 + 39 * i + 20, mty + 42; anchor: center; size: 10; weight: 600; family: "SF Pro Display"
                color: ink; opacity: 42%
            }
        }
        grid {
            at: cl + 10, mty + 52; columns: 7; width: 280; gap: 0; row: 34
            for c in cdays { CalDay(c) }
        }
    }

    //  ── under it, on its own: Up Next ──
    //  The same glass as the card the capsule grows into (its dark, its frost), coming in one
    //  after the other once the card has opened.
    let m2 = smooth(0.35, 0.85, co)
    group {
        show: co > 0.01 and side_k == 0
        group {
            opacity: m2
            move: 0, -10 * (1 - m2)
            body {
                gradient: tx0, uty to tx0 + tw0, uty + upn_h, mix(mix(pearl, lilac, 0.3), dusk, 1), mix(mix(pearl, sunset, 0.3), deep, 1)
                glass: 100%; ripple: 0%; rim: 0%; milk: lg_card_milk
                blur: lg_card_frost; refraction: lg_card_refraction * m2; bevel: lg_card_bevel; dispersion: lg_dispersion; specular: lg_specular; magnify: 0; glass_tint: lg_glass_tint; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_r
                smoke: card_smoke; opacity: card_alpha + 3% * upn_z.hover
                light: 1%, uty, 10; shadow: 0, 8, 22, 16% * m2
                box { from: tx0, uty; size: tw0, upn_h; corner: 22 continuous }
            }
            box { from: tx0 + 0.5, uty + 0.5; size: tw0 - 1, upn_h - 1; corner: 21.5 continuous; stroke: 1; color: rim_grey; opacity: lg_card_rim * m2 }
            zone box upn_z { from: tx0, uty; size: tw0, upn_h; corner: 22 continuous; cursor: pointer; label: "Open Google Calendar"; active: cal }
            text "Up Next" { at: tx0 + 14, uty + 18; anchor: left center; size: 12; weight: 600; family: "SF Pro Display"; color: ink; opacity: 85% }
            column {
                at: tx0 + 8, uty + 32; gap: 4
                for u in upn { UpRow(u) }
            }
            text upn_empty {
                at: tx0 + 14, uty + 32; anchor: left top; width: tw0 - 28; lines: 3
                size: 11.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(upn.count == 0, 55%, 0)
            }
        }
    }
}
