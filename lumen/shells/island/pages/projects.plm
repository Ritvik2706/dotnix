// The projects page of the open card (Mod+A): what sesh knows —tmux sessions,
// configs, the folders zoxide remembers—, picked by typing. Each opens on a
// workspace of its own with a terminal on its tmux session (niri's
// scripts/project.sh open); one already open is marked, and picking it goes
// there. ↑ ↓ (or Ctrl+j/k) choose, Enter opens, Ctrl+a/t/g/x narrow it to all,
// tmux, configs or folders (as the fzf picker did), Esc clears then closes.
// On its own, what is chosen shows on the right (sesh preview: the session's
// pane, or the folder); beside an app, the list alone.
part Projects {
    component ProjRow(r: record) {
        size: 380, 46
        //  A section's title (Active sessions, Projects): small capitals, as iOS's grouped lists.
        text r.name { at: 14, 30; anchor: left center; size: 10.5; weight: 700; family: "SF Pro Text"; color: ink; opacity: if(r.head, 45%, 0) }
        group {
            show: not r.head
            zone box row { from: 0, 0; size: 380, 46; corner: 23 continuous; cursor: pointer; label: "{r.name}"; selected: r.sel; active: not r.head }
            body {
                color: chip_hi; opacity: 38% * row.hover; light: 4%, 0, 23
                box { from: 0, 0; size: 380, 46; corner: 23 continuous }
            }
            body {
                gradient: 0, 0 to 380, 46, mix(chip_hi, lilac, 0.16), mix(chip_hi, sunset, 0.13)
                glass: 25%; blur: 0%; light: 4%, 0, 23; shadow: 0, 1.8, 7, 20%; show: r.sel
                box { from: 0, 0; size: 380, 46; corner: 23 continuous }
            }
            //  What it is: a session (lit green while it runs), a config, a folder.
            ellipse { at: 25, 23; radius: 15; color: if(r.kind == 0, mix(chip, #30d158, 0.22), chip); opacity: 70% }
            image ic_code_p { at: 16, 14; size: 18, 18; tint: if(r.kind == 0, #6ee79a, soft_l); show: r.kind == 0 }
            image ic_tune_p { at: 16, 14; size: 18, 18; tint: soft_s; show: r.kind == 1 }
            image ic_folder_p { at: 16, 14; size: 18, 18; tint: ink; opacity: 80%; show: r.kind == 2 }
            text r.name {
                at: 50, 16; anchor: left center; width: 240; lines: 1
                size: 13.5; weight: 600; family: "SF Pro Display"; color: ink
            }
            text r.sub {
                at: 50, 32; anchor: left center; width: 240; lines: 1
                size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: 45%
            }
            //  In the terminal now (Current), or with a workspace of its own (Open).
            group {
                show: r.cur or r.open
                body {
                    color: mix(chip_hi, #30d158, 0.25); light: 4%, 12, 11
                    box { from: 290, 12; size: 76, 22; corner: 11 continuous }
                }
                ellipse { at: 302, 23; radius: 3; color: #30d158 }
                text pick(r.cur, "Open", "Current") { at: 310, 23.5; anchor: left center; size: 11; weight: 600; family: "SF Pro Display"; color: ink; opacity: 85% }
            }
            on press row { emit proj_pick_row(r.index) }
        }
    }

    group {
        opacity: smooth(0.4, 1, on_proj)
        move: 28 * (1 - on_proj), 0

        //  The header is the search: back, and the field.
        group {
            move: ex0 + 16, 44
            zone ellipse pjb { at: 16, 18; radius: 16; cursor: pointer; label: "Back" }
            body {
                color: mix(chip, chip_hi, pjb.hover); material: control
                ellipse { at: 16, 18; radius: 16 - 0.6 * pjb.pressed }
            }
            path { at: 16, 18; stroke: 1.8; color: ink; opacity: 70% + 30% * pjb.hover; move 2, -5.5; line -3, 0; line 2, 5.5 }
            body {
                color: chip; material: field
                box { from: 40, 0; size: 332, 36; corner: 18 continuous }
            }
            image ic_search { at: 52, 11; size: 14, 14; tint: ink; opacity: 75% }
            input proj_q { at: 74, 9; width: 290; size: 13.5; color: ink; placeholder: ""; label: "Search projects" }
            text "Projects" {
                at: 74, 18; anchor: left center; size: 13.5; weight: 500; family: "SF Pro Display"
                color: ink; opacity: 40%; show: proj_q_empty
            }
        }

        //  All · tmux · Configs · Folders: iOS's segmented control, the chosen one a lifted thumb.
        prop pjt = 0 ~240ms
        follow pjt = proj_tab
        group {
            move: ex0 + 16, 88
            body {
                color: chip; material: control
                box { from: 0, 0; size: 372, 28; corner: 14 continuous }
            }
            body {
                color: chip_hi; light: 5%, 2, 12
                box { from: 2 + 92 * pjt, 2; size: 92, 24; corner: 12 continuous }
            }
            repeat k in 0..4 {
                zone box pjtz.$k { from: 2 + 92 * k, 0; size: 92, 28; corner: 14 continuous; cursor: pointer; label: "Show"; role: tab; selected: proj_tab == k }
                on press pjtz.$k { emit proj_tab_at(k) }
            }
            text "All" { at: 48, 14.5; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 55% + 45% * clamp(1 - abs(pjt - 0), 0, 1) }
            text "Active" { at: 140, 14.5; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 55% + 45% * clamp(1 - abs(pjt - 1), 0, 1) }
            text "Configs" { at: 232, 14.5; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 55% + 45% * clamp(1 - abs(pjt - 2), 0, 1) }
            text "Folders" { at: 324, 14.5; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 55% + 45% * clamp(1 - abs(pjt - 3), 0, 1) }
        }

        //  Under the rows, so a press reaches them; the wheel works over all of it.
        zone box proj_list { from: ex0 + 12, 128; size: 380, pl_h; label: "Projects" }
        column plist {
            at: ex0 + 12, 128; gap: 2
            for r in projs { ProjRow(r) }
        }
        text pick(proj_state, "", "Nothing found", "Looking…") {
            at: ex0 + 202, 152; anchor: center; size: 12.5; weight: 500; family: "SF Pro Display"
            color: ink; opacity: 50%; show: projs.count == 0
        }

        //  What is chosen, on the right (on its own: beside an app there is no room).
        group {
            show: proj_wide
            let pjx = ex0 + 404
            box { from: pjx, 44; size: 360, 8 * 48 - 2 + 84; corner: 22 continuous; color: well; opacity: 26% }
            box { from: pjx, 44; size: 360, 8 * 48 - 2 + 84; corner: 22 continuous; stroke: 0.6; color: ink; opacity: 8% }
            text proj_pv_name { at: pjx + 18, 66; anchor: left center; width: 324; lines: 1; size: 13.5; weight: 600; family: "SF Pro Display"; color: ink }
            text proj_pv_meta { at: pjx + 18, 84; anchor: left center; width: 324; lines: 1; size: 10.5; weight: 500; family: "SF Pro Display"; color: tint_ink }
            line { from: pjx + 18, 98.5; to: pjx + 342, 98.5; width: 0.7; color: ink; opacity: 10% }
            group {
                clip box { from: pjx + 12, 104; size: 336, 8 * 48 - 2 + 18 }
                text proj_pv {
                    at: pjx + 18, 112; anchor: left top; width: 324; lines: 30
                    size: 10.5; weight: 400; line_height: 1.3; family: "JetBrainsMono Nerd Font"; color: ink; opacity: 78%
                }
            }
        }
    }

    on press pjb { emit go_home }
    on scroll proj_list { emit proj_scroll(wheel) }
}
