// Files: the island's file manager (logic: finder.luau). One view, `FilesView(x, y, w, h, win)`,
// drawn in the pill's card and in a window of its own (`surface files`, W): the same state in
// both, laid out for whatever room it has: the places on the left, the folder (a list or a grid
// of real thumbnails) in the middle, the preview on the right, and along the foot what is here,
// what a key is waiting for (which-key) and what just happened. `?` lists every key.
part Finder {
    //  A row of the folder, or of a search: its picture (a thumbnail when there is one, else its
    //  icon), its name, and quietly to the right its size and age (a search: where it is, under
    //  the name). Marked: a bead at its edge; cut: faded; pinned or marked: its key on the icon's
    //  corner; what you usually go to from here: a small lit dot on it (AccessRank's prediction).
    component FRow(r: record, lw: number) {
        size: lw, if(fnd_mode == 0, 30, if(r.head, 30, 44))
        let rh = if(fnd_mode == 0, 30, if(r.head, 30, 44))
        zone box row { from: 0, 0; size: lw, rh; corner: rh / 2 continuous; cursor: pointer; label: "{r.name}"; selected: r.sel; carries: "{r.drag}"; active: not r.head }
        on leave row while fnd_hover == r.index { fnd_hover = -1 }
        on enter row { fnd_hover = r.index }
        body {
            color: ink; opacity: 6%; show: row.hover > 0.5 and not r.sel and not r.head
            box { from: 0, 0; size: lw, rh; corner: rh / 2 continuous }
        }
        //  A drop target: a folder under a drag, or under the cursor while something is carried
        //  (yy / dd): lit as Finder lights where a drag will land, with "into" at its end.
        prop tg = 0 ~160ms
        follow tg = if((drag.over > 0.5 and row.hover > 0.5 and r.dir) or r.target, 1, 0)
        body {
            gradient: 0, 0 to lw, rh, soft_l, soft_s; opacity: 16% * tg
            box { from: 0, 0; size: lw, rh; corner: rh / 2 continuous }
        }
        box { from: 0.75, 0.75; size: lw - 1.5, rh - 1.5; corner: rh / 2 continuous; stroke: 1.5; color: soft_l; opacity: 85% * tg }
        //  Held there while dragging: the folder opens under the pointer (spring-loaded).
        on hover row for 750ms while drag.over > 0.5 and r.dir { emit fnd_spring(r.index) }
        on carry row { emit fnd_carried(r.index) }
        body {
            gradient: 3, rh / 2 - 7 to 7, rh / 2 + 7, soft_l, soft_s; light: 6%, 10, 2
            opacity: if(r.mark, 100%, 0)
            box { from: 3, rh / 2 - 7; size: 4, 14; corner: 2 continuous }
        }
        //  A section's heading among the results ("Inside files").
        text r.name { at: 14, rh / 2 + 1; anchor: left center; size: 10.5; weight: 700; family: "SF Pro Display"; color: tint_ink; opacity: if(r.head, 80%, 0) }
        group {
            opacity: if(r.head, 0, if(r.cut, 40%, 100%))
            image r.ic { at: 12, rh / 2 - 11; size: 22, 22 }
            text r.name { at: 44, if(fnd_mode == 0, rh / 2, 15.5); anchor: left center; width: lw - if(fnd_mode == 0, 190, 60); lines: 1; size: 12.5; weight: 500; family: "SF Pro Display"; color: ink }
            text r.sub { at: 44, 31; anchor: left center; width: lw - 60; lines: 1; size: 10.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(fnd_mode == 0, 0, 48%) }
            text r.size { at: lw - 92, rh / 2; anchor: right center; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(fnd_mode == 0, 42%, 0) * (1 - tg) }
            text "into ›" { at: lw - 92, rh / 2; anchor: right center; size: 11; weight: 700; family: "SF Pro Display"; color: tint_ink; opacity: tg }
            text r.date { at: lw - 16, rh / 2; anchor: right center; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(fnd_mode == 0, 52%, 0) }
            //  A link: a small arrow on the icon's foot.
            path { at: 31, rh / 2 + 9; stroke: 1.3; color: ink; opacity: if(r.link, 75%, 0); move -5, 0; line 0, -5 }
            path { at: 31, rh / 2 + 9; stroke: 1.3; color: ink; opacity: if(r.link, 75%, 0); move -3, -5; line 0, -5; line 0, -2 }
        }
        //  Predicted: a lit dot on the icon's upper corner.
        body {
            gradient: 29, rh / 2 - 14 to 37, rh / 2 - 6, soft_l, soft_s; light: 6%, 4, 4
            opacity: if(r.hint and not r.head, 100%, 0)
            ellipse { at: 33, rh / 2 - 10; radius: 3 }
        }
        //  Pinned (1–9) or marked ('a): its key on the icon's lower corner.
        group {
            opacity: if(r.hasb and not r.head, 1, 0)
            body {
                gradient: 26, rh / 2 to 40, rh / 2 + 14, soft_l, soft_s; light: 6%, 4, 7; shadow: 0, 1, 3, 30%
                ellipse { at: 33, rh / 2 + 7; radius: 6.5 }
            }
            text r.badge { at: 33, rh / 2 + 7.5; anchor: center; size: 8.5; weight: 700; family: "SF Pro Display"; color: pearl_ink }
        }
        on press row { emit fnd_pick_row(r.index) }
        on press right row { emit fnd_mark_row(r.index) }
    }

    //  A cell of the grid: the real picture (a photo, a PDF's page, a video's frame, a document,
    //  the first lines of code…) with its own corners, or a large icon; its name under it.
    component FTile(r: record) {
        size: 116, 132
        zone box tz { from: 2, 2; size: 112, 128; corner: 18 continuous; cursor: pointer; label: "{r.name}"; selected: r.sel; carries: "{r.drag}" }
        on leave tz while fnd_hover == r.index { fnd_hover = -1 }
        on enter tz { fnd_hover = r.index }
        body {
            color: ink; opacity: 6%; show: tz.hover > 0.5 and not r.sel
            box { from: 2, 2; size: 112, 128; corner: 18 continuous }
        }
        prop tg = 0 ~160ms
        follow tg = if((drag.over > 0.5 and tz.hover > 0.5 and r.dir) or r.target, 1, 0)
        body {
            gradient: 2, 2 to 114, 130, soft_l, soft_s; opacity: 16% * tg
            box { from: 2, 2; size: 112, 128; corner: 18 continuous }
        }
        box { from: 2.75, 2.75; size: 110.5, 126.5; corner: 17.25 continuous; stroke: 1.5; color: soft_l; opacity: 85% * tg }
        on hover tz for 750ms while drag.over > 0.5 and r.dir { emit fnd_spring(r.index) }
        on carry tz { emit fnd_carried(r.index) }
        //  The picture's frame, fitted into 96 × 80 keeping its shape.
        let pic = r.ar > 0
        let tw = if(r.ar >= 1.2, 96, 80 * r.ar)
        let th = if(r.ar >= 1.2, 96 / r.ar, 80)
        let dd = if(r.ar >= 1.2, 96, if(r.ar >= 1, 80 * r.ar, 80))
        group {
            opacity: if(r.cut, 40%, 100%)
            group {
                show: pic
                box { from: 58 - tw / 2, 48 - th / 2; size: tw, th; corner: 8 continuous; color: chip_hi }
                group {
                    clip box { from: 58 - tw / 2, 48 - th / 2; size: tw, th; corner: 8 continuous }
                    image r.ic { at: 58 - dd / 2, 48 - dd / 2; size: dd, dd }
                }
                box { from: 58 - tw / 2, 48 - th / 2; size: tw, th; corner: 8 continuous; stroke: 0.6; color: ink; opacity: 14% }
            }
            image r.ic { at: 30, 20; size: 56, 56; show: not pic }
            text r.name { at: 58, 96; anchor: center top; width: 104; lines: 2; align: center; line_height: 1.15; size: 11; weight: 500; family: "SF Pro Display"; color: ink }
        }
        body {
            gradient: 8, 40 to 12, 56, soft_l, soft_s; light: 6%, 40, 2
            opacity: if(r.mark, 100%, 0)
            box { from: 8, 40; size: 4, 16; corner: 2 continuous }
        }
        body {
            gradient: 92, 10 to 100, 18, soft_l, soft_s; light: 6%, 4, 4
            opacity: if(r.hint, 100%, 0)
            ellipse { at: 96, 14; radius: 3.5 }
        }
        group {
            opacity: if(r.hasb, 1, 0)
            body {
                gradient: 12, 6 to 28, 22, soft_l, soft_s; light: 6%, 6, 8; shadow: 0, 1, 3, 30%
                ellipse { at: 20, 14; radius: 8 }
            }
            text r.badge { at: 20, 14.5; anchor: center; size: 9.5; weight: 700; family: "SF Pro Display"; color: pearl_ink }
        }
        on press tz { emit fnd_pick_row(r.index) }
        on press right tz { emit fnd_mark_row(r.index) }
    }

    //  A place on the left: a heading (Pinned, Suggested, Places, Drives), or a folder with its icon
    //  and, pinned or marked, its key; where you are, lit. A drive not mounted: a click mounts it.
    component RailRow(p: record) {
        size: 172, if(p.head, 28, 30)
        zone box rz { from: 0, 0; size: 172, 30; corner: 15 continuous; cursor: pointer; label: "{p.name}"; active: not p.head; selected: p.at }
        body {
            color: ink; opacity: if(p.at, 9%, 5% * rz.hover); show: not p.head
            box { from: 0, 0; size: 172, 30; corner: 15 continuous }
        }
        text p.name { at: 10, 18; anchor: left center; size: 10; weight: 700; family: "SF Pro Display"; color: ink; opacity: if(p.head, 42%, 0) }
        group {
            show: not p.head
            image p.ic { at: 10, 6; size: 18, 18 }
            text p.name { at: 36, 15; anchor: left center; width: 108; lines: 1; size: 12; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(p.kind == 1, 78%, 92%) }
            text p.badge { at: 160, 15.5; anchor: right center; size: 10; weight: 600; family: "SF Pro Display"; color: tint_ink; opacity: if(p.hasb, 85%, 0) }
        }
        on leave rz while fnd_rhover == p.index { fnd_rhover = -1 }
        on enter rz { fnd_rhover = p.index }
        box { from: 0.75, 0.75; size: 170.5, 28.5; corner: 14.25 continuous; stroke: 1.5; color: soft_l; opacity: if(drag.over > 0.5 and rz.hover > 0.5 and not p.head, 85%, 0) }
        on hover rz for 900ms while drag.over > 0.5 and not p.head { emit fnd_rspring(p.index) }
        on press rz { emit fnd_rail(p.index) }
        on press right rz { emit fnd_eject(p.index) }
    }

    //  A crumb of the path: a folder you can go back to, quiet, lit under the pointer; the last
    //  one is where you are (a click copies its path). Between them, a fine chevron.
    component Crumb(c: record) {
        measure cw
        group {
            size: cw.width + if(c.last, 4, 22), 30
            zone box cz { from: -4, 3; size: cw.width + 8, 24; corner: 12 continuous; cursor: pointer; label: "{c.name}" }
            box { from: -4, 3; size: cw.width + 8, 24; corner: 12 continuous; color: ink; opacity: 7% * cz.hover + 4% * cz.pressed }
            text c.name { at: 0, 15; anchor: left center; size: 14; weight: 600; family: "SF Pro Display"; color: ink; opacity: if(c.last, 100%, 50% + 35% * cz.hover); measure: cw }
            path { at: cw.width + 11, 15; stroke: 1.5; color: ink; opacity: if(c.last, 0, 32%); move -1.6, -4; line 1.6, 0; line -1.6, 4 }
            on leave cz while fnd_chover == c.index { fnd_chover = -1 }
            on enter cz { fnd_chover = c.index }
            box { from: -3.25, 3.75; size: cw.width + 6.5, 22.5; corner: 11.25 continuous; stroke: 1.5; color: soft_l; opacity: if(drag.over > 0.5 and cz.hover > 0.5, 85%, 0) }
            on press cz { emit fnd_crumb(c.index) }
        }
    }

    //  An entry of a folder's (or an archive's) preview as a list: a small icon, its name, and at
    //  the right, quietly, its size (a file) or how much it holds (a folder).
    component PvRow(t: record, pw: number) {
        size: pw, 31
        box { from: 0, 2; size: pw, 27; corner: 13.5 continuous; color: ink; opacity: if(t.dir, 3.5%, 0) }
        image t.ic { at: 8, 6; size: 19, 19 }
        text t.name { at: 36, 15.5; anchor: left center; width: pw - 130; lines: 1; size: 12; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(t.dir, 95%, 80%) }
        text t.sub { at: pw - 12, 15.5; anchor: right center; size: 10.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: 45% }
        ellipse { at: 26, 7; radius: 2.5; color: soft_l; opacity: if(t.hint, 95%, 0) }
    }
    //  …and as icons (what you usually open in it first, with its dot).
    component PvTile(t: record) {
        size: 104, 100
        image t.ic { at: 26, 4; size: 52, 52 }
        text t.name { at: 52, 64; anchor: center top; width: 94; lines: 2; align: center; line_height: 1.15; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: 85% }
        ellipse { at: 80, 8; radius: 3; color: soft_l; opacity: if(t.hint, 95%, 0) }
    }

    //  A round glass button of the header.
    component HBtn(cx: number, cy: number, lit: number, tip: text, k: number) {
        size: 0, 0
        zone ellipse hb { at: cx, cy; radius: 15; cursor: pointer; label: tip }
        body {
            gradient: cx - 15, cy - 15 to cx + 15, cy + 15, mix(mix(chip, chip_hi, hb.hover), soft_l, lit), mix(mix(chip, chip_hi, hb.hover), soft_s, lit)
            material: control; opacity: lgc_fill + 55% * lit
            ellipse { at: cx, cy; radius: 15 - 0.6 * hb.pressed }
        }
        on press hb { emit fnd_hbtn(k) }
    }

    //  The whole file manager in a box: `x, y` its corner, `w, h` its room, `win` whether it is the
    //  window (which has a backdrop of its own; the card's glass is the pill's).
    component FilesView(x0: number, y0: number, w: number, h: number, win: bool, live: bool) {
        size: 0, 0
        //  How the room is shared: the places (from 760 wide), the preview (when on, and when
        //  the folder keeps at least 380), the folder in between.
        let rail_w = if(w >= 760, 184, 0)
        let pv_want = if(fnd_pv_on, clamp(w * 0.36, 300, 620), 0)
        let pv_w = if(w - rail_w - pv_want - 36 >= 380, pv_want, 0)
        let lx = x0 + 12 + rail_w
        let lw = w - 24 - rail_w - if(pv_w > 0, pv_w + 12, 0)
        let ly = y0 + 60
        prop carry_room = 0 ~260ms
        follow carry_room = if(fnd_carrying, 48, 0)
        let lh = h - 60 - 40 - carry_room
        let pvx = x0 + w - 12 - pv_w
        let pvy = y0 + 12
        let pvh = h - 12 - 40
        let foot = y0 + h - 20

        //  The window's own backdrop: the island card's dark glass, so it reads as one family.
        group {
            show: win
            //  The island card's dark glass: niri draws it on the window too (patch 0041), so the
            //  window is one of the island's cards that floats (or tiles) with the others.
            body {
                gradient: x0, y0 to x0 + w, y0 + h, dusk, deep
                glass: 100%; blur: lg_card_frost; refraction: lg_card_refraction; bevel: lg_card_bevel; dispersion: lg_dispersion; specular: lg_specular; glass_tint: lg_glass_tint; rim_tint: lg_rim_tint
                opacity: card_alpha; milk: lg_card_milk; smoke: card_smoke; rim: 0%; ripple: 0%
                box { from: x0, y0; size: w, h; corner: 24 continuous }
            }
            box { from: x0 + 0.5, y0 + 0.5; size: w - 1, h - 1; corner: 23.5 continuous; stroke: 1; color: rim_grey; opacity: lg_card_rim }
        }

        //  Something dragged in and let go anywhere on it lands here (rows, places and crumbs over it take their own).
        zone box fdrop { from: x0, y0; size: w, h; label: "Drop here"; active: drag.over > 0.5 }

        // ── the header: back · forward · the path · search · view · sort · window · keys ──
        HBtn(x0 + 28, y0 + 30, 0, "Back (H)", 1)
        path { at: x0 + 28, y0 + 30; stroke: 1.8; color: ink; opacity: 80%; move 2, -5.5; line -3, 0; line 2, 5.5 }
        HBtn(x0 + 64, y0 + 30, 0, "Up (h)", 2)
        path { at: x0 + 64, y0 + 31; stroke: 1.8; color: ink; opacity: 80%; move -5.5, 2; line 0, -3; line 5.5, 2 }
        //  The search: a glass button that stretches into the field (i searches anywhere, / this folder).
        prop fsx = 0 ~300ms
        follow fsx = if(fnd_insert and not fnd_prompting, 1, if(fnd_mode == 1 or fnd_filtering, 1, 0))
        prop f_ins = 0 ~200ms
        follow f_ins = if(fnd_insert and not fnd_prompting, 1, 0)
        //  The right-hand group, from the edge in, 8 apart: ? · window · preview · list/grid; the search ends 10 before it.
        let right_w = 196 - 12
        let sf_l = x0 + w - right_w - 12 - 36 - (min(420, w - right_w - 160) - 36) * fsx
        let sf_r = x0 + w - right_w - 12
        group {
            opacity: 1 - smooth(0, 0.5, fsx)
            move: -10 * fsx, 0
            group {
                clip box { from: x0 + 90, y0 + 12; size: max(0, sf_l - x0 - 100), 36 }
                row {
                    at: x0 + 94, y0 + 15; gap: 0
                    for c in fcrumbs { Crumb(c) }
                }
            }
        }
        body {
            color: mix(chip, chip_hi, fsb.hover * (1 - fsx)); material: field
            opacity: (lgc_fill + 5%) * (1 - fsx)
            box { from: sf_l, y0 + 12; size: sf_r - sf_l, 36; corner: 18 continuous }
        }
        box { from: sf_l, y0 + 12; size: sf_r - sf_l, 36; corner: 18 continuous; color: well; opacity: 30% * fsx }
        box { from: sf_l, y0 + 12; size: sf_r - sf_l, 36; corner: 18 continuous; stroke: 1; color: soft_l; opacity: 45% * f_ins }
        image ic_search { at: sf_l + 11, y0 + 23; size: 14, 14; tint: ink; opacity: 85% - 25% * fsx * (1 - f_ins) }
        //  (Drawn only while it is in use: a window gaining the keyboard hands it to the first field
        //  drawn, and the keys must stay the files' until `i` or `/`.)
        group {
            show: fnd_insert or fsx > 0.01
            opacity: smooth(0.55, 1, fsx)
            input fq { at: sf_l + 34, y0 + 21; width: max(10, sf_r - sf_l - 46); size: 13.5; color: ink; placeholder: ""; label: "Search files" }
            text pick(fnd_qkind == 2, "Search anywhere · .pdf · photos · week · “inside”", "Filter this folder") {
                at: sf_l + 34, y0 + 30; anchor: left center; width: max(10, sf_r - sf_l - 46); lines: 1; size: 13; weight: 500; family: "SF Pro Display"
                color: ink; opacity: if(fq_empty, 38%, 0)
            }
        }
        zone box fsb { from: sf_l, y0 + 12; size: sf_r - sf_l, 36; corner: 18 continuous; cursor: pointer; label: "Search (i)"; active: not fnd_insert }
        on press fsb { emit fnd_search_click }
        //  List or grid (w): iOS's segmented control, its bead of soft light sliding to the one chosen.
        prop vsel = 0 ~shape
        follow vsel = if(fnd_grid, 1, 0)
        let vsx = x0 + w - 186
        body {
            color: chip; material: control
            box { from: vsx, y0 + 17; size: 60, 26; corner: 13 continuous }
        }
        body {
            gradient: vsx + 2 + 28 * vsel, y0 + 19 to vsx + 30 + 28 * vsel, y0 + 41, soft_l, soft_s
            glass: 25%; blur: 0%; light: 7%, 7, 11; shadow: 0, 1, 3.5, 24%
            box { from: vsx + 2 + 28 * vsel, y0 + 19; size: 28, 22; corner: 11 continuous }
        }
        group {
            move: vsx + 16, y0 + 30
            repeat k in 0..3 {
                ellipse { at: -4.5, -4 + 4 * k; radius: 1; color: mix(ink, pearl_ink, 1 - vsel) }
                box { from: -2, -4.6 + 4 * k; size: 8, 1.3; corner: 0.65; color: mix(ink, pearl_ink, 1 - vsel) }
            }
        }
        group {
            move: vsx + 44, y0 + 30
            repeat k in 0..4 {
                box { from: -5 + 5.6 * mod(k, 2), -5 + 5.6 * floor(k / 2); size: 4.4, 4.4; corner: 1.2 continuous; color: mix(ink, pearl_ink, vsel) }
            }
        }
        zone box vs_list { from: vsx, y0 + 17; size: 30, 26; corner: 13 continuous; cursor: pointer; label: "As a list (w)" }
        zone box vs_grid { from: vsx + 30, y0 + 17; size: 30, 26; corner: 13 continuous; cursor: pointer; label: "As thumbnails (w)" }
        on press vs_list { emit fnd_grid_as(0) }
        on press vs_grid { emit fnd_grid_as(1) }
        //  The preview on or off (P), the window (W), the keys (?).
        HBtn(x0 + w - 103, y0 + 30, if(fnd_pv_on, 1, 0), "Preview (zp)", 3)
        box { from: x0 + w - 110, y0 + 24; size: 14, 12; corner: 2.5; stroke: 1.4; color: mix(ink, pearl_ink, if(fnd_pv_on, 1, 0)) }
        box { from: x0 + w - 102, y0 + 24; size: 1.4, 12; color: mix(ink, pearl_ink, if(fnd_pv_on, 1, 0)) }
        HBtn(x0 + w - 65, y0 + 30, 0, pick(win, "A window of its own (W)", "Back into the island (W)"), 4)
        image ic_pop { at: x0 + w - 72, y0 + 23; size: 14, 14; tint: ink; opacity: 85% }
        HBtn(x0 + w - 27, y0 + 30, if(fnd_help_on, 1, 0), "Keys (?)", 5)
        text "?" { at: x0 + w - 27, y0 + 30.5; anchor: center; size: 14; weight: 700; family: "SF Pro Display"; color: mix(ink, pearl_ink, if(fnd_help_on, 1, 0)) }

        // ── the places ──
        group {
            show: rail_w > 0
            clip box { from: x0 + 6, ly - 4; size: rail_w, lh + 8 }
            column {
                at: x0 + 12, ly; gap: 1
                for p in frail { RailRow(p) }
            }
        }

        // ── the folder: rows, or a grid of thumbnails ──
        zone box fnd_list { from: lx, ly; size: lw, lh; label: "Files" }
        on scroll fnd_list while wheel.glide < 0.5 { emit fnd_scroll(wheel) }
        //  (told to the logic by the copy showing: the card's, or the window's)
        let fnd_at_y = fnd_at * if(fnd_mode == 0, 32, 46)
        on change floor(lh) + 100000 * if(live, 1, 0) while live { fnd_lh = lh }
        on change floor(lw) + 100000 * if(live, 1, 0) while live { fnd_lw = lw }
        group {
            show: not (fnd_grid and fnd_mode == 0)
            Glide(lx, ly + fnd_at_y, lw, if(fnd_mode == 0, 30, 44), if(fnd_mode == 0, 15, 22), fnd_at >= 0, 0)
            clip box { from: lx - 4, ly - 2; size: lw + 8, lh + 4 }
            column {
                at: lx, ly; gap: 2
                for r in fhits { FRow(r, lw) }
            }
        }
        group {
            show: fnd_grid and fnd_mode == 0
            Glide(lx + 2 + 116 * mod(max(fnd_at, 0), fnd_cols), ly + 2 + 132 * floor(max(fnd_at, 0) / fnd_cols), 112, 128, 18, fnd_at >= 0, 0)
            clip box { from: lx - 4, ly - 2; size: lw + 8, lh + 4 }
            for r in fhits {
                group {
                    move: lx + 116 * mod(r.index, fnd_cols), ly + 132 * floor(r.index / fnd_cols)
                    FTile(r)
                }
            }
        }
        //  Where the list stands in all of it: a thin bar at its right edge, only when it does not all fit.
        let sb_total = max(1, fnd_count)
        let sb_seen = if(fnd_grid and fnd_mode == 0, fhits.count, fhits.count)
        box { from: lx + lw - 3, ly + lh * fnd_first / sb_total; size: 3, max(18, lh * sb_seen / sb_total); corner: 1.5; color: ink; opacity: if(fnd_count > sb_seen, 22%, 0) }
        text pick(fnd_mode == 1, "Nothing here", "No matches") {
            at: lx + lw / 2, ly + 60; anchor: center; size: 12.5; weight: 500; family: "SF Pro Display"
            color: ink; opacity: if(fnd_count == 0, 50%, 0)
        }

        //  Carrying (yy / dd) with a file under the cursor: here is the target, the list's edge lit.
        prop th_on = 0 ~200ms
        follow th_on = if(fnd_carrying and fnd_tgt_here and fnd_mode == 0, 1, 0)
        box { from: lx - 4, ly - 4; size: lw + 8, lh + 8; corner: 20 continuous; stroke: 1.5; color: soft_l; opacity: 55% * th_on }
        //  What is carried, in hand: a small stack of what it is and where p would put it,
        //  floating over the foot of the list as a drag's ghost does.
        prop cy_on = 0 ~260ms
        follow cy_on = if(fnd_carrying, 1, 0)
        group {
            opacity: smooth(0.1, 1, cy_on)
            move: 0, 12 * (1 - cy_on)
            let cbw = min(lw - 8, 640)
            let cby = foot - 58
            body {
                color: mix(chip_hi, lilac, 0.16); material: control; opacity: lgb_fill + 18%
                box { from: lx + 4, cby; size: cbw, 40; corner: 20 continuous }
            }
            repeat k in 0..3 {
                group {
                    opacity: if(fcarry.count > k, 1, 0)
                    move: 8 * k, -2 * k
                    box { from: lx + 12, cby + 6; size: 28, 28; corner: 7 continuous; color: chip; opacity: 90% }
                }
            }
            for c in fcarry {
                group {
                    move: 8 * c.index, -2 * c.index
                    image c.ic { at: lx + 14, cby + 8; size: 24, 24 }
                }
            }
            text fnd_carry { at: lx + 30 + 8 * min(3, fcarry.count), cby + 20; anchor: left center; width: cbw - 50 - 8 * min(3, fcarry.count); lines: 1; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink }
        }

        // ── the foot: what is here · what a key waits for · what just happened ──
        line { from: x0 + 18, foot - 16.5; to: x0 + w - 18, foot - 16.5; width: 0.7; color: ink; opacity: 7% }
        text fnd_status { at: lx + 4, foot; anchor: left center; width: lw - 8; lines: 1; size: 10.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: if(fnd_pre or fnd_busy or fnd_toast_on, 0, 50%) }
        text fnd_pending { at: lx + 4, foot; anchor: left center; width: w - (lx - x0) - 24; lines: 1; size: 10.5; weight: 600; family: "SF Pro Display"; color: tint_ink; opacity: if(fnd_pre, 100%, 0) }
        text fnd_busy_text { at: lx + 4, foot; anchor: left center; width: lw - 8; lines: 1; size: 10.5; weight: 600; family: "SF Pro Display"; color: tint_ink; opacity: if(fnd_busy and not fnd_pre, 100%, 0) }
        text fnd_toast { at: lx + 4, foot; anchor: left center; width: w - (lx - x0) - 24; lines: 1; size: 10.5; weight: 600; family: "SF Pro Display"; color: tint_ink; opacity: if(fnd_toast_on and not fnd_pre and not fnd_busy, 100%, 0) }
        text "VISUAL" { at: x0 + w - 22, foot; anchor: right center; size: 10; weight: 700; family: "SF Pro Display"; color: tint_ink; opacity: if(fnd_visual, 90%, 0) }

        // ── the preview ──
        group {
            show: pv_w > 0
            box { from: pvx, pvy + 48; size: pv_w, pvh - 48; corner: 22 continuous; color: well; opacity: 26% }
            body { color: well; opacity: 26%; box { from: pvx + 16, pvy + 48; size: pv_w - 32, 2; corner: 1 continuous } }
            box { from: pvx, pvy + 48; size: pv_w, pvh - 48; corner: 22 continuous; stroke: 0.6; color: ink; opacity: 8% }
            on change floor(pv_w) + 100000 * if(live, 1, 0) while live { fnd_pvw = pv_w }
            on change floor(pvh) + 100000 * if(live, 1, 0) while live { fnd_pvh = pvh - 48 }
            let py = pvy + 48
            let ph = pvh - 48
            group {
                opacity: if(fnd_count > 0 or fnd_help_on, 1, 0)
                text pv_name { at: pvx + 18, py + 22; anchor: left center; width: pv_w - 70; lines: 1; size: 13.5; weight: 600; family: "SF Pro Display"; color: ink }
                text pv_meta { at: pvx + 18, py + 40; anchor: left center; width: pv_w - 70; lines: 1; size: 10.5; weight: 500; family: "SF Pro Display"; color: tint_ink }
                line { from: pvx + 18, py + 54.5; to: pvx + pv_w - 18, py + 54.5; width: 0.7; color: ink; opacity: 10% }
                //  A folder's contents, as icons or as a list (the switch beside the copy button).
                group {
                    show: pv_kind == 7
                    prop vsel2 = 0 ~shape
                    follow vsel2 = if(pvd_list, 0, 1)
                    let vx2 = pvx + pv_w - 84
                    body { color: chip; material: control; box { from: vx2, py + 15; size: 60, 26; corner: 13 continuous } }
                    body {
                        gradient: vx2 + 2 + 28 * vsel2, py + 17 to vx2 + 30 + 28 * vsel2, py + 39, soft_l, soft_s
                        glass: 25%; blur: 0%; light: 7%, 7, 11; shadow: 0, 1, 3.5, 24%
                        box { from: vx2 + 2 + 28 * vsel2, py + 17; size: 28, 22; corner: 11 continuous }
                    }
                    group {
                        move: vx2 + 16, py + 28
                        repeat k in 0..3 {
                            ellipse { at: -4.5, -4 + 4 * k; radius: 1; color: mix(ink, pearl_ink, 1 - vsel2) }
                            box { from: -2, -4.6 + 4 * k; size: 8, 1.3; corner: 0.65; color: mix(ink, pearl_ink, 1 - vsel2) }
                        }
                    }
                    group {
                        move: vx2 + 44, py + 28
                        repeat k in 0..4 {
                            box { from: -5 + 5.6 * mod(k, 2), -5 + 5.6 * floor(k / 2); size: 4.4, 4.4; corner: 1.2 continuous; color: mix(ink, pearl_ink, vsel2) }
                        }
                    }
                    zone box pvs_list { from: vx2, py + 15; size: 30, 26; corner: 13 continuous; cursor: pointer; label: "Contents as a list" }
                    zone box pvs_icons { from: vx2 + 30, py + 15; size: 30, 26; corner: 13 continuous; cursor: pointer; label: "Contents as icons" }
                    on press pvs_list { emit fnd_view_as(0) }
                    on press pvs_icons { emit fnd_view_as(1) }
                }
                //  Text and code, as written; an archive's list; prose; the keys (cut at the panel's foot).
                group {
                clip box { from: pvx + 8, py + 62; size: pv_w - 16, ph - 100 }
                text pv_text { at: pvx + 18, py + 68; anchor: left top; width: pv_w - 36; lines: 64; size: 10.5; family: "JetBrainsMono Nerd Font"; color: ink; opacity: if(pv_kind == 1, 82%, 0) }
                text pv_text { at: pvx + 18, py + 68; anchor: left top; width: pv_w - 36; lines: 48; size: 12; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(pv_kind == 3, 75%, 0) }
                text pv_text { at: pvx + 18, py + 68; anchor: left top; width: pv_w - 36; lines: 40; size: 13.5; weight: 400; family: "SF Pro Display"; color: ink; opacity: if(pv_kind == 6, 85%, 0) }
                text fnd_help_text { at: pvx + 18, py + 68; anchor: left top; width: pv_w - 36; lines: 40; size: 10.5; family: "JetBrainsMono Nerd Font"; color: ink; opacity: if(pv_kind == 5, 85%, 0) }
                }
                //  A folder: what is in it (what you usually open there first, with its dot).
                let pcols = max(1, floor((pv_w - 36) / 104))
                //  (An archive's contents always as a list: 8.)
                group {
                    opacity: if((pv_kind == 7 and pvd_list) or pv_kind == 8, 1, 0)
                    clip box { from: pvx + 8, py + 62; size: pv_w - 16, ph - 110 }
                    column {
                        at: pvx + 14, py + 66; gap: 0
                        for t in pvd { PvRow(t, pv_w - 28) }
                    }
                }
                group {
                    opacity: if(pv_kind == 7 and not pvd_list, 1, 0)
                    clip box { from: pvx + 8, py + 62; size: pv_w - 16, ph - 110 }
                    grid {
                        at: pvx + 18, py + 70; columns: 4; width: 416; gap: 0; row: 100
                        for t in pvd { PvTile(t) }
                    }
                }
                text "+{pvd_more} more" { at: pvx + pv_w - 22, py + ph - 58; anchor: right center; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: if((pv_kind == 7 or pv_kind == 8) and pvd_more > 0, 55%, 0) }
                text pv_text { at: pvx + pv_w / 2, py + ph / 2; anchor: center; size: 12; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(pv_kind == 7, 45%, 0) }
                //  A picture (a PDF's page, a video's frame, a cover, a font's sheet), fitted and
                //  rounded; zoomed and moved while looking closer. A video plays in it (K).
                prop vz = 1 ~200ms
                follow vz = pv_z
                prop vx = 0 ~200ms
                follow vx = pv_px
                prop vy = 0 ~200ms
                follow vy = pv_py
                prop vf = 0 ~220ms
                follow vf = if(fnd_view, 1, 0)
                group {
                    show: pv_kind == 2
                    let vcx = pvx + pv_w / 2
                    let vcy = py + 64 + (ph - 120) / 2
                    let pfw = min(pv_iw * vz, pv_w - 36)
                    let pfh = min(pv_ih * vz, ph - 120)
                    box { from: vcx - pfw / 2, vcy - pfh / 2; size: pfw, pfh; corner: 12 continuous; color: chip_hi }
                    group {
                        clip box { from: vcx - pfw / 2, vcy - pfh / 2; size: pfw, pfh; corner: 12 continuous }
                        image pv_img { at: vcx - 312 * pv_cs * vz + vx, vcy - 200 * pv_cs * vz + vy; size: 624 * pv_cs * vz, 400 * pv_cs * vz; opacity: if(fnd_vplay and vid.on, 0, 100%) }
                        image fnd_vid { at: vcx - 312 * pv_cs, vcy - 200 * pv_cs; size: 624 * pv_cs, 400 * pv_cs; opacity: if(fnd_vplay and vid.on, 100%, 0) }
                    }
                    box { from: vcx - pfw / 2, vcy - pfh / 2; size: pfw, pfh; corner: 12 continuous; stroke: 0.6 + 0.6 * vf; color: mix(ink, soft_l, vf); opacity: 16% + 54% * vf }
                    //  A video: a play button over its frame, and while it plays, its progress under it.
                    group {
                        opacity: if(fnd_isvid and not fnd_vplay, 1, 0)
                        body {
                            color: chip; material: control; opacity: lgb_fill + 10%
                            ellipse { at: vcx, vcy; radius: 24 }
                        }
                        path { at: vcx + 2, vcy; color: #ffffff; move -6, -9; line 9, 0; line -6, 9; close }
                    }
                    group {
                        opacity: if(fnd_vplay, 1, 0)
                        let vbx = vcx - pfw / 2 + 12
                        let vbw = pfw - 24 - 96
                        let vy2 = vcy + pfh / 2 - 16
                        box { from: vbx, vy2 - 1.5; size: vbw, 3; corner: 1.5; color: #ffffff; opacity: 28% }
                        box { from: vbx, vy2 - 1.5; size: vbw * if(vid.length > 0, clamp(vid.position / vid.length, 0, 1), 0), 3; corner: 1.5; color: #ffffff; opacity: 90% }
                        text "{vid.position, time} / {vid.length, time}" { at: vcx + pfw / 2 - 12, vy2 + 0.5; anchor: right center; size: 10.5; weight: 600; family: "SF Pro Text"; color: #ffffff; opacity: 85%; shadow: 0, 1, 3, 40% }
                        zone box fvbar { from: vbx, vy2 - 8; size: vbw, 16; cursor: pointer; label: "Seek" }
                        on press fvbar { emit fnd_vseek(vid.length * clamp((pointer.x - vbx) / vbw, 0, 1)) }
                    }
                }
                zone box pv_area { from: pvx + 18, py + 64; size: pv_w - 36, ph - 120; cursor: pointer; label: "Look closer, or play (K)"; active: pv_kind == 2 }
                on press pv_area { emit pv_click; emit pv_grab }
                on drag pv_area while fnd_view { emit pv_drag_x(drag.dx); emit pv_drag_y(drag.dy) }
                on scroll pv_area while wheel.glide < 0.5 and not fnd_vplay { fnd_view = true; emit pv_zoom(if(wheel > 0, 1.15, 0.87)) }
                //  Nothing to show: a large symbol of what it is.
                group {
                    opacity: if(pv_kind == 4, 1, 0)
                    image ic_doc { at: pvx + pv_w / 2 - 12, py + ph / 2 - 20; size: 24, 24; tint: ink; opacity: 30% }
                    text "No preview" { at: pvx + pv_w / 2, py + ph / 2 + 20; anchor: center; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: 40% }
                }
                text pick(fnd_view, "⏎ open · K look closer / play · O open with · ? keys", pv_zoom) {
                    at: pvx + pv_w / 2, py + ph - 16; anchor: center; width: pv_w - 30; lines: 1; size: 10; weight: 600; family: "SF Pro Display"; color: ink; opacity: if(fnd_view, 70%, 36%)
                }
            }
        }

        //  Rename, a new file or folder, a name for a zip, a path to go to: a field of glass rising over the foot.
        prop prm = 0 ~260ms
        follow prm = if(fnd_prompting, 1, 0)
        group {
            show: fnd_prompting or prm > 0.01
            opacity: smooth(0.2, 1, prm)
            move: 0, 10 * (1 - prm)
            let pmw = min(lw, 520)
            let pmy = y0 + h - 92
            body {
                gradient: lx, pmy to lx + pmw, pmy + 44, well_t, well_b
                opacity: 97%; light: 3%, pmy, 22; shadow: 0, 6, 18, 34%
                box { from: lx, pmy; size: pmw, 44; corner: 22 continuous }
            }
            box { from: lx + 0.5, pmy + 0.5; size: pmw - 1, 43; corner: 21.5 continuous; stroke: 1; color: soft_l; opacity: 45% }
            text fnd_prompt_label { at: lx + 18, pmy + 22; anchor: left center; size: 11; weight: 700; family: "SF Pro Display"; color: tint_ink; measure: prlm }
            input fnd_in { at: lx + 28 + prlm.width, pmy + 13; width: pmw - prlm.width - 48; size: 13; color: ink; placeholder: ""; label: "Name" }
        }
    }
}
