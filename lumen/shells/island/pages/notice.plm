// A notification arriving: the pill itself grows into a banner (the island's
// own glass, prism rim and all), says it, and shrinks back. Hovering holds it;
// a click opens it; its buttons are pills under it; × lets it go. Over a
// fullscreen window, which hides the pill, it comes on its own instead
// (surface note_hud in island.plm). Both draw NoteCard.
part Notice {
    component NoteAct(a: record, w: number, fg: color = ink) {
        size: w, 32
        zone box b { from: 0, 0; size: w, 32; corner: 16 continuous; cursor: pointer; label: "{a.label}" }
        body {
            color: mix(chip, chip_hi, b.hover); material: control
            box { from: 0, 0; size: w, 32; corner: 16 continuous }
        }
        text a.label { at: w / 2, 16; anchor: center; width: w - 16; lines: 1; align: center; size: 12; weight: 600; family: "SF Pro Display"; color: fg }
        on press b { emit note_act(a.index) }
    }
    let bx0 = cx - 192
    let nw = (352 - 8 * (nacts.count - 1)) / max(nacts.count, 1)

    //  The banner's face, 384 wide from its corner: `shown` 0..1 as it arrives,
    //  `gl` how light the glass under it is, `swap` 0→1 as a new one takes it,
    //  `pull` the flick up; the hovers hold its ✕.
    component NoteCard(shown: number, gl: number, swap: number, pull: number, hov: number, xhov: number, xpress: number) {
        size: 384, 140
        let c_ink = mix(ink_base, ink_dark, gl)
        let c_tint = mix(c_ink, lilac, 0.45)
        group {
            opacity: smooth(0.45, 1, shown) * clamp(1 + pull / 60, 0, 1) * smooth(0, 1, swap)
            move: 0, 6 * (1 - shown) + 0.5 * pull - 7 * (1 - swap)

            //  Its picture: the sender's photo filling a squircle, or the app's icon on a chip.
            body {
                color: chip_hi; glass: 25%; blur: 0%; light: 4%, 16, 22; shadow: 0, 1.8, 7, 20%
                box { from: 16, 16; size: 44, 44; corner: 14 continuous }
            }
            //  A quiet bell first: what shows if neither a picture nor the app's icon does.
            image ic_bell { at: 30, 30; size: 16, 16; tint: c_ink; opacity: 40% }
            group {
                show: n_is_pic
                clip box { from: 16, 16; size: 44, 44; corner: 14 continuous }
                image n_pic { at: 16, 16; size: 44, 44 }
            }
            image n_pic { at: 24, 24; size: 28, 28; show: not n_is_pic }
            box { from: 16, 16; size: 44, 44; corner: 14 continuous; stroke: 1.2; color: coral; opacity: 80% * n_urgent }

            text n_app {
                at: 72, 23; anchor: left center; width: 250; lines: 1
                size: 10.5; weight: 600; family: "SF Pro Display"; color: if(n_urgent, coral, c_tint); opacity: 85%
            }
            text "now" {
                at: 366, 23; anchor: right center; size: 10.5; weight: 500; family: "SF Pro Display"
                color: c_ink; opacity: 40% * (1 - xhov) * (1 - hov)
            }
            text n_title {
                at: 72, 40; anchor: left center; width: 290; lines: 1
                size: 13.5; weight: 600; family: "SF Pro Display"; color: c_ink
            }
            text n_body {
                at: 72, 50; anchor: left top; width: 290; lines: 2; line_height: 1.25
                size: 12; weight: 500; family: "SF Pro Display"; color: c_ink; opacity: 72%
            }

            //  Its buttons, as many as it brings (up to three), sharing the width.
            row nacts_row {
                at: 16, nb_text_h + 6; gap: 8
                for a in nacts { NoteAct(a, nw, c_ink) }
            }

            //  Let it go: a small bead in the corner, there while it is under the pointer.
            group {
                opacity: max(hov, xhov)
                body {
                    color: mix(chip_hi, rose, xhov); light: 4%, 12, 11
                    ellipse { at: 360, 23; radius: 10 - 0.5 * xpress }
                }
                image ic_x { at: 354.5, 17.5; size: 11, 11; tint: mix(c_ink, rose_ink, xhov); opacity: 85% }
            }
        }
    }

    //  Its body measured once, out of sight, for the banner's height.
    text n_body {
        at: 0, -400; width: 290; lines: 2; line_height: 1.25
        size: 12; weight: 500; family: "SF Pro Display"; opacity: 0
        measure: n_bm
    }

    //  Inside the glass only: while the pill is still growing, nothing spills out of it.
    group {
        clip inset 1 box { from: x0, 0; size: pw, max(34, ph + bpull); corner: pr continuous }
        group {
            move: bx0, 0
            NoteCard(ban, gl_cs, nswap, bpull, hit.hover, nx.hover, nx.pressed)
        }
    }
    //  The count is part of the app line now; clicking the stack opens them all.
    zone box more_z { from: bx0 + 30, ph - 2; size: 324, 18; corner: 9 continuous; cursor: pointer; label: "See all notifications"; active: ban > 0.9 and n_more > 0 }
    zone ellipse nx { at: bx0 + 360, 23; radius: 12; cursor: pointer; label: "Dismiss"; active: ban > 0.9 }
}
