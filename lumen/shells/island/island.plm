// Island — LUMEN's dynamic island: the whole bar, as one piece of glass that
// changes shape.
//
// One silhouette, three states (the body never changes, only its springs):
//   rest      a stadium: occupied workspaces (a numbered rail), the time,
//             and battery, with a continuous rail through expansion.
//   live      something is playing: the pill widens, a teal waveform (the one
//             cold pop, as in waybar) and the track ride inside it.
//   expanded  hover it: it grows into a card with every workspace, the date,
//             now-playing (when there is a player), and the telemetry
//             waybar showed — wifi · cpu · ram · volume · battery.
//
// LUMEN, translated:
//   · Waybar LUMEN glass: a translucent plum tint, violet/peach edges,
//     and a live refracting lens with low frost behind the labels.
//   · one circular selection ring glides along the workspace rail, with
//     a softly shaded grey border around the selected number.
//   · telemetry as light (waybar's ramp): dim at idle, white as it works,
//     amber, then coral only when something deserves attention.
//   · controlled, interruptible motion without overshoot; the selection
//     deforms slightly in transit and settles back into a circle.
//   · quiet by default: no `time` anywhere, so a still island draws nothing.

scene Island {
    surface {
        size: full, 885       // the top edge: room for the card (the large mail view is 840) and its shadow; empty parts let clicks through
        //  60 frames a second at rest (a playing waveform costs little); 120 while the
        //  bar itself is moving, so it keeps up with the windows the compositor
        //  slides under it (they go at the screen's 240), and 60 again once it settles.
        rate: 60, 120 while abs(vel(pw)) + abs(vel(k_mid)) + abs(vel(k_rail)) + abs(vel(ldv)) + abs(vel(ws_position)) + abs(vel(rail_ws)) + abs(vel(bat_in)) + abs(vel(slosh)) + abs(vel(slosh2)) + abs(vel(k_cap)) > 0.5
        anchor: top
        margin: 5             // same line as waybar's capsules
        level: top            // like waybar: over windows, but a fullscreen video or game covers it (overlay would sit above fullscreen)
        reserve: 34           // windows tile below the resting pill (like waybar: 34 + the 5 px margin);
                              // the expanded card draws past this strip, over the windows
        keyboard: exclusive while pw_open or (expanded and (panel == clip or panel == launch or panel == emoji or panel == wall or panel == cap or panel == mix or panel == cam or panel == fnd or panel == timer or panel == awk or panel == mailx or panel == wa)) or pk.pending   // only while it is needed: a password, the clipboard, the launcher, the pickers
    }

    // ── palette (waybar/style.css, LUMEN v2) ─────────────────────
    //  The colours that follow the wallpaper (ink, the prism, the glass, the greys)
    //  come from theme.plm, written by theme/wallpaper-theme.py; the rest are fixed.
    include "theme.plm"
    let teal   = #6fd3ec      // cup-teal: lit only while media is live
    // Shared material: a clear capsule, with modest dimming for text-heavy cards.
    // These are material controls; the shader scales tint, smoke and milk separately.
    let card_alpha = 82%
    let glass_milk = 10%
    let card_smoke = 28%
    let amber  = #ffce6e
    let coral  = #ff7a8c
    let charge = #76ff58
    //  The controls inside the card: small pieces of solid glass, lit at the
    //  edge and lifted by a shadow; wells (fields, the stats) are pressed in.
    //  The island's light, softly: lilac and sunset mixed into the glass, not painted on it.
    let soft_l  = mix(pearl, lilac, 0.42)
    let soft_s  = mix(pearl, sunset, 0.38)
    let tint_ink = mix(ink, lilac, 0.45)
    let well    = #000000     // what is pressed in, at low opacity
    let rose    = #6a3442     // a control that removes something
    let rose_ink = #ffb3bd
    let link_c  = #6cb4ff     // a link, as iOS's blue reads on the dark glass
    //  WhatsApp's view in iMessage's own colours (not the island's tint: that follows a wallpaper).
    let im_blue  = #0a84ff    // iOS's system blue, dark: what is ours, what is unread, what sends
    let im_blue2 = #3a9bff    // …its lighter top, for the bubble's soft gradient
    let im_gray  = chip       // their bubbles, the field, the pills: the island's own neutral chips
    let im_gray2 = chip_hi    // …and what is chosen, or has the keys

    // ── springs: GLIDE as springs, no overshoot ──────────────────
    spring shape = 520, 45.6  // critically damped (2·√520): fast, no overshoot — hover has to feel instant

    // ── what the system reports, with no logic ───────────────────
    service clock { time: text = "--:--"; date: text }
    // ── the weather (Open-Meteo, fetched by the logic) ──
    fact wx_ok = false
    fact wx_ic = 4            // 0 sun · 1 moon · 2 cloud+sun · 3 cloud+moon · 4 cloud · 5 rain · 6 snow · 7 storm · 8 fog
    fact wx_sky = 0           // 0 clear day · 1 night · 2 grey day · 3 rain by day
    text wx_city = "Weather"
    measure wxtm              // how wide the temperature is: the place and the sky sit after it
    text wx_temp = "--"
    text wx_cond = "Loading…"
    text wx_hilo = ""
    model wxh max 6 { t: text; temp: text; ic: number }
    event wx_refresh ->
    // ── the widgets ──
    event cal_web ->          // Google Calendar, in the browser
    //  Batteries: what is connected and says how full it is (rings in the stats row)
    model bats max 2 { name: text; pct: number }
    //  News
    model news max 40 { title: text; meta: text }
    fact news_lang = 0        // 0 all · 1 French · 2 English
    text news_state = "Loading…"
    event news_open ->
    event news_filter ->
    //  Gmail (scripts/gmail.py, through the logic): the inbox, newest first…
    model mail max 40 { from: text; subj: text; ago: text; unread: bool }
    fact mail_ok = false
    fact mail_setup = false   // no address and app password yet
    fact mail_unread = 0
    text mail_state = "Loading…"
    event mail_open ->
    //  The inbox turns a page (four mails) a scroll, as iOS's pages do: one swipe of
    //  the trackpad, however long it coasts, is one page; `mtick` counts its events
    //  so the lock lets go once they have stopped.
    fact mpage = 0
    fact mlock = false
    fact mtick = 0
    event mail_arch ->
    event mail_do ->          // the reader's buttons: 0 reply · 1 unread · 2 archive · 3 bin · 4 in Gmail
    event mail_send ->
    //  …and the one open in the reader.
    text mr_from = ""
    text mr_addr = ""
    text mr_init = ""
    text mr_subj = ""
    text mr_when = ""
    //  Its body: a block a run of words (markdown: links are links), or a picture.
    //  A picture's cell is 520 × 480: drawn so the picture, fitted in it, fills its block exactly.
    model mrb max 48 { md: text; img: bool; pic: image 520, 480; iw: number; ih: number; linked: bool }
    event mail_img ->         // a picture that is a link, clicked
    //  …or, in the large view, the mail as Gmail shows it: Firefox's render, in tiles of 600, and its links' boxes.
    model mrt max 8 { pic: image 620, 602 }   // 600 a step, 2 more over the next: no seam where they meet
    model mrk max 150 { x: number; y: number; w: number; h: number }
    fact mr_has_web = false
    fact mr_web_h = 0
    fact mr_web_cut = false   // longer than the render goes: the rest is Gmail's
    fact mr_web_wait = false  // Firefox is still drawing it: a quiet page meanwhile
    //  Focused (l), it is drawn larger: the same render scaled, and its first tiles photographed finer.
    model mrtz max 4 { pic: image 1004, 975 }
    fact mr_zoom_ok = false
    //  …its GIFs that move, played over the photograph where each sits (a 400 cell: a mail's GIF at its own resolution).
    model mra max 8 { pic: image 400, 400; x: number; y: number; w: number; h: number; iw: number; ih: number }
    //  Shift+K / Shift+J zoom it, as a PDF viewer does; zoomed wider than the reader, h/l pan across it.
    fact mx_zoom = 1
    fact mx_pan = 0
    event mail_wlink ->
    fact mx_web = true        // v: Gmail's look, or the island's own reader
    fact mx_focus = false     // l: the keys move through the mail, not the list (h, Esc: back)
    fact mx_rail = false      // s: the inbox list folded away, the mail alone (it folds by itself while a tool is beside it)
    //  The large view (Super+U): which mail of the list is chosen, and its keys.
    fact mx_sel = 0
    fact mx_dd = false        // the first d of dd (or g of gg): it lapses if the second does not follow at once
    fact mx_gg = false
    //  Letting a mail go, as iOS does: binning asks first; a row slides away; a pill offers it back.
    fact mr_confirm = false   // "Move to Bin?" showing in the reader's header
    fact mx_leaving = -1      // the row sliding away (its index), for the moment before it is gone
    fact mail_undo = false    // the pill: "Moved to Bin · Undo"
    fact mail_undo_bin = false
    text mail_undo_t = ""
    event mail_undo_do ->
    event mail_big            // Super+U: the large view, open or closed
    event mailx_pick ->
    event mailx_move ->
    text mr_note = ""
    text mr_in = ""
    fact mr_loading = false
    fact mr_rep = false       // the reply field is open
    fact mr_sending = false
    fact mr_seq = 0           // another mail opened: its body back to the top

    //  WhatsApp (scripts/whatsapp, a linked device of the phone, through the logic): Super+W.
    //  The chats, pinned then newest…
    model wac max 16 { name: text; last: text; ago: text; unread: number; badge: text; muted: bool; pinned: bool; group: bool; init: text; pic: image 44, 44; typing: bool }
    //  …and the open one's messages, oldest first, with a row for each day between them.
    model wam max 120 { text: text; has_text: bool; me: bool; long: bool; from: text; has_from: bool; time: text; tail: bool; status: text; has_status: bool; day: bool; faint: bool; img: bool; sticker: bool; pic: image 280, 280; dw: number; dh: number; file: bool; has_q: bool; qfrom: text; qtext: text; full: text }
    fact wa_state: pair | qr | connecting | ok | offline = connecting
    fact wa_linked = true     // false while it has to be linked from the phone (the QR code)
    text wa_msg = ""
    text wa_qr_path = ""
    image wa_qr = from wa_qr_path, 236, 236
    fact wa_unread = 0
    text wa_list_t = "Loading…"
    fact wa_sel = 0           // the chat chosen in the list (from 0)
    fact wa_focus = false     // l: the keys scroll the chat, not the list (h, Esc: back)
    fact wa_typing = false    // the message field has the keys
    fact wa_search = false    // the search field has the keys
    fact wa_filtered = false  // …and something is written in it
    fact wa_gg = false
    fact wa_sending = false
    fact wa_seq = 0           // another chat opened: to its newest, at once
    fact wa_tail = 0          // one more message of theirs at the bottom of the open chat
    fact wa_mine = 0          // …or of ours (sent here or from the phone)
    text wa_find = ""
    text wa_in = ""
    text wa_name = ""
    fact wa_open = false      // a chat is open on the right
    fact wa_has_sub = false
    fact wa_has_in = false
    text wa_sub = ""
    text wa_init = ""
    text wa_pic_path = ""
    image wa_pic = from wa_pic_path, 36, 36
    fact wa_typing_in = false // the open chat's other side is writing
    event wa_big              // Super+W: the view, open or closed
    event wa_pick ->
    event wa_move ->
    event wa_send ->
    event wa_media ->         // a picture, video, voice note or file in the chat, pressed
    event wa_pair ->          // a new QR code
    event wa_find_clear ->
    event wa_wheel ->         // the wheel over the list: the logic moves its window
    event wa_older ->         // scrolled near the top of a chat
    fact wa_snap = false      // a chat opening: its rows take their heights at once, not on their springs
    fact wa_vim: insert | normal | visual = insert   // the message field's Vim mode
    //  The chat's cursor (l, then j/k), as Vim's on lines: the row it is on (-1: none), how far
    //  that row's top is from the bottom of the chat, and which way it last went (to step over days).
    fact wa_cur = -1
    fact wa_cy = 0
    fact wa_dir = 0
    fact wa_cnt = 0           // a count being typed: 5j, 3k, 12G
    fact wa_yy = false        // the first y of yy (z of zz)
    fact wa_zz = false
    fact wa_quote = false     // answering a message (r): it shows over the field
    text wa_q_from = ""
    text wa_q_text = ""
    event wa_k                // the cursor a row up / down (the logic sends one per step of a count)
    event wa_j
    event wa_last             // …to the newest (G) / the oldest drawn (gg)
    event wa_first
    event wa_center           // zz
    event wa_cmove ->         // j/k in the chat, with their count
    event wa_jump ->          // the list: 0 H · 1 M · 2 L · 3 n · 4 N · 5 zz
    event wa_yank ->          // yy: the message under the cursor, copied
    event wa_open ->          // o: its picture, file or link, opened
    event wa_reply ->         // r: answering it
    event wa_quote_clear ->
    fact wa_off = 0           // the first chat in sight
    fact wa_first = 0         // …and the first the list's records hold (a few above it, to glide over)
    fact wa_total = 0         // how many chats the list goes through
    fact wa_hov = -1          // the picture under the pointer (its row), for Space
    fact wa_ql = false        // Space: a picture large over the chat, as macOS's Quick Look
    fact wa_qlw = 400         // …its size, fitted into 992 × 600
    fact wa_qlh = 300
    text wa_ql_path = ""
    text wa_ql_cap = ""
    image wa_ql_img = from wa_ql_path, 1984, 1200
    event wa_look ->          // Space on a picture (under the cursor, or the pointer)
    fact wa_att = false       // files waiting over the field (pasted, dropped): Enter sends them, the words as their caption
    fact wa_att_kind = 0      // …the first one: 0 a picture, 1 a video, 2 a song or voice note, 3 any other file
    text wa_att_name = ""
    text wa_att_sub = ""
    text wa_att_path = ""
    image wa_att_pic = from wa_att_path, 44, 44
    event wa_paste ->         // Ctrl+V with no words on the clipboard (a picture, files): the logic takes it
    event wa_att_clear ->
    event wa_prefetch ->      // the pointer over a picture or file: fetched whole, ready to open or drag out
    service media { playing: bool; title: text; artist: text; position: number; length: number; rate: number = 1 }
    service battery { present: bool; percent: number = 100; charging: bool }
    service audio { volume: number; muted: bool }
    service brightness as backlight { present: bool; level: number }

    // ── what the logic reports ───────────────────────────────────
    text cover_path = ""
    fact has_art = false
    //  The artwork's colour (the logic picks it), for the waveform; teal without one.
    fact art_r: number = 0.435
    fact art_g: number = 0.827
    fact art_b: number = 0.925
    fact art_tinted = false
    fact art_aspect: number = 1   // the artwork's width over its height: 1 an album's, 1.78 a video's
    fact has_player = false   // any MPRIS player at all (the logic knows; texts don't compare)
    //  Wide, so a video's 16:9 frame fills it and square album art sits in its middle:
    //  either way the squircle it is clipped to is filled, never letterboxed.
    image cover = from cover_path, 86, 48
    image ic_out = file "icons/logout.svg", 18, 18
    image ic_re = file "icons/restart.svg", 18, 18
    image ic_off = file "icons/power.svg", 18, 18
    image ic_search = file "icons/search.svg", 14, 14
    image ic_x = file "icons/xmark.svg", 12, 12
    image ic_trash = file "icons/trash.svg", 15, 15
    image ic_doc = file "icons/doc.svg", 24, 24
    image ic_folder = file "icons/folder.svg", 24, 24
    image ic_chev = file "icons/chevron.svg", 14, 14
    image ic_bell = file "icons/bell.svg", 14, 14
    image ic_moon = file "icons/moon.svg", 14, 14
    image ic_plug = file "icons/plug.svg", 13, 13   // plugged in: a power plug (the user's choice; iOS itself draws a bolt while charging)
    image ic_grid = file "icons/grid.svg", 14, 14
    image ic_photo = file "icons/photo.svg", 14, 14
    image ic_smile = file "icons/smile.svg", 14, 14
    image ic_windows = file "icons/windows.svg", 14, 14
    image ic_shot = file "icons/shot.svg", 14, 14
    image ic_rec = file "icons/record.svg", 14, 14
    image ic_stop = file "icons/stop.svg", 14, 14
    image ic_picker = file "icons/picker.svg", 14, 14
    image ic_mixer = file "icons/mixer.svg", 14, 14
    image ic_night = file "icons/night.svg", 14, 14
    image ic_awake = file "icons/awake.svg", 14, 14
    image ic_leaf = file "icons/leaf.svg", 14, 14
    image ic_gauge = file "icons/gauge.svg", 14, 14
    image ic_rocket = file "icons/rocket.svg", 14, 14
    image ic_lock = file "icons/lock.svg", 18, 18
    //  Weather symbols, in their own colours as iOS draws them (not tinted).
    image wx_sun = file "icons/wx-sun.svg", 30, 30
    image wx_moon = file "icons/wx-moon.svg", 30, 30
    image wx_csun = file "icons/wx-cloud-sun.svg", 30, 30
    image wx_cmoon = file "icons/wx-cloud-moon.svg", 30, 30
    image wx_cloud = file "icons/wx-cloud.svg", 30, 30
    image wx_rain = file "icons/wx-rain.svg", 30, 30
    image wx_snow = file "icons/wx-snow.svg", 30, 30
    image wx_storm = file "icons/wx-storm.svg", 30, 30
    image wx_fog = file "icons/wx-fog.svg", 30, 30
    image ic_cal = file "icons/calendar.svg", 15, 15
    image ic_news = file "icons/news.svg", 15, 15
    image ic_mail = file "icons/mail.svg", 15, 15
    image ic_chat = file "icons/chat.svg", 15, 15
    image ic_up = file "icons/arrow-up.svg", 14, 14
    image ic_pin = file "icons/pin.svg", 11, 11
    image ic_bellx = file "icons/bell-slash.svg", 11, 11
    image ic_reply = file "icons/reply.svg", 15, 15
    image ic_unread = file "icons/unread.svg", 15, 15
    image ic_archive = file "icons/archive.svg", 15, 15
    image ic_archive_s = file "icons/archive.svg", 12, 12
    image ic_trash_s = file "icons/trash.svg", 14, 14
    image ic_ext = file "icons/external.svg", 15, 15
    image ic_send = file "icons/send.svg", 14, 14
    //  The Controls page's buttons: the same symbols, drawn larger.
    image cc_grid = file "icons/grid.svg", 20, 20
    image cc_clip = file "icons/clip.svg", 20, 20
    image cc_smile = file "icons/smile.svg", 20, 20
    image cc_photo = file "icons/photo.svg", 20, 20
    image cc_shot = file "icons/shot.svg", 20, 20
    image cc_rec = file "icons/record.svg", 20, 20
    image cc_stop = file "icons/stop.svg", 20, 20
    image cc_picker = file "icons/picker.svg", 20, 20
    image cc_mixer = file "icons/mixer.svg", 20, 20
    image cc_moon = file "icons/moon.svg", 20, 20
    image cc_night = file "icons/night.svg", 20, 20
    image cc_awake = file "icons/awake.svg", 20, 20
    image cc_leaf = file "icons/leaf.svg", 20, 20
    image cc_gauge = file "icons/gauge.svg", 20, 20
    image cc_rocket = file "icons/rocket.svg", 20, 20
    image cc_timer = file "icons/timer.svg", 20, 20
    image cc_watch = file "icons/stopwatch.svg", 20, 20
    image cc_camera = file "icons/camera.svg", 20, 20
    image cc_folder = file "icons/folder.svg", 20, 20
    image cc_switch = file "icons/switch.svg", 20, 20
    image ic_cam_l = file "icons/camera.svg", 20, 20
    image ic_folder_s = file "icons/folder.svg", 16, 16
    image fi_folder = file "icons/folder.svg", 18, 18
    image fi_doc = file "icons/doc.svg", 18, 18
    image fi_photo = file "icons/photo.svg", 18, 18
    image fi_film = file "icons/film.svg", 18, 18
    image fi_code = file "icons/code.svg", 18, 18
    image ic_timer = file "icons/timer.svg", 14, 14
    image ic_watch = file "icons/stopwatch.svg", 14, 14
    image dv_head = file "icons/headphones.svg", 18, 18
    image dv_mouse = file "icons/mouse.svg", 18, 18
    image dv_keys = file "icons/keyboard.svg", 18, 18
    image dv_phone = file "icons/phone.svg", 18, 18
    image dv_other = file "icons/btdev.svg", 18, 18
    image ic_speaker_s = file "icons/speaker.svg", 14, 14
    image ic_mute_s = file "icons/muted.svg", 14, 14
    image ic_shot_l = file "icons/shot.svg", 20, 20
    image ic_rec_l = file "icons/record.svg", 20, 20
    image ic_windows_l = file "icons/windows.svg", 20, 20
    image ic_clip = file "icons/clip.svg", 14, 14
    image ic_check = file "icons/check.svg", 10, 10
    image ic_spk = file "icons/speaker.svg", 18, 18
    image ic_mute = file "icons/muted.svg", 16, 16
    image ic_mute_cut = file "icons/muted-cut.svg", 16, 16
    image ic_w1 = file "icons/wave1.svg", 18, 18
    image ic_w2 = file "icons/wave2.svg", 18, 18
    image ic_w3 = file "icons/wave3.svg", 18, 18
    image ic_note = file "icons/note.svg", 14, 14
    repeat i in 1..11 {
        fact ws.$i.there = false
    }
    fact ws_active = 1
    fact ws_count = 1
    fact ws_slot = 0          // active position in the visible rail, not desktop ID
    fact ws_vertical = false  // the compositor slides workspaces up and down (niri)
    fact cpu = 0              // %
    fact mem = 0              // GiB used
    fact mem_frac = 0         // 0..1

    event toggle ->
    event seek_to ->           // seconds from the start of the song
    event next ->
    event previous ->
    event go ->
    event ws_step ->
    event vol_step ->
    event mixer ->
    event log_out ->
    event restart ->
    event power_off ->

    // ── Wi-Fi and Bluetooth: the logic fills these (island.luau) ─
    //  Rows say which one by their position; the logic keeps the rest
    //  (an address, the real name) in the same record, out of the scene's sight.
    model nets max 16 { ssid: text; sig: number; secure: bool; known: bool; active: bool; busy: bool; asking: bool; menu: bool; wrong: bool }
    model devs max 16 { name: text; icon: image 20, 20; status: text; battery: number = -1; connected: bool; busy: bool; menu: bool; caption: number }
    fact wifi_on = false
    fact bt_on = false
    fact scanning = false     // a Wi-Fi scan the logic asked for is under way
    fact bt_scanning = false
    fact busy_any = false     // something is connecting: the spinners turn
    fact pw_open = false      // a password is being asked for
    fact pw_bad = false       // and the last one was wrong
    fact pw_wrongs = 0        // how many times: each one shakes the field
    text wifi_label = "…"
    text bt_label = "…"
    text pw_for = ""
    text pass = ""
    event wifi_pick ->
    event wifi_join ->
    event wifi_cancel ->
    event wifi_disconnect ->
    event wifi_forget ->
    event wifi_power ->
    event wifi_scan ->
    event bt_pick ->
    event bt_forget ->
    event bt_power ->
    event bt_menu ->
    event wifi_menu ->
    event open_wifi

    // ── the clipboard: the logic hands over only the rows in sight ──
    model clips max 12 { kind: number; text: text; thumb: image 96, 54; ago: text; sel: bool; dims: text }
    event clip_hover ->        // a row under the pointer (its index), or -1 off the list
    //  The chosen one, large: 1 a text, 2 a picture.
    fact cpv_kind = 0
    text cpv_text = ""
    text cpv_meta = ""
    text cpv_img_path = ""
    image cpv_img = from cpv_img_path, 324, 320
    fact cpv_iw = 464
    fact cpv_ih = 260
    fact clip_total = 0       // how many match the search
    fact clip_off = 0         // which of them is the first in sight
    fact clip_q_empty = true
    fact clip_insert = false  // vim: searching (insert) or moving through the list (normal)
    fact clip_dd = false      // a first `d` (or `g`) waiting for its second
    fact clip_gg = false
    text clip_q = ""
    event clip_open           // Super+C: `lumen --say island "emit clip_open"`
    fact side = false         // a tool open from the right capsule, beside a large view (WhatsApp, the mail, the files)
    fact side_k = 0           // …which: 1 the clipboard, 2 the emoji, 3 the files (kept while it closes; 0 once the calendar has it)
    fact wa_rail = false      // s: WhatsApp's chat list folded into a strip of faces (it folds by itself while a tool is beside it)
    fact side_focus = true    // …and it has the keys (Ctrl+h gives them to the view on the left, Ctrl+l back)
    event fnd_to_view ->      // Ctrl+Shift+H: the finder's file(s) handed to the view beside it (WhatsApp)
    event clip_pick_row ->
    event clip_del_row ->
    event clip_scroll ->
    event clip_clear ->
    event clip_move ->
    event clip_pick ->
    event clip_del ->
    event clip_q_clear ->

    // ── the launcher: apps, or files after a leading space ──
    model hits max 5 { kind: number; name: text; sub: text; has_sub: bool; icon: image 28, 28; sel: bool }
    fact launch_total = 0
    fact launch_off = 0
    fact launch_q_empty = true
    fact files_mode = false
    fact launch_state = 0     // 0 nothing to say, 1 nothing found, 2 looking
    text launch_q = ""
    text launch_where = "Files"
    event launch_open         // Super+D: `lumen --say island "emit launch_open"`
    event launch_move ->
    event launch_pick ->
    event launch_pick_row ->
    event launch_scroll ->
    event launch_into ->
    event launch_up ->

    // ── notifications: the pill grows into a banner; the card keeps the rest ──
    fact banner = false       // a banner is showing
    fact banner_seq = 0       // one more each time a new one arrives
    text n_app = ""
    text n_title = ""
    text n_body = ""
    text n_pic_path = ""
    image n_pic = from n_pic_path, 44, 44
    fact n_is_pic = false     // the sender's picture, not the app's icon
    fact n_urgent = false
    model nacts max 3 { label: text }
    measure n_bm
    fact n_count = 0
    model notes max 4 { app: text; title: text; body: text; pic: image 40, 40; is_pic: bool; urgent: bool; ago: text }
    event note_open ->
    event note_dismiss ->
    event note_act ->
    event note_open_row ->
    event note_del_row ->
    event notes_clear ->
    event notes_scroll ->
    event open_notes
    fact n_more = 0           // how many more arrived while this banner showed
    fact dnd = false          // muted: no banners (urgent ones still come), all still listed
    event dnd_toggle ->

    // ── the tray: apps' status icons on the bar, a glass menu on right-click ──
    model trayi max 4 { icon: image 16, 16; title: text }
    fact tm_slot = 0          // which tray icon the menu belongs to
    fact tm_rows_h = 0        // its rows' height (a separator is thin)
    model trows max 10 { label: text; separator: bool; enabled: bool = true; checked: number = -1; children: number; back: bool }
    fact tmenu_open = false
    fact tray_cool = false    // a tray icon was just clicked: the next 450 ms are the same click
    on still tray_cool for 450ms while tray_cool { tray_cool = false }
    event tray_activate ->
    event tray_menu ->
    event tray_choose ->

    // ── emoji: the logic hands over the 32 in sight ──
    model emo max 56 { e: text; name: text; sel: bool }
    fact emo_q_empty = true
    fact emo_insert = false   // vim: searching (insert) or moving through the grid (normal)
    fact emo_gg = false       // a first `g` waiting for its second
    event emo_q_clear ->
    event emo_cat_step ->     // [ ] : the category before or after the one in sight
    fact emo_cat_at = -1      // which category the rows in sight belong to (-1: recent)
    text emo_q = ""
    text emo_name = ""
    event emoji_open          // Super+E: `lumen --say island "emit emoji_open"`
    event emo_move ->
    event emo_pick ->
    event emo_pick_cell ->
    event emo_scroll ->
    event emo_cat ->

    // ── wallpapers: the logic hands over the nine in sight ──
    model walls max 9 { thumb: image 112, 70; name: text; sel: bool; cur: bool }
    fact wall_total = 0
    text wall_name = ""
    event wall_open           // Super+P: `lumen --say island "emit wall_open"`
    event wall_move ->
    event wall_pick ->
    event wall_pick_cell ->
    event wall_scroll ->

    // ── the window switcher: Alt+Tab (Hyprland's binds), or the header's bead ──
    model wins max 6 { picture: image 156, 88; icon: image 16, 16; has_icon: bool; title: text; app: text; ws: text; sel: bool; has_pic: bool }
    fact wins_total = 0
    event win_open            // `emit win_open 1` steps forward (Alt+Tab), -1 back; 0 just opens
    event win_commit          // Alt let go: focus the chosen one
    event win_cancel
    event win_step ->
    event win_pick ->
    event win_pick_cell ->
    event win_scroll ->
    event win_close_cell ->   // the × on a window's picture
    event win_look ->
    fact switching = false    // opened by Alt+Tab: letting go of Alt picks
    fact wv = false           // the left capsule grown into the window viewer

    // ── capture: screenshots and recordings ──
    fact cap_rec = false      // the page's mode: a screenshot or a recording
    fact cap_save = true      // screenshots also go to ~/Pictures/Screenshots
    fact recording = false
    text rec_time = "0:00"
    event cap_take ->         // which: 0 region, 1 window, 2 screen
    event rec_stop ->
    event shot_open
    event rec_open

    // ── the mixer: where it plays, and each application's volume ──
    model outs max 3 { name: text; on: bool }
    model mixapps max 3 { name: text; title: text; volume: number; muted: bool; icon: image 16, 16 }
    fact mix_more = 0         // apps beyond the three in sight (the wheel scrolls them)
    event mix_scroll ->
    event mix_out ->
    event mix_set ->
    event mix_mute ->
    event mix_master ->

    // ── the colour picker: the pill shows what it picked ──
    fact picked = false
    fact pk_seq = 0
    fact pk_r = 1
    fact pk_g = 1
    fact pk_b = 1
    text pk_hex = ""
    event pick_color ->
    event open_mix

    // ── a copy: the pill widens for a moment to show what was copied ──
    fact copied = false
    fact cp_seq = 0
    fact cp_kind = 0          // 0 text, 1 image, 2 text read off the screen (OCR), 3 OCR found nothing
    text cp_text = ""
    text cp_thumb_path = ""
    image cp_thumb = from cp_thumb_path, 48, 27
    //  A copied picture: the pill grows down over the windows into a card
    //  shaped like it (fitted in 300 × 170), so you can make out what it was.
    text cp_img_path = ""
    image cp_big = from cp_img_path, 300, 170
    fact cp_iw = 300          // the picture, fitted
    fact cp_ih = 170
    text cp_dims = ""
    measure cpm
    fact low_seq = 0          // one more each time the battery crosses 20 % or 10 %
    event copy_kind ->        // ocr-sel: `emit copy_kind 1` before it copies, `2` when it found nothing

    // ── the focused app: its icon right of the workspaces (waybar's front app) ──
    //  Two slots, so a change can crossfade: the new icon goes in the hidden one.
    text front_a = ""
    text front_b = ""
    text front_name = ""
    fact front_has = false
    fact front_on_b = false   // which slot shows the app in focus
    image front_ia = from front_a, 18, 18
    image front_ib = from front_b, 18, 18
    measure frm

    // ── a device connects: the pill shows it, with its battery (AirPods-style) ──
    fact dev_on = false
    fact dv_seq = 0
    fact dv_glyph = 0         // 0 headphones, 1 mouse, 2 keyboard, 3 phone, 4 anything else
    fact dv_bat = -1          // 0..1, or -1 when it doesn't say
    text dv_name = ""
    measure dvm

    // ── landing on another desktop (niri): its name, and the apps on it ──
    fact ld_on = false
    fact ld_seq = 0
    fact ld_n = 0             // app icons to show, most recently used first (at most four)
    text ld_name = ""
    text ld_a1 = ""
    text ld_a2 = ""
    text ld_a3 = ""
    text ld_a4 = ""
    image ld_i1 = from ld_a1, 20, 20
    image ld_i2 = from ld_a2, 20, 20
    image ld_i3 = from ld_a3, 20, 20
    image ld_i4 = from ld_a4, 20, 20
    measure ldm

    // ── a timer or a stopwatch: a Live Activity beside the island ──
    fact tmr_on = false       // running (or paused)
    fact tmr_paused = false
    fact tmr_mode: timer | watch = timer
    fact tmr_frac = 1         // a timer's part still to go
    text tmr_text = "0:00"
    text tmr_total = ""
    measure tbm
    event tmr_start ->        // a timer of so many seconds
    event watch_start ->
    event tmr_pause ->        // pause or resume
    event tmr_cancel ->
    event tmr_add ->          // seconds more
    event open_timer
    event open_watch

    // ── the camera: lumen's own (a live viewfinder, photos, videos) ──
    service camera as cam { present: bool; on: bool; picture: text; recording: bool; last: text; error: text }
    image cam_view = from cam.picture, 896, 504
    text cam_last_photo = ""
    image cam_last = from cam_last_photo, 71, 40
    text cam_rec_time = "0:00"
    fact cam_video = false
    fact cam_shots = 0        // one more each photo: the thumbnail pops
    fact cam_has_last = false
    event open_cam
    event cam_photo ->
    event cam_record ->
    event cam_record_stop ->
    event cam_open_last ->
    event cam_open_dir ->

    // ── files: a quick finder, ranked by what is opened often and lately ──
    //  A row: its icon (WhiteSur's, by type), its name, where it is (a search) or its size and age (a folder).
    model fhits max 16 { name: text; sub: text; kind: number; sel: bool; pin: number; mark: bool; cut: bool; ic: image 26, 26; date: text; size: text; icl: image 52, 52; drag: text }
    fact pvd_list = false     // a folder's preview lists its contents instead of showing icons: V, or the preview's switch
    event fnd_view_as ->      // 0 a list · 1 icons · −1 the other one
    event fnd_back ->         // H: the folder before (history)
    event fnd_forward ->      // L: and forward again
    //  Where you are: Files, then each folder down to this one (the last is here).
    model fcrumbs max 4 { name: text; last: bool }
    event fnd_crumb ->
    fact fnd_listing = false  // inside a folder, not searching: single-line rows, twelve of them
    //  A folder's preview: what is in it, as icons (folders first), and how many more than show.
    model pvd max 24 { name: text; dir: bool; ic: image 52, 52 }
    fact pvd_more = 0
    fact fq_empty = true
    fact fnd_insert = false
    fact fnd_gg = false
    fact fnd_scoped = false   // inside a folder (stepped into), not the whole list
    text fq = ""
    text fnd_title = "Files"
    fact pv_kind = 0          // 0 nothing, 1 text, 2 picture, 3 a list (archive), 4 no preview, 5 the keys, 6 prose, 7 a folder (icons)
    text pv_name = ""
    text pv_meta = ""
    text pv_text = ""
    text pv_img_path = ""
    image pv_img = from pv_img_path, 1248, 800   // twice what it is drawn at whole: room to zoom in sharp
    fact fnd_view = false     // looking closer at the preview (v, or a click): its keys move and zoom it
    fact pv_z = 1             // its zoom: 1 is all of it in view
    fact pv_px = 0            // …and how far it is moved, from the middle
    fact pv_py = 0
    text pv_zoom = "100%"
    event pv_zoom ->          // by that factor
    event pv_fit ->           // 0: all of it
    event pv_width ->         // w: as wide as the panel
    event pv_pan_x ->
    event pv_pan_y ->
    event pv_end ->           // gg (1) · G (-1)
    event pv_grab ->
    event pv_drag_x ->
    event pv_drag_y ->
    fact pv_iw = 312
    fact pv_cs = 1            // how much the preview's 624×400 canvas is scaled so the picture in it fills its frame exactly
    fact pv_ih = 200
    event find_open           // Super+R: `lumen --say island "emit find_open"`
    event fnd_move ->
    event fnd_open ->
    event fnd_open_row ->
    event fnd_up ->
    event fnd_thunar ->
    event fnd_scroll ->
    event fq_clear ->
    event fnd_pin ->          // m: pin or unpin (the pinned stay on top, numbered)
    event fnd_jump ->         // 1–4: open that pin
    event fnd_yank ->         // yp: the path, to the clipboard
    event fnd_yank_dir ->     // yd: the folder's path
    event fnd_tmux ->         // t: the folder as a tmux session (sesh), on the terminal's workspace
    event fnd_term ->         // T: a new terminal window there
    event fnd_edit ->         // e: in Neovim, whatever it is
    event fnd_mark ->         // Space: mark for a batch (copy, cut, trash)
    event fnd_unmark ->
    event fnd_copy ->         // yy
    event fnd_cut ->          // dd
    event fnd_paste ->        // p: into the folder showing
    event fnd_trash ->        // dD: to the trash (it can be restored from there)
    event fnd_rename ->       // r
    event fnd_new ->          // a: a file (0); A: a folder (1)
    event fnd_prompt_ok ->
    event fnd_sort ->         // s: name → modified → size → type; S: reversed
    event fnd_hidden ->       // .: hidden files, shown or not
    event fnd_top ->          // ~: back to the whole list
    event fnd_help ->         // ?
    fact fnd_marks = 0        // how many are marked
    fact fnd_help_on = false  // the key list shows in the preview
    fact fnd_prompting = false
    fact fnd_y = false        // a first `y` (or `d`) waiting for its second
    fact fnd_d = false
    fact fnd_toast_on = false
    fact fnd_toast_seq = 0
    text fnd_toast = ""
    text fnd_sort = "Name ↑"
    text fnd_in = ""
    text fnd_prompt_label = "Rename"
    text fnd_help_text = ""
    measure srtm
    measure prlm

    // ── toggles ──
    fact night = false
    fact awake = false
    fact profile: saver | balanced | performance = balanced
    event night_toggle ->
    event awake_toggle ->
    //  Switching compositor (Hyprland <-> niri, scripts/switch-wm.sh): the bead left
    //  of Log out, held (every window closes and comes back).
    event wm_switch ->
    event awake_tap           // the Keep Awake button: off → choose how long; on → end it
    event awake_for ->        // minutes (0: until turned off)
    text awake_left = "On"    // what the button says while it runs: "1:42 left"
    //  The dial (Timer, Keep Awake): where its knob is (0..1), which step that is, and what it says.
    fact dial_f: number = 0.2
    fact dial_idx = 0
    text dial_label = "5 min"
    text dial_sub = "Let go to start"
    event dial_move ->
    event dial_go ->
    event dial_step ->
    event profile_next ->

    // ── privacy: what is listening or watching ──
    fact mic_on = false
    fact cam_on = false
    fact scr_on = false

    // ── polkit: the island is the session's password prompt ──
    service polkit as pk {
        pending: bool
        asking: bool
        message: text
        user: text
        prompt: text
        info: text
        error: none | wrong
    }
    text answer = ""
    event pk_send ->
    event pk_cancel ->

    event open_bt
    event go_home

    // ── holding AltGr peeks at the card: `emit peek 1` on press, `peek 0` on release ──
    //  (reserved for this: nothing else uses the key)
    event peek
    fact peek_held = false
    fact peeking = false      // the card is open because the key is held

    // ── volume and brightness: the pill becomes the gauge (pages/osd.plm) ──
    fact osd = false
    fact osd_kind: vol | bright | kbd = vol
    fact osd_seq = 0          // one more each change: the gauge stays while they keep coming
    fact osd_ready = false    // the logic says so once the services have spoken: no gauge at login
    fact bright = 0.5         // the screen, as the keys say it (the service only looks every 0.7 s)
    event vol_key             // the volume keys: `lumen --say island "emit vol_key 1"` (−1 down)
    event bright_up           // brightness.sh, with the new percent
    event bright_down
    fact kbd = 0              // the keyboard's backlight, as kbd-backlight.sh says it
    event kbd_up              // kbd-backlight.sh, with the new percent
    event kbd_down
    event kbd_step ->
    event osd_set ->
    event osd_mute ->
    event bright_step ->

    // ── state ────────────────────────────────────────────────────
    fact expanded = false
    fact hold_h: number = 0    // see `hit`: how far down the card still counts as under the pointer
    fact hold_w: number = 0    // …and how wide, when a press narrows it (the mail reader back to the inbox)
    //  Which face the open card shows: the home one, or a page that slides in over it.
    fact panel: home | ctl | timer | cam | fnd | awk | wifi | bt | clip | launch | notes | emoji | wall | cap | mix | auth | mailx | wa = home
    prop on_home = 1 ~280ms
    prop on_wifi = 0 ~280ms
    prop on_bt = 0 ~280ms
    follow on_home = if(panel == home, 1, 0)
    follow on_wifi = if(panel == wifi, 1, 0)
    follow on_bt = if(panel == bt, 1, 0)
    prop on_clip = 0 ~280ms
    follow on_clip = if(panel == clip or (side and side_k == 1), 1, 0)
    prop on_launch = 0 ~280ms
    follow on_launch = if(panel == launch, 1, 0)
    prop on_notes = 0 ~280ms
    follow on_notes = if(panel == notes, 1, 0)
    prop on_mailx = 0 ~280ms
    follow on_mailx = if(panel == mailx, 1, 0)
    prop on_wa = 0 ~280ms
    follow on_wa = if(panel == wa, 1, 0)
    prop on_emoji = 0 ~280ms
    follow on_emoji = if(panel == emoji or (side and side_k == 2), 1, 0)
    prop on_wall = 0 ~280ms
    follow on_wall = if(panel == wall, 1, 0)
    prop on_cap = 0 ~280ms
    follow on_cap = if(panel == cap, 1, 0)
    prop on_mix = 0 ~280ms
    follow on_mix = if(panel == mix, 1, 0)
    prop on_ctl = 0 ~300ms
    prop on_timer = 0 ~280ms
    prop on_cam = 0 ~280ms
    prop on_fnd = 0 ~280ms
    prop on_awk = 0 ~280ms
    follow on_awk = if(panel == awk, 1, 0)
    follow on_fnd = if(panel == fnd or (side and side_k == 3), 1, 0)
    follow on_cam = if(panel == cam, 1, 0)
    follow on_timer = if(panel == timer, 1, 0)
    prop dvv = 0 ~360ms
    follow dvv = if(dev_on and not expanded and not osd and not picked and not copied, 1, 0)
    //  [16][glyph 18][10][name][14][ring 22][6][84%][16]
    prop ldv = 0 ~360ms
    follow ldv = if(ld_on and not expanded and not osd and not picked and not copied and not dev_on and not banner, 1, 0)
    //  [16][icons, 15 apart, 20 wide][10][name][14][the time][16]
    let ld_iw = if(ld_n > 0, 20 + 15 * (ld_n - 1) + 10, 0)
    let ld_w = 16 + ld_iw + min(ldm.width, 200) + 14 + clockm.width + 16
    let dv_w = 16 + 18 + 10 + min(dvm.width, 180) + if(dv_bat >= 0, 14 + 22 + 6 + 32, 0) + 16
    follow on_ctl = if(panel == ctl, 1, 0)
    prop on_auth = 0 ~280ms
    follow on_auth = if(panel == auth, 1, 0)
    //  The colour picker's answer: the pill widens into a swatch and its code.
    prop pkv = 0 ~360ms
    follow pkv = if(picked and not expanded, 1, 0)
    prop cpv = 0 ~360ms
    follow cpv = if(copied and not expanded and not osd and not picked, 1, 0)
    //  [16][thumb 44 or icon 16][10][text, at most 230][12]["Copied"][16]
    let cp_lead = 16
    let cp_w = 16 + cp_lead + 10 + min(cpm.width, 230) + 12 + 46 + 16
    //  A picture's card: as wide as it (never narrower than its caption row), as tall as it plus the row.
    let cpi = cpv * if(cp_kind == 1, 1, 0)
    let cpb_w = max(250, cp_iw + 24)
    let cpb_h = 38 + cp_ih + 12
    let cp_tw = if(cp_kind == 1, cpb_w, cp_w)
    let cp_th = if(cp_kind == 1, cpb_h, 34)
    //  The banner: 0 the pill, 1 the pill grown into a notification.
    prop ban = 0 ~380ms
    follow ban = if(banner and not expanded and not osd and not picked and not copied and not dev_on, 1, 0)
    //  The level gauge: 0 the pill, 1 the pill grown into it.
    //  How far the pill has gone into its dark, smoked glass: the card and banners are.
    let dark = max(max(open, ban), cpi)
    prop os = 0 ~360ms
    follow os = if(osd and not expanded, 1, 0)
    prop lv = 0 ~240ms        // the level shown: it pours rather than jumps
    follow lv = clamp(if(osd_kind == vol, audio.volume, if(osd_kind == bright, bright, kbd)), 0, 1)
    prop trail = 0 ~700ms     // …and where it was, catching up slowly
    follow trail = clamp(if(osd_kind == vol, audio.volume, if(osd_kind == bright, bright, kbd)), 0, 1)
    prop mu = 0 ~260ms
    follow mu = if(osd_kind == vol and audio.muted, 1, 0)
    spring band = 420, 41     // critically damped: a kick out and straight back
    prop thump = 0 ~band
    prop swell = 0 ~band
    //  Flicking the banner up: it follows the finger (and goes on letting go past 28 px).
    prop bdrag = 0 ~180ms
    prop nswap = 1 ~260ms      // 0→1 each time a new one takes the banner
    let bpull = min(0, bdrag)
    //  Others behind it: thin layers of glass peeking out under it.
    prop stack = 0 ~300ms
    follow stack = if(banner and not expanded, min(n_more, 2), 0)
    prop dnd_s = 0 ~260ms
    follow dnd_s = if(dnd, 1, 0)
    let dnd_w = 20 * dnd_s
    prop pw_in = 0 ~260ms
    follow pw_in = if(pw_open, 1, 0)
    prop shake = 0 ~spring(520, 14)   // a wrong password: a short, settling shake
    prop turn = 0 ~300ms              // the spinners, a third of a turn a step

    measure clockm
    measure datem

    //  Muted: a speaker settles into the battery capsule and a slash cuts through it.
    prop mut = 0 ~460ms
    follow mut = if(audio.muted, 1, 0)
    let mute_w = 24 * mut
    //  The slash draws in the second half, opening its gap in the speaker as it goes.
    let slash = smooth(0.4, 1, mut)

    prop open  = 0 ~250ms     // 0 pill → 1 card
    prop live  = 0 ~420ms     // 0 clock only → 1 now-playing pill
    prop bloom = 0 ~420ms     // hover: the rim ignites
    prop media_in = 0 ~420ms  // the card's media row, there or not
    prop pw = 160 ~shape
    prop ph = 34  ~shape
    prop pr = 17  ~shape

    follow open  = if(expanded, 1, 0)
    follow live  = if(media.playing, 1, 0)
    follow bloom = hit.hover
    follow media_in = if(has_player, 1, 0)


    // A persistent numbered rail makes occupied desktops readable at a glance.
    // Reserve its full width even while layout springs settle.
    let pad = 16
    let rail_w = (14 + 8 * rh) * max(1, ws_count) + 24
    //  …and as it is drawn: a desktop coming or going slides what follows on the
    //  rail's own spring, not in one frame.
    prop rail_ws = 1 ~calm
    follow rail_ws = max(1, ws_count)
    //  The island holds only the time (and what is playing); the rest is the bar's.
    // ── what is playing: as the Dynamic Island shows it, compact ───
    //  The artwork leading, a live waveform trailing, the time between: no
    //  title, no progress (those are the card's, a hover away). Paused, the
    //  bars settle into dots and it stays two minutes, then leaves.
    prop mus_p = 0 ~460ms
    follow mus_p = if(media.playing and has_player, 1, 0)
    prop mus_keep = 0 ~460ms
    prop wb0 = 0
    prop wb1 = 0
    prop wb2 = 0
    prop wb3 = 0
    prop wb4 = 0
    wave wb0 = 3.6 * amp at 6.3
    wave wb1 = 4.4 * amp at 8.9
    wave wb2 = 3.8 * amp at 7.4
    wave wb3 = 4.6 * amp at 10.1
    wave wb4 = 3.4 * amp at 5.7
    //  A second rhythm under each bar, at unrelated speeds: uneven, like music.
    prop wc0 = 0
    prop wc1 = 0
    prop wc2 = 0
    prop wc3 = 0
    prop wc4 = 0
    wave wc0 = 2.2 * amp at 13.7
    wave wc1 = 1.8 * amp at 3.9
    wave wc2 = 2.6 * amp at 15.3
    wave wc3 = 1.6 * amp at 4.6
    wave wc4 = 2.4 * amp at 12.2
    on change media.playing while media.playing { mus_keep: 1 }
    on change media.playing while not media.playing { mus_keep: 0 after 120000ms }
    let mus = max(mus_p, mus_keep * if(has_player, 1, 0))
    prop amp = 0 ~520ms                       // the bars' life: dots while paused
    follow amp = if(media.playing, 1, 0)
    let mm = smooth(0, 1, mus)
    //  The bars take the artwork's colour, eased from one song's to the next.
    prop art_cr = 0.435 ~600ms
    prop art_cg = 0.827 ~600ms
    prop art_cb = 0.925 ~600ms
    follow art_cr = art_r
    follow art_cg = art_g
    follow art_cb = art_b
    prop tint_k = 0 ~500ms
    follow tint_k = if(art_tinted and has_art, 1, 0)
    let bar_c = mix(teal, mix(rgb(art_cr, art_cg, art_cb), pearl, 0.18), tint_k)
    //  A new song: the artwork gives a small pop, as the island acknowledges it.
    prop artpop = 0 ~spring(420, 24)
    on change media.length while media.playing { impulse artpop 7 }
    //  The artwork keeps its shape: as tall as it fits, as wide as it is (a
    //  square album cover, a 16:9 video's frame), only its corners rounded.
    prop art_k = 1 ~400ms
    follow art_k = if(has_art, clamp(art_aspect, 1, 1.78), 1)
    let art_w = 22 * art_k
    //  [7][art 22–39][10][time][10][bars 19][13] against [16][time][16] at rest.
    let mus_w = (49 + art_w - 22) * mm
    let rest_w = pad * 2 + clockm.width + mus_w
    let wx_h = 358            // the widgets (weather, the mail) and the gap under them
    let card_h = 168 + wx_h + 140 * media_in
    //  The pages are as tall as their list (five rows show; more scroll).
    let wl_h = if(nets.count == 0, 48, min(wl.content, 218))
    let bl_h = if(devs.count == 0, 48, min(bl.content, 218))
    let wifi_h = 88 + wl_h + 12 + 48 * pw_in
    let bt_h = 88 + bl_h + 12
    let clip_h = 88 + 366 + 16
    let ll_h = if(hits.count == 0, 48, hits.count * 50 - 2)
    let launch_h = 88 + ll_h + 12
    let nl_h = if(notes.count == 0, 48, notes.count * 62 - 2)
    let notes_h = 94 + nl_h + 12
    let wg_h = max(1, ceil(walls.count / 3)) * 78 - 8
    let wall_h = 88 + wg_h + 34
    let capt_h = 230
    let mix_h = 88 + 36 + 14 + 46 * (mixapps.count + 1) + 16 + if(mix_more > 0, 14, 0)
    let auth_h = 262
    //  The mail reader: as tall as the mail, up to a point (then it scrolls), and the reply field under it.
    let mb_h = 840 - 182 - 14 - 54 * rep_in     // the reader (the large view): the card under its header, less the reply field
    prop wqp = 0 ~200ms         // the quote over the WhatsApp field coming in
    follow wqp = if(wa_quote, 1, 0)
    prop wap = 0 ~200ms         // …and files waiting to be sent, over it
    follow wap = if(wa_att, 1, 0)
    //  The WhatsApp chat's messages (pages/whatsapp.plm) run the whole height of the chat, under
    //  its floating header and field; what they show unhidden is from y 100 to just over the field.
    let wvh = 744 - 64 - 100 - 46 * wqp - 64 * wap
    measure wanm              // how wide the chat's name is: its glass pill fits it
    prop wfb = 0 ~quick         // …scrolled up this far from its newest (0: at the bottom)
    let wmax = max(0, wml.height - wvh)   // …and as far as it goes
    let mzs = 1004 / 620      // how much larger the focused view draws a mail (the card's whole width)
    //  Reading (l) in the large view: the list slides away and the mail takes the whole card.
    prop mxf = 0 ~shape
    follow mxf = if(mx_focus and panel == mailx and not mail_slim, 1, 0)   // folded, there is no room to widen into
    //  The inbox list folded away (s, or a tool beside the view): the card is the mail alone.
    prop mxs = 0 ~shape
    follow mxs = if(mail_slim, 1, 0)
    prop mxz = 1 ~shape
    follow mxz = if(panel == mailx, mx_zoom, 1)
    //  The finer photograph of a focused mail coming in over the scaled one.
    prop zin = 0 ~220ms
    follow zin = if(mr_zoom_ok and mx_focus, 1, 0)
    //  How much larger the page is drawn: focused (wz), and with the zoom (wzz).
    let wz = 1 + (mzs - 1) * mxf
    let wzz = wz * mxz
    //  Only the part of the page in sight —and a tile's worth either side, so scrolling finds it
    //  there— is drawn: a tile out of sight drawn and clipped still holds its place in the atlas,
    //  and a long mail with GIFs came to more than the atlas holds (parts of it then went missing).
    prop msc = 0 ~1ms         // the reader's scroll (follows mrl.scroll, in pages/mail.plm)
    let mvt = msc / wzz - 300
    let mvb = (msc + mb_h) / wzz + 300
    prop rep_in = 0 ~shape
    follow rep_in = if(mr_rep, 1, 0)
    //  The card's second header row (the toggles and the tray) pushes every face down.
    let hdr2 = 0
    let ctl_h = 52 + 4 * 84 + 6
    let timer_h = if(tmr_on, 88 + 34 + 12 + 150 + 56, 88 + 34 + 14 + 132 + 22)
    let nb_text_h = max(66, 50 + n_bm.height + 14)
    let ban_h = nb_text_h + if(nacts.count > 0, 44, 0)
    let open_h = hdr2 + if(panel == wifi, wifi_h, if(panel == bt, bt_h, if(panel == clip, clip_h, if(panel == launch, launch_h, if(panel == notes, notes_h, if(panel == emoji, 330, if(panel == wall, wall_h, if(panel == ctl, ctl_h, if(panel == timer, timer_h, if(panel == cam, 44 + 504 + 16, if(panel == fnd, 88 + 458 + 16, if(panel == awk, 116 + 132 + 26, if(panel == cap, capt_h, if(panel == mix, mix_h, if(panel == auth, auth_h, if(panel == mailx, 840, if(panel == wa, 760, card_h)))))))))))))))))
    //  On its two Control Center pages the card is a little wider.
    //  WhatsApp with its list folded (s, or a tool beside it): the faces only, and the card that much narrower.
    let wa_slim = panel == wa and (wa_rail or side) and not wa_search
    let mail_slim = panel == mailx and (mx_rail or side)
    let cw_t = if(panel == home or panel == ctl, 412, if(panel == cam, 928, if(panel == fnd, 1120, if(panel == clip, 780, if(panel == mailx or panel == wa, 1040 - if(wa_slim, 284, 0) - if(mail_slim, 384, 0), 384)))))
    prop cwp = 412 ~shape
    follow cwp = cw_t
    follow pw = if(expanded, max(cw_t, rest_w), if(osd, 340, if(picked, 214, if(copied, cp_tw, if(dev_on, dv_w, if(banner, 384, if(ld_on, ld_w, rest_w)))))))
    follow ph = if(expanded, open_h, if(osd, 34, if(picked, 34, if(copied, cp_th, if(dev_on, 34, if(banner, ban_h, 34))))))
    follow pr = if(expanded, 24, if(osd, 17, if(picked, 17, if(copied, if(cp_kind == 1, 22, 17), if(dev_on, 17, if(banner, 26, 17))))))

    //  The views that fill the centre: beside them, a tool opens from the right capsule (the
    //  clipboard's list, twelve rows; the emoji, seven), and the card slides left just enough
    //  for the two to sit side by side.
    let big = expanded and (panel == wa or panel == mailx or panel == fnd)
    let side_w = if(side_k == 1, 404, if(side_k == 3, 760, 384))
    let side_h = if(side_k == 1, 88 + 12 * 46 - 2 + 16, if(side_k == 3, 88 + 458 + 16, 462))
    //  The calendar (the date hovered) makes room the same way: a card grown from the right capsule never covers the view.
    let side_room = if(side, side_w, 300)
    let nudge_t = if((side or cal) and big, clamp(screen.width / 2 + max(cw_t, rest_w) / 2 + 14 - (screen.width - 24 - side_room), 0, max(0, screen.width / 2 - max(cw_t, rest_w) / 2 - 12)), 0)
    prop nudge = 0 ~shape
    follow nudge = nudge_t
    let cx = screen.width / 2 - nudge
    let x0 = cx - pw / 2
    let ex0 = cx - max(cwp, rest_w) / 2        // the card's left edge once open
    let exr = ex0 + max(cwp, rest_w)             // …and its right edge

    //  Telemetry colours, as indices: a colour choice has to sit in a `color:`.
    let cpu_i = floor(clamp(cpu / 20, 0, 4))
    let mem_i = floor(clamp(mem_frac * 5, 0, 4))
    let bat_i = if(battery.charging, 3, if(battery.percent <= 15, 2, if(battery.percent <= 30, 1, 0)))      // ink · amber · coral · charge

    prop cpu_s = 0 ~420ms
    prop mem_s = 0 ~420ms
    prop bat_s = 1 ~420ms
    prop vol_s = 0 ~420ms
    follow vol_s = audio.volume
    follow cpu_s = cpu / 100
    follow mem_s = mem_frac
    follow bat_s = battery.percent / 100

    // ── the glass ────────────────────────────────────────────────
    //  Changing workspace, niri slides the windows up or down under the bar,
    //  and the pills answer as iOS's tab bar does when content scrolls beneath
    //  it: they draw in to a compact size and their glass thickens (more frost,
    //  a little smoke) so what is on them stays readable over whatever passes.
    //  Once the windows have landed they swell back out, the centre first and
    //  the sides a beat later, with a soft liquid give. A run of switches keeps
    //  them compact until the last one has landed.
    prop ws_was = 1 ~280ms
    follow ws_was = ws_active
    fact ws_dir = 1           // +1 to a later workspace (the windows go up), −1 back: the rail's number rolls in from there
    prop k_mid = 0 ~150ms
    prop k_rail = 0 ~150ms
    //  The side pills each have a temper of their own around the centre's:
    //    the rail      light and quick: it is what you navigate with, so it
    //                  draws in furthest and comes back with the most spring;
    //    the capsule   its glass stays still: what moves is the battery's charge,
    //                  a liquid. The windows' rush jolts it: its surface tilts
    //                  and bulges, rocks a few times and settles (two modes
    //                  of a slosh, lightly damped, at different pitches).
    //                  The glass is gripped too, its own way: pinned to the
    //                  corner it hangs from, squeezed more in height than in
    //                  width, a beat after the others, letting go softly.
    prop k_cap = 0 ~150ms
    prop slosh = 0 ~spring(180, 4.5)
    prop slosh2 = 0 ~spring(420, 7)
    on change ws_active while ws_vertical and ws_active > ws_was { ws_dir = 1; k_rail: 1 ~110ms; k_mid: 1 ~150ms; impulse slosh 16; impulse slosh2 -18; k_cap: 1 ~180ms after 40ms }
    on change ws_active while ws_vertical and ws_active < ws_was { ws_dir = -1; k_rail: 1 ~110ms; k_mid: 1 ~150ms; impulse slosh -16; impulse slosh2 18; k_cap: 1 ~180ms after 40ms }
    on still ws_active for 260ms while ws_vertical { k_rail: 0 ~spring(340, 27); k_mid: 0 ~spring(260, 27); k_cap: 0 ~spring(200, 21) after 40ms }
    //  The centre pill opens into where you landed as it swells back: one gesture.
    on still ws_active for 260ms while ws_vertical and not expanded { ld_on = true }
    on still ws_active for 1260ms while ld_on { ld_on = false }      // about a second on screen
    let sb = max(34, ph + bpull)
    //  The pill itself: under everything else, so the card's controls stay on top.
    //  Its shape is the TARGET one, not the animating one: the instant the
    //  pointer arrives the whole card is "inside", so a quick move down into it
    //  can't outrun the spring, leave, and snap it shut.
    let tw = if(expanded, max(max(cw_t, rest_w), hold_w), if(osd, 340, if(picked, 214, if(copied, cp_tw, if(dev_on, dv_w, if(banner, 384, if(ld_on, ld_w, rest_w)))))))
    //  A page shorter than the one clicked from would leave the pointer below
    //  the card, which would close it: the zone reaches down to the pointer
    //  until it is back inside.
    let th = if(expanded, max(open_h, hold_h), if(osd, 34, if(picked, 34, if(copied, cp_th, if(dev_on, 34, if(banner, ban_h, 34))))))
    zone box hit { from: cx - tw / 2, 0; size: tw, th; corner: pr continuous; cursor: pointer; label: "Island" }
    prop rec_pulse = 0 ~600ms
    every 1.2s while recording { rec_pulse: 0 ~1ms; rec_pulse: 1 after 20ms; rec_pulse: 0 after 640ms }
    //  Workspace compression belongs to the pill, never a notification (including its exit).
    let km = if(banner or ban > 0.001, 0, k_mid * (1 - open))
    group {
        pivot: cx, 17
        scale: 1 - 0.12 * km
    //  The notifications behind the banner: up to two cards stacked under it,
    //  each narrower and dimmer, peeking out 8 px below the one in front.
    //  Only what shows below the banner is drawn: the banner is see-through.
    group {
        clip box { from: x0 - 4, sb - 2; size: pw + 8, 30 }
        body {
            gradient: x0, sb - 30 to x0, sb + 16, stack1_t, stack1_b
            opacity: 72% * clamp(stack - 1, 0, 1)
            shadow: 0, 3, 8, 18% * clamp(stack - 1, 0, 1)
            box { from: x0 + 34, sb - 30; size: pw - 68, 46 * clamp(stack - 1, 0, 1); corner: 18 continuous }
        }
        body {
            gradient: x0, sb - 30 to x0, sb + 8, stack2_t, stack2_b
            opacity: 85% * clamp(stack, 0, 1)
            shadow: 0, 3, 8, 22% * clamp(stack, 0, 1)
            box { from: x0 + 16, sb - 30; size: pw - 32, 38 * clamp(stack, 0, 1); corner: 20 continuous }
        }
        box { from: x0 + 16.5, sb - 29.5; size: pw - 33, 37 * clamp(stack, 0, 1); corner: 19.5 continuous; stroke: 0.7; color: rim_grey; opacity: 30% * clamp(stack, 0, 1) }
    }

    //  Clear pearl at rest; a restrained neutral tint behind cards and banners.
    //  Blur and the lit edge supply depth without a dense black veil.
    body {
        gradient: x0, 0 to x0 + pw, ph, mix(mix(pearl, lilac, 0.3), dusk, dark), mix(mix(pearl, sunset, 0.3), deep, dark)
        glass: 100%               // always: its lit, 3D edge is the glass's
        opacity: glass_alpha + (card_alpha - glass_alpha) * dark
        ripple: 0%            // no ring of light on click
        milk: (glass_milk + 4% * bloom) * (1 - dark) + 6% * max(0, km)
        smoke: card_smoke * dark + 16% * max(0, km)
        rim: 0%
        light: 3%, 0, 12
        shadow: 0, 8 * dark, 22 * dark, 16% * dark
        box { from: x0, 0; size: pw, max(34, ph + bpull); corner: pr continuous }
    }

    //  The prism: the rim isn't white, it's where the light splits —
    //  violet on the left edge, peach on the right, as in waybar. Collapsed only:
    //  expanded, it is grey (below).
    //  Waybar's dusk pickup over the smoke: violet from the left, peach from the right.
    body {
        gradient: x0, 0 to x0 + pw, 0, cool, ink 50%, warm
        opacity: (55% + 15% * bloom) * (1 - open)    // as the capsules' rim
        box { from: x0 + 0.5, 0.5; size: pw - 1, max(33, ph - 1 + bpull); corner: pr - 0.5 continuous; stroke: 1 }
    }

    //  Expanded: a plain grey rim instead of the prism.
    body {
        color: rim_grey
        opacity: 45% * open
        box { from: x0 + 0.5, 0.5; size: pw - 1, max(33, ph - 1 + bpull); corner: pr - 0.5 continuous; stroke: 1 }
    }



    // ── how far into the song ────────────────────────────────────
    //  The player only says where it is on a new song, a pause or a seek;
    //  between, it is carried on here, four steps a second and only while
    //  playing (no `time`: a still island must be able to sleep). The spring
    //  turns the steps into a glide, rewinds it on a new song, and slides
    //  it on a seek.
    fact pos: number = 0
    on change media.position { pos = media.position }
    on change media.length { pos = media.position }
    every 250ms while media.playing { pos = min(pos + 0.25 * media.rate, media.length) }
    prop prog = 0 ~420ms
    follow prog = clamp(pos / max(media.length, 1), 0, 1)
    //  The card's scrubber: where it shows (the pointer's while dragged), the
    //  times under it, and how far it is pulled past an end.
    fact scrubbing = false
    fact scrub_f: number = 0
    fact scrub_over: number = 0
    fact cur: number = 0
    fact rem: number = 0
    on change pos while not scrubbing { cur = pos; rem = max(0, media.length - pos) }
    on change scrub_f while scrubbing { cur = scrub_f * media.length; rem = max(0, media.length - scrub_f * media.length) }
    on change media.length { cur = pos; rem = max(0, media.length - pos) }
    prop cprog = 0 ~120ms
    follow cprog = if(scrubbing, scrub_f, prog)
    prop scrub_s = 0 ~200ms
    follow scrub_s = if(scrubbing, 1, 0)
    //  Past an end: a little give, at most 7 px, and back when let go.
    prop stretch_l = 0 ~spring(420, 30)
    prop stretch_r = 0 ~spring(420, 30)
    follow stretch_l = if(scrubbing, min(7, max(0, -scrub_over) * 60), 0)
    follow stretch_r = if(scrubbing, min(7, max(0, scrub_over - 1) * 60), 0)

    // ── the pill's contents (rest + live) ────────────────────────
    let clock_live = x0 + pad + (23 + art_w - 22) * mm + clockm.width / 2
    let wbx = x0 + pw - 13 - 19.2             // the waveform's left edge

    group {
        opacity: 1 - smooth(0, 0.45, max(max(open, ban), max(max(os, dvv), max(pkv, cpv))))

        //  Landed on another desktop, the time stays: it slides to the right end
        //  to make room for where you are.
        text clock.time {
            at: mix(clock_live, x0 + pw - 16 - clockm.width / 2, ldv), 17; anchor: center
            size: 13; weight: 600; family: "SF Pro Display"; color: ink; shadow: 0, 1, 3, 35%
            measure: clockm
        }

        group {
            opacity: 1 - smooth(0, 0.45, ldv)
            clip box { from: x0, 0; size: pw, 34; corner: pr continuous }
            //  The artwork, its own shape with rounded corners, growing out of a
            //  blur as the pill makes room. Without art, a note on teal.
            group {
                opacity: smooth(0.15, 0.6, mus)
                pivot: x0 + 7 + art_w / 2, 17
                scale: 0.6 + 0.4 * smooth(0.1, 0.8, mus) + 0.22 * artpop
                blur: 4 * (1 - smooth(0.1, 0.7, mus))
                box { from: x0 + 7, 6; size: 22, 22; corner: 7 continuous; color: teal; opacity: if(has_art, 0, 30%) }
                image ic_note { at: x0 + 11, 10; size: 14, 14; tint: ink; opacity: if(has_art, 0, 90%) }
                group {
                    clip box { from: x0 + 7, 6; size: art_w, 22; corner: 7 continuous }
                    image cover { at: x0 + 7 + art_w / 2 - 20, 6; size: 40, 22; show: has_art }
                }
                box { from: x0 + 7, 6; size: art_w, 22; corner: 7 continuous; stroke: 0.6; color: ink; opacity: 14%; show: has_art }
            }
            //  The waveform: five rounded bars, alive while it plays; dots when paused.
            group {
                opacity: smooth(0.3, 0.8, mus)
                box { at: wbx + 1.2, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb0 + wc0) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 5.4, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb1 + wc1) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 9.6, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb2 + wc2) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 13.8, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb3 + wc3) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 18, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb4 + wc4) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
            }
        }
    }

    // ── beside the pill: recording, and what is listening or watching ──
    //  A recording: a small coral capsule with its time (a click stops it).
    //  A timer or stopwatch: a small bubble of the bar's glass right of the
    //  island (as iOS shows a second activity), the time counting in it. A
    //  click opens its page.
    prop tbv = 0 ~320ms
    follow tbv = if(tmr_on, 1, 0)
    let tb_x = cx + pw / 2 + 8
    let tb_w = (tbm.width + 40) * tbv
    group {
        opacity: smooth(0.3, 1, tbv)
        body {
            gradient: tb_x, 3 to tb_x + tb_w, 31, mix(pearl, lilac, 0.3), mix(pearl, sunset, 0.3)
            glass: 100%; ripple: 0%; rim: 0%; milk: glass_milk + 4% * tb_z.hover
            opacity: glass_alpha; light: 4%, 3, 10; shadow: 0, 1.5, 6, 18%
            box { from: tb_x, 3; size: max(0.1, tb_w), 28; corner: 14 continuous }
        }
        box { from: tb_x + 0.5, 3.5; size: max(0.1, tb_w - 1), 27; corner: 13.5 continuous; stroke: 1; color: ink; opacity: 35% }
        group {
            clip box { from: tb_x, 3; size: max(0, tb_w), 28; corner: 14 continuous }
            image ic_timer { at: tb_x + 11, 10; size: 14, 14; tint: warm; show: tmr_mode == timer }
            image ic_watch { at: tb_x + 11, 10; size: 14, 14; tint: warm; show: tmr_mode == watch }
            text tmr_text {
                at: tb_x + 30, 17; anchor: left center; size: 12.5; weight: 700; family: "SF Pro Display"
                color: ink; opacity: if(tmr_paused, 55%, 100%); shadow: 0, 1, 3, 35%; measure: tbm
            }
        }
    }
    zone box tb_z { from: tb_x, 3; size: max(0, tb_w), 28; corner: 14 continuous; cursor: pointer; label: "Timer"; active: tmr_on }
    on press tb_z { expanded = true; panel = timer }
    let pv_x = cx + pw / 2 + 8 + tb_w + 6 * tbv
    prop recv = 0 ~300ms
    follow recv = if(recording, 1, 0)
    measure recm
    let rec_w = (recm.width + 30) * recv
    group {
        opacity: smooth(0.3, 1, recv)
        clip box { from: pv_x, 0; size: max(0, rec_w), 34 }
        body {
            gradient: pv_x, 6 to pv_x + rec_w, 28, coral, #e85d72
            glass: 25%; blur: 0%; light: 6%, 6, 11; shadow: 0, 1.2, 4, 22%
            box { from: pv_x, 6; size: max(0.1, rec_w), 22; corner: 11 continuous }
        }
        ellipse { at: pv_x + 12, 17; radius: 3.4; color: #ffffff; opacity: 75% + 25% * rec_pulse }
        text rec_time { at: pv_x + 20, 17; anchor: left center; size: 11.5; weight: 700; family: "SF Pro Display"; color: #ffffff; measure: recm }
    }
    zone box rec_z { from: pv_x, 6; size: max(0, rec_w), 22; corner: 11 continuous; cursor: pointer; label: "Stop recording"; active: recording }
    on press rec_z { emit rec_stop }
    prop micv = 0 ~280ms
    prop camv = 0 ~280ms
    prop scrv = 0 ~280ms
    follow micv = if(mic_on, 1, 0)
    follow camv = if(cam_on, 1, 0)
    follow scrv = if(scr_on, 1, 0)

    // ── a copy, in the pill: a small picture or a symbol, the first line, "Copied" ──
    //  An image shows as a tiny squircle of itself; text read off the screen
    //  says "Scanned", and OCR that found nothing says so instead.
    text cp_text { at: 0, -40; size: 12.5; weight: 600; family: "SF Pro Display"; opacity: 0; measure: cpm }
    group {
        opacity: smooth(0.45, 1, cpv)
        move: 0, 2 * (1 - cpv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        //  A picture: "Image copied" and its size along the bar, the picture under it.
        group {
            show: cp_kind == 1
            image ic_clip { at: x0 + 16, 10; size: 14, 14; tint: ink; opacity: 85% }
            text "Image copied" { at: x0 + 38, 17; anchor: left center; size: 12.5; weight: 600; family: "SF Pro Display"; color: ink }
            text cp_dims { at: x0 + pw - 16, 17; anchor: right center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 55% }
            let pic_x = cx - cp_iw / 2
            let pic_y = 38
            box { from: pic_x, pic_y; size: cp_iw, cp_ih; corner: 12 continuous; color: chip_hi }
            group {
                clip box { from: pic_x, pic_y; size: cp_iw, cp_ih; corner: 12 continuous }
                image cp_big { at: cx - 150, pic_y + cp_ih / 2 - 85; size: 300, 170 }
            }
            box { from: pic_x, pic_y; size: cp_iw, cp_ih; corner: 12 continuous; stroke: 0.6; color: ink; opacity: 18% }
        }
        image ic_clip { at: x0 + 16, 10; size: 14, 14; tint: ink; opacity: 85%; show: cp_kind == 0 }
        image ic_shot { at: x0 + 16, 10; size: 14, 14; tint: ink; opacity: 85%; show: cp_kind == 2 or cp_kind == 3 }
        //  Low battery: a small coral battery, and how much is left on the right.
        group {
            show: cp_kind == 4
            box { from: x0 + 14, 12; size: 16, 9; corner: 2.8 continuous; stroke: 1.2; color: coral }
            box { from: x0 + 30.6, 14.6; size: 1.4, 3.8; corner: 0.7 continuous; color: coral }
            box { from: x0 + 16, 14; size: 3, 5; corner: 1 continuous; color: coral }
            text cp_dims { at: x0 + pw - 16, 17; anchor: right center; size: 12; weight: 700; family: "SF Pro Display"; color: coral }
        }
        //  A timer has run out: its symbol in warm light, and how long it was.
        group {
            show: cp_kind == 5
            image ic_timer { at: x0 + 16, 10; size: 14, 14; tint: warm }
            text cp_dims { at: x0 + pw - 16, 17; anchor: right center; size: 12; weight: 600; family: "SF Pro Display"; color: ink; opacity: 65% }
        }
        text cp_text {
            at: x0 + 42, 17; anchor: left center; width: 230; lines: 1
            size: 12.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: if(cp_kind == 1, 0, if(cp_kind == 3, 70%, 100%)); shadow: 0, 1, 3, 35%
        }
        text pick(min(cp_kind, 2), "Copied", "Copied", "Scanned") {
            at: x0 + pw - 16, 17; anchor: right center; size: 12; weight: 600; family: "SF Pro Display"
            color: ink; opacity: if(cp_kind == 0 or cp_kind == 2, 65%, 0); shadow: 0, 1, 3, 35%
        }
    }
    on change cp_seq { copied = true }
    on still cp_seq for 2400ms while copied and cp_kind != 1 and cp_kind != 4 and cp_kind != 5 { copied = false }
    on still cp_seq for 4000ms while copied and cp_kind == 4 { copied = false }
    on still cp_seq for 6000ms while copied and cp_kind == 5 { copied = false }
    on still cp_seq for 3200ms while copied and cp_kind == 1 { copied = false }
    on change expanded while expanded { copied = false }

    // ── a device connected, in the pill: its symbol, its name, its battery ──
    //  The ring fills once the pill has opened, green, or coral when low.
    text dv_name { at: 0, -40; size: 12.5; weight: 600; family: "SF Pro Display"; opacity: 0; measure: dvm }
    prop dvr = 0 ~700ms
    follow dvr = if(dvv > 0.6, max(dv_bat, 0), 0)
    group {
        opacity: smooth(0.45, 1, dvv)
        move: 0, 2 * (1 - dvv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group {
            move: x0 + 16, 8
            image dv_head { at: 0, 0; size: 18, 18; tint: ink; show: dv_glyph == 0 }
            image dv_mouse { at: 0, 0; size: 18, 18; tint: ink; show: dv_glyph == 1 }
            image dv_keys { at: 0, 0; size: 18, 18; tint: ink; show: dv_glyph == 2 }
            image dv_phone { at: 0, 0; size: 18, 18; tint: ink; show: dv_glyph == 3 }
            image dv_other { at: 0, 0; size: 18, 18; tint: ink; show: dv_glyph == 4 }
        }
        text dv_name {
            at: x0 + 44, 17; anchor: left center; width: 180; lines: 1
            size: 12.5; weight: 600; family: "SF Pro Display"; color: ink; shadow: 0, 1, 3, 35%
        }
        group {
            show: dv_bat >= 0
            let rx = x0 + pw - 16 - 32 - 6 - 11
            ellipse { at: rx, 17; radius: 9; stroke: 2.4; color: ink; opacity: 18% }
            arc { at: rx, 17; radius: 9; span: clamp(dvr, 0.012, 1) * 360deg; rotate: clamp(dvr, 0.012, 1) * 180deg; width: 2.4; color: if(dv_bat <= 0.2, coral, #30d158) }
            text number(dv_bat * 100, 0, "%") {
                at: x0 + pw - 16, 17; anchor: right center; size: 12; weight: 700; family: "SF Pro Display"
                color: ink; shadow: 0, 1, 3, 35%
            }
        }
    }
    on change dv_seq { dev_on = true }
    on still dv_seq for 3600ms while dev_on { dev_on = false }
    on change expanded while expanded { dev_on = false }

    // ── landed on another desktop: the pill says where, as the Dynamic Island
    //  says what is going on. It widens from the clock into the desktop's apps
    //  (their icons popping in one after another, the most recent in front)
    //  and its name, the time still at its end; then it settles back.
    text ld_name { at: 0, -40; size: 13; weight: 600; family: "SF Pro Display"; opacity: 0; measure: ldm }
    let ld_x = x0 + 16
    let ld_e1 = clamp((ldv - 0.25) / 0.5, 0, 1)
    let ld_e2 = clamp((ldv - 0.35) / 0.5, 0, 1)
    let ld_e3 = clamp((ldv - 0.45) / 0.5, 0, 1)
    let ld_e4 = clamp((ldv - 0.55) / 0.45, 0, 1)
    group {
        opacity: smooth(0.45, 1, ldv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        //  Back to front, so the first one sits on top of the stack.
        group {
            show: ld_n > 3
            pivot: ld_x + 55, 17; scale: 0.6 + 0.4 * ld_e4; opacity: ld_e4
            image ld_i4 { at: ld_x + 45, 7; size: 20, 20 }
        }
        group {
            show: ld_n > 2
            pivot: ld_x + 40, 17; scale: 0.6 + 0.4 * ld_e3; opacity: ld_e3
            image ld_i3 { at: ld_x + 30, 7; size: 20, 20 }
        }
        group {
            show: ld_n > 1
            pivot: ld_x + 25, 17; scale: 0.6 + 0.4 * ld_e2; opacity: ld_e2
            image ld_i2 { at: ld_x + 15, 7; size: 20, 20 }
        }
        group {
            show: ld_n > 0
            pivot: ld_x + 10, 17; scale: 0.6 + 0.4 * ld_e1; opacity: ld_e1
            image ld_i1 { at: ld_x, 7; size: 20, 20 }
        }
        text ld_name {
            at: ld_x + ld_iw, 17 + 2 * (1 - ldv); anchor: left center; width: 200; lines: 1
            size: 13; weight: 600; family: "SF Pro Display"; color: tint_ink; shadow: 0, 1, 3, 35%
        }
    }
    on change expanded while expanded { ld_on = false }

    // ── the colour picker's answer, in the pill: a swatch, its code, "Copied" ──
    group {
        opacity: smooth(0.45, 1, pkv)
        move: 0, 2 * (1 - pkv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        ellipse { at: x0 + 19, 17; radius: 9; color: rgb(pk_r, pk_g, pk_b) }
        ellipse { at: x0 + 19, 17; radius: 9; stroke: 1; color: ink; opacity: 35% }
        text pk_hex { at: x0 + 36, 17; anchor: left center; size: 13; weight: 600; family: "SF Pro Display"; color: ink; shadow: 0, 1, 3, 35% }
        text "Copied" { at: x0 + pw - 16, 17; anchor: right center; size: 12; weight: 600; family: "SF Pro Display"; color: ink; opacity: 70%; shadow: 0, 1, 3, 35% }
    }
    }

    //  An app's tray icon: a small dark disc in a stack, which fans out into a
    //  row while the stack is under the pointer (or its menu is open).
    component TrayIcon(t: record) {
        size: 26, 26
        group {
            move: t.index * (14 + 16 * tfan), 0
            body {
                color: mix(well_t, chip_hi, z.hover * tfan); shadow: 0, 1, 4, 30% * (1 - tfan)
                ellipse { at: 13, 13; radius: 12 }
            }
            ellipse { at: 13, 13; radius: 12; stroke: 1; color: ink; opacity: 14% + 10% * z.hover }
            image t.icon { at: 5, 5; size: 16, 16 }
            zone ellipse z { at: 13, 13; radius: 13; cursor: pointer; label: "{t.title}" }
        }
        //  A double click is one: most apps show or hide their window on each
        //  activation, so a second within 450 ms would close what the first opened.
        on press z while not tray_cool { emit tray_activate(t.index); tray_cool = true }
        on press right z { emit tray_menu(t.index) }
    }

    // ── the bar's right side: battery and date, in a capsule of frosted glass ──
    //  The same glass as the workspace capsule on the left, so the bar is held
    //  between two of them: a battery drawn as iOS draws it, a hairline, the date.
    let cap_r = screen.width - 24
    let cap_h = 28
    let cap_y = 17 - cap_h / 2
    //  Charging: 0 on battery → 1 plugged in. The plug and the room it takes ride this.
    prop chg = 0 ~460ms
    follow chg = if(battery.charging, 1, 0)
    //  The plug slides down into place (and is wiped back up when unplugged).
    let strike = smooth(0.25, 0.85, chg)
    let bat_gw = 29 + 13 * chg  // the battery glyph and its nub, and the plug while charging
    //  The fill's colour on battery alone, then eased into green while charging.
    let bat_nc = if(battery.percent <= 15, 2, if(battery.percent <= 30, 1, 0))
    prop bat_was = 0 ~400ms
    follow bat_was = battery.percent
    prop bat_in = 1 ~spring(300, 30)
    //  Not on the first value it reports as the island starts: only real changes roll.
    prop booted = 0 ~1500ms
    follow booted = 1
    fact bat_dir = 1          // +1 filling (the new digit comes up from below), −1 draining
    on change battery.percent while booted > 0.99 and battery.percent > bat_was { bat_dir = 1; bat_in: 0 ~1ms; bat_in: 1 after 16ms }
    on change battery.percent while booted > 0.99 and battery.percent < bat_was { bat_dir = -1; bat_in: 0 ~1ms; bat_in: 1 after 16ms }
    //  Which digits changed: the last; the tens too when it crosses one; all at 100.
    let bat_from = if(battery.percent >= 99, 0, if(mod(battery.percent, 10) == if(bat_dir > 0, 0, 9), 0, 1) - if(battery.percent < 10, 1, 0))


    include "pages/notice.plm"
    include "pages/osd.plm"

    //  A dial to drag, as iOS's Control Center timer: a pressed-in track that
    //  fills with soft glass behind a white knob as it is dragged, the time
    //  above it, and the main ones marked under it. It snaps to sensible steps
    //  (fine at first, coarser further on), the knob ticking at each; letting
    //  go starts it. h l (← →) step it, Enter starts. mode 0: a timer (1 min to
    //  3 h); mode 1: Keep Awake (5 min to 8 h, then until turned off).
    component Dial(mode: number) {
        size: 352, 132
        prop dk = 0.2 ~70ms
        follow dk = dial_f
        spring dtick = 420, 41
        prop dpop = 0 ~dtick
        on change dial_idx { impulse dpop 6 }
        let kx = 22 + 308 * dk
        text dial_label { at: 176, 18; anchor: center; size: 34; weight: 600; family: "SF Pro Display"; color: ink }
        text dial_sub { at: 176, 46; anchor: center; size: 11.5; weight: 500; family: "SF Pro Display"; color: tint_ink }
        //  The track, pressed in; the part behind the knob filled with soft glass.
        box { from: 0, 64; size: 352, 44; corner: 22 continuous; color: well; opacity: 30% }
        body { color: well; opacity: 30%; box { from: 14, 64; size: 324, 2; corner: 1 continuous } }
        body {
            gradient: 0, 64 to 352, 108, soft_l, soft_s
            glass: 25%; blur: 0%; light: 6%, 64, 22; opacity: 85%
            box { from: 3, 67; size: max(38, kx + 19 - 3), 38; corner: 19 continuous }
        }
        //  The knob: white glass, swelling a touch under the finger and at each step.
        body {
            color: ink; glass: 25%; blur: 0%; light: 6%, 70, 16; shadow: 0, 1.5, 5, 30%
            ellipse { at: kx, 86; radius: 16 + 1.5 * dz.pressed + 0.25 * dpop }
        }
        //  The marks, under the track.
        group {
            opacity: if(mode == 0, 1, 0)
            text "1m" { at: 22, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "5m" { at: 22 + 308 * 4 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "15m" { at: 22 + 308 * 8 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "30m" { at: 22 + 308 * 11 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "1h" { at: 22 + 308 * 14 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "2h" { at: 22 + 308 * 17 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "3h" { at: 330, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
        }
        group {
            opacity: if(mode == 1, 1, 0)
            text "5m" { at: 22, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "30m" { at: 22 + 308 * 4 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "1h" { at: 22 + 308 * 6 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "2h" { at: 22 + 308 * 8 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "4h" { at: 22 + 308 * 10 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "8h" { at: 22 + 308 * 12 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "∞" { at: 330, 124; anchor: center; size: 11; weight: 700; family: "SF Pro Display"; color: ink; opacity: 55% }
        }
        zone box dz { from: -6, 56; size: 364, 60; corner: 30 continuous; cursor: pointer; label: "Drag to set how long" }
        on press dz { dial_f = clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1); emit dial_move(clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1)) }
        on drag dz { dial_f = clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1); emit dial_move(clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1)) }
        on release dz { emit dial_go(clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1)) }
    }

    //  The tiles of the home face: the round button switches the radio, the
    //  rest opens its page.
    //  One hour of the forecast: when, its symbol, how warm.
    component WxHour(h: record) {
        size: 57, 40
        text h.t { at: 28.5, 5; anchor: center; size: 10; weight: 600; family: "SF Pro Display"; color: tint_ink }
        group {
            move: 20.5, 12
            image wx_sun { at: 0, 0; size: 16, 16; show: h.ic == 0 }
            image wx_moon { at: 0, 0; size: 16, 16; show: h.ic == 1 }
            image wx_csun { at: 0, 0; size: 16, 16; show: h.ic == 2 }
            image wx_cmoon { at: 0, 0; size: 16, 16; show: h.ic == 3 }
            image wx_cloud { at: 0, 0; size: 16, 16; show: h.ic == 4 }
            image wx_rain { at: 0, 0; size: 16, 16; show: h.ic == 5 }
            image wx_snow { at: 0, 0; size: 16, 16; show: h.ic == 6 }
            image wx_storm { at: 0, 0; size: 16, 16; show: h.ic == 7 }
            image wx_fog { at: 0, 0; size: 16, 16; show: h.ic == 8 }
        }
        text h.temp { at: 28.5, 36; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink }
    }

    //  A connected device's battery, as the stats are drawn: a ring, how full, its name.
    component BatMini(b: record) {
        size: 44, 48
        prop f = 0 ~420ms
        follow f = b.pct / 100
        ellipse { at: 14, 18; radius: 14; stroke: 2.6; color: ink; opacity: 9% }
        arc { at: 14, 18; radius: 14; span: clamp(f, 0.012, 1) * 360deg; rotate: clamp(f, 0.012, 1) * 180deg; width: 2.6; color: if(b.pct <= 20, coral, soft_l); opacity: 95% }
        text number(b.pct, 0, "%") { at: 14, 18; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: if(b.pct <= 20, coral, ink) }
        text b.name { at: 14, 42; anchor: center; width: 42; lines: 1; align: center; size: 7; weight: 600; family: "SF Pro Display"; color: ink; opacity: 42% }
    }

    //  A headline (in the calendar, so narrow): two lines of it, where it is from and how long ago; lit under the pointer.
    component NewsRow(n: record) {
        size: 284, 50
        zone box z { from: 0, 0; size: 284, 50; corner: 10 continuous; cursor: pointer; label: "{n.title}" }
        box { from: 0, 0; size: 284, 50; corner: 10 continuous; color: ink; opacity: 6% * z.hover + 4% * z.pressed }
        text n.title { at: 10, 5; anchor: left top; width: 264; lines: 2; line_height: 1.18; size: 12; weight: 600; family: "SF Pro Display"; color: ink }
        text n.meta { at: 10, 41; anchor: left center; width: 264; lines: 1; size: 9.5; weight: 600; family: "SF Pro Display"; color: tint_ink; opacity: 85% }
        on press z { emit news_open(n.index) }
    }

    //  A mail in the inbox: who, when, what about; unread ones bolder, with a bead of the island's light.
    //  Under the pointer, an archive button takes the place of the time.
    component MailRow(m: record) {
        size: 364, 42
        //  Let go (archived, binned): it slides away and fades, and the rows below close up after it.
        prop lv = 0 ~200ms
        follow lv = if(mx_leaving == m.index, 1, 0)
        group {
        opacity: 1 - lv
        move: -36 * lv, 0
        zone box z { from: 0, 0; size: 364, 42; corner: 12 continuous; cursor: pointer; label: "{m.from}: {m.subj}" }
        box { from: 0, 0; size: 364, 42; corner: 12 continuous; color: ink; opacity: 6% * max(z.hover, arc.hover) + 4% * z.pressed }
        body {
            gradient: 7, 17 to 15, 25, soft_l, soft_s; light: 7%, 17, 4
            opacity: if(m.unread, 100%, 0)
            ellipse { at: 11, 21; radius: 3.6 }
        }
        text m.from { at: 23, 13.5; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 700; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 100%, 0) }
        text m.from { at: 23, 13.5; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 0, 88%) }
        text m.subj { at: 23, 29.5; anchor: left center; width: 300; lines: 1; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 80%, 55%) }
        text m.ago { at: 354, 13.5; anchor: right center; size: 10; weight: 600; family: "SF Pro Display"; color: if(m.unread, tint_ink, ink); opacity: (if(m.unread, 95%, 45%)) * (1 - max(z.hover, arc.hover)) }
        group {
            opacity: max(z.hover, arc.hover)
            body {
                color: mix(chip, chip_hi, arc.hover); glass: 25%; blur: 0%; light: 4%, 2, 11; shadow: 0, 1 + 0.5 * arc.hover - arc.pressed, 3.5, 21%
                ellipse { at: 343, 21; radius: 12 - 0.4 * arc.pressed }
            }
            image ic_archive_s { at: 337, 15; size: 12, 12; tint: ink; opacity: 85% }
        }
        zone ellipse arc { at: 343, 21; radius: 13; cursor: pointer; label: "Archive" }
        //  A short mail makes the card shorter than where the row was: it stays open until the pointer is back over it.
        }
        on press z { emit mail_open(m.index) }     // a mail: the large view, open on it
        on press arc { emit mail_arch(m.index) }
    }

    //  A row of the large view's list: who, when, what about; the chosen one a pane of the island's light.
    component MailRowX(m: record) {
        size: 364, 52
        prop lv = 0 ~200ms
        follow lv = if(mx_leaving == m.index, 1, 0)
        group {
        opacity: 1 - lv
        move: -36 * lv, 0
        zone box z { from: 0, 0; size: 364, 52; corner: 14 continuous; cursor: pointer; label: "{m.from}: {m.subj}" }
        body {
            gradient: 0, 0 to 364, 52, soft_l, soft_s; glass: 25%; blur: 0%; light: 4%, 0, 26
            opacity: if(mx_sel == m.index, 20%, 0)
            box { from: 0, 0; size: 364, 52; corner: 14 continuous }
        }
        box { from: 0, 0; size: 364, 52; corner: 14 continuous; color: ink; opacity: (6% * z.hover + 4% * z.pressed) * if(mx_sel == m.index, 0, 1) }
        body {
            gradient: 7, 13 to 15, 21, soft_l, soft_s; light: 7%, 13, 4
            opacity: if(m.unread, 100%, 0)
            ellipse { at: 11, 17; radius: 3.6 }
        }
        text m.from { at: 23, 17; anchor: left center; width: 260; lines: 1; size: 13; weight: 700; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 100%, 0) }
        text m.from { at: 23, 17; anchor: left center; width: 260; lines: 1; size: 13; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 0, 90%) }
        text m.ago { at: 352, 17; anchor: right center; size: 10.5; weight: 600; family: "SF Pro Display"; color: if(m.unread, tint_ink, ink); opacity: if(m.unread, 95%, 45%) }
        text m.subj { at: 23, 35.5; anchor: left center; width: 330; lines: 1; size: 11.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 82%, 58%) }
        }
        on press z { emit mailx_pick(m.index) }
    }

    //  A chat in the WhatsApp list, as iOS's Messages lists them: its face, who, when, and what
    //  was said last over two lines; a bead of the island's light before it while it is unread,
    //  and the count under the time. Pinned and muted ones say so with a small symbol.
    component WaChat(c: record) {
        size: 364 - 284 * wcol, 66
        let rw = 364 - 284 * wcol         // folded: the face alone
        let wt = 1 - smooth(0, 0.6, wcol) // …its words fade first
        let bw = if(c.unread > 99, 28, if(c.unread > 9, 23, 18))
        let sel = if(wa_sel == wa_first + c.index, 1, 0)
        zone box z { from: 0, 0; size: rw, 66; corner: 18 continuous; cursor: pointer; label: "{c.name}" }
        body {
            color: im_gray2; light: 4%, 0, 20
            opacity: 85% * sel
            box { from: 0, 0; size: rw, 66; corner: 18 continuous }
        }
        box { from: 0, 0; size: rw, 66; corner: 18 continuous; color: ink; opacity: (5% * z.hover + 4% * z.pressed) * (1 - sel) }
        //  Unread: a bead of light before the face (grey when it is muted).
        body {
            color: if(c.muted, im_gray2, im_blue); light: 7%, 29, 4
            opacity: if(c.unread > 0, 100%, 0) * wt
            ellipse { at: 9, 33; radius: 3.8 }
        }
        body {
            gradient: 18, 11 to 62, 55, #7d7d85, #57575e; light: 4%, 11, 22
            ellipse { at: 40, 33; radius: 22 }
        }
        text c.init { at: 40, 33.5; anchor: center; size: 14; weight: 600; family: "SF Pro Display"; color: ink; opacity: 92% }
        group {
            clip ellipse { at: 40, 33; radius: 22 }
            image c.pic { at: 18, 11; size: 44, 44 }
        }
        ellipse { at: 40, 33; radius: 22; stroke: 0.6; color: ink; opacity: 10% }
        group {
        opacity: wt
        show: wcol < 0.98
        text c.name { at: 72, 19; anchor: left center; width: 205; lines: 1; size: 13.5; weight: 700; family: "SF Pro Display"; color: ink; opacity: if(c.unread > 0, 100%, 0) }
        text c.name { at: 72, 19; anchor: left center; width: 205; lines: 1; size: 13.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: if(c.unread > 0, 0, 94%) }
        text c.ago { at: 352, 19; anchor: right center; size: 10.5; weight: 500; family: "SF Pro Text"; color: if(c.unread > 0 and not c.muted, im_blue2, ink); opacity: if(c.unread > 0, 100%, 45%) }
        //  Pinned, muted: before the time.
        image ic_pin { at: 352 - 44, 13; size: 11, 11; tint: ink; opacity: if(c.pinned and not c.muted, 40%, 0) }
        image ic_bellx { at: 352 - 44, 13; size: 11, 11; tint: ink; opacity: if(c.muted, 40%, 0) }
        text c.last { at: 72, 29; anchor: left top; width: 250 - bw * if(c.unread > 0, 1, 0); lines: 2; line_height: 1.22; size: 11.5; weight: 400; family: "SF Pro Text"; color: ink; opacity: if(c.typing, 0, if(c.unread > 0, 78%, 52%)) }
        text "typing…" { at: 72, 37; anchor: left center; size: 11.5; weight: 500; family: "SF Pro Text"; color: im_blue2; opacity: if(c.typing, 100%, 0) }
        }
        //  The unread count: under the time, or (folded) on the face's shoulder.
        let bcx = 352 - bw / 2 + (58 - 352 + bw / 2) * wcol
        let bcy = 42.5 + (16 - 42.5) * wcol
        group {
            opacity: if(c.unread > 0, 1, 0)
            body {
                color: if(c.muted, im_gray2, im_blue); light: 6%, bcy - 8.5, 8
                shadow: 0, 1, 3, 25% * wcol
                box { from: bcx - bw / 2, bcy - 8.5; size: bw, 17; corner: 8.5 continuous }
            }
            text c.badge { at: bcx, bcy + 0.2; anchor: center; size: 10; weight: 700; family: "SF Pro Display"; color: #ffffff }
        }
        on press z { emit wa_pick(c.index) }
    }

    //  A message, as iOS's Messages draws them: a bubble as wide as what it says (up to 420),
    //  ours on the right in the island's light, theirs on the left in grey; messages that follow
    //  each other close up, and only the last of a run has a tail and its time. A picture is its
    //  own rounded shape, with the time on a small pane over it and any caption in a bubble
    //  under it. Between days, the day; under the last one sent, whether it was read.
    component WaMsg(m: record) {
        let side = max(m.dw, m.dh)
        let picked = if(wa_focus and wa_cur == m.index, 1, 0)
        //  Its slot takes its height on a spring: the words of a new message are measured a few
        //  frames after it is there, and this way it slides in instead of jumping as they come.
        //  Opening a chat (`wa_snap`), the height itself, at once. (Not with a `~1ms` rule: that
        //  would leave the follow travelling in 1 ms from then on.)
        prop hs = 0 ~200ms
        follow hs = if(m.index < wam.count, wmc.height, 0)   // an unused slot at nothing, so a new one grows from it
        //  …and rises into place as it comes, as a message sent leaves the field on iOS.
        prop born = 0 ~380ms
        follow born = if(m.index < wam.count, 1, 0)
        group {
        size: 624, if(wa_snap, wmc.height, hs)
        move: 0, if(wa_snap, 0, 26 * (1 - born))
        column wmc {
            //  The day, and the time of its first message: quiet, centred.
            group {
                show: m.day
                size: 624, 38
                row {
                    at: 312, 20; anchor: center middle; gap: 5
                    text m.text { size: 10.5; weight: 700; family: "SF Pro Text"; color: ink; opacity: 50% }
                    text m.time { size: 10.5; weight: 400; family: "SF Pro Text"; color: ink; opacity: 42% }
                }
            }
            //  Who said it, over the first of their run (in a group).
            group {
                show: m.has_from
                size: 624, 17
                text m.from { at: 14, 8; anchor: left center; size: 10.5; weight: 600; family: "SF Pro Text"; color: ink; opacity: 50% }
            }
            //  A picture: its own shape, rounded as the bubbles are.
            group {
                show: m.img
                size: 624, m.dh + if(m.has_text or m.has_q, 3, 0)
                let px = if(m.me, 624 - m.dw, 0)
                zone box iz { from: px, 0; size: m.dw, m.dh; corner: 18 continuous; cursor: pointer; label: "Open the picture"; carries: "{m.full}" }
                group {
                    //  A sticker is cut out already: no ground behind it, no rounding.
                    clip box { from: px, 0; size: m.dw, m.dh; corner: if(m.sticker, 0, 18) continuous }
                    box { from: px, 0; size: m.dw, m.dh; color: ink; opacity: if(m.sticker, 0, 8%) }
                    image m.pic { at: px + (m.dw - side) / 2, (m.dh - side) / 2; size: side, side }
                }
                box { from: px - 1.5, -1.5; size: m.dw + 3, m.dh + 3; corner: 19.5 continuous; stroke: 2; color: im_blue2; opacity: 90% * picked }
                //  Its time, on a small dark pane in its corner (when no caption carries it).
                group {
                    opacity: if(m.tail and not m.has_text, 1, 0)
                    body {
                        color: well; opacity: glass_alpha
                        box { from: px + m.dw - 48, m.dh - 24; size: 40, 16; corner: 8 continuous }
                    }
                    text m.time { at: px + m.dw - 28, m.dh - 15.6; anchor: center; size: 9.5; weight: 600; family: "SF Pro Text"; color: #ffffff; opacity: 92% }
                }
                on press iz { emit wa_media(m.index) }
                on enter iz { emit wa_prefetch(m.index); wa_hov = m.index }
                on leave iz while wa_hov == m.index { wa_hov = -1 }
            }
            //  The bubble: drawn behind its words, as big as they come to.
            group {
                show: not m.day and (m.has_text or m.file or m.has_q)
                size: 624, bub.height
                let bx = if(m.me, 624 - bub.width, 0)
                //  The bubble is one outline, not a box with a stem stuck on (that showed a step where
                //  they met): three soft corners, and on its own side the fourth is either a corner or,
                //  on the last of a run, iMessage's stem — the side running straight down into a fine
                //  tip and a concave sweep back into the bottom, every join tangent.
                let sx = if(m.me, bx + bub.width, bx)      // the stem's side…
                let ox = if(m.me, bx, bx + bub.width)      // …the other
                let sd = if(m.me, 1, -1)                   // outwards, on the stem's side
                let tl = if(m.tail, 1, 0)
                let br = min(18, bub.height / 2)
                let bb = bub.height
                body {
                    gradient: bx, 0 to bx, bb, if(m.me, im_blue2, im_gray), if(m.me, im_blue, im_gray)
                    light: 5%, 0, 12
                    path {
                        move ox + sd * br, 0
                        line sx - sd * br, 0
                        curve sx, br via sx, 0
                        line sx, bb - br + tl * (br - 10)
                        curve sx + sd * (-br / 4 + tl * (6 + br / 4)), bb - br / 4 + tl * (br / 4 + 0.2) via sx + sd * tl * 0.3, bb - br / 2 + tl * (br / 2 - 2.5)
                        curve sx - sd * (br + tl * (9 - br)), bb - tl * 1.6 via sx - sd * (br / 2 + tl * (5 - br / 2)), bb - tl * 2.9
                        curve sx - sd * (br + tl * (18 - br)), bb via sx - sd * (br + tl * (14 - br)), bb
                        line ox + sd * br, bb
                        curve ox, bb - br via ox, bb
                        line ox, br
                        curve ox + sd * br, 0 via ox, 0
                        close
                    }
                }
                box { from: bx - 1.5, -1.5; size: bub.width + 3, bub.height + 3; corner: 19.5 continuous; stroke: 2; color: if(m.me, #ffffff, im_blue2); opacity: 85% * picked }
                column bub {
                    at: bx, 0; padding: 7, 13; gap: 2
                    //  What it answers.
                    column {
                        show: m.has_q
                        padding: 4, 9; gap: 1; fill: if(m.me, mix(im_blue, #000000, 0.22), mix(im_gray, #000000, 0.3)); corner: 10
                        text m.qfrom { size: 10.5; weight: 700; family: "SF Pro Text"; color: if(m.me, #ffffff, im_blue2); opacity: 90% }
                        text m.qtext { size: 11.5; weight: 400; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: 68% }
                    }
                    //  A voice note, video or file: a line that opens it.
                    group {
                        size: 236, 22
                        show: m.file
                        zone box fz { from: -6, -3; size: 248, 28; cursor: pointer; label: "Open it"; carries: "{m.full}" }
                        text m.text { at: 0, 11; anchor: left center; width: 236; lines: 1; size: 13.5; weight: 600; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: 88% + 12% * fz.hover }
                        on press fz { emit wa_media(m.index) }
                        on enter fz { emit wa_prefetch(m.index) }
                    }
                    text m.text { size: 13.5; weight: 400; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: if(m.faint, 55%, 100%); selectable: true; show: m.has_text and not m.long and not m.file }
                    text m.text { width: 420; size: 13.5; weight: 400; line_height: 1.3; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: if(m.faint, 55%, 100%); selectable: true; show: m.has_text and m.long and not m.file }
                    text m.time { size: 9.5; weight: 500; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: if(m.me, 70%, 42%); show: m.tail and not (m.img and not m.has_text) }
                }
            }
            //  Under the last one sent: Delivered, Read.
            group {
                show: m.has_status
                size: 624, 17
                text m.status { at: 620, 9; anchor: right center; size: 10; weight: 600; family: "SF Pro Text"; color: ink; opacity: 45% }
            }
            //  The room after it: close within a run, more between runs.
            group { size: 624, if(m.day, 0, if(m.tail, 8, 2)) }
        }
        }
        //  The chat's cursor. Each step is worked out by the row it crosses, which knows its own
        //  height (`wa_cy` is the chosen row's top, from the chat's bottom); then the chosen one
        //  keeps itself in sight, and a day's row passes the cursor on.
        let sh = if(wa_snap, wmc.height, hs)
        on wa_k while wa_cur == m.index + 1 { wa_cy = wa_cy + sh; wa_cur = m.index; wa_dir = -1 }
        on wa_j while wa_cur == m.index and m.index + 1 < wam.count { wa_cy = wa_cy - sh; wa_cur = m.index + 1; wa_dir = 1 }
        on wa_last while m.index == wam.count - 1 { wa_cur = m.index; wa_cy = sh; wa_dir = 1; wfb: 0 ~quick }
        on wa_first while m.index == 0 and wam.count > 1 { wa_cur = 1; wa_cy = wml.height - sh; wa_dir = 1 }
        on change wa_cur while wa_cur == m.index and m.day and wa_dir < 0 and m.index > 0 { emit wa_k }
        on change wa_cur while wa_cur == m.index and m.day and (wa_dir > 0 or m.index == 0) and m.index + 1 < wam.count { emit wa_j }
        on change wa_cy while wa_cur == m.index and not m.day and wa_focus and not wa_typing { wfb: clamp(max(min(wfb, wa_cy - sh - 30), wa_cy - wvh + 30), 0, wmax) ~quick }
        on wa_center while wa_cur == m.index { wfb: clamp(wa_cy - sh / 2 - wvh / 2, 0, wmax) ~quick }
        //  A message come at the bottom: the chosen one's top is that much further from it.
        on change wam.count while wa_cur >= 0 and m.index == wam.count - 1 and wa_cur < m.index { wa_cy = wa_cy + wmc.height }
    }

    //  A tile of a mail as Gmail shows it, and a link on it: a zone over its words, lit faintly under the pointer.
    component WebTile(t: record) {
        //  Always drawn under the finer one too: hidden while that was still on its way, the page went blank.
        image t.pic { at: 0, t.index * 600; size: 620, 602; opacity: if(t.index * 600 > mvb or t.index * 600 + 602 < mvt, 0, 1) }
    }
    //  A GIF of the mail that moves, over the photograph: its 400 cell drawn so the picture fills its place.
    component WebAnim(a: record) {
        let wide = a.iw > a.ih
        let cs = if(wide, a.w, a.h)
        group {
            opacity: if(a.y > mvb or a.y + a.h < mvt, 0, 1)
            clip box { from: a.x, a.y; size: a.w, a.h }
            image a.pic { at: a.x + (a.w - cs) / 2, a.y + (a.h - cs) / 2; size: cs, cs }
        }
    }

    //  The same tile photographed finer, drawn at the focused view's size.
    component ZoomTile(t: record) {
        //  Shown once the view has settled; before that, drawn all but invisibly so it is already loaded then.
        image t.pic { at: 0, t.index * 600 * mzs; size: 620 * mzs, 602 * mzs; opacity: if(t.index * 600 > mvb or t.index * 600 + 602 < mvt, 0, if(zin > 0.98 and mxf > 0.98, 1, if(mxf > 0.5, 0.004, 0))) }
    }
    component WebLink(k: record) {
        zone box z { from: k.x - 2, k.y - 1; size: k.w + 4, k.h + 2; corner: 4 continuous; cursor: pointer; label: "Link" }
        box { from: k.x - 2, k.y - 1; size: k.w + 4, k.h + 2; corner: 4 continuous; color: link_c; opacity: 16% * z.hover + 10% * z.pressed }
        on press z { emit mail_wlink(k.index) }
    }

    //  A piece of a mail's body: a run of its words (markdown, so its links are links, in the
    //  island's blue), or one of its pictures, fitted to the width and no taller than 560.
    component MailBlock(b: record, bw: number) {
        let dw = min(min(b.iw, bw), b.iw * 560 / max(1, b.ih))
        let dh = dw * b.ih / max(1, b.iw)
        //  The cell (520:480) around the fitted picture: as wide as it, or as tall, centred on it.
        let wide = b.iw * 480 > b.ih * 520
        let cw = if(wide, dw, dh * 520 / 480)
        let chh = if(wide, dw * 480 / 520, dh)
        column {
            text b.md { width: bw; size: 12.5; weight: 500; line_height: 1.42; family: "SF Pro Display"; color: ink; markdown: true; selectable: true; link: link_c; show: not b.img }
            group {
                size: bw, if(b.img, dh, 0)
                show: b.img
                zone box pz { from: 0, 0; size: dw, dh; corner: 10 continuous; cursor: pointer; label: "Open the picture's link"; active: b.img and b.linked }
                group {
                    clip box { from: 0, 0; size: dw, dh; corner: 10 continuous }
                    image b.pic { at: (dw - cw) / 2, (dh - chh) / 2; size: cw, chh }
                }
                on press pz { emit mail_img(b.index) }
            }
        }
    }

    component Tile(title: text, sub: text, lit: bool, pick: event, power: event, glyph: number) {
        //  A slim pill: the radio's bead, its name, what it is on, a chevron to its page.
        size: 184, 34
        zone box t { from: 0, 0; size: 184, 34; corner: 17 continuous; cursor: pointer; label: "{title}" }
        prop lift = 0 ~160ms
        follow lift = t.hover - t.pressed
        body {
            color: mix(chip, chip_hi, max(lift, 0)); glass: 25%; blur: 0%
            light: 4%, 0, 17; shadow: 0, 1.5 + 0.5 * lift, 6 + 2 * lift, 21%
            box { from: 0, 0; size: 184, 34; corner: 17 continuous }
        }
        prop glow = 0 ~280ms
        follow glow = if(lit, 1, 0)
        //  The radio's button: a bead of softly tinted glass when on, a plain chip when off.
        body {
            gradient: 6, 6 to 28, 28, mix(chip_hi, soft_l, glow), mix(chip_hi, soft_s, glow)
            glass: 25%; blur: 0%; light: 7%, 5, 12; shadow: 0, 1 + 0.5 * p.hover, 3.5, 26%
            ellipse { at: 17, 17; radius: 12 + 0.3 * p.hover - 0.5 * p.pressed }
        }
        zone ellipse p { at: 17, 17; radius: 13; cursor: pointer; label: "{title} on or off"; role: toggle; checked: lit }
        group {
            show: glyph == 0
            opacity: 55% + 45% * glow
            ellipse { at: 17, 21; radius: 1.3; color: mix(ink, pearl_ink, glow) }
            arc { at: 17, 21; radius: 3.8; span: 90deg; width: 1.4; color: mix(ink, pearl_ink, glow) }
            arc { at: 17, 21; radius: 6.6; span: 90deg; width: 1.4; color: mix(ink, pearl_ink, glow) }
            arc { at: 17, 21; radius: 9.4; span: 90deg; width: 1.4; color: mix(ink, pearl_ink, glow) }
        }
        path {
            show: glyph == 1
            at: 17, 17; stroke: 1.4; color: mix(ink, pearl_ink, glow); opacity: 55% + 45% * glow
            move -3, -3; line 3, 3; line 0, 6; line 0, -6; line 3, -3; line -3, 3
        }
        text title { at: 36, 17; anchor: left center; size: 12; weight: 600; family: "SF Pro Display"; color: ink }
        text sub { at: 162, 17; anchor: right center; width: 66; lines: 1; align: right; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: 55% }
        path { at: 171, 17; stroke: 1.5; color: ink; opacity: 30% + 30% * t.hover; move -1.8, -4.5; line 2.7, 0; line -1.8, 4.5 }
        on press t { emit pick }
        on press p { emit power }
    }

    //  A page's header: back, its title, the scanning dots, and the radio's switch.
    component Header(title: text, lit: bool, busy: bool, back: event, power: event) {
        size: 352, 32
        zone ellipse b { at: 14, 16; radius: 14; cursor: pointer; label: "Back" }
        body {
            color: mix(chip, chip_hi, b.hover); glass: 25%; blur: 0%
            light: 4%, 2, 14; shadow: 0, 1.2 + 0.5 * b.hover - b.pressed, 4.2, 21%
            ellipse { at: 14, 16; radius: 14 - 0.6 * b.pressed }
        }
        path { at: 14, 16; stroke: 1.8; color: ink; opacity: 70% + 30% * b.hover; move 2, -5.5; line -3, 0; line 2, 5.5 }
        text title { at: 36, 16; anchor: left center; size: 15; weight: 600; family: "SF Pro Display"; color: ink }
        //  Searching: a sonar. Two rings keep leaving a small emitter beside the
        //  switch, and a beam of light glides along the hairline under the header.
        //  They only move while a scan is under way.
        prop scan = 0 ~280ms
        follow scan = if(busy, 1, 0)
        prop ping1 = 1 ~1100ms
        prop ping2 = 1 ~1100ms
        every 1.2s while busy and expanded { ping1: 0 ~1ms; ping1: 1 after 20ms; ping2: 0 ~1ms after 600ms; ping2: 1 after 620ms }
        fact beam_right = false
        prop beam = 0 ~1150ms
        follow beam = if(beam_right, 1, 0)
        every 1.2s while busy and expanded { toggle beam_right }
        group {
            opacity: scan
            ellipse { at: 292, 16; radius: 2.2; color: tint_ink }
            ellipse { at: 292, 16; radius: 3 + 11 * ping1; stroke: 1.2; color: tint_ink; opacity: 70% * (1 - ping1) }
            ellipse { at: 292, 16; radius: 3 + 11 * ping2; stroke: 1.2; color: tint_ink; opacity: 70% * (1 - ping2) }
        }
        group {
            opacity: scan
            blur: 3
            mode: screen
            ellipse { at: 8 + 328 * beam, 38; radius: 4; scale: 9, 0.45; color: soft_l }
        }

        //  The switch: a capsule track, and a capsule knob of white glass that
        //  stretches as it slides and swells under the finger.
        prop knob = 0 ~240ms
        follow knob = if(lit, 1, 0)
        prop kstretch = 0 ~120ms
        follow kstretch = clamp(abs(vel(knob)) / 5, 0, 1)
        zone box s { from: 308, 3; size: 48, 26; corner: 13 continuous; cursor: pointer; label: "{title} on or off"; role: toggle; checked: lit }
        //  Off, a groove pressed into the card; on, it fills with softly tinted glass.
        body {
            gradient: 308, 3 to 356, 29, mix(shade, mix(#b9bac4, lilac, 0.45), knob), mix(shade, mix(#9d9ea9, sunset, 0.42), knob)
            glass: 25% * knob; blur: 0%; light: 5%, 3, 13
            box { from: 308, 3; size: 48, 26; corner: 13 continuous }
        }
        body { color: well; opacity: 35% * (1 - knob); box { from: 314, 3; size: 36, 2; corner: 1 continuous } }
        let kw = 26 + 8 * kstretch + 4 * s.pressed
        let kh = 20 - 2 * kstretch + 2 * s.pressed
        body {
            color: ink; glass: 25%; blur: 0%; light: 6%, 6, 10; shadow: 0, 1, 3, 26%
            box { at: 324 + 16 * knob, 16; size: kw, kh; corner: kh / 2 continuous }
        }
        on press b { emit back }
        on press s { emit power }
    }

    //  Expanded rows: persistent workspace header, then the face that is showing.
    let row_tiles = 44
    let row_wx = 90           // under the slim Wi-Fi / Bluetooth pills
    let row_media = row_wx + wx_h
    let row_stats = row_wx + 8 + wx_h + 140 * media_in
    let tx = ex0 + 192
    let ty = row_media + 106
    //  The card's scrubber, as iOS draws Now Playing: a capsule of light that
    //  thickens under the pointer and more while held; the times underneath.
    let py = row_media + 66
    let cl_l = ex0 + 20
    let cl_w = 344
    let craw = (pointer.x - cl_l) / cl_w        // where the pointer is along it (only inside a rule)

    group {
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group {
            opacity: smooth(0.5, 1, open) * (1 - 0.3 * cdim)
            move: 0, 8 * (1 - open)

            //  The header, one calm row: the apps' tray icons on the left (a click
            //  is the app's own, the right button opens its menu); the time on the
            //  right, and the notifications button beside it while some wait.
            text clock.time {
                at: exr - 20, 22; anchor: right center
                size: 13; weight: 600; family: "SF Pro Display"; color: ink
            }
            let bell_w = 50
            let bell_x = exr - 20 - clockm.width - 12 - bell_w
            group {
            show: n_count > 0
            body {
                color: mix(mix(chip, chip_hi, bell_z.hover), lilac, 0.18 * (n_count > 0)); glass: 25%; blur: 0%; light: 4%, 6, 12; shadow: 0, 1.2, 4, 18%
                box { from: bell_x, 10; size: bell_w, 24; corner: 12 continuous }
            }
            image ic_bell { at: bell_x + 9, 15; size: 14, 14; tint: ink; opacity: 85% }
            text number(n_count, 0, "") { at: bell_x + 35, 22; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink }
            }
            zone box bell_z { from: bell_x, 10; size: bell_w, 24; corner: 12 continuous; cursor: pointer; label: "Notifications"; active: expanded and n_count > 0 }
            //  Only on the home face: the other pages have their own business.
            prop tfan = 0 ~260ms
            group {
                opacity: smooth(0.5, 1, on_home)
                zone box tray_z { from: ex0 + 14, 7; size: 34 + max(0, trayi.count - 1) * 30, 30; corner: 15 continuous; label: "Background apps"; active: trayi.count > 0 and panel == home }
                group {
                    move: ex0 + 18, 9
                    for t in trayi { TrayIcon(t) }
                }
            }
            follow tfan = if(tray_z.hover or tmenu_open, 1, 0)

            //  The two Control Center pages, as iOS stacks them: a small column on
            //  the right edge says which one shows and switches; so does the wheel.
            zone box cc_z { from: ex0, 40; size: max(cwp, rest_w), max(0, ph - 40); label: "Control Center"; active: expanded and (panel == home or panel == ctl) }
            on scroll cc_z while panel == home and wheel < 0 and not mail_z.hover { panel = ctl }
            on press wx_z { emit wx_refresh }
            on scroll cc_z while panel == ctl and wheel > 0 { panel = home }

            group {
            move: 0, hdr2
            //  ── the home face ──
            group {
                opacity: smooth(0.4, 1, on_home)
                move: -28 * max(0, 1 - on_home - on_ctl), -26 * on_ctl

                group {
                    move: ex0 + 16, row_tiles
                    Tile("Wi-Fi", wifi_label, wifi_on, open_wifi, wifi_power, 0)
                    group {
                        move: 196, 0
                        Tile("Bluetooth", bt_label, bt_on, open_bt, bt_power, 1)
                    }
                }

                //  The widgets: the weather across with its next hours, the news under it. Each a pane of the card's
                //  own glass; the weather's sky only a wash in it.
                group {
                    move: ex0 + 16, row_wx

                    //  ── Weather: where, how warm, the sky, the day's high and low, the next hours ──
                    zone box wx_z { from: 0, 0; size: 380, 110; corner: 22 continuous; cursor: pointer; label: "Weather (click to refresh)"; active: expanded and panel == home }
                    prop wlift = 0 ~160ms
                    follow wlift = wx_z.hover - wx_z.pressed
                    body {
                        color: mix(chip, chip_hi, max(wlift, 0)); glass: 25%; blur: 0%
                        light: 4%, 0, 24; shadow: 0, 1.8 + 0.5 * wlift, 7 + 2 * wlift, 21%
                        box { from: 0, 0; size: 380, 110; corner: 22 continuous }
                    }
                    prop sk0 = 1 ~600ms
                    prop sk1 = 0 ~600ms
                    prop sk2 = 0 ~600ms
                    prop sk3 = 0 ~600ms
                    follow sk0 = if(wx_sky == 0, 1, 0)
                    follow sk1 = if(wx_sky == 1, 1, 0)
                    follow sk2 = if(wx_sky == 2, 1, 0)
                    follow sk3 = if(wx_sky == 3, 1, 0)
                    body { gradient: 0, 0 to 380, 110, #5aa2ff, mix(#5aa2ff, lilac, 0.5); opacity: 26% * sk0; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    body { gradient: 0, 0 to 380, 110, #3a3f88, mix(#3a3f88, lilac, 0.35); opacity: 30% * sk1; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    body { gradient: 0, 0 to 380, 110, #8a97ab, #5d6880; opacity: 22% * sk2; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    body { gradient: 0, 0 to 380, 110, #56708f, #2f3d52; opacity: 28% * sk3; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    //  A clear day: the sun's warmth, softly, from its corner.
                    group {
                        opacity: sk0 * if(wx_ic == 0, 1, if(wx_ic == 2, 0.6, 0))
                        clip box { from: 0, 0; size: 380, 110; corner: 22 continuous }
                        repeat k in 0..5 { ellipse { at: 354, 22; radius: 16 + 11 * k; color: soft_s; opacity: 7% - k } }
                    }
                    //  One band: how warm, large, and beside it where and the sky in words;
                    //  on the right the sky's symbol over the day's high and low. An even
                    //  18 px inset at the sides, ~14 above and below, as iOS's widgets keep;
                    //  space, not a rule, between the band and the hours.
                    text wx_temp { at: 18, 31; anchor: left center; size: 32; weight: 300; family: "SF Pro Display"; color: ink; measure: wxtm }
                    let wtx = 18 + wxtm.width + 10
                    path { at: wtx, 17; color: ink; move 0, 3.8; line 8.6, 0; line 4.5, 8.6; line 3.8, 4.5; close }
                    text wx_city { at: wtx + 14, 21.5; anchor: left center; width: max(40, 326 - wtx - 14); lines: 1; size: 12.5; weight: 600; family: "SF Pro Display"; color: ink }
                    text wx_cond { at: wtx, 39; anchor: left center; width: max(40, 290 - wtx); lines: 1; size: 11.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: 72% }
                    group {
                        move: 342, 12
                        image wx_sun { at: 0, 0; size: 20, 20; show: wx_ic == 0 }
                        image wx_moon { at: 0, 0; size: 20, 20; show: wx_ic == 1 }
                        image wx_csun { at: 0, 0; size: 20, 20; show: wx_ic == 2 }
                        image wx_cmoon { at: 0, 0; size: 20, 20; show: wx_ic == 3 }
                        image wx_cloud { at: 0, 0; size: 20, 20; show: wx_ic == 4 }
                        image wx_rain { at: 0, 0; size: 20, 20; show: wx_ic == 5 }
                        image wx_snow { at: 0, 0; size: 20, 20; show: wx_ic == 6 }
                        image wx_storm { at: 0, 0; size: 20, 20; show: wx_ic == 7 }
                        image wx_fog { at: 0, 0; size: 20, 20; show: wx_ic == 8 }
                    }
                    text wx_hilo { at: 362, 39; anchor: right center; size: 11; weight: 600; family: "SF Pro Display"; color: tint_ink }
                    row {
                        at: 19, 56; gap: 0
                        for h in wxh { WxHour(h) }
                    }

                    //  ── Mail: the Gmail inbox, a list that scrolls (wheel or drag); a click
                    //  opens one in the reader, ↑ goes back to the newest ──
                    group {
                        move: 0, 122
                        //  Anywhere on it but a mail: the large view, on the mail chosen last (the newest the first time).
                        zone box mail_z { from: 0, 0; size: 380, 222; corner: 22 continuous; cursor: pointer; label: "Open Mail"; active: expanded and panel == home }
                        on press mail_z { panel = mailx; mr_rep = false; mx_focus = false }
                        body {
                            color: chip; glass: 25%; blur: 0%
                            light: 4%, 0, 24; shadow: 0, 1.8, 7, 21%
                            box { from: 0, 0; size: 380, 222; corner: 22 continuous }
                        }
                        image ic_mail { at: 18, 15; size: 15, 15; tint: tint_ink }
                        text "INBOX" { at: 40, 22.5; anchor: left center; size: 10; weight: 700; family: "SF Pro Display"; color: tint_ink }
                        column ml ~spring(900, 60) {
                            at: 8, 42; view: 364, 172; gap: 1; step: 0
                            for m in mail { MailRow(m) }
                        }
                        on scroll mail_z { mtick = mtick + 1 }
                        on scroll mail_z while not mlock and wheel < 0 and mpage < ceil(mail.count / 4) - 1 { mpage = mpage + 1; mlock = true }
                        on scroll mail_z while not mlock and wheel > 0 and mpage > 0 { mpage = mpage - 1; mlock = true }
                        on still mtick for 200ms while mlock { mlock = false }
                        //  Where the page is, always (it overrides the list's own wheel): the last page sits flush with the end.
                        follow ml.scroll = min(mpage * 172, max(0, ml.content - 172))
                        //  How many wait: a small bead of the island's light, right; it steps aside for ↑.
                        measure mcm
                        let mc_w = mcm.width + 18
                        let mc_x = 362 - mc_w - 28 * smooth(4, 40, ml.scroll)
                        group {
                            show: mail_unread > 0
                            body {
                                gradient: mc_x, 12 to mc_x + mc_w, 33, soft_l, soft_s
                                glass: 25%; blur: 0%; light: 4%, 12, 10; shadow: 0, 1, 3.5, 20%
                                box { from: mc_x, 12; size: mc_w, 21; corner: 10.5 continuous }
                            }
                            text "{mail_unread} unread" { at: mc_x + 9, 22.5; anchor: left center; size: 10; weight: 700; family: "SF Pro Display"; color: pearl_ink; measure: mcm }
                        }
                        //  Where in the list: a thin bar at the edge, while there is more than shows.
                        box {
                            from: 374, 44 + 168 * ml.scroll / max(1, ml.content); size: 2.5, 168 * min(1, 172 / max(1, ml.content)); corner: 1.25 continuous
                            color: ink; opacity: if(ml.content > 176, 22%, 0)
                        }
                        //  Back to the newest, once scrolled away from them.
                        group {
                            opacity: smooth(4, 40, ml.scroll)
                            zone ellipse mtop_z { at: 358, 22.5; radius: 11; cursor: pointer; label: "Back to the newest"; active: expanded and panel == home and ml.scroll > 4 }
                            body {
                                color: mix(chip, chip_hi, mtop_z.hover); glass: 25%; blur: 0%; light: 4%, 12, 11; shadow: 0, 1 + 0.5 * mtop_z.hover - mtop_z.pressed, 3.5, 21%
                                ellipse { at: 358, 22.5; radius: 11 - 0.4 * mtop_z.pressed }
                            }
                            path { at: 358, 22.5; stroke: 1.5; color: ink; opacity: 80%; move -3.5, 1.5; line 0, -2; line 3.5, 1.5 }
                            on press mtop_z { mpage = 0 }
                        }
                        //  Nothing to list: why (not set up yet, can't reach it, an empty inbox).
                        text mail_state {
                            at: 190, 122; anchor: center; width: 320; lines: 3; align: center
                            size: 12; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(mail.count == 0, 55%, 0)
                        }
                    }
                }

                // media: cover, track, transport
                group {
                    opacity: media_in
                    let cart_w = 48 * art_k
                    box { from: ex0 + 20, row_media; size: cart_w, 48; corner: 12 continuous; color: teal; opacity: if(has_art, 0, 22%) }
                    //  The art, its own shape (a square cover, a 16:9 frame), corners rounded.
                    group {
                        clip box { from: ex0 + 20, row_media; size: cart_w, 48; corner: 12 continuous }
                        image cover { at: ex0 + 20 + cart_w / 2 - 43, row_media; size: 86, 48; show: has_art }
                    }
                    box { from: ex0 + 20, row_media; size: cart_w, 48; corner: 12 continuous; stroke: 0.6; color: ink; opacity: 12%; show: has_art }
                    text media.title {
                        at: ex0 + 34 + cart_w, row_media + 14; anchor: left center; width: 328 - cart_w; lines: 1
                        size: 14.5; weight: 600; family: "SF Pro Display"; color: ink
                    }
                    text media.artist {
                        at: ex0 + 34 + cart_w, row_media + 35; anchor: left center; width: 328 - cart_w; lines: 1
                        size: 12.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: 62%
                    }

                    //  Where the song is. Dragged, it follows the pointer and the song
                    //  jumps on release; pulled past an end, it stretches a little.
                    group {
                        show: media.length > 0
                        let sk_h = 6 + 3 * cseek_z.hover + 3 * scrub_s          // thickens: hovered, then held
                        let sk_x = cl_l - stretch_l
                        let sk_w = cl_w + stretch_l + stretch_r
                        //  The groove, pressed into the glass.
                        box { from: sk_x, py - sk_h / 2; size: sk_w, sk_h; corner: sk_h / 2 continuous; color: well; opacity: 24% }
                        box { from: sk_x, py - sk_h / 2; size: sk_w, sk_h; corner: sk_h / 2 continuous; color: ink; opacity: 12% + 4% * cseek_z.hover }
                        //  What has played: bright glass.
                        group {
                            clip box { from: sk_x, py - sk_h / 2; size: sk_w, sk_h; corner: sk_h / 2 continuous }
                            body {
                                gradient: sk_x, py - sk_h / 2 to sk_x, py + sk_h / 2, #ffffff, mix(ink, pearl, 0.5)
                                opacity: 90% + 8% * scrub_s
                                box { from: sk_x - sk_h, py - sk_h / 2; size: max(0.01, sk_h + stretch_l + cl_w * cprog), sk_h; corner: sk_h / 2 continuous }
                            }
                        }
                        text "{cur, time}" { at: cl_l, py + 15; anchor: left center; size: 10.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 50% + 30% * max(cseek_z.hover, scrub_s) }
                        text "-{rem, time}" { at: cl_l + cl_w, py + 15; anchor: right center; size: 10.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 50% + 30% * max(cseek_z.hover, scrub_s) }
                        zone box cseek_z { from: cl_l - 6, py - 12; size: cl_w + 12, 24; cursor: pointer; label: "Seek"; active: has_player and expanded and media.length > 0 }
                    }

                    //  Transport: three beads of glass, the middle one larger.
                    body { color: mix(chip, chip_hi, prev_z.hover); glass: 25%; blur: 0%; light: 4%, ty - 18, 18; shadow: 0, 1.8 + prev_z.hover - prev_z.pressed, 6.3, 21%
                           ellipse { at: tx - 46, ty; radius: 18 - 0.8 * prev_z.pressed } }
                    body { color: mix(chip_hi, #5a5a64, play_z.hover); glass: 25%; blur: 0%; light: 5%, ty - 20, 20; shadow: 0, 2.4 + play_z.hover - play_z.pressed, 7.7, 23%
                           ellipse { at: tx, ty; radius: 20 - 0.8 * play_z.pressed } }
                    body { color: mix(chip, chip_hi, next_z.hover); glass: 25%; blur: 0%; light: 4%, ty - 18, 18; shadow: 0, 1.8 + next_z.hover - next_z.pressed, 6.3, 21%
                           ellipse { at: tx + 46, ty; radius: 18 - 0.8 * next_z.pressed } }
                    box { at: tx - 53, ty; size: 2.6, 12; corner: 1.3 continuous; color: ink }
                    path { at: tx - 43, ty; color: ink; move 4.5, -6; line -5, 0; line 4.5, 6; close }
                    path { at: tx + 1.5, ty; color: ink; show: not media.playing; move -5, -7.5; line 7.5, 0; line -5, 7.5; close }
                    box { at: tx - 4, ty; size: 4, 14; corner: 2 continuous; color: ink; show: media.playing }
                    box { at: tx + 4, ty; size: 4, 14; corner: 2 continuous; color: ink; show: media.playing }
                    path { at: tx + 43, ty; color: ink; move -4.5, -6; line 5, 0; line -4.5, 6; close }
                    box { at: tx + 53, ty; size: 2.6, 12; corner: 1.3 continuous; color: ink }
                    zone ellipse prev_z { at: tx - 46, ty; radius: 18; cursor: pointer; label: "Previous"; active: has_player and expanded }
                    zone ellipse play_z { at: tx,      ty; radius: 20; cursor: pointer; label: "Play or pause"; active: has_player and expanded }
                    zone ellipse next_z { at: tx + 46, ty; radius: 18; cursor: pointer; label: "Next"; active: has_player and expanded }
                }

                //  The stats on the left, as one group: three rings (the battery is the right capsule's), like an activity
                //  ring, each filling with its share. The session on the right.
                group {
                    move: ex0 + 16, row_stats
                    //  The sound ring lights up under the pointer: it scrolls the volume.
                    ellipse { at: 108, 24; radius: 22; color: ink; opacity: 5% * vol_z.hover + 4% * vol_z.pressed }
                    ellipse { at: 20, 18; radius: 14; stroke: 2.6; color: ink; opacity: 9% }
                    arc { at: 20, 18; radius: 14; span: clamp(cpu_s, 0.012, 1) * 360deg; rotate: clamp(cpu_s, 0.012, 1) * 180deg; width: 2.6; color: if(cpu_i >= 4, coral, if(cpu_i >= 3, amber, soft_l)); opacity: 95% }
                    text number(cpu, 0, "%") { at: 20, 18; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: if(cpu_i >= 4, coral, if(cpu_i >= 3, amber, ink)); opacity: 100% }
                    text "CPU" { at: 20, 42; anchor: center; size: 7; weight: 600; family: "SF Pro Display"; color: ink; opacity: 42% }
                    ellipse { at: 64, 18; radius: 14; stroke: 2.6; color: ink; opacity: 9% }
                    arc { at: 64, 18; radius: 14; span: clamp(mem_s, 0.012, 1) * 360deg; rotate: clamp(mem_s, 0.012, 1) * 180deg; width: 2.6; color: if(mem_i >= 4, coral, if(mem_i >= 3, amber, soft_l)); opacity: 95% }
                    text number(mem, 1, "G") { at: 64, 18; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: if(mem_i >= 4, coral, if(mem_i >= 3, amber, ink)); opacity: 100% }
                    text "MEMORY" { at: 64, 42; anchor: center; size: 7; weight: 600; family: "SF Pro Display"; color: ink; opacity: 42% }
                    ellipse { at: 108, 18; radius: 14; stroke: 2.6; color: ink; opacity: 9% }
                    arc { at: 108, 18; radius: 14; span: clamp(vol_s, 0.012, 1) * 360deg; rotate: clamp(vol_s, 0.012, 1) * 180deg; width: 2.6; color: soft_l; opacity: 95% * if(audio.muted, 40%, 100%) }
                    text number(audio.volume * 100, 0, "") { at: 108, 18; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 100% * if(audio.muted, 40%, 100%) }
                    text pick(audio.muted, "SOUND", "MUTED") { at: 108, 42; anchor: center; size: 7; weight: 600; family: "SF Pro Display"; color: ink; opacity: 42% }
                    zone ellipse vol_z { at: 108, 24; radius: 22; cursor: pointer; label: "Volume"; active: expanded }
                    //  What is connected and has a battery (headphones, a mouse): one more ring each.
                    row {
                        at: 138, 0; gap: 0
                        for b in bats { BatMini(b) }
                    }

                    //  Switch compositor, log out, restart, power off: beads like the media buttons. They
                    //  cannot be undone, so they act on a hold: a red ring fills round
                    //  the button while it is held, and drains away if let go early.
                    prop hold_sw = 0 ~700ms
                    prop hold_out = 0 ~700ms
                    prop hold_re = 0 ~700ms
                    prop hold_off = 0 ~700ms
                    follow hold_sw = sw_z.pressed
                    follow hold_out = out_z.pressed
                    follow hold_re = re_z.pressed
                    follow hold_off = off_z.pressed
                    body {
                        color: mix(chip, chip_hi, sw_z.hover); glass: 25%; blur: 0%; light: 4%, 8, 16
                        shadow: 0, 1.8 + 0.5 * sw_z.hover - sw_z.pressed, 6, 21%
                        ellipse { at: 216, 24; radius: 16 - 0.6 * sw_z.pressed }
                    }
                    arc { at: 216, 24; radius: 19.5; span: hold_sw * 360deg; rotate: hold_sw * 180deg; width: 2; color: coral; opacity: if(hold_sw > 0.02, 90%, 0%) }
                    body {
                        color: mix(chip, chip_hi, out_z.hover); glass: 25%; blur: 0%; light: 4%, 8, 16
                        shadow: 0, 1.8 + 0.5 * out_z.hover - out_z.pressed, 6, 21%
                        ellipse { at: 256, 24; radius: 16 - 0.6 * out_z.pressed }
                    }
                    arc { at: 256, 24; radius: 19.5; span: hold_out * 360deg; rotate: hold_out * 180deg; width: 2; color: coral; opacity: if(hold_out > 0.02, 90%, 0%) }
                    body {
                        color: mix(chip, chip_hi, re_z.hover); glass: 25%; blur: 0%; light: 4%, 8, 16
                        shadow: 0, 1.8 + 0.5 * re_z.hover - re_z.pressed, 6, 21%
                        ellipse { at: 296, 24; radius: 16 - 0.6 * re_z.pressed }
                    }
                    arc { at: 296, 24; radius: 19.5; span: hold_re * 360deg; rotate: hold_re * 180deg; width: 2; color: coral; opacity: if(hold_re > 0.02, 90%, 0%) }
                    body {
                        color: mix(chip, chip_hi, off_z.hover); glass: 25%; blur: 0%; light: 4%, 8, 16
                        shadow: 0, 1.8 + 0.5 * off_z.hover - off_z.pressed, 6, 21%
                        ellipse { at: 336, 24; radius: 16 - 0.6 * off_z.pressed }
                    }
                    arc { at: 336, 24; radius: 19.5; span: hold_off * 360deg; rotate: hold_off * 180deg; width: 2; color: coral; opacity: if(hold_off > 0.02, 90%, 0%) }
                    //  Their symbols: SVGs with round caps and joins, as Apple draws them.
                    image cc_switch { at: 207, 15; size: 18, 18; tint: ink; opacity: 88% }
                    image ic_out { at: 247, 15; size: 18, 18; tint: ink; opacity: 88% }
                    image ic_re { at: 287, 15; size: 18, 18; tint: ink; opacity: 88% }
                    image ic_off { at: 327, 15; size: 18, 18; tint: ink; opacity: 88% }
                    zone ellipse sw_z { at: 216, 24; radius: 16; cursor: pointer; label: "Switch compositor (hold)"; active: expanded }
                    zone ellipse out_z { at: 256, 24; radius: 16; cursor: pointer; label: "Log out (hold)"; active: expanded }
                    zone ellipse re_z { at: 296, 24; radius: 16; cursor: pointer; label: "Restart (hold)"; active: expanded }
                    zone ellipse off_z { at: 336, 24; radius: 16; cursor: pointer; label: "Power off (hold)"; active: expanded }
                }
            }

            //  ── the pages ──
            include "pages/wifi.plm"
            include "pages/bluetooth.plm"
            include "pages/launcher.plm"
            include "pages/notes.plm"
            include "pages/mail.plm"
            include "pages/mailx.plm"
            include "pages/whatsapp.plm"
            include "pages/undo.plm"
            include "pages/controls.plm"
            include "pages/timer.plm"
            include "pages/camera.plm"
            include "pages/awake.plm"
            include "pages/wall.plm"
            include "pages/capture.plm"
            include "pages/mixer.plm"
            include "pages/auth.plm"
            }
        }
    }

    // A controlled glide with a small velocity-driven deformation.
    // No overshoot, vertical hop, or brightness pulse; circular at rest.
    // Slot coordinates keep sparse workspace IDs beside their actual labels.
    //  The workspaces, as a page control: the one you are on is a capsule of
    //  the pearl glass the switches use, with its number; the others are dots,
    //  which turn back into numbers while the pointer is on the rail.
    prop rh = 0 ~220ms
    follow rh = ws_z.hover
    let ws_s = 14 + 8 * rh            // a slot: a dot, or a number while hovered
    let ws_a = ws_s + 24              // the slot of the one you are on
    prop ws_position = 0 ~280ms
    follow ws_position = ws_slot
    prop ws_squash = 0 ~120ms
    follow ws_squash = clamp(abs(vel(ws_position)) / 14, 0, 1)
    let bubble = clamp(ws_squash, 0, 1)
    //  Slid aside for a tool beside it, a large view can reach the left of the bar: then the rail
    //  rides in its top-left corner, over it, instead of being covered.
    let card_l_t = screen.width / 2 - nudge_t - max(cw_t, rest_w) / 2
    prop ws_in = 0 ~shape
    follow ws_in = if(big and card_l_t < 23 + rail_w + 70, 1, 0)
    let lx = 23 + ex0 * ws_in      // its capsule (drawn 1 px in) 24 from the edge, like the date capsule on the right (cap_r)
    let sel_cx = lx + ws_position * ws_s + ws_a / 2
    let wdy = 7 * max(wo, ws_in)      // open (or in a large view's corner), the rail sits inside the card, not on its edge
    let sel_cy = 17 + wdy
    let sel_w = ws_a - 2 + 10 * bubble    // it stretches as it glides
    let sel_h = 28 - 2 * bubble       // as tall as the battery and date capsule
    //  Hovering the one you are on: a card grows out from under it, in the
    //  dark glass the other cards use, with every window as a live picture.
    //  The rail stays on top as its header. Alt+Tab opens it too.
    prop wo = 0 ~280ms
    follow wo = if(wv, 1, 0)
    let wl = 18 + (lx - 23)                       // the card's left edge, once open
    let wv_w = 524
    let wn_h = max(1, ceil(wins.count / 3)) * 144 - 12
    let wv_th = 62 + if(wins.count == 0, 40, wn_h) + 18 - 3
    prop wv_hh = 200 ~shape
    follow wv_hh = wv_th
    let wcl = mix(sel_cx - sel_w / 2, wl, wo)
    let wcr = mix(sel_cx + sel_w / 2, wl + wv_w, wo)
    let wct = mix(sel_cy - sel_h / 2, 3, wo)
    let wch = mix(sel_h, wv_hh, wo)
    group {
        show: wo > 0.01
        body {
            gradient: wcl, wct to wcr, wct + wch, mix(mix(pearl, lilac, 0.3), dusk, wo), mix(mix(pearl, sunset, 0.3), deep, wo)
            glass: 100%; ripple: 0%; rim: 0%; milk: glass_milk * (1 - wo)
            smoke: card_smoke * wo
            opacity: glass_alpha + (card_alpha - glass_alpha) * wo
            light: 4%, wct, 10
            shadow: 0, 1.5 + 6.5 * wo, 6 + 16 * wo, 18% - 2% * wo
            box { from: wcl, wct; size: wcr - wcl, wch; corner: 14 + 8 * wo continuous }
        }
        body {
            color: rim_grey
            opacity: 45% * wo
            box { from: wcl + 0.5, wct + 0.5; size: wcr - wcl - 1, wch - 1; corner: 13.5 + 8 * wo continuous; stroke: 1 }
        }
    }
    //  Its zone is its whole target shape, so moving down into it keeps it open.
    zone box wv_z { from: wl, 3; size: wv_w, wv_th; corner: 22 continuous; label: "Windows"; active: wv }
    zone box wsel_z { at: sel_cx, sel_cy; size: sel_w, sel_h; corner: sel_h / 2 continuous; label: "Windows on this desktop" }
    on enter wsel_z while not wv { wv = true; emit win_look(0) }
    on leave wv_z while wv and not switching { wv = false }

    zone box ws_z { from: lx - 4, 4 + wdy; size: rail_w + 8, 26; label: "Workspaces" }
    let kr = k_rail * (1 - wo)
    group {
        pivot: lx + rail_w / 2, sel_cy
        scale: 1 - 0.14 * kr
    //  Clear glass, as the island is: the compositor frosts what is behind it,
    //  a faint pearl tint, its lit edge, and the island's prism for a rim.
    body {
        gradient: sel_cx - sel_w / 2, 6 to sel_cx + sel_w / 2, 28, mix(pearl, lilac, 0.3), mix(pearl, sunset, 0.3)
        glass: 100%; ripple: 0%; rim: 0%; milk: glass_milk + 6% * max(0, kr)
        smoke: 16% * max(0, kr)
        opacity: glass_alpha
        light: 4%, 6, 10
        shadow: 0, 1.5, 6, 18%
        box { at: sel_cx, sel_cy; size: sel_w, sel_h; corner: sel_h / 2 continuous }
    }
    body {
        gradient: sel_cx - sel_w / 2, 0 to sel_cx + sel_w / 2, 0, cool, ink 50%, warm
        opacity: 55%
        box { at: sel_cx, sel_cy; size: sel_w - 1, sel_h - 1; corner: (sel_h - 1) / 2 continuous; stroke: 1 }
    }

    // The same rail stays visible through the entire morph, without a crossfade.
    component Desk(i, active: number) {
        size: 14 + 8 * rh + 24 * (active == i), 26
        prop on = 0 ~280ms
        follow on = if(active == i, 1, 0)
        let w = 14 + 8 * rh + 24 * on
        //  On niri the number rolls in from where the windows come from, and the
        //  one left rolls out the other way, as it fades back into a dot.
        let roll = if(ws_vertical, ws_dir * 6 * (1 - on) * if(active == i, 1, 0 - smooth(0, 0.4, on)), 0)
        zone box d { from: 0, 0; size: w, 26; corner: 13 continuous; cursor: pointer; label: "Workspace {i}"; selected: active == i }
        //  Under the pointer (not the one you are on): a faint pill.
        box { from: 1, 3; size: w - 2, 20; corner: 10 continuous; color: ink; opacity: (10% * d.hover + 10% * d.pressed) * (1 - on) }
        ellipse { at: w / 2, 13; radius: 2.6 + 0.4 * d.hover; color: ink; opacity: (50% + 30% * d.hover) * (1 - max(on, rh)) }
        text "{i}" {
            at: w / 2, 13 - 0.5 * d.pressed + roll; anchor: center; size: 12; weight: 600 + 100 * on; family: "SF Pro Display"
            color: ink; opacity: max(on, 75% * rh); shadow: 0, 1, 3, 35%
        }
        on press d { emit go(i) }
    }
    row desks ~calm {
        at: lx, 4 + wdy
        repeat i in 1..11 { Desk(i, ws_active) { show: ws.$i.there or ws_active == i } }
    }

    //  The app you are in, right after the workspaces: its icon, as waybar
    //  showed it. A new app crossfades in, as iOS swaps a glyph: the old one
    //  softens and shrinks a touch as the new one settles in, critically
    //  damped, no bounce. Hovering it, the app's name slides out beside it,
    //  on the bar itself (no capsule), as the clock sits.
    let fx = lx + (14 + 8 * rh) * rail_ws + 24 + 8
    prop fab = 0 ~260ms
    follow fab = if(front_on_b, 1, 0)
    prop fh = 0 ~240ms
    follow fh = front_z.hover
    let fcap_w = 30 + (frm.width + 10) * fh
    group {
        opacity: (1 - smooth(0, 0.4, wo)) * if(front_has, 1, 0)
        group {
            pivot: fx + 9, 17
            scale: 0.9 + 0.1 * (1 - fab)
            opacity: smooth(0.15, 1, 1 - fab)
            blur: 2.5 * fab
            image front_ia { at: fx, 8; size: 18, 18 }
        }
        group {
            pivot: fx + 9, 17
            scale: 0.9 + 0.1 * fab
            opacity: smooth(0.15, 1, fab)
            blur: 2.5 * (1 - fab)
            image front_ib { at: fx, 8; size: 18, 18 }
        }
        group {
            clip box { from: fx + 20, 3; size: max(0, fcap_w - 26), 28 }
            text front_name {
                at: fx + 26 - 6 * (1 - fh), 17; anchor: left center; size: 12.5; weight: 600; family: "SF Pro Display"
                color: ink; opacity: fh; shadow: 0, 1, 3, 35%; measure: frm
            }
        }
    }
    zone box front_z { from: fx - 6, 3; size: fcap_w, 28; corner: 14 continuous; label: "{front_name}"; active: front_has and not wv }
    }

    include "pages/windows.plm"

    //  Hovering the battery: the capsule widens to the left with how long is
    //  left (or until full). Hovering the date: it drops into a calendar card.
    fact bat_peek = false
    fact bat_has = false      // the logic has an estimate to show
    text bat_tip = ""
    event bat_look ->
    measure tipm
    prop bh = 0 ~300ms
    follow bh = if((bat_peek or peek_held) and bat_has, 1, 0)     // hovered, or AltGr held
    let tip_w = (tipm.width + 12) * bh
    fact cal = false
    fact cal_weeks = 5
    fact cal_here = true      // the month shown is this one
    text cal_month = ""
    text cal_year = ""
    model cdays max 42 { d: text; inm: bool; today: bool; ev: bool }
    model upn max 3 { title: text; time: text; when: text; first: bool }
    text upn_empty = "Loading…"
    event cal_step ->
    event cal_look ->
    prop co = 0 ~280ms        // 0 the capsule → 1 the card it grows into (the calendar, or a tool beside a large view)
    follow co = if(cal or side, 1, 0)
    let cal_w = 300
    let upn_h = 40 + max(1, upn.count) * 42 + if(upn.count == 0, 12, 0)   // the Up next list under the month
    let cnews_h = 210         // the news from Mauritius, under Up next
    let cal_th = 92 + cal_weeks * 34 + 8 + upn_h + cnews_h + 6 - cap_y       // its height once open
    prop cal_hh = 260 ~shape
    follow cal_hh = cal_th

    let cap_w = 16 + tip_w + dnd_w + mute_w + bat_gw + 12 + 1 + 12 + datem.width + 16
    let cap_l = cap_r - cap_w
    //  In the calendar the date is the card's: it fades, and the battery slides into its place.
    let cshift = (25 + datem.width) * co
    let bx = cap_l + 16 + tip_w + dnd_w + mute_w + cshift
    let mx = cap_l + 16 + tip_w + dnd_w + 7 + cshift     // the muted glyph's centre
    //  The capsule's drawn shape: the capsule, or the card it grows into.
    //  The other way round (the files fill the centre, then WhatsApp or the mail opens): the files'
    //  card itself slides right into this place (`inv` 1 → 0) instead of growing out of the capsule.
    prop inv = 0 ~shape
    let fl0 = screen.width / 2 - 560        // where the files' card was, in the centre
    let cm = max(co, inv)                   // how much of a card it is: its glass, its corners
    let cg = max(co, if(inv > 0.002, 1, 0))   // sliding in, it is already its whole size: only where it is changes
    let ccw0 = cap_w + (if(side_k > 0, side_w, max(cal_w, cap_w)) - cap_w) * cg
    let cch0 = cap_h + (if(side_k > 0, side_h, cal_hh) - cap_h) * cg
    let ccw = ccw0 + (1120 - ccw0) * inv
    let cch = cch0 + (88 + 458 + 16 - cch0) * inv
    let ccl = cap_r - ccw0 + (fl0 - (cap_r - ccw0)) * inv
    let ccr = 14 + 8 * cm
    //  Plugged in: a sweep of light across the fill, and the rim warms to green.
    prop plug_sweep = 1 ~900ms
    prop plug_glow = 0 ~500ms
    on change battery.charging while battery.charging { plug_sweep: 0 ~1ms; plug_sweep: 1 after 180ms; plug_glow: 1 ~150ms; plug_glow: 0 after 900ms; impulse jolt 5 }
    //  Unplugged: the light runs back out the other way, the rim cools for a
    //  moment, and the battery gives a small settling dip.
    prop unplug_sweep = 1 ~800ms
    prop unplug_glow = 0 ~500ms
    on change battery.charging while not battery.charging { unplug_sweep: 0 ~1ms; unplug_sweep: 1 after 30ms; unplug_glow: 1 ~150ms; unplug_glow: 0 after 600ms; impulse jolt -4 }
    prop jolt = 0 ~band
    //  Low battery: the rim glows coral twice, as iOS warns, while the pill says so.
    prop low_glow = 0 ~260ms
    on change low_seq { low_glow: 1 ~200ms; low_glow: 0.15 after 450ms; low_glow: 1 after 800ms; low_glow: 0 ~700ms after 1500ms }
    //  Muting: the rim brightens for a moment, as it does for the charger.
    prop mute_glow = 0 ~400ms
    on change audio.muted while audio.muted { mute_glow: 1 ~140ms; mute_glow: 0 after 380ms }
    prop cap_hov = 0 ~180ms
    follow cap_hov = stat_z.hover
    let kc = k_cap * (1 - cm)
    group {
        pivot: cap_r, cap_y + cap_h / 2
        scale: 1 - 0.05 * kc, 1 - 0.07 * kc
    //  Grown into the calendar it smokes over into the centre card's dark plum
    //  glass, with its grey rim, so the days read over busy windows.
    body {
        gradient: ccl, cap_y to ccl + ccw, cap_y + cch, mix(mix(pearl, lilac, 0.3), dusk, cm), mix(mix(pearl, sunset, 0.3), deep, cm)
        //  `lens: false`: the compositor blurs; a lens would screenshot the desktop as it moves.
        glass: 100%; ripple: 0%; rim: 0%; milk: (glass_milk + 4% * cap_hov) * (1 - cm) + 6% * max(0, kc)
        smoke: card_smoke * cm + 16% * max(0, kc)
        opacity: glass_alpha + (card_alpha - glass_alpha) * cm
        light: 4%, cap_y, 10
        shadow: 0, 1.5 + 6.5 * cm, 6 + 16 * cm, 18% - 2% * cm
        box { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous }
    }
    body {
        gradient: ccl, 0 to cap_r, 0, mix(mix(mix(cool, charge, plug_glow), ink, unplug_glow), coral, low_glow), mix(ink, coral, low_glow) 50%, mix(mix(mix(warm, charge, plug_glow), ink, unplug_glow), coral, low_glow)
        opacity: (55% + 25% * plug_glow + 18% * unplug_glow + 22% * mute_glow + 40% * low_glow) * (1 - cm)
        box { from: ccl + 0.5, cap_y + 0.5; size: ccw - 1, cch - 1; corner: ccr - 0.5 continuous; stroke: 1 }
    }
    body {
        color: rim_grey
        opacity: 45% * cm
        box { from: ccl + 0.5, cap_y + 0.5; size: ccw - 1, cch - 1; corner: ccr - 0.5 continuous; stroke: 1 }
    }
    //  The battery's estimate, sliding out of the capsule's left end.
    group {
        opacity: smooth(0.35, 1, bh)
        move: 6 * (1 - bh), 0
        clip box { from: cap_l + 2, cap_y; size: max(0, cap_w - 4), cap_h; corner: cap_h / 2 continuous }
        text bat_tip {
            at: cap_l + 16 + cshift, 17; anchor: left center; size: 12.5; weight: 600; family: "SF Pro Display"
            color: ink; shadow: 0, 1, 3, 35%; measure: tipm
        }
    }
    //  What is listening or watching: iOS's dots (green the camera, orange the
    //  microphone, violet the screen), on the bar just left of the capsule,
    //  following its edge as it widens.
    let pdots = camv + micv + scrv
    let dots_l = ccl - 9 - (11 * pdots - 5 * min(pdots, 1))
    group {
        opacity: 1 - smooth(0, 0.4, co)
        ellipse { at: dots_l + 3 * camv, 17; radius: 3 * camv; color: #30d158 }
        ellipse { at: dots_l + 11 * camv + 3 * micv, 17; radius: 3 * micv; color: #ff9f0a }
        ellipse { at: dots_l + 11 * (camv + micv) + 3 * scrv, 17; radius: 3 * scrv; color: #bf5af2 }
    }
    //  Notifications muted: a small moon first.
    image ic_moon { at: cap_l + 15 + tip_w + cshift, 11; size: 12, 12; tint: ink; opacity: 90% * dnd_s }
    //  Sound muted: the speaker grows out of a blur as the capsule makes room,
    //  then a slash draws across, cutting its gap, and the speaker gives a
    //  small flinch as it goes through. Still once it has settled.
    //  It is a button too: a click unmutes. Under the pointer, a pill lights behind it.
    prop mute_hov = 0 ~180ms
    follow mute_hov = mute_z.hover
    box { from: mx - 12, cap_y + 3; size: 24, cap_h - 6; corner: (cap_h - 6) / 2 continuous; color: ink; opacity: (12% * mute_hov + 8% * mute_z.pressed) * mut }
    group {
        opacity: smooth(0.15, 0.55, mut)
        pivot: mx, 17
        scale: 0.5 + 0.5 * smooth(0.1, 0.7, mut) - 0.09 * sin(slash * 3.14159) - 0.08 * mute_z.pressed
        blur: 4 * (1 - smooth(0.1, 0.65, mut))
        clip box { from: cap_l + 2, cap_y; size: max(0, cap_w - 4), cap_h; corner: cap_h / 2 continuous }
        image ic_mute { at: mx - 8, 9; size: 16, 16; tint: ink; opacity: 92% * (1 - smooth(0, 0.3, slash)) }
        image ic_mute_cut { at: mx - 8, 9; size: 16, 16; tint: ink; opacity: 92% * smooth(0, 0.3, slash) }
        group {
            pivot: mx, 17
            rotate: -45deg
            //  A rounded bar growing from its top end: the round caps of SF's slash.
            box { from: mx - 0.8, 17 - 8.5; size: 1.6, max(0.01, 17 * slash); corner: 0.8 continuous; color: ink; opacity: 95% * min(1, slash * 6) }
        }
    }
    group {
        move: bx, 0
        pivot: 14, 17
        scale: 1 + 0.45 * jolt
        //  The battery as iOS draws it with its percentage: a light track that
        //  fills up, and the number inside it in dark, readable at any level.
        box { from: 0, 10.5; size: 26, 13; corner: 4.2 continuous; color: ink; opacity: 38% }
        box { from: 26.8, 14.8; size: 1.8, 4.4; corner: 0.9 continuous; color: ink; opacity: 40% }
        group {
            clip box { from: 0, 10.5; size: 26, 13; corner: 4.2 continuous }
            //  The charge is a liquid: its surface (the fill's edge) tilts and
            //  bulges with the slosh, row by row; at rest, a straight edge.
            repeat j in 0..13 {
                box {
                    //  (each a touch taller than its step, so no seam shows where they meet)
                    from: 0, 10.5 + j; size: max(0.1, 26 * bat_s + 3 * clamp(slosh, -1.2, 1.2) * (j - 6) / 6 + 1.6 * clamp(slosh2, -1, 1) * sin(j * 15)), if(j == 12, 1, 1.6)
                    color: mix(pick(bat_nc, ink, amber, coral), mix(charge, pearl, 0.3), chg)
                }
            }
            box { at: 34 * plug_sweep - 4, 17; size: 6, 15; corner: 3 continuous; color: #ffffff; opacity: 70% * (1 - plug_sweep) }
            box { at: 30 - 34 * unplug_sweep, 17; size: 6, 15; corner: 3 continuous; color: #ffffff; opacity: 45% * (1 - unplug_sweep) }
        }
        //  Its digits roll as the clock's do: up as it fills, down as it drains.
        text number(battery.percent, 0, "") {
            at: 13, 17.2; anchor: center; size: 10; weight: 700; family: "SF Pro Display"
            color: pearl_ink
            letter_move: 0, 4 * bat_dir * (1 - bat_in) * if(letter >= bat_from, 1, 0)
            letter_opacity: if(letter >= bat_from, bat_in, 1)
        }
        //  The plug: out of a blur, revealed top to bottom like a strike, with a
        //  little kick as it lands. Unplugged, all of it runs backwards.
        group {
            opacity: smooth(0.2, 0.5, chg)
            pivot: 37, 17
            scale: 0.6 + 0.4 * smooth(0.15, 0.8, chg) + 0.9 * jolt
            blur: 3 * (1 - smooth(0.2, 0.75, chg))
            clip box { from: 29, 9.5; size: 17, 15 * strike }
            image ic_plug { at: 30.5, 10.5; size: 13, 13; tint: ink }
        }
        box { from: bat_gw + 12, 10; size: 1, 14; corner: 0.5 continuous; color: ink; opacity: 28% * (1 - smooth(0, 0.4, co)) }
    }
    text clock.date {
        at: cap_r - 16, 17; anchor: right center; size: 13; weight: 600; family: "SF Pro Display"
        color: ink; shadow: 0, 1, 3, 35%; measure: datem
        opacity: 1 - smooth(0, 0.4, co)
    }
    }
    //  Only a hover: it brightens, but a click is not for it (the card is the centre pill's).
    zone box stat_z { from: cap_l, cap_y; size: cap_w, cap_h; corner: cap_h / 2 continuous; label: "Battery and date" }
    include "pages/calendar.plm"
    zone box bat_z { from: cap_l, cap_y; size: bx + bat_gw + 6 - cap_l, cap_h; corner: cap_h / 2 continuous; label: "Battery" }
    zone box date_z { from: bx + bat_gw + 6, cap_y; size: max(0, cap_r - bx - bat_gw - 6), cap_h; corner: cap_h / 2 continuous; label: "Date"; active: not cal and not side }
    on enter bat_z { bat_peek = true; emit bat_look }
    on leave bat_z { bat_peek = false }
    every 15s while bat_peek or peek_held { emit bat_look }
    on peek(v) while v > 0 and not peek_held { emit bat_look }
    on enter date_z { cal = true; side_k = 0 }
    on change cal while cal { emit cal_look; side_k = 0 }
    //  After the capsule's zone, so the click lands here.
    zone box mute_z { from: mx - 12, cap_y + 3; size: 24, cap_h - 6; corner: (cap_h - 6) / 2 continuous; cursor: pointer; label: "Unmute"; active: audio.muted and mut > 0.6 }
    on press mute_z { emit osd_mute }

    //  ── a tool beside a large view ──
    //  While WhatsApp, the mail or the files fill the centre, the clipboard (Super+C) and the
    //  emoji (Super+E) open from the right capsule instead: it grows down into their card, over
    //  the view, which stays as it was. The same pages as in the centre card, drawn here or there.
    let tool_side = side_k > 0 and big
    prop cdim = 0 ~200ms          // …and the view, while the tool has them
    follow cdim = if(side and side_focus and big, 1, 0)
    prop sdim = 0 ~200ms          // the tool beside the view without the keys (Ctrl+h): a little dimmer
    follow sdim = if(side and not side_focus, 1, 0)
    let side_keys = side and side_focus                                      // the tool beside the view has the keys, not the view
    let clip_keys = expanded and (panel == clip or (side_keys and side_k == 1))   // whose keys: the clipboard's, wherever it shows
    let emo_keys = expanded and (panel == emoji or (side_keys and side_k == 2))
    let fnd_keys = expanded and ((panel == fnd and not side_keys) or (side_keys and side_k == 3))
    let clx = if(side_k == 1 and big, cap_r - 404, ex0)     // where the pages start: in the side card, or the centre one
    let emx0 = if(side_k == 2 and big, cap_r - 384, ex0)
    let emy = if(side_k == 2 and big, 132, 0)                // …and the emoji grid three rows taller there
    let clip_wide = not (side_k == 1 and big)                // the clipboard's preview: only in the centre card
    let clip_lh = if(clip_wide, 366, 12 * 46 - 2)             // its list: eight rows there, twelve beside a view
    group {
        clip inset 1 box { from: if(tool_side, ccl, x0), if(tool_side, cap_y, 0); size: if(tool_side, ccw, pw), if(tool_side, cch, ph); corner: if(tool_side, ccr, pr) continuous }
        group {
            opacity: if(tool_side, smooth(0.45, 1, co) * (1 - 0.35 * sdim), smooth(0.5, 1, open))
            move: 0, if(tool_side, 8 * (1 - co), 8 * (1 - open) + hdr2)
            //  The card itself takes the pointer: nothing of the view under it is touched through it.
            zone box side_z { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous; label: "Beside the view"; active: side }
            include "pages/clipboard.plm"
            include "pages/emoji.plm"
        }
    }
    //  The files: the same, on their own (in the centre card they sit beside the clipboard's card, not in it).
    let fnd_side = side_k == 3 and big and not (panel == fnd)     // not when the files are the large view themselves
    let fx0 = if(fnd_side, cap_r - 760 + (fl0 - (cap_r - 760)) * inv, ex0)
    let pvw = if(fnd_side, 304, 660)        // the preview: wide enough that a page reads at its own size; narrower beside a view
    group {
        clip inset 1 box { from: if(fnd_side, ccl, x0), if(fnd_side, cap_y, 0); size: if(fnd_side, ccw, pw), if(fnd_side, cch, ph); corner: if(fnd_side, ccr, pr) continuous }
        group {
            opacity: if(fnd_side, smooth(0.45, 1, cm) * (1 - 0.35 * sdim), smooth(0.5, 1, open))
            move: 0, if(fnd_side, 8 * (1 - cm), 8 * (1 - open) + hdr2)
            zone box fside_z { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous; label: "Beside the view"; active: side and side_k == 3 }
            include "pages/finder.plm"
        }
    }

    //  Its menu: a small glass card dropping from its tray icon, over the open card.
    prop tm = 0 ~240ms
    follow tm = if(tmenu_open, 1, 0)
    let tm_w = 240
    let tm_h = 12 + tm_rows_h
    let tm_x = min(ex0 + 18 + 30 * tm_slot - 8, exr - tm_w - 12)
    let tm_y = 42
    component TrayRow(r: record) {
        size: 228, if(r.separator, 11, 32)
        zone box z { from: 0, 0; size: 228, 32; corner: 16 continuous; cursor: pointer; label: "{r.label}"; active: r.enabled and not r.separator }
        box { from: 0, 0; size: 228, 32; corner: 16 continuous; color: chip_hi; opacity: if(r.separator, 0, 70% * z.hover) }
        line { from: 14, 5.5; to: 214, 5.5; width: 0.7; color: ink; opacity: if(r.separator, 16%, 0) }
        text pick(r.back, r.label, "Back") {
            at: 16 + 14 * (r.checked >= 0), 16; anchor: left center; width: 180; lines: 1
            size: 12.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(r.separator, 0, if(r.enabled, 92%, 38%))
        }
        ellipse { at: 15, 16; radius: 2.6; color: tint_ink; show: r.checked == 1 }
        path { at: 212, 16; stroke: 1.6; color: ink; opacity: 45%; show: r.children > 0; move -2, -4.5; line 2.5, 0; line -2, 4.5 }
        on press z { emit tray_choose(r.index) }
    }
    group {
        show: tm > 0.01
        opacity: smooth(0, 0.6, tm)
        move: 0, -6 * (1 - tm)
        body {
            gradient: tm_x, tm_y to tm_x, tm_y + tm_h, well_t, well_b
            opacity: 97%; light: 3%, 42, 20
            shadow: 0, 8, 22, 34%
            box { from: tm_x, tm_y; size: tm_w, tm_h; corner: 20 continuous }
        }
        box { from: tm_x + 0.5, tm_y + 0.5; size: tm_w - 1, tm_h - 1; corner: 19.5 continuous; stroke: 1; color: rim_grey; opacity: 22% }
        zone box tmenu_z { from: tm_x, tm_y; size: tm_w, tm_h; corner: 20 continuous; label: "Tray menu" }
        column tcol {
            at: tm_x + 6, tm_y + 6; gap: 0
            for r in trows { TrayRow(r) }
        }
    }
    //  It goes once the pointer has been away from it a moment.
    on away tmenu_z for 500ms while tmenu_open { tmenu_open = false }
    on change expanded while not expanded { tmenu_open = false }

    // ── rules ────────────────────────────────────────────────────
    //  Hover is the whole interaction: in, it opens; out, it closes. No delay
    //  either way (moving onto a button inside doesn't count as leaving: each
    //  zone checks the pointer against its own shape).
    on enter hit while not banner and not osd { expanded = true }
    //  A banner: a click opens it; it goes by itself after six seconds out from
    //  under the pointer (an urgent one waits to be dealt with).
    on drag hit while banner and not expanded { bdrag: min(4, drag.dy) ~30ms }
    on release hit while banner and not expanded and drag.dy < -28 { banner = false; bdrag: 0 }
    on release hit while banner and not expanded and drag.dy >= -28 { bdrag: 0 }
    //  A click opens it; a right click (two fingers on a trackpad) tucks it away.
    on release hit while banner and not expanded and abs(drag.dy) < 6 and abs(drag.dx) < 6 { emit note_open }
    on press right hit while banner and not expanded { banner = false }
    on change banner_seq { nswap: 0 ~1ms; nswap: 1 after 30ms; impulse ph 70 }
    on press more_z { expanded = true; panel = notes; banner = false }
    on still banner_seq * 2 + hit.hover for 6s while banner and not hit.hover and not n_urgent { banner = false }
    on press nx { emit note_dismiss }
    on change expanded while expanded { banner = false }
    on press bell_z { panel = notes }
    on open_notes { expanded = true; panel = notes }
    //  Not while a password is being typed: the card holds until Join or Esc.
    on change pointer.y while hold_h > 0 and pointer.y < open_h - 6 { hold_h = 0 }
    on change expanded while not expanded { hold_h = 0 }
    on change pointer.x while hold_w > 0 and abs(pointer.x - cx) < cw_t / 2 - 6 { hold_w = 0 }
    on change expanded while not expanded { hold_w = 0 }
    on change expanded while not expanded { mpage = 0 }   // the inbox opens on its first page again
    on leave hit while not pw_open and not tmenu_open and panel != mailx and panel != wa and panel != clip and panel != launch and panel != emoji and panel != wall and panel != auth and panel != fnd { expanded = false }
    //  Closed, it comes back on its home face (once it has finished closing).
    on still expanded for 400ms while not expanded { panel = home }

    on open_wifi { panel = wifi }
    on open_bt { panel = bt }

    //  Super+C: open on the clipboard, in vim's normal mode; again, close.
    on clip_open while expanded and panel == clip { expanded = false }
    on clip_open while not (expanded and panel == clip) and not big { expanded = true; panel = clip; clip_insert = false }
    on clip_open while big and not (side and side_k == 1) { side = true; side_k = 1; cal = false; side_focus = true; clip_insert = false; blur }
    on clip_open while big and side and side_k == 1 { side = false }
    //  Normal mode: j k (and the arrows) move, gg G go to the ends, Ctrl+d Ctrl+u
    //  half a page, Enter y l copy, dd x forget, i searches (insert), q Esc close.
    on key j while clip_keys and not clip_insert { emit clip_move(1) }
    on key k while clip_keys and not clip_insert { emit clip_move(-1) }
    on key Down while clip_keys { emit clip_move(1) }
    on key Up while clip_keys { emit clip_move(-1) }
    //  Typing in the search: Ctrl with j k still moves through the list.
    on key Ctrl+j while clip_keys and clip_insert { emit clip_move(1) }
    on key Ctrl+k while clip_keys and clip_insert { emit clip_move(-1) }
    on key Ctrl+d while clip_keys { emit clip_move(3) }
    on key Ctrl+u while clip_keys { emit clip_move(-3) }
    on key G while clip_keys and not clip_insert { emit clip_move(100000) }
    on key g while clip_keys and not clip_insert and clip_gg { emit clip_move(-100000); clip_gg = false }
    on key g while clip_keys and not clip_insert and not clip_gg { clip_gg = true }
    on key d while clip_keys and not clip_insert and clip_dd { emit clip_del; clip_dd = false }
    on key d while clip_keys and not clip_insert and not clip_dd { clip_dd = true }
    on still clip_dd for 600ms while clip_dd { clip_dd = false }
    on still clip_gg for 600ms while clip_gg { clip_gg = false }
    on key x while clip_keys and not clip_insert { emit clip_del }
    on key Shift+Delete while clip_keys { emit clip_del }
    on key Return while clip_keys and not clip_insert { emit clip_pick }
    on key y while clip_keys and not clip_insert { emit clip_pick }
    on key l while clip_keys and not clip_insert { emit clip_pick }
    on key q while clip_keys and not side and not clip_insert { expanded = false }
    on key q while clip_keys and side and not clip_insert { side = false }
    //  Esc in normal mode: a filter kept is let go first (the field folds back into its button), then the page closes.
    on key Escape while clip_keys and not clip_insert and not clip_q_empty { emit clip_q_clear }
    on key Escape while clip_keys and not side and not clip_insert and clip_q_empty { expanded = false }
    on key Escape while clip_keys and side and not clip_insert and clip_q_empty { side = false }
    //  i searches (insert, as in vim); Esc goes back to normal, keeping what it found.
    on key i while clip_keys and not clip_insert { clip_insert = true; focus clip_q }
    on key Escape while clip_keys and clip_insert { clip_insert = false; blur }
    on submit clip_q { emit clip_pick }

    //  Super+D: open on the launcher, straight into its search; again, close.
    on launch_open while expanded and panel == launch { expanded = false }
    on launch_open while not (expanded and panel == launch) { expanded = true; panel = launch; focus launch_q }
    on key Escape while expanded and panel == launch { expanded = false }
    on key Down while expanded and panel == launch { emit launch_move(1) }
    on key Up while expanded and panel == launch { emit launch_move(-1) }
    on key Ctrl+j while expanded and panel == launch { emit launch_move(1) }
    on key Ctrl+k while expanded and panel == launch { emit launch_move(-1) }
    on key Ctrl+n while expanded and panel == launch { emit launch_move(1) }
    on key Ctrl+p while expanded and panel == launch { emit launch_move(-1) }
    on key Tab while expanded and panel == launch { emit launch_into }
    on key Shift+Tab while expanded and panel == launch { emit launch_up }
    on submit launch_q { emit launch_pick }

    //  Super+E: open on the emoji, straight into the search; again, close.
    on emoji_open while expanded and panel == emoji { expanded = false }
    on emoji_open while not (expanded and panel == emoji) and not big { expanded = true; panel = emoji; emo_insert = false }
    //  Beside a large view (WhatsApp, the mail, the files) it opens from the right capsule instead; again, closes.
    on emoji_open while big and not (side and side_k == 2) { side = true; side_k = 2; cal = false; side_focus = true; emo_insert = false; blur }
    on emoji_open while big and side and side_k == 2 { side = false }
    //  Normal mode, as vim: h j k l move, gg G the ends, Ctrl+d Ctrl+u half a
    //  page, [ ] the categories, Enter y pick, i searches, q Esc close.
    on key h while emo_keys and not emo_insert { emit emo_move(-1) }
    on key l while emo_keys and not emo_insert { emit emo_move(1) }
    on key j while emo_keys and not emo_insert { emit emo_move(8) }
    on key k while emo_keys and not emo_insert { emit emo_move(-8) }
    on key G while emo_keys and not emo_insert { emit emo_move(100000) }
    on key g while emo_keys and not emo_insert and emo_gg { emit emo_move(-100000); emo_gg = false }
    on key g while emo_keys and not emo_insert and not emo_gg { emo_gg = true }
    on still emo_gg for 600ms while emo_gg { emo_gg = false }
    on key bracketright while emo_keys and not emo_insert { emit emo_cat_step(1) }
    on key bracketleft while emo_keys and not emo_insert { emit emo_cat_step(-1) }
    on key Return while emo_keys and not emo_insert { emit emo_pick }
    on key y while emo_keys and not emo_insert { emit emo_pick }
    on key q while emo_keys and not side and not emo_insert { expanded = false }
    on key q while emo_keys and side and not emo_insert { side = false }
    on key i while emo_keys and not emo_insert { emo_insert = true; focus emo_q }
    on key Escape while emo_keys and emo_insert { emo_insert = false; blur }
    on key Escape while emo_keys and not emo_insert and not emo_q_empty { emit emo_q_clear }
    on key Escape while emo_keys and not side and not emo_insert and emo_q_empty { expanded = false }
    on key Escape while emo_keys and side and not emo_insert and emo_q_empty { side = false }
    //  Typing in the search: Ctrl with h j k l still moves through the grid.
    on key Ctrl+h while emo_keys and emo_insert and not side { emit emo_move(-1) }
    on key Ctrl+l while emo_keys and emo_insert and not side { emit emo_move(1) }
    on key Ctrl+j while emo_keys and emo_insert { emit emo_move(8) }
    on key Ctrl+k while emo_keys and emo_insert { emit emo_move(-8) }
    //  Both modes: the arrows, Tab, and half a page.
    on key Right while emo_keys { emit emo_move(1) }
    on key Left while emo_keys { emit emo_move(-1) }
    on key Down while emo_keys { emit emo_move(8) }
    on key Up while emo_keys { emit emo_move(-8) }
    on key Tab while emo_keys { emit emo_move(1) }
    on key Ctrl+d while emo_keys { emit emo_move(16) }
    on key Ctrl+u while emo_keys { emit emo_move(-16) }
    on submit emo_q { emit emo_pick }

    //  Super+P: open on the wallpapers; again, close. Enter puts the chosen one on.
    on wall_open while expanded and panel == wall { expanded = false }
    on wall_open while not (expanded and panel == wall) { expanded = true; panel = wall }
    on key Escape while expanded and panel == wall { expanded = false }
    on key q while expanded and panel == wall { expanded = false }
    on key Right while expanded and panel == wall { emit wall_move(1) }
    on key Left while expanded and panel == wall { emit wall_move(-1) }
    on key Down while expanded and panel == wall { emit wall_move(3) }
    on key Up while expanded and panel == wall { emit wall_move(-3) }
    on key l while expanded and panel == wall { emit wall_move(1) }
    on key h while expanded and panel == wall { emit wall_move(-1) }
    on key j while expanded and panel == wall { emit wall_move(3) }
    on key k while expanded and panel == wall { emit wall_move(-3) }
    on key Tab while expanded and panel == wall { emit wall_move(1) }
    on key Shift+Tab while expanded and panel == wall { emit wall_move(-1) }
    on key Return while expanded and panel == wall { emit wall_pick }

    //  Alt+Tab (Hyprland binds it: `emit win_open 1`, Shift −1, Alt let go
    //  `emit win_commit`): the card opens on the windows, most recent first,
    //  the one before this chosen; each Tab steps; letting go of Alt goes there.
    on win_open(v) while not wv { wv = true; switching = v != 0; expanded = false; emit win_look(v) }
    on win_open(v) while wv { emit win_step(v) }
    on win_commit while switching { emit win_pick; switching = false; wv = false }
    on win_cancel { switching = false; wv = false }
    on win_pick_cell { switching = false; wv = false }

    //  Capture: the card closes before anything is taken, so it is not in the picture.
    on shot_open { expanded = true; panel = cap; cap_rec = false }
    on rec_open while recording { emit rec_stop }
    on rec_open while not recording { expanded = true; panel = cap; cap_rec = true }
    on cap_take { expanded = false }
    on key Escape while expanded and panel == cap { expanded = false }
    on key Escape while expanded and panel == mix { expanded = false }
    on open_mix { panel = mix }
    on awake_tap while awake { emit awake_toggle }
    on awake_tap while not awake { panel = awk }
    on awake_for { panel = ctl }
    //  The dial: letting go (or Enter) starts; the timer's card goes, Keep Awake goes back to the controls.
    on dial_go while panel == timer { expanded = false }
    on dial_go while panel == awk { panel = ctl }
    on key Return while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_go(dial_f) }
    on key l while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(1) }
    on key Right while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(1) }
    on key h while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(-1) }
    on key Left while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(-1) }
    on key Escape while expanded and (panel == timer or panel == awk) { expanded = false }
    on open_cam { panel = cam; cam_video = false }
    on open_timer while not tmr_on { panel = timer; tmr_mode = timer }
    on open_watch while not tmr_on { panel = timer; tmr_mode = watch }
    on open_timer while tmr_on { panel = timer }
    on open_watch while tmr_on { panel = timer }
    on tmr_start { expanded = false }
    on watch_start { expanded = false }

    //  The colour picker: the card goes, hyprpicker takes the screen; then the pill says what it took.
    on pick_color { expanded = false }
    on change pk_seq { picked = true; osd = false }
    on still pk_seq for 2600ms while picked { picked = false }
    on change expanded while expanded { picked = false }

    //  Polkit: a program wants the password. The card opens on the prompt and
    //  holds the keyboard until it is answered or cancelled.
    on change pk.pending while pk.pending { expanded = true; panel = auth; focus answer }
    on change pk.asking while pk.asking { focus answer }
    on change pk.pending while not pk.pending and panel == auth { expanded = false }
    on submit answer { emit pk_send }
    on key Escape while expanded and panel == auth { emit pk_cancel }


    //  Super+R: the finder, in normal mode; again, close.
    on find_open while expanded and panel == fnd { expanded = false }
    on find_open while not (expanded and panel == fnd) and not big { expanded = true; panel = fnd; fnd_insert = false }
    on find_open while big and not (panel == fnd) and not (side and side_k == 3) { side = true; side_k = 3; cal = false; side_focus = true; fnd_insert = false; blur }
    on find_open while big and side and side_k == 3 { side = false }
    on key j while fnd_keys and not fnd_view and not fnd_insert { emit fnd_move(1) }
    on key k while fnd_keys and not fnd_view and not fnd_insert { emit fnd_move(-1) }
    on key G while fnd_keys and not fnd_view and not fnd_insert { emit fnd_move(100000) }
    on key g while fnd_keys and not fnd_view and not fnd_insert and fnd_gg { emit fnd_move(-100000); fnd_gg = false }
    on key g while fnd_keys and not fnd_view and not fnd_insert and not fnd_gg { fnd_gg = true }
    on still fnd_gg for 600ms while fnd_gg { fnd_gg = false }
    on key l while fnd_keys and not fnd_view and not fnd_insert { emit fnd_open }
    on key Return while fnd_keys and not fnd_view and not fnd_insert { emit fnd_open }
    on key h while fnd_keys and not fnd_view and not fnd_insert { emit fnd_up }
    on key BackSpace while fnd_keys and not fnd_view and not fnd_insert { emit fnd_up }
    on key Shift+Return while fnd_keys and not fnd_view { emit fnd_thunar }
    on key q while fnd_keys and not side and not fnd_view and not fnd_insert { expanded = false }
    on key q while fnd_keys and side and not fnd_view and not fnd_insert { side = false }
    on key i while fnd_keys and not fnd_view and not fnd_insert { fnd_insert = true; focus fq }
    on key Escape while fnd_keys and not fnd_view and fnd_insert and not fnd_prompting { fnd_insert = false; blur }
    on key Escape while fnd_keys and not fnd_view and not fnd_insert and fnd_marks > 0 { emit fnd_unmark }
    on key Escape while fnd_keys and not fnd_view and not fnd_insert and fnd_marks == 0 and not fq_empty { emit fq_clear }
    on key Escape while fnd_keys and not side and not fnd_view and not fnd_insert and fnd_marks == 0 and fq_empty { expanded = false }
    on key Escape while fnd_keys and side and not fnd_view and not fnd_insert and fnd_marks == 0 and fq_empty { side = false }
    on key Ctrl+j while fnd_keys and not fnd_view and fnd_insert { emit fnd_move(1) }
    on key Ctrl+k while fnd_keys and not fnd_view and fnd_insert { emit fnd_move(-1) }
    on key Down while fnd_keys and not fnd_view { emit fnd_move(1) }
    on key Up while fnd_keys and not fnd_view { emit fnd_move(-1) }
    on key Ctrl+d while fnd_keys and not fnd_view { emit fnd_move(4) }
    on key Ctrl+u while fnd_keys and not fnd_view { emit fnd_move(-4) }
    on key Tab while fnd_keys and not fnd_view { emit fnd_open }
    on key minus while fnd_keys and not fnd_view and not fnd_insert { emit fnd_up }
    on key m while fnd_keys and not fnd_view and not fnd_insert { emit fnd_pin }
    on key t while fnd_keys and not fnd_view and not fnd_insert { emit fnd_tmux }
    on key T while fnd_keys and not fnd_view and not fnd_insert { emit fnd_term }
    on key e while fnd_keys and not fnd_view and not fnd_insert { emit fnd_edit }
    on key o while fnd_keys and not fnd_view and not fnd_insert { emit fnd_thunar }
    on key space while fnd_keys and not fnd_view and not fnd_insert { emit fnd_mark }
    //  yy copy, yp the path; dd cut, dD trash: the second key within 600 ms.
    on key y while fnd_keys and not fnd_view and not fnd_insert and fnd_y { emit fnd_copy; fnd_y = false }
    on key y while fnd_keys and not fnd_view and not fnd_insert and not fnd_y { fnd_y = true }
    on key p while fnd_keys and not fnd_view and not fnd_insert and fnd_y { emit fnd_yank; fnd_y = false }
    on key d while fnd_keys and not fnd_view and not fnd_insert and fnd_y { emit fnd_yank_dir; fnd_y = false }
    on key p while fnd_keys and not fnd_view and not fnd_insert and not fnd_y { emit fnd_paste }
    on key d while fnd_keys and not fnd_view and not fnd_insert and not fnd_y and fnd_d { emit fnd_cut; fnd_d = false }
    on key d while fnd_keys and not fnd_view and not fnd_insert and not fnd_y and not fnd_d { fnd_d = true }
    on key D while fnd_keys and not fnd_view and not fnd_insert and fnd_d { emit fnd_trash; fnd_d = false }
    on still fnd_y for 600ms while fnd_y { fnd_y = false }
    on still fnd_d for 600ms while fnd_d { fnd_d = false }
    on key r while fnd_keys and not fnd_view and not fnd_insert { emit fnd_rename }
    on key a while fnd_keys and not fnd_view and not fnd_insert { emit fnd_new(0) }
    on key A while fnd_keys and not fnd_view and not fnd_insert { emit fnd_new(1) }
    on key s while fnd_keys and not fnd_view and not fnd_insert { emit fnd_sort(1) }
    on key S while fnd_keys and not fnd_view and not fnd_insert { emit fnd_sort(-1) }
    on key period while fnd_keys and not fnd_view and not fnd_insert { emit fnd_hidden }
    on key asciitilde while fnd_keys and not fnd_view and not fnd_insert { emit fnd_top }
    on key question while fnd_keys and not fnd_view and not fnd_insert { emit fnd_help }
    on key H while fnd_keys and not fnd_view and not fnd_insert { emit fnd_back }
    on key L while fnd_keys and not fnd_view and not fnd_insert { emit fnd_forward }
    on key Alt+Left while fnd_keys and not fnd_view and not fnd_insert { emit fnd_back }
    on key Alt+Right while fnd_keys and not fnd_view and not fnd_insert { emit fnd_forward }
    on key slash while fnd_keys and not fnd_view and not fnd_insert { fnd_insert = true; focus fq }
    //  A name being typed (rename, new): Enter does it, Esc lets it go.
    on change fnd_prompting while fnd_prompting { fnd_insert = true; focus fnd_in }
    on submit fnd_in { emit fnd_prompt_ok; fnd_prompting = false; fnd_insert = false; blur }
    on key Escape while fnd_keys and not fnd_view and fnd_prompting { fnd_prompting = false; fnd_insert = false; blur }
    on change fnd_toast_seq { fnd_toast_on = true }
    on still fnd_toast_seq for 2500ms while fnd_toast_on { fnd_toast_on = false }
    //  v: look closer at the preview; then its keys zoom and move it, and Esc (or v) comes back.
    on key v while fnd_keys and not fnd_view and not fnd_insert and pv_kind == 2 { fnd_view = true }
    on key Escape while fnd_keys and fnd_view { fnd_view = false }
    on key v while fnd_keys and fnd_view { fnd_view = false }
    on key V while fnd_keys and not fnd_view and not fnd_insert { emit fnd_view_as(-1) }
    on key q while fnd_keys and fnd_view { fnd_view = false }
    on key K while fnd_keys and fnd_view { emit pv_zoom(1.25) }
    on key J while fnd_keys and fnd_view { emit pv_zoom(0.8) }
    on key plus while fnd_keys and fnd_view { emit pv_zoom(1.25) }
    on key equal while fnd_keys and fnd_view { emit pv_zoom(1.25) }
    on key minus while fnd_keys and fnd_view { emit pv_zoom(0.8) }
    on key 0 while fnd_keys and fnd_view { emit pv_fit }
    on key w while fnd_keys and fnd_view { emit pv_width }
    on key h while fnd_keys and fnd_view { emit pv_pan_x(80) }
    on key l while fnd_keys and fnd_view { emit pv_pan_x(-80) }
    on key k while fnd_keys and fnd_view { emit pv_pan_y(80) }
    on key j while fnd_keys and fnd_view { emit pv_pan_y(-80) }
    on key Left while fnd_keys and fnd_view { emit pv_pan_x(80) }
    on key Right while fnd_keys and fnd_view { emit pv_pan_x(-80) }
    on key Up while fnd_keys and fnd_view { emit pv_pan_y(80) }
    on key Down while fnd_keys and fnd_view { emit pv_pan_y(-80) }
    on key Ctrl+u while fnd_keys and fnd_view { emit pv_pan_y(200) }
    on key Ctrl+d while fnd_keys and fnd_view { emit pv_pan_y(-200) }
    on key g while fnd_keys and fnd_view and fnd_gg { emit pv_end(1); fnd_gg = false }
    on key g while fnd_keys and fnd_view and not fnd_gg { fnd_gg = true }
    on key G while fnd_keys and fnd_view { emit pv_end(-1) }
    on key 1 while fnd_keys and not fnd_view and not fnd_insert { emit fnd_jump(1) }
    on key 2 while fnd_keys and not fnd_view and not fnd_insert { emit fnd_jump(2) }
    on key 3 while fnd_keys and not fnd_view and not fnd_insert { emit fnd_jump(3) }
    on key 4 while fnd_keys and not fnd_view and not fnd_insert { emit fnd_jump(4) }
    on submit fq while not fnd_prompting { emit fnd_open }
    on go_home { panel = home }
    //  The mail reader's reply: the field takes the keys as it opens; Enter sends, Escape lets it go.
    on change mr_rep while mr_rep { focus mr_in }
    on submit mr_in { emit mail_send }
    on key Escape while expanded and panel == mailx and not side_keys and mr_rep { mr_rep = false; blur }
    //  The large mail view: Super+U opens it (and closes it); its keys, vim's, while no reply is being typed.
    on mail_big while expanded and panel == mailx { expanded = false }
    on mail_big while expanded and panel == fnd { side = true; side_k = 3; side_focus = false; cal = false; inv: 1 ~1ms; inv: 0 ~shape after 20ms }
    on mail_big while not (expanded and panel == mailx) { expanded = true; panel = mailx; mr_rep = false; mx_focus = false }
    on key j while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus { emit mailx_move(1) }
    on key k while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus { emit mailx_move(-1) }
    on key Down while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus { emit mailx_move(1) }
    on key Up while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus { emit mailx_move(-1) }
    on key G while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus { emit mailx_pick(100000) }
    on still mx_dd for 700ms while mx_dd { mx_dd = false }
    on still mx_gg for 700ms while mx_gg { mx_gg = false }
    on key g while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus and mx_gg { emit mailx_pick(0); mx_gg = false }
    on key g while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus and not mx_gg { mx_gg = true }
    //  l: into the mail; then vim's motions scroll it (j/k a few lines, Ctrl+d/u half a page, gg/G its ends), h or Esc come back.
    on key l while expanded and panel == mailx and not side_keys and not mr_rep and not mx_focus { mx_focus = true }
    on key Right while expanded and panel == mailx and not side_keys and not mr_rep { mx_focus = true }
    on key h while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus and 620 * wz * mx_zoom <= mrw - 35 { mx_focus = false }
    on key h while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus and 620 * wz * mx_zoom > mrw - 35 { mx_pan = clamp(mx_pan - 110, 0, max(0, 620 * wz * mx_zoom - (mrw - 36))) }
    on key l while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus and 620 * wz * mx_zoom > mrw - 35 { mx_pan = clamp(mx_pan + 110, 0, max(0, 620 * wz * mx_zoom - (mrw - 36))) }
    on key Left while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus { mx_focus = false }
    on key j while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus { mrl.scroll: min(mrl.scroll + 140, max(0, mrl.content - mb_h)) ~quick }
    on key k while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus { mrl.scroll: max(0, mrl.scroll - 140) ~quick }
    on key Down while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus { mrl.scroll: min(mrl.scroll + 140, max(0, mrl.content - mb_h)) ~quick }
    on key Up while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus { mrl.scroll: max(0, mrl.scroll - 140) ~quick }
    on key Ctrl+d while expanded and panel == mailx and not side_keys and not mr_rep { mrl.scroll: min(mrl.scroll + mb_h / 2, max(0, mrl.content - mb_h)) ~quick }
    on key Ctrl+u while expanded and panel == mailx and not side_keys and not mr_rep { mrl.scroll: max(0, mrl.scroll - mb_h / 2) ~quick }
    on key G while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus { mrl.scroll: max(0, mrl.content - mb_h) ~quick }
    on key g while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus and mx_gg { mrl.scroll: 0 ~quick; mx_gg = false }
    on key g while expanded and panel == mailx and not side_keys and not mr_rep and mx_focus and not mx_gg { mx_gg = true }
    on key v while expanded and panel == mailx and not side_keys and not mr_rep { mx_web = not mx_web }
    //  Zoom, as in a PDF viewer: Shift+K in, Shift+J out (into the mail first), about the middle of what shows;
    //  zoomed wider than the reader, h and l pan across it instead of leaving it.
    on key K while expanded and panel == mailx and not side_keys and not mr_rep and not mr_confirm and mx_zoom < 2.99 {
        mx_focus = true
        mx_zoom = min(3, mx_zoom * 1.25)
        mx_pan = clamp(mx_pan * 1.25 + (mrw - 36) * 0.125, 0, max(0, 620 * mzs * mx_zoom * 1.25 - (mrw - 36)))
        mrl.scroll: max(0, (mrl.scroll + mb_h / 2) * 1.25 - mb_h / 2) ~quick
    }
    on key J while expanded and panel == mailx and not side_keys and not mr_rep and not mr_confirm and mx_zoom > 0.61 {
        mx_focus = true
        mx_zoom = max(0.6, mx_zoom / 1.25)
        mx_pan = clamp(mx_pan / 1.25 - (mrw - 36) * 0.1, 0, max(0, 620 * mzs * mx_zoom / 1.25 - (mrw - 36)))
        mrl.scroll: max(0, (mrl.scroll + mb_h / 2) / 1.25 - mb_h / 2) ~quick
    }
    on key r while expanded and panel == mailx and not side_keys and not mr_rep { emit mail_do(0) }
    on key u while expanded and panel == mailx and not side_keys and not mr_rep and not mail_undo { emit mail_do(1) }
    on key u while expanded and panel == mailx and not side_keys and not mr_rep and mail_undo { emit mail_undo_do }
    on key e while expanded and panel == mailx and not side_keys and not mr_rep { emit mail_do(2) }
    on key d while expanded and panel == mailx and not side_keys and not mr_rep and mx_dd { mr_confirm = true; mx_dd = false }
    //  "Move to Bin?": Enter or y bins it, Esc or n keeps it.
    on key Return while expanded and panel == mailx and not side_keys and mr_confirm { emit mail_do(3); mr_confirm = false }
    on key y while expanded and panel == mailx and not side_keys and mr_confirm { emit mail_do(3); mr_confirm = false }
    on key n while expanded and panel == mailx and not side_keys and mr_confirm { mr_confirm = false }
    on key d while expanded and panel == mailx and not side_keys and not mr_rep and not mx_dd { mx_dd = true }
    on key o while expanded and panel == mailx and not side_keys and not mr_rep { emit mail_do(4) }
    on key space while expanded and panel == mailx and not side_keys and not mr_rep { mrl.scroll: min(mrl.scroll + mb_h - 48, max(0, mrl.content - mb_h)) ~quick }
    on key Shift+space while expanded and panel == mailx and not side_keys and not mr_rep { mrl.scroll: max(0, mrl.scroll - mb_h + 48) ~quick }
    on key Escape while expanded and panel == mailx and not side_keys and mr_confirm { mr_confirm = false }
    on key Escape while expanded and panel == mailx and not side_keys and not mr_rep and not mr_confirm and mx_focus { mx_focus = false }
    on key Escape while expanded and panel == mailx and not side_keys and not mr_rep and not mr_confirm and not mx_focus { expanded = false }
    on key q while expanded and panel == mailx and not side_keys and not mr_rep and not mr_confirm { expanded = false }
    //  WhatsApp: Super+W opens it (and closes it). The fields first: i (or Enter) writes, Enter
    //  sends, Escape lets the field go; i in the list searches it.
    on wa_big while expanded and panel == wa { expanded = false }
    //  Over the files: WhatsApp takes the centre and the files slide aside, beside it (the same as Super+Y from WhatsApp).
    on wa_big while expanded and panel == fnd { side = true; side_k = 3; side_focus = false; cal = false; inv: 1 ~1ms; inv: 0 ~shape after 20ms }
    on wa_big while not (expanded and panel == wa) { expanded = true; panel = wa; wa_focus = false; wa_typing = false; wa_search = false }
    on change wa_typing while wa_typing { focus wa_in }
    on change wa_search while wa_search { focus wa_find }
    on submit wa_in { emit wa_send }
    on submit wa_find { wa_search = false; blur }
    on key Escape while expanded and panel == wa and not side_keys and not wa_ql and wa_typing { wa_typing = false; blur }
    on key Escape while expanded and panel == wa and not side_keys and not wa_ql and wa_search { wa_search = false; blur; emit wa_find_clear }
    on key Down while expanded and panel == wa and not side_keys and wa_search { emit wa_move(1) }
    on key Up while expanded and panel == wa and not side_keys and wa_search { emit wa_move(-1) }
    on press wa_in_z { wa_typing = true }
    //  Ctrl+V with a picture or files on the clipboard (words the field pastes itself); Ctrl+. the emoji.
    on key Ctrl+v while expanded and panel == wa and not side_keys and wa_open and not wa_search { emit wa_paste }
    on key Ctrl+V while expanded and panel == wa and not side_keys and wa_open and not wa_search { emit wa_paste }
    on key Ctrl+period while expanded and panel == wa and not side_keys and wa_open and not wa_search { emit emoji_open }
    on press wa_find_z { wa_search = true }
    //  …and Vim's keys while neither has them: the list, or (l) the chat. A count first (5j, 12G).
    on still wa_cnt for 2s while wa_cnt > 0 { wa_cnt = 0 }
    on key 1 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 1) }
    on key 2 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 2) }
    on key 3 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 3) }
    on key 4 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 4) }
    on key 5 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 5) }
    on key 6 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 6) }
    on key 7 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 7) }
    on key 8 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 8) }
    on key 9 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 9) }
    on key 0 while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_cnt > 0 { wa_cnt = min(9999, wa_cnt * 10) }
    on still wa_gg for 700ms while wa_gg { wa_gg = false }
    on still wa_yy for 700ms while wa_yy { wa_yy = false }
    on still wa_zz for 700ms while wa_zz { wa_zz = false }
    //  The list.
    on key j while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(max(1, wa_cnt)); wa_cnt = 0 }
    on key k while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(-max(1, wa_cnt)); wa_cnt = 0 }
    on key Down while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(max(1, wa_cnt)); wa_cnt = 0 }
    on key Up while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(-max(1, wa_cnt)); wa_cnt = 0 }
    on key G while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus and wa_cnt > 0 { emit wa_pick(wa_cnt - 1); wa_cnt = 0 }
    on key G while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus and wa_cnt == 0 { emit wa_pick(100000) }
    on key g while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus and wa_gg { emit wa_pick(0); wa_gg = false }
    on key g while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_focus and not wa_gg { wa_gg = true }
    on key Ctrl+d while expanded and panel == wa and not side_keys and not wa_search and not wa_focus { emit wa_move(5) }
    on key Ctrl+u while expanded and panel == wa and not side_keys and not wa_search and not wa_focus { emit wa_move(-5) }
    on key Ctrl+f while expanded and panel == wa and not side_keys and not wa_search and not wa_focus { emit wa_move(10) }
    on key Ctrl+b while expanded and panel == wa and not side_keys and not wa_search and not wa_focus { emit wa_move(-10) }
    on key Ctrl+e while expanded and panel == wa and not side_keys and not wa_search and not wa_focus { emit wa_wheel(-1) }
    on key Ctrl+y while expanded and panel == wa and not side_keys and not wa_search and not wa_focus { emit wa_wheel(1) }
    on key H while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus { emit wa_jump(0) }
    on key M while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus { emit wa_jump(1) }
    on key L while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus { emit wa_jump(2) }
    on key n while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus { emit wa_jump(3) }
    on key N while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus { emit wa_jump(4) }
    on key z while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus and wa_zz { emit wa_jump(5); wa_zz = false }
    on key z while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus and not wa_zz { wa_zz = true }
    on key i while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus and wa_linked { wa_search = true }
    on key s while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_rail = not wa_rail }
    on key Return while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_linked { wa_typing = true }
    on key l while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_focus and wa_open { wa_focus = true; wa_typing = true }
    on key s while expanded and panel == mailx and not side_keys and not mr_rep and not mr_confirm { mx_rail = not mx_rail }
    on key Right while expanded and panel == wa and not side_keys and not wa_typing and not wa_search { wa_focus = true }
    //  The chat: a cursor on its messages; yy copies the one it is on, o opens it, r answers it.
    on key j while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { emit wa_cmove(max(1, wa_cnt)); wa_cnt = 0 }
    on key k while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { emit wa_cmove(-max(1, wa_cnt)); wa_cnt = 0 }
    on key Down while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { emit wa_cmove(max(1, wa_cnt)); wa_cnt = 0 }
    on key Up while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { emit wa_cmove(-max(1, wa_cnt)); wa_cnt = 0 }
    on key G while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { emit wa_last; wa_cnt = 0 }
    on key g while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus and wa_gg { emit wa_first; wfb: wmax ~quick; wa_gg = false }
    on key g while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus and not wa_gg { wa_gg = true }
    on key z while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus and wa_zz { emit wa_center; wa_zz = false }
    on key z while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus and not wa_zz { wa_zz = true }
    on key y while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus and wa_yy { emit wa_yank; wa_yy = false }
    on key y while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus and not wa_yy { wa_yy = true }
    on key Y while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { emit wa_yank }
    on key o while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { emit wa_open }
    on key r while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus and wa_cur >= 0 { emit wa_reply; wa_ql = false }
    //  The field in normal mode: j and k step out of it onto the messages (a cursor there: r answers, Space looks).
    on key j while expanded and panel == wa and not side_keys and wa_typing and wa_vim == normal { wa_typing = false; blur; wa_focus = true; emit wa_cmove(1) }
    on key k while expanded and panel == wa and not side_keys and wa_typing and wa_vim == normal { wa_typing = false; blur; wa_focus = true; emit wa_cmove(-1) }
    on key Down while expanded and panel == wa and not side_keys and wa_typing and wa_vim == normal { wa_typing = false; blur; wa_focus = true; emit wa_cmove(1) }
    on key Up while expanded and panel == wa and not side_keys and wa_typing and wa_vim == normal { wa_typing = false; blur; wa_focus = true; emit wa_cmove(-1) }
    //  Space: the picture under the pointer (or the cursor) large, as Quick Look; Space, Escape or q again close it.
    on key space while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and not wa_ql and (wa_hov >= 0 or (wa_focus and wa_cur >= 0)) { emit wa_look }
    on key space while expanded and panel == wa and wa_ql { wa_ql = false }
    on key Escape while expanded and panel == wa and wa_ql { wa_ql = false }
    on key q while expanded and panel == wa and wa_ql { wa_ql = false }
    on change expanded while not expanded { wa_ql = false }
    on change panel while wa_ql { wa_ql = false }
    on key i while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { wa_typing = true }
    on key h while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { wa_focus = false; wa_cur = -1 }
    on key Left while expanded and panel == wa and not side_keys and not wa_typing and not wa_search and wa_focus { wa_focus = false; wa_cur = -1 }
    //  Ctrl+h j k l: between the three, as Vim's windows: the list on the left, the chat on the
    //  right, its field under it (from the list, l goes to the chat; past it, to a tool beside).
    on key Ctrl+h while expanded and panel == wa and not side_keys and (wa_focus or wa_typing) { wa_typing = false; blur; wa_focus = false; wa_cur = -1 }
    on key Ctrl+l while expanded and panel == wa and not side_keys and not wa_focus and not wa_typing and wa_open { wa_search = false; blur; wa_focus = true }
    on key Ctrl+j while expanded and panel == wa and not side_keys and wa_focus and not wa_typing and not wa_search { wa_typing = true }
    on key Ctrl+k while expanded and panel == wa and not side_keys and wa_typing { wa_typing = false; blur; wa_focus = true }
    //  Scrolling the chat (in the list too, and from the field's normal mode, which passes Ctrl on).
    on key Ctrl+d while expanded and panel == wa and not side_keys and not wa_search and (wa_focus or wa_typing) { wfb: max(0, wfb - wvh / 2) ~quick }
    on key Ctrl+u while expanded and panel == wa and not side_keys and not wa_search and (wa_focus or wa_typing) { wfb: min(wmax, wfb + wvh / 2) ~quick }
    on key Ctrl+f while expanded and panel == wa and not side_keys and not wa_search and (wa_focus or wa_typing) { wfb: max(0, wfb - wvh + 40) ~quick }
    on key Ctrl+b while expanded and panel == wa and not side_keys and not wa_search and (wa_focus or wa_typing) { wfb: min(wmax, wfb + wvh - 40) ~quick }
    on key Ctrl+e while expanded and panel == wa and not side_keys and not wa_search and (wa_focus or wa_typing) { wfb: max(0, wfb - 40) ~quick }
    on key Ctrl+y while expanded and panel == wa and not side_keys and not wa_search and (wa_focus or wa_typing) { wfb: min(wmax, wfb + 40) ~quick }
    //  Escape, one thing at a time: the answer being written, the cursor, the chat, the view.
    on key Escape while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and wa_att { emit wa_att_clear }
    on key Escape while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_att and wa_quote { emit wa_quote_clear }
    on key Escape while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_att and not wa_quote and wa_focus and wa_cur >= 0 { wa_cur = -1 }
    on key Escape while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_att and not wa_quote and wa_focus and wa_cur < 0 { wa_focus = false }
    on key Escape while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search and not wa_att and not wa_quote and not wa_focus { expanded = false }
    on key q while expanded and panel == wa and not side_keys and not wa_ql and not wa_typing and not wa_search { expanded = false }
    on change expanded while not expanded { mr_confirm = false; side = false }
    //  The tool beside a large view: gone with the view; closed, the keys go back to the field that had them.
    on change big while not big { side = false }
    on change side while not side and expanded and panel == wa and wa_typing { focus wa_in }
    //  Ctrl+h, Ctrl+l: the keys to the view on the left, or back to the tool beside it (it stays open).
    on key Ctrl+h while expanded and side and side_focus { side_focus = false; blur }
    on key Ctrl+l while expanded and side and not side_focus and not (panel == wa and not wa_focus and not wa_typing and wa_open) { side_focus = true; blur }
    //  Ctrl+Shift+H in the files beside WhatsApp: the file under the cursor (or every one marked) goes
    //  over its message field, ready to send, and the keys go with it: a drag and drop by keyboard.
    on key Ctrl+Shift+H while fnd_keys and side and side_k == 3 and panel == wa and not fnd_prompting { emit fnd_to_view }
    on key Ctrl+Shift+h while fnd_keys and side and side_k == 3 and panel == wa and not fnd_prompting { emit fnd_to_view }
    on change side_focus while not side_focus and expanded and panel == wa and wa_typing { focus wa_in }
    on change side_focus while not side_focus and expanded and panel == mailx and mr_rep { focus mr_in }
    on change side while not side and expanded and panel == mailx and mr_rep { focus mr_in }
    on change side while not side and expanded and panel == fnd and fnd_prompting { focus fnd_in }
    on change panel while panel == wifi { emit wifi_scan }
    every 12s while expanded and panel == wifi and wifi_on { emit wifi_scan }
    on change pw_open while pw_open { focus pass }
    on change pw_wrongs { impulse shake 260 }
    on key Escape while pw_open { emit wifi_cancel }
    on submit pass { emit wifi_join }
    //  The spinners step only while there is something to show.
    every 300ms while expanded and busy_any { turn: turn + 1 }

    on press prev_z { emit previous }
    on press play_z { emit toggle }
    //  Scrubbing the card's bar: it follows the pointer, the song jumps on release.
    on press cseek_z { scrubbing = true; scrub_f = clamp(craw, 0, 1); scrub_over = craw }
    on drag cseek_z while scrubbing { scrub_f = clamp(craw, 0, 1); scrub_over = craw }
    on release cseek_z while scrubbing { pos = scrub_f * media.length; emit seek_to(scrub_f * media.length); scrubbing = false; scrub_over = scrub_f }
    on change expanded while not expanded { scrubbing = false }
    on press next_z { emit next }
    on scroll ws_z { emit ws_step(wheel) }
    on scroll vol_z { emit vol_step(wheel) }
    on press vol_z { emit mixer }
    on hold sw_z for 700ms { emit wm_switch }
    on hold out_z for 700ms { emit log_out }
    on hold re_z for 700ms { emit restart }
    on hold off_z for 700ms { emit power_off }

    //  AltGr held: the card, at once; let go, it closes, unless the pointer has gone into it.
    on peek(v) while v > 0 and not peek_held and not expanded { expanded = true; peeking = true; osd = false }
    on peek(v) while v > 0 and not peek_held { peek_held = true }
    on peek(v) while v <= 0 { peek_held = false }
    on change peek_held while not peek_held and peeking and not hit.hover { expanded = false }
    on change peek_held while not peek_held { peeking = false }
    on change expanded while not expanded { peeking = false }

    //  Volume and brightness: any change shows the gauge (not over the open
    //  card, which has its own); it goes 1.5 s after the last one, unless held.
    on change audio.volume while osd_ready and not expanded { osd = true; osd_kind = vol; osd_seq = osd_seq + 1; impulse swell 40 }
    on vol_key(v) while not expanded { osd = true; osd_kind = vol; osd_seq = osd_seq + 1; impulse thump 5 }
    //  Pushed past an end: the pill stretches like rubber and springs back.
    on vol_key(v) while v > 0 and audio.volume >= 0.995 { impulse pw 320 }
    on vol_key(v) while v < 0 and audio.volume <= 0.005 { impulse pw 320 }
    on bright_up(v) while not expanded { bright = v / 100; osd = true; osd_kind = bright; osd_seq = osd_seq + 1; impulse swell 40 }
    on bright_down(v) while not expanded { bright = v / 100; osd = true; osd_kind = bright; osd_seq = osd_seq + 1; impulse swell 40 }
    on bright_up(v) while v >= 100 and bright >= 0.995 { impulse pw 320 }
    on bright_down(v) while v <= 1 and bright <= 0.015 { impulse pw 320 }
    on kbd_up(v) while not expanded { kbd = v / 100; osd = true; osd_kind = kbd; osd_seq = osd_seq + 1; impulse swell 40 }
    on kbd_down(v) while not expanded { kbd = v / 100; osd = true; osd_kind = kbd; osd_seq = osd_seq + 1; impulse swell 40 }
    on kbd_up(v) while v >= 100 and kbd >= 0.995 { impulse pw 320 }
    on kbd_down(v) while v <= 0 and kbd <= 0.005 { impulse pw 320 }
    //  Brightness changed by something else (the service looks every 0.7 s).
    on change backlight.level while osd_ready and abs(backlight.level - bright) > 0.02 { bright = backlight.level }
    on still osd_seq * 2 + os_z.hover for 1500ms while osd and not os_z.hover { osd = false }
    on change expanded while expanded { osd = false }
    on press bead_z { emit osd_mute }
    on press track_z { emit osd_set(clamp((pointer.x - tl) / max(tlen, 1), 0, 1)) }
    on drag track_z { emit osd_set(clamp((pointer.x - tl) / max(tlen, 1), 0, 1)) }
    on scroll os_z while osd_kind == vol { emit vol_step(wheel); osd_seq = osd_seq + 1 }
    on scroll os_z while osd_kind == bright { emit bright_step(wheel); osd_seq = osd_seq + 1 }
    on scroll os_z while osd_kind == kbd { emit kbd_step(wheel); osd_seq = osd_seq + 1 }
}
