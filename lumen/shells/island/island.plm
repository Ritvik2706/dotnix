// Island — LUMEN's dynamic island: the whole bar, as one piece of glass that
// changes shape.
//
// One silhouette, three states (the body never changes, only its springs):
//   rest      a stadium: occupied workspaces (a numbered rail), the time,
//             and battery, with a continuous rail through expansion.
//   live      something is playing: the pill widens, a teal waveform (the one
//             cold pop, as in waybar) and the track ride inside it.
//   expanded  hover it: it grows into a card with every workspace, the date,
//             now-playing (when there is a player), and the telemetry
//             waybar showed — wifi · cpu · ram · temperatures · battery.
//
// LUMEN, translated:
//   · Waybar LUMEN glass: a translucent plum tint, violet/peach edges,
//     and a live refracting lens with low frost behind the labels.
//   · one circular selection ring glides along the workspace rail, with
//     a softly shaded grey border around the selected number.
//   · telemetry as light (waybar's ramp): dim at idle, white as it works,
//     amber, then coral only when something deserves attention.
//   · controlled, interruptible motion without overshoot; the selection
//     deforms slightly in transit and settles back into a circle.
//   · quiet by default: no `time` anywhere, so a still island draws nothing.

scene Island {
    surface {
        size: full, 885       // the top edge: room for the card (the large mail view is 840) and its shadow; empty parts let clicks through
        //  60 frames a second at rest (a playing waveform costs little); 120 while the
        //  bar itself is moving, so it keeps up with the windows the compositor
        //  slides under it (they go at the screen's 240), and 60 again once it settles.
        rate: 60, 120 while abs(vel(pw)) + abs(vel(k_mid)) + abs(vel(k_rail)) + abs(vel(ldv)) + abs(vel(ws_position)) + abs(vel(rail_ws)) + abs(vel(bat_in)) + abs(vel(slosh)) + abs(vel(slosh2)) + abs(vel(k_cap)) > 0.5, 240 while app == wa and abs(vel(wfb)) + abs(vel(wbar)) > 0.5   // …and a chat or the list scrolling: as fast as the screen and the card allow, as a browser's page
        anchor: top
        margin: 5             // same line as waybar's capsules
        level: top, overlay while fs_under and fsc > 0.002   // like waybar: over windows, but a fullscreen video or game covers it, until a page is called up over it. Only then: changing level rebuilds the glass (a blink, and a heavier blur). Not `fs`: taking the keyboard unfocuses the window, fs goes false, and the two would chase each other
        open: not fs or fsc > 0.002   // covered then anyway: closed, it gives back its frames (~40–70 MB of shared memory) for the game
        reserve: -1           // the strips below keep the room windows tile under, on every monitor,
                              // so nothing moves when the island changes monitor
        keyboard: exclusive while pw_open or (expanded and (panel == clip or panel == launch or panel == emoji or panel == wall or panel == cap or panel == mix or panel == cam or panel == timer or panel == awk or panel == proj or panel == fnds or panel == stor or panel == act)) or app != none or pk.pending   // only while it is needed: a password, the clipboard, the launcher, the pickers
    }

    //  The level gauge over a fullscreen window, which covers the island: its
    //  own capsule of the island's dark glass, above fullscreen (overlay), that
    //  drops in from above, grows from 86% and settles, instead of the pill
    //  widening (no pill to widen there). The gauge is the pill's (pages/osd.plm).
    surface hud {
        size: 400, 110
        anchor: hud_at
        margin: 12
        level: overlay
        reserve: -1           // from the very top, not below the island's strip
        open: fso > 0.002
        group {
            move: if(hud_at == top_right, 14, 0), if(hud_at == top_right, 30, 0)
        group {
            pivot: 200, 17
            scale: 0.86 + 0.14 * fso
            move: 0, -16 * (1 - fso)
            opacity: smooth(0, 0.55, fso)
            //  The glass comes in with it: frost, bend and light grow from nothing.
            body {
                gradient: 30, 0 to 370, 34, dusk, deep
                glass: 100%
                blur: lg_card_frost * fso; refraction: lg_refraction * fso; bevel: lg_bevel; dispersion: lg_dispersion * fso; specular: lg_specular * fso; glass_tint: lg_glass_tint * fso; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_h
                opacity: card_alpha
                milk: lg_card_milk
                smoke: card_smoke
                rim: 0%
                ripple: 0%
                light: 1%, 0, 12
                shadow: 0, 8, 22, 16%
                box { from: 30, 0; size: 340, 34; corner: 17 continuous }
            }
            group {
                clip inset 1 box { from: 30, 0; size: 340, 34; corner: 17 continuous }
                group {
                    move: 30, 0
                    Gauge(340, 34, fso, gl_hs)
                }
            }
        }
    }
    }

    //  The monitor the island is not on: where you are, the time and the date, in the rest pills'
    //  glass. Always there, for the room it reserves; hovering it calls the island over.
    component Strip(w, n, on) {
        group {
            show: on
            body {
                gradient: 0, 6 to w, 28, mix(pearl, lilac, 0.3), mix(pearl, sunset, 0.3)
                glass: 100%; ripple: 0%; rim: 0%; milk: glass_milk
                blur: lg_frost; refraction: lg_refraction; bevel: lg_bevel; dispersion: lg_dispersion; specular: lg_specular; magnify: lg_magnify
                glass_tint: lg_glass_tint; rim_tint: lg_rim_tint; merge: lg_merge
                opacity: lg_tint; light: 1%, 6, 10; shadow: 0, 1.5, 6, 18%
                box { from: 24, 3; size: 40, 28; corner: 14 continuous }
                box { from: w / 2 - 38, 3; size: 76, 28; corner: 14 continuous }
                box { from: w - 134, 3; size: 110, 28; corner: 14 continuous }
            }
            text "{if(n == 10, 0, n)}" { at: 44, 17; anchor: center; size: 12; weight: 700; family: "SF Pro Display"; color: ink_base }
            text clock.time { at: w / 2, 17; anchor: center; size: 13; weight: 600; family: "SF Pro Display"; color: ink_base }
            text clock.date { at: w - 79, 17; anchor: center; size: 13; weight: 600; family: "SF Pro Display"; color: ink_base }
        }
    }
    surface strip_lap {
        size: full, 34
        anchor: top
        margin: 5
        level: top
        reserve: 34
        screens: "eDP-2"
        Strip(st_lap_w, st_lap_ws, isl_tv)
        zone box st_l { from: 0, 0; size: st_lap_w, 34; label: "Bring the island here"; active: isl_tv }
        on enter st_l { emit isl_lap }
    }
    surface strip_tv {
        size: full, 34
        anchor: top
        margin: 5
        level: top
        reserve: 34
        screens: "HDMI-A-1"
        Strip(st_tv_w, st_tv_ws, not isl_tv)
        zone box st_t { from: 0, 0; size: st_tv_w, 34; label: "Bring the island here"; active: not isl_tv }
        on enter st_t { emit isl_tv_here }
    }

    //  A notification over a fullscreen window: the banner as its own card of
    //  the island's dark glass, above fullscreen, arriving like the gauge above.
    //  A click opens it, a flick up or its ✕ lets it go, hovering holds it.
    surface note_hud {
        size: 440, 224
        anchor: hud_at
        margin: 12
        level: overlay
        reserve: -1
        screens: "eDP-2"      // notifications only ever show on the laptop
        open: fsn > 0.002
        group {
            move: if(hud_at == top_right, 16, 0), if(hud_at == top_right, 30, 0)
        group {
            pivot: 220, 30
            scale: 0.86 + 0.14 * fsn
            move: 0, -16 * (1 - fsn) + 0.5 * bpull
            opacity: smooth(0, 0.55, fsn) * clamp(1 + bpull / 60, 0, 1)
            body {
                gradient: 28, 0 to 412, ban_h, dusk, deep
                glass: 100%
                blur: lg_card_frost * fsn; refraction: lg_card_refraction * fsn; bevel: lg_card_bevel; dispersion: lg_dispersion * fsn; specular: lg_specular * fsn; glass_tint: lg_glass_tint * fsn; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_n
                opacity: card_alpha
                milk: lg_card_milk + 2% * nh_hit.hover
                smoke: card_smoke
                rim: 0%
                ripple: 0%
                light: 1%, 0, 12
                shadow: 0, 8, 22, 16%
                box { from: 28, 0; size: 384, ban_h; corner: 26 continuous }
            }
            group {
                clip inset 1 box { from: 28, 0; size: 384, ban_h; corner: 26 continuous }
                group {
                    move: 28, 0
                    NoteCard(fsn, gl_ns, nswap, 0, nh_hit.hover, nh_x.hover, nh_x.pressed)
                }
            }
        }
        }
        zone box nh_hit { from: 28 + if(hud_at == top_right, 16, 0), if(hud_at == top_right, 30, 0); size: 384, ban_h; corner: 26 continuous; cursor: pointer; label: "Notification"; active: fsn > 0.9 }
        zone ellipse nh_x { at: 28 + 360 + if(hud_at == top_right, 16, 0), 23 + if(hud_at == top_right, 30, 0); radius: 12; cursor: pointer; label: "Dismiss"; active: fsn > 0.9 }
        on drag nh_hit while banner { bdrag: min(4, drag.dy) ~30ms }
        on release nh_hit while banner and drag.dy < -28 { banner = false; bdrag: 0 }
        on release nh_hit while banner and drag.dy >= -28 { bdrag: 0 }
        on release nh_hit while banner and abs(drag.dy) < 6 and abs(drag.dx) < 6 { emit note_open }
        on press nh_x { emit note_dismiss }
    }

    //  While recording: a small bar of the island's dark glass at the bottom
    //  (where niri's screenshot panel was), with the time and a Stop button.
    //  `captures: hidden` gives it the layer namespace lumen-private, which
    //  niri's layer rule (rules/layers.kdl) leaves out of every capture: on the
    //  monitor, never in the video. The coral capsule by the pill stays too.
    surface rec_bar {
        size: 260, 96
        anchor: bottom
        margin: 0
        level: overlay
        reserve: -1
        captures: hidden
        open: rbv > 0.002
        group {
            pivot: 118, 66
            scale: 0.86 + 0.14 * rbv
            move: 0, 18 * (1 - rbv)
            opacity: smooth(0, 0.55, rbv)
            body {
                gradient: 20, 14 to 216, 66, dusk, deep
                glass: 100%
                blur: lg_card_frost * rbv; refraction: lg_refraction * rbv; bevel: lg_bevel; dispersion: lg_dispersion * rbv; specular: lg_specular * rbv; glass_tint: lg_glass_tint * rbv; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_rb
                opacity: card_alpha
                milk: lg_card_milk
                smoke: card_smoke
                rim: 0%
                ripple: 0%
                light: 1%, 0, 12
                shadow: 0, 8, 22, 16%
                box { from: 20, 14; size: 196, 52; corner: 26 continuous }
            }
            ellipse { at: 44, 40; radius: 5; color: coral; opacity: 70% + 30% * rec_pulse }
            text rec_time { at: 58, 40; anchor: left center; size: 15; weight: 600; family: "SF Pro Display"; color: ink }
            zone box rb_stop { from: 120, 23; size: 88, 34; corner: 17 continuous; cursor: pointer; label: "Stop recording"; active: rbv > 0.9 }
            body {
                color: mix(rose, #8a3e50, rb_stop.hover); material: control; opacity: 50% + 10% * rb_stop.pressed
                box { from: 120, 23; size: 88, 34; corner: 17 continuous }
            }
            box { from: 140, 35; size: 10, 10; corner: 2.5 continuous; color: rose_ink }
            text "Stop" { at: 157, 40; anchor: left center; size: 12.5; weight: 600; family: "SF Pro Display"; color: rose_ink }
        }
        on press rb_stop { emit rec_stop }
    }

    // ── palette (waybar/style.css, LUMEN v2) ─────────────────────
    //  The colours that follow the wallpaper (ink, the prism, the glass, the greys)
    //  come from theme.plm, written by theme/wallpaper-theme.py; the rest are fixed.
    include "theme.plm"
    //  Light or dark glass, like iOS: niri decides for each glass from what is
    //  really behind it (with hysteresis, so it never flickers) and says so
    //  (lumen-glass v3 `appearance`) to the fact the glass names with `adapt:`.
    //  Text on light glass turns to Apple's dark label colour, crossfading with
    //  the glass (~300 ms); everything made from `ink` follows.
    fact gl_c = 0             // the centre pill / card
    fact gl_l = 0             // the workspace rail and its card
    fact gl_r = 0             // the battery & date capsule
    fact gl_h = 0             // the level gauge over a fullscreen window (surface hud)
    fact gl_n = 0             // a notification over a fullscreen window (surface note_hud)
    fact gl_rb = 0            // the recording bar (surface rec_bar)
    //  2026-11-02: niri draws every glass dark now (patch 0035), so the text stays white: these are
    //  held at 0 (dark). To follow niri's light/dark again, set the switch below to true.
    let gl_follow = false
    prop gl_cs = 0 ~300ms
    follow gl_cs = if(gl_follow, gl_c, 0)
    prop gl_ls = 0 ~300ms
    follow gl_ls = if(gl_follow, gl_l, 0)
    prop gl_rs = 0 ~300ms
    follow gl_rs = if(gl_follow, gl_r, 0)
    prop gl_hs = 0 ~300ms
    follow gl_hs = if(gl_follow, gl_h, 0)
    prop gl_ns = 0 ~300ms
    follow gl_ns = if(gl_follow, gl_n, 0)
    let ink_dark = #161618
    let ink = mix(ink_base, ink_dark, gl_cs)
    let ink_l = mix(ink_base, ink_dark, gl_ls)
    let ink_r = mix(ink_base, ink_dark, gl_rs)
    //  The compositor's liquid glass: frost, refraction, bevel, dispersion, rim light.
    include "glass.plm"
    include "pages/glide.plm"
    include "pages/finder.plm"

    //  The files in a window of their own (W, Super+R): tiled with the others, so files can be
    //  dragged between it and any program. The same view as the card's, laid out for its room.
    surface files {
        size: 560, 420
        kind: window
        title: "Files"
        open: fnd_win
        FilesView(0, 0, files.width, files.height, true, fnd_win and not (app == fnd or (expanded and panel == fnds)))
    }

    let teal   = #6fd3ec      // cup-teal: lit only while media is live
    // Shared glass material controls live in glass.plm.
    let amber  = #ffce6e
    let coral  = #ff7a8c
    let charge = #76ff58
    //  The controls inside the card: small pieces of solid glass, lit at the
    //  edge and lifted by a shadow; wells (fields, the stats) are pressed in.
    //  The island's light, softly: lilac and sunset mixed into the glass, not painted on it.
    let soft_l  = mix(pearl, lilac, 0.42)
    let soft_s  = mix(pearl, sunset, 0.38)
    let tint_ink = mix(ink, lilac, 0.45)
    let well    = #000000     // what is pressed in, at low opacity
    let rose    = #6a3442     // a control that removes something
    let rose_ink = #ffb3bd
    let link_c  = #6cb4ff     // a link, as iOS's blue reads on the dark glass
    //  WhatsApp's view in iMessage's own colours (not the island's tint: that follows a wallpaper).
    let im_blue  = #0a84ff    // iOS's system blue, dark: what is ours, what is unread, what sends
    let im_blue2 = #3a9bff    // …its lighter top, for the bubble's soft gradient
    let im_deep  = #3b55e6    // …and deeper, towards indigo: ours far up the chat, away from the field
    let im_gray  = chip       // their bubbles, the field, the pills: the island's own neutral chips
    let im_gray2 = chip_hi    // …and what is chosen, or has the keys

    // ── springs: GLIDE as springs, no overshoot ──────────────────
    spring shape = 520, 45.6  // critically damped (2·√520): fast, no overshoot — hover has to feel instant

    // ── what the system reports, with no logic ───────────────────
    service clock { time: text = "--:--"; date: text }
    // ── the weather (Open-Meteo, fetched by the logic) ──
    fact wx_ok = false
    fact wx_ic = 4            // 0 sun · 1 moon · 2 cloud+sun · 3 cloud+moon · 4 cloud · 5 rain · 6 snow · 7 storm · 8 fog
    fact wx_sky = 0           // 0 clear day · 1 night · 2 grey day · 3 rain by day
    text wx_city = "Weather"
    measure wxtm              // how wide the temperature is: the place and the sky sit after it
    text wx_temp = "--"
    text wx_cond = "Loading…"
    text wx_hilo = ""
    model wxh max 6 { t: text; temp: text; ic: number }
    event wx_refresh ->
    // ── the widgets ──
    event cal_web ->          // Google Calendar, in the browser
    //  Batteries: what is connected and says how full it is (rings in the stats row)
    model bats max 2 { name: text; pct: number }
    //  News
    model news max 40 { title: text; meta: text }
    fact news_lang = 0        // 0 all · 1 French · 2 English
    text news_state = "Loading…"
    event news_open ->
    event news_filter ->
    //  Gmail (scripts/gmail.py, through the logic): the inbox, newest first…
    model mail max 40 { from: text; subj: text; ago: text; unread: bool }
    fact mail_ok = false
    fact mail_setup = false   // no address and app password yet
    fact mail_unread = 0
    text mail_state = "Loading…"
    event mail_open ->
    //  The inbox turns a page (four mails) a scroll, as iOS's pages do: one swipe of
    //  the trackpad, however long it coasts, is one page; `mtick` counts its events
    //  so the lock lets go once they have stopped.
    fact mpage = 0
    fact mlock = false
    fact mtick = 0
    event mail_arch ->
    event mail_do ->          // the reader's buttons: 0 reply · 1 unread · 2 archive · 3 bin · 4 in Gmail
    event mail_send ->
    //  …and the one open in the reader.
    text mr_from = ""
    text mr_addr = ""
    text mr_init = ""
    text mr_subj = ""
    text mr_when = ""
    //  Its body: a block a run of words (markdown: links are links), or a picture.
    //  A picture's cell is 520 × 480: drawn so the picture, fitted in it, fills its block exactly.
    model mrb max 48 { md: text; img: bool; pic: image 520, 480; iw: number; ih: number; linked: bool }
    event mail_img ->         // a picture that is a link, clicked
    //  …or, in the large view, the mail as Gmail shows it: Firefox's render, in tiles of 600, and its links' boxes.
    model mrt max 8 { pic: image 620, 602 }   // 600 a step, 2 more over the next: no seam where they meet
    model mrk max 150 { x: number; y: number; w: number; h: number }
    fact mr_has_web = false
    fact mr_web_h = 0
    fact mr_web_cut = false   // longer than the render goes: the rest is Gmail's
    fact mr_web_wait = false  // Firefox is still drawing it: a quiet page meanwhile
    //  Focused (l), it is drawn larger: the same render scaled, and its first tiles photographed finer.
    model mrtz max 4 { pic: image 1004, 975 }
    fact mr_zoom_ok = false
    //  …its GIFs that move, played over the photograph where each sits (a 400 cell: a mail's GIF at its own resolution).
    model mra max 8 { pic: image 400, 400; x: number; y: number; w: number; h: number; iw: number; ih: number }
    //  Shift+K / Shift+J zoom it, as a PDF viewer does; zoomed wider than the reader, h/l pan across it.
    fact mx_zoom = 1
    fact mx_pan = 0
    event mail_wlink ->
    fact mx_web = true        // v: Gmail's look, or the island's own reader
    fact mx_focus = false     // l: the keys move through the mail, not the list (h, Esc: back)
    fact mx_rail = false      // s: the inbox list folded away, the mail alone (it folds by itself while a tool is beside it)
    //  The large view (Super+U): which mail of the list is chosen, and its keys.
    fact mx_sel = 0
    fact mx_dd = false        // the first d of dd (or g of gg): it lapses if the second does not follow at once
    fact mx_gg = false
    //  Letting a mail go, as iOS does: binning asks first; a row slides away; a pill offers it back.
    fact mr_confirm = false   // "Move to Bin?" showing in the reader's header
    fact mx_leaving = -1      // the row sliding away (its index), for the moment before it is gone
    fact mail_undo = false    // the pill: "Moved to Bin · Undo"
    fact mail_undo_bin = false
    text mail_undo_t = ""
    event mail_undo_do ->
    event mail_big            // Super+U: the large view, open or closed
    event mailx_pick ->
    event mailx_move ->
    text mr_note = ""
    text mr_in = ""
    fact mr_loading = false
    fact mr_rep = false       // the reply field is open
    fact mr_sending = false
    fact mr_seq = 0           // another mail opened: its body back to the top

    //  WhatsApp (scripts/whatsapp, a linked device of the phone, through the logic): Super+W.
    //  The chats, pinned then newest…
    model wac max 16 { name: text; last: text; ago: text; unread: number; badge: text; muted: bool; pinned: bool; group: bool; init: text; pic: image 44, 44; typing: bool }
    //  …and the open one's messages, oldest first, with a row for each day between them.
    model wam max 120 { text: text; has_text: bool; me: bool; long: bool; from: text; has_from: bool; time: text; clock: text; jumbo: bool; tail: bool; status: text; has_status: bool; day: bool; faint: bool; ghost: bool; gi: number; grp: bool; has_face: bool; face: image 28, 28; finit: text; img: bool; sticker: bool; react: text; has_react: bool; rmine: bool; edited: bool; can_edit: bool; can_save: bool; pic: image 280, 280; dw: number; dh: number; file: bool; voice: bool; vsecs: number; vwave: image 384, 48; has_vwave: bool; vbars: number; vtime: text; md: text; has_link: bool; has_lp: bool; ltitle: text; has_ltitle: bool; ldesc: text; has_ldesc: bool; lsite: text; lpic: image 420, 420; has_lpic: bool; lbig: bool; lr: number; has_q: bool; qme: bool; has_qlt: bool; qltitle: text; qlsite: text; qfrom: text; qtext: text; has_qtext: bool; full: text; video: bool; qpic: image 34, 34; has_qpic: bool; stack: number; stack_n: text; pic2: image 280, 280; pic3: image 280, 280 }
    fact wa_state: pair | qr | connecting | ok | offline = connecting
    fact wa_linked = true     // false while it has to be linked from the phone (the QR code)
    text wa_msg = ""
    text wa_qr_path = ""
    image wa_qr = from wa_qr_path, 236, 236
    fact wa_unread = 0
    text wa_list_t = "Loading…"
    fact wa_sel = 0           // the chat chosen in the list (from 0)
    fact wa_focus = false     // l: the keys scroll the chat, not the list (h, Esc: back)
    fact wa_typing = false    // the message field has the keys
    fact wa_search = false    // the search field has the keys
    fact wa_filtered = false  // …and something is written in it
    fact wa_gg = false
    fact wa_sending = false
    fact wa_seq = 0           // another chat opened: to its newest, at once
    fact wa_tail = 0          // one more message of theirs at the bottom of the open chat
    fact wa_mine = 0          // …or of ours (sent here or from the phone)
    text wa_find = ""
    //  The command line (:), as Vim's: what is written in it, what it answers (an unknown command…), the
    //  commands that fit what is written (the chosen one first lit; Tab completes it), and which is chosen.
    //  A voice note playing in its bubble: which row (-1: none), whether it runs, where this run began
    //  (seconds; the row counts on from there at the speed), a run begun (counting starts again), how
    //  long is left (the logic's, every quarter second).
    fact wa_vplay = -1
    fact wa_vgo = false
    fact wa_vfrom = 0
    fact wa_vspeed = 1
    fact wa_vseq = 0
    text wa_vleft = ""
    event wa_vseek ->         // row × 1000 + where on its waveform (‰)
    event wa_vspeed_cycle ->
    fact wa_cmd = false
    text wa_cmd_in = ""
    text wa_cmd_msg = ""
    model wacmd max 10 { name: text; desc: text }
    fact wa_cmd_sel = 0
    fact wa_cmd_said = false  // …and whether it has something to say
    event wa_cmd_run ->
    event wa_cmd_tab ->
    event wa_cmd_move ->
    text wa_in = ""
    text wa_name = ""
    fact wa_open = false      // a chat is open on the right
    fact wa_has_sub = false
    fact wa_has_in = false
    text wa_sub = ""
    text wa_init = ""
    text wa_pic_path = ""
    image wa_pic = from wa_pic_path, 36, 36
    fact wa_typing_in = false // the open chat's other side is writing
    event wa_big              // Super+W: the view, open or closed
    event wa_pick ->
    event wa_move ->
    event wa_send ->
    event wa_media ->         // a picture, video, voice note or file in the chat, pressed
    event wa_pair ->          // a new QR code
    event wa_sync ->          // R or :sync: reconnect and catch up with the phone
    event wa_find_clear ->
    event wa_wheel ->         // the wheel over the list: the logic moves its window
    event wa_older ->         // scrolled near the top of a chat
    fact wa_snap = false      // a chat opening: its rows take their heights at once, not on their springs
    fact wa_times = false     // t: every message's time, out at the chat's right (ours slide aside for them)
    //  The chat's cursor (l, then j/k), as Vim's on lines: the row it is on (-1: none), how far
    //  that row's top is from the bottom of the chat, and which way it last went (to step over days).
    fact wa_cur = -1
    fact wa_cy = 0
    fact wa_dir = 0
    fact wa_cnt = 0           // a count being typed: 5j, 3k, 12G
    fact wa_yy = false        // the first y of yy (z of zz)
    fact wa_zz = false
    fact wa_quote = false     // answering a message (r): it shows over the field
    text wa_q_from = ""
    text wa_q_text = ""
    event wa_k                // the cursor a row up / down (the logic sends one per step of a count)
    event wa_j
    event wa_last             // …to the newest (G) / the oldest drawn (gg)
    event wa_first
    event wa_center           // zz
    event wa_cmove ->         // j/k in the chat, with their count
    event wa_jump ->          // the list: 0 H · 1 M · 2 L · 3 n · 4 N · 5 zz
    event wa_yank ->          // yy: the message under the cursor, copied
    event wa_open ->          // o: its picture, file or link, opened
    event wa_reply ->         // r: answering it
    event wa_quote_clear ->
    fact wa_off = 0           // the first chat in sight
    fact wa_sb = false        // the chat list is scrolling: its bar shows (pages/whatsapp.plm)
    fact wa_msb = false       // …the messages are
    fact wa_first = 0         // …and the first the list's records hold (a few above it, to glide over)
    fact wa_total = 0         // how many chats the list goes through
    fact wa_sync_show = false // catching up after being away (the helper's "sync"), and a moment after
    fact wa_sync_p = 0        // …how far along, 0 to 1
    text wa_sync_t = ""
    fact wa_hov = -1          // the picture under the pointer (its row)
    fact wa_cur_media = false // the cursor is on a picture, video or sticker: Enter views it
    fact wa_ql = false        // Enter: a picture or video large over the chat, as macOS's Quick Look
    fact wa_qlv = false       // …a video, playing there (the engine's `video` service)
    fact wa_ql_n = 1          // …a stack's pictures: how many, and which one (h/l)
    fact wa_ql_i = 1
    fact wa_qlw = 400         // …its size, fitted into 992 × 600
    fact wa_qlh = 300
    text wa_ql_path = ""
    text wa_ql_cap = ""
    image wa_ql_img = from wa_ql_path, 1984, 1200
    service video as vid { on: bool; playing: bool; ended: bool; picture: text; position: number; length: number; error: text }
    image wa_vid = from vid.picture, 992, 600
    event wa_look ->          // Enter on a picture or video (under the cursor, or the pointer)
    event wa_look_at ->       // …that row's
    event wa_ql_step ->       // h/l over a stack: the one before / after
    event wa_ql_space ->      // Space over it: a video stops or goes on, a picture closes
    event wa_ql_seek ->       // a video: to that second
    fact wa_att = false       // files waiting over the field (pasted, dropped): Enter sends them, the words as their caption
    fact wa_att_kind = 0      // …the first one: 0 a picture, 1 a video, 2 a song or voice note, 3 any other file
    text wa_att_name = ""
    text wa_att_sub = ""
    text wa_att_path = ""
    image wa_att_pic = from wa_att_path, 44, 44
    event wa_paste ->         // Ctrl+V with no words on the clipboard (a picture, files): the logic takes it
    event wa_att_clear ->
    event wa_prefetch ->      // the pointer over a picture or file: fetched whole, ready to open or drag out
    //  Over the chat, one at a time (`wa_modal`: the view's other keys wait): the gallery (m), the
    //  reactions (e), deleting (dd), forwarding (f), searching the chat (/), a voice note (v).
    let wa_modal = wa_gal or wa_rx or wa_del > 0 or wa_fwd or wa_cs or wa_rec or wa_menu >= 0 or wa_who or wa_cmd
    //  The pointer's way to the same: a bar beside the message under it (react, reply, more), and
    //  its menu (… or a right click), opened where it was pressed, for the message it is on.
    fact wa_menu = -1         // the row the menu is for (-1: none)
    fact wa_mx = 0
    fact wa_my = 0
    fact wa_m_edit = false    // …what it offers for that message
    fact wa_m_save = false
    fact wa_m_fail = false    // one that did not go: its menu is Try Again, Copy, Delete
    fact wa_cur_fail = false  // the cursor is on one that did not go: Enter tries again
    event wa_retry ->
    event wa_act ->           // row × 10 + what: 1 react, 2 reply, 3 forward, 4 copy, 5 save, 6 edit, 7 delete, 8 open in its app, 9 try again
    event wa_rec_tap ->       // the microphone pressed: a voice note, until sent or thrown away
    event wa_ql_open ->       // Quick Look's picture, in the program that opens it
    event wa_gsave ->         // a tile's or a file's own save button (its record)
    fact wa_gal = false       // m: the chat's pictures and files
    fact wa_gtab = 0          // …0 its photos, videos and stickers, 1 its documents and voice notes
    fact wa_gc = 0            // …the one chosen (from 0, oldest first)
    fact wa_gfirst = 0        // …the first the records hold (a whole row of four)
    fact wa_grow = 0          // …the first row in sight
    fact wa_gtotal = 0
    model wag max 24 { pic: image 200, 200; cw: number; ch: number; video: bool; sticker: bool; dur: text }
    model wagf max 14 { name: text; sub: text; audio: bool }
    event wa_gal_open ->
    event wa_gmove ->         // the gallery's cursor, by so many (a row is four)
    event wa_gpick ->         // a tile or row pressed (its record)
    event wa_gview ->         // Space / Enter: the picture large, the video or the file opened
    event wa_gopen ->         // o: in the program that opens it
    event wa_gtabs ->         // Tab: photos ⇄ files
    event wa_gwheel ->
    event wa_save ->          // Ctrl+S (s in the gallery): into ~/Downloads
    fact wa_rx = false        // e: the reactions over the message under the cursor
    fact wa_rxi = 0           // …the one chosen (0–5)
    fact wa_rx_mine = -1      // …the one we gave it already (-1: none, 6: another)
    event wa_rx_open ->
    event wa_react ->         // one of the six (-1: ours taken back)
    fact wa_del = 0           // dd: 1 ours (for everyone, or for us), 2 theirs (for us only)
    fact wa_dd = false
    event wa_del_ask ->
    event wa_del_do ->        // 1 for everyone, 2 here only
    event wa_edit ->          // c: one of ours, written again
    fact wa_fwd = false       // f: which chat to send the message under the cursor to
    fact wa_fwi = 0
    text wa_fwd_q = ""
    model wafw max 8 { name: text; init: text; pic: image 32, 32 }
    fact wa_who = false       // E (or a press on a message's reactions): who reacted, with what
    fact wa_whi = 0           // …the one chosen
    fact wa_who_tab = 0       // …all of them (0), or one emoji's
    model wawho max 12 { name: text; init: text; pic: image 32, 32; emoji: text; me: bool; sub: text }
    model wawt max 7 { label: text }
    event wa_who_open ->
    event wa_link_at ->       // a link's card pressed: the browser (the row's index)
    event wa_qjump ->         // a reply's quoted message pressed: the chat goes to the original (the row's index)
    event wa_who_at ->        // …that row's
    event wa_who_move ->
    event wa_who_tab ->
    event wa_who_tab_at ->
    event wa_who_pick ->      // ours: taken back
    event wa_fwd_open ->
    event wa_fwd_move ->
    event wa_fwd_pick ->
    fact wa_cs = false        // /: the field that searches the chat has the keys
    fact wa_csr = false       // …and what it found is being gone through (n N)
    text wa_cq = ""
    text wa_cs_t = ""
    event wa_cs_go ->         // 0 the newest found, 1 the next older, -1 the next newer
    event wa_cs_close ->
    fact wa_detached = false  // a message found far back: the chat shows its part, not the newest (G goes back)
    event wa_newest ->
    fact wa_rec = false       // v: a voice note being recorded
    fact wa_rec_free = false  // …let go of quickly: it goes on until Enter (held: until v is let go)
    text wa_rec_t = "0:00"
    event wa_rec_send ->
    event wa_rec_cancel ->
    text wa_toast = ""        // what just happened (Saved to Downloads, Forwarded…), for a moment
    fact wa_toast_on = false
    service media { playing: bool; title: text; artist: text; position: number; length: number; rate: number = 1 }
    service battery { present: bool; percent: number = 100; charging: bool }
    service audio { volume: number; muted: bool }
    service brightness as backlight { present: bool; level: number }

    // ── what the logic reports ───────────────────────────────────
    text cover_path = ""
    fact has_art = false
    //  The artwork's colour (the logic picks it), for the waveform; teal without one.
    fact art_r: number = 0.435
    fact art_g: number = 0.827
    fact art_b: number = 0.925
    fact art_tinted = false
    fact art_aspect: number = 1   // the artwork's width over its height: 1 an album's, 1.78 a video's
    fact has_player = false   // any MPRIS player at all (the logic knows; texts don't compare)
    //  Wide, so a video's 16:9 frame fills it and square album art sits in its middle:
    //  either way the squircle it is clipped to is filled, never letterboxed.
    image cover = from cover_path, 86, 48
    image ic_out = file "icons/logout.svg", 18, 18
    image ic_re = file "icons/restart.svg", 18, 18
    image ic_off = file "icons/power.svg", 18, 18
    image ic_search = file "icons/search.svg", 14, 14
    image ic_x = file "icons/xmark.svg", 12, 12
    //  What stands in for a WhatsApp message: on its way, view once, open on the phone, deleted.
    image ic_g_wait = file "icons/timer.svg", 13, 13
    image ic_g_once = file "icons/once.svg", 13, 13
    image ic_g_phone = file "icons/phone.svg", 13, 13
    image ic_g_del = file "icons/nosign.svg", 13, 13
    image ic_trash = file "icons/trash.svg", 15, 15
    image ic_doc = file "icons/doc.svg", 24, 24
    image ic_folder = file "icons/folder.svg", 24, 24
    image ic_chev = file "icons/chevron.svg", 14, 14
    image ic_search_l = file "icons/search.svg", 20, 20     // the launcher's search pill
    image ic_sun = file "icons/sun.svg", 16, 16
    image ic_wifi_s = file "icons/wifi.svg", 16, 16
    image ic_bt_s = file "icons/bluetooth.svg", 16, 16
    image ic_spk_s = file "icons/speaker.svg", 16, 16
    image ic_ext_s = file "icons/external.svg", 16, 16
    image ic_code_s = file "icons/code.svg", 16, 16
    image ic_lock_s = file "icons/lock.svg", 16, 16
    image ic_off_s = file "icons/power.svg", 16, 16
    image ic_re_s = file "icons/restart.svg", 16, 16
    image ic_out_s = file "icons/logout.svg", 16, 16
    image ic_trash_l = file "icons/trash.svg", 16, 16
    image ic_bell = file "icons/bell.svg", 14, 14
    image ic_moon = file "icons/moon.svg", 14, 14
    image ic_plug = file "icons/plug.svg", 13, 13   // plugged in: a power plug (the user's choice; iOS itself draws a bolt while charging)
    image ic_grid = file "icons/grid.svg", 14, 14
    image ic_photo = file "icons/photo.svg", 14, 14
    image ic_smile = file "icons/smile.svg", 14, 14
    image ic_windows = file "icons/windows.svg", 14, 14
    image ic_shot = file "icons/shot.svg", 14, 14
    image ic_rec = file "icons/record.svg", 14, 14
    image ic_stop = file "icons/stop.svg", 14, 14
    image ic_picker = file "icons/picker.svg", 14, 14
    image ic_mixer = file "icons/mixer.svg", 14, 14
    image ic_night = file "icons/night.svg", 14, 14
    image ic_awake = file "icons/awake.svg", 14, 14
    image ic_leaf = file "icons/leaf.svg", 14, 14
    image ic_gauge = file "icons/gauge.svg", 14, 14
    image ic_rocket = file "icons/rocket.svg", 14, 14
    image ic_lock = file "icons/lock.svg", 18, 18
    //  Weather symbols, in their own colours as iOS draws them (not tinted).
    image wx_sun = file "icons/wx-sun.svg", 30, 30
    image wx_moon = file "icons/wx-moon.svg", 30, 30
    image wx_csun = file "icons/wx-cloud-sun.svg", 30, 30
    image wx_cmoon = file "icons/wx-cloud-moon.svg", 30, 30
    image wx_cloud = file "icons/wx-cloud.svg", 30, 30
    image wx_rain = file "icons/wx-rain.svg", 30, 30
    image wx_snow = file "icons/wx-snow.svg", 30, 30
    image wx_storm = file "icons/wx-storm.svg", 30, 30
    image wx_fog = file "icons/wx-fog.svg", 30, 30
    image ic_cal = file "icons/calendar.svg", 15, 15
    image ic_news = file "icons/news.svg", 15, 15
    image ic_mail = file "icons/mail.svg", 15, 15
    image ic_chat = file "icons/chat.svg", 15, 15
    image ic_up = file "icons/arrow-up.svg", 14, 14
    image ic_pin = file "icons/pin.svg", 11, 11
    image ic_bellx = file "icons/bell-slash.svg", 11, 11
    image ic_reply = file "icons/reply.svg", 15, 15
    image ic_unread = file "icons/unread.svg", 15, 15
    image ic_archive = file "icons/archive.svg", 15, 15
    image ic_archive_s = file "icons/archive.svg", 12, 12
    image ic_trash_s = file "icons/trash.svg", 14, 14
    image ic_ext = file "icons/external.svg", 15, 15
    image ic_mic = file "icons/mic.svg", 15, 15
    image ic_more = file "icons/ellipsis.svg", 15, 15
    image ic_dl = file "icons/download.svg", 14, 14
    image ic_fwd = file "icons/forward.svg", 15, 15
    image ic_photo_m = file "icons/photo.svg", 15, 15
    image ic_smile_m = file "icons/smile.svg", 15, 15
    image ic_send = file "icons/send.svg", 14, 14
    //  The Controls page's buttons: the same symbols, drawn larger.
    image cc_grid = file "icons/grid.svg", 20, 20
    image cc_clip = file "icons/clip.svg", 20, 20
    image cc_smile = file "icons/smile.svg", 20, 20
    image cc_photo = file "icons/photo.svg", 20, 20
    image cc_shot = file "icons/shot.svg", 20, 20
    image cc_rec = file "icons/record.svg", 20, 20
    image cc_stop = file "icons/stop.svg", 20, 20
    image cc_picker = file "icons/picker.svg", 20, 20
    image cc_mixer = file "icons/mixer.svg", 20, 20
    image cc_moon = file "icons/moon.svg", 20, 20
    image cc_night = file "icons/night.svg", 20, 20
    image cc_awake = file "icons/awake.svg", 20, 20
    image cc_leaf = file "icons/leaf.svg", 20, 20
    image cc_gauge = file "icons/gauge.svg", 20, 20
    image cc_tune = file "icons/tune.svg", 20, 20
    image cc_rocket = file "icons/rocket.svg", 20, 20
    image cc_timer = file "icons/timer.svg", 20, 20
    image cc_watch = file "icons/stopwatch.svg", 20, 20
    image cc_camera = file "icons/camera.svg", 20, 20
    image cc_folder = file "icons/folder.svg", 20, 20
    image cc_drive = file "icons/drive.svg", 20, 20
    image cc_activity = file "icons/activity.svg", 20, 20
    image cc_switch = file "icons/switch.svg", 20, 20
    image ic_cam_l = file "icons/camera.svg", 20, 20
    image ic_folder_s = file "icons/folder.svg", 16, 16
    image fi_folder = file "icons/folder.svg", 18, 18
    image fi_doc = file "icons/doc.svg", 18, 18
    image fi_photo = file "icons/photo.svg", 18, 18
    image fi_film = file "icons/film.svg", 18, 18
    image fi_code = file "icons/code.svg", 18, 18
    image ic_timer = file "icons/timer.svg", 14, 14
    image ic_watch = file "icons/stopwatch.svg", 14, 14
    image dv_head = file "icons/headphones.svg", 18, 18
    image dv_mouse = file "icons/mouse.svg", 18, 18
    image dv_keys = file "icons/keyboard.svg", 18, 18
    image dv_phone = file "icons/phone.svg", 18, 18
    image dv_other = file "icons/btdev.svg", 18, 18
    image ic_speaker_s = file "icons/speaker.svg", 14, 14
    image ic_mute_s = file "icons/muted.svg", 14, 14
    image ic_shot_l = file "icons/shot.svg", 20, 20
    image ic_rec_l = file "icons/record.svg", 20, 20
    image ic_windows_l = file "icons/windows.svg", 20, 20
    image ic_clip = file "icons/clip.svg", 14, 14
    image ic_xmark = file "icons/xmark.svg", 12, 12
    image ic_check = file "icons/check.svg", 10, 10
    image ic_spk = file "icons/speaker.svg", 18, 18
    image ic_mute = file "icons/muted.svg", 16, 16
    image ic_mute_cut = file "icons/muted-cut.svg", 16, 16
    image ic_w1 = file "icons/wave1.svg", 18, 18
    image ic_w2 = file "icons/wave2.svg", 18, 18
    image ic_w3 = file "icons/wave3.svg", 18, 18
    image ic_note = file "icons/note.svg", 14, 14
    repeat i in 1..15 {
        fact ws.$i.there = false
    }
    fact ws_active = 1
    fact ws_count = 1
    fact ws_slot = 0          // active position in the visible rail, not desktop ID
    fact ws_vertical = false  // the compositor slides workspaces up and down (niri)
    fact cpu = 0              // %
    fact cpu_t = 0            // degrees, for the stat rings (scripts/temps.sh)
    fact gpu_t = -1           // degrees; -1 while the dGPU sleeps (asking would wake it)
    fact mem = 0              // GiB used
    fact mem_frac = 0         // 0..1

    event toggle ->
    event seek_to ->           // seconds from the start of the song
    event next ->
    event previous ->
    event go ->
    event ws_step ->
    event vol_step ->
    event log_out ->
    event restart ->
    event power_off ->

    // ── Wi-Fi and Bluetooth: the logic fills these (island.luau) ─
    //  Rows say which one by their position; the logic keeps the rest
    //  (an address, the real name) in the same record, out of the scene's sight.
    model nets max 16 { ssid: text; sig: number; secure: bool; known: bool; active: bool; busy: bool; asking: bool; menu: bool; wrong: bool }
    model devs max 16 { name: text; icon: image 20, 20; status: text; battery: number = -1; connected: bool; busy: bool; menu: bool; caption: number }
    fact wifi_on = false
    //  The cable (a port, a USB adapter, a phone's tethering), from the network service:
    //  0 none, 1 unplugged, 2 switched off, 3 connected; and whether it is the way out now.
    fact eth = 0
    fact eth_used = false
    text eth_name = "Ethernet"
    text net_title = "Wi-Fi"   // the home pill: Wi-Fi, or the cable while it is the way out
    text net_page = "Wi-Fi"    // its page's title: Internet when there is a cable too
    text eth_state = ""        // No cable · Off · Connected
    event eth_toggle ->        // the cable on or off (off: the wifi takes over)
    event net_power ->         // the home pill's bead: the connection in use, off
    fact bt_on = false
    fact scanning = false     // a Wi-Fi scan the logic asked for is under way
    fact bt_scanning = false
    fact busy_any = false     // something is connecting: the spinners turn
    fact pw_open = false      // a password is being asked for
    fact pw_bad = false       // and the last one was wrong
    fact pw_wrongs = 0        // how many times: each one shakes the field
    text wifi_label = "…"
    text bt_label = "…"
    text pw_for = ""
    text pass = ""
    event wifi_pick ->
    event wifi_join ->
    event wifi_cancel ->
    event wifi_disconnect ->
    event wifi_forget ->
    event wifi_power ->
    event wifi_scan ->
    event bt_pick ->
    event bt_forget ->
    event bt_power ->
    event bt_menu ->
    event wifi_menu ->
    event open_wifi

    // ── the clipboard: the logic hands over only the rows in sight ──
    model clips max 12 { kind: number; text: text; thumb: image 96, 54; ago: text; sel: bool; dims: text }
    event clip_hover ->        // a row under the pointer (its index), or -1 off the list
    //  The chosen one, large: 1 a text, 2 a picture.
    fact cpv_kind = 0
    text cpv_text = ""
    text cpv_meta = ""
    text cpv_img_path = ""
    image cpv_img = from cpv_img_path, 324, 320
    fact cpv_iw = 464
    fact cpv_ih = 260
    fact clip_total = 0       // how many match the search
    fact clip_off = 0         // which of them is the first in sight
    fact clip_q_empty = true
    fact clip_insert = false  // vim: searching (insert) or moving through the list (normal)
    fact clip_dd = false      // a first `d` (or `g`) waiting for its second
    fact clip_gg = false
    text clip_q = ""
    event clip_open           // Super+C: `lumen --say island "emit clip_open"`
    fact side = false         // a tool open from the right capsule, beside a large view (WhatsApp, the mail, the files)
    fact side_k = 0           // …which: 1 the clipboard, 2 the emoji, 3 the files (kept while it closes; 0 once the calendar has it)
    fact wa_rail = false      // s: WhatsApp's chat list folded into a strip of faces (it folds by itself while a tool is beside it)
    fact side_focus = true    // …and it has the keys (Ctrl+h gives them to the view on the left, Ctrl+l back)
    event clip_pick_row ->
    event clip_del_row ->
    event clip_scroll ->
    event clip_clear ->
    event clip_move ->
    event clip_pick ->
    event clip_del ->
    event clip_q_clear ->

    // ── projects (Mod+A): sesh's list; picked, niri's project.sh opens its workspace ──
    model projs max 8 { kind: number; name: text; sub: text; open: bool; cur: bool; head: bool; sel: bool }
    fact proj_tab = 0         // 0 all, 1 tmux, 2 configs, 3 folders
    fact proj_state = 0       // 0 nothing to say, 1 nothing found, 2 looking
    fact proj_q_empty = true
    text proj_q = ""
    text proj_pv_name = ""
    text proj_pv_meta = ""
    text proj_pv = ""
    event proj_open           // Mod+A: `lumen --say island "emit proj_open"`
    event proj_move ->
    event proj_pick ->
    event proj_pick_row ->
    event proj_scroll ->
    event proj_tab_at ->
    event proj_tab_step ->
    event proj_clear ->

    // ── storage (Controls → Storage, Mod+B): scripts/storage.py's scan and clean-ups ──
    model stseg max 11 { w: number; hue: number }
    model strows max 7 { name: text; sub: text; size: text; frac: number; hue: number; dir: bool; can_trash: bool; armed: bool; root: bool; sel: bool }
    fact stor_tab = 0          // 0 overview, 1 clean up
    fact stor_depth = 0        // folders opened below the overview
    fact stor_state = 0        // 0 fine, 1 scanning, 2 empty, 3 failed
    fact stor_rev = false      // a clean-up's review is up
    fact stor_rev_root = false
    fact stor_busy = false     // cleaning: the review waits for it (and for the password)
    fact stor_can_open = false // inside a real folder: it can be opened in the file manager
    fact stor_q_empty = true
    fact stor_ins = false      // vim: searching (insert) or moving through the list (normal)
    fact stor_dd = false       // a first `d` (or `g`) waiting for its second
    fact stor_gg = false
    text stor_q = ""
    text stor_used = ""
    text stor_free = ""
    text stor_crumb = ""
    text stor_status = ""
    text stor_rev_title = ""
    text stor_rev_size = ""
    text stor_rev_about = ""
    text stor_rev_text = ""
    text stor_rev_btn = ""
    event stor_open            // Mod+B: `lumen --say island "emit stor_open"`
    event stor_tab_at ->
    event stor_row ->
    event stor_trash ->
    event stor_scroll ->
    event stor_up ->
    event stor_rescan ->
    event stor_rev_cancel ->
    event stor_rev_go ->
    event stor_files ->
    event stor_clear ->
    event stor_move ->
    event stor_pick ->
    event stor_del ->
    event stor_tab_step ->

    // ── activity (Controls → Activity, Mod+X): a task manager over lumen's `processes` ──
    model acts max 7 { name: text; sub: text; initial: text; cpu: text; mem: text; app: bool; group: bool; can_kill: bool; armed: bool; force: bool; sel: bool }
    model actspark max 44 { h: number }
    fact act_tab = 0           // 0 by CPU, 1 by memory
    fact act_depth = 0         // inside an app's processes
    fact act_mem_k = 0         // memory used, 0..1
    fact act_desc = true       // the sort's way round (CPU and memory: biggest first; name: A to Z)
    fact act_q_empty = true
    fact act_ins = false
    fact act_dd = false
    fact act_gg = false
    text act_q = ""
    text act_cpu = ""
    text act_mem = ""
    text act_info = ""
    text act_count = ""
    text act_crumb = ""
    text act_status = ""
    event act_open             // Mod+X: `lumen --say island "emit act_open"`
    event act_tab_at ->
    event act_row ->
    event act_quit ->
    event act_scroll ->
    event act_up ->
    event act_clear ->
    event act_move ->
    event act_pick ->
    event act_del ->
    event act_tab_step ->
    event act_reverse ->
    image ic_code_p = file "icons/code.svg", 18, 18
    image ic_tune_p = file "icons/tune.svg", 18, 18
    image ic_folder_p = file "icons/folder.svg", 18, 18

    // ── the launcher (Super+D): a search pill; apps, the system's switches, or files after a leading space ──
    model hits max 6 { kind: number; name: text; sub: text; has_sub: bool; icon: image 28, 28; sel: bool; sk: number; on: bool; val: text }    // kind 3: a setting (sk which)
    fact launch_total = 0
    fact launch_off = 0
    fact launch_q_empty = true
    fact files_mode = false
    fact launch_state = 0     // 0 nothing to say, 1 nothing found, 2 looking
    text launch_q = ""
    text launch_where = "Files"
    event launch_open         // Super+D: `lumen --say island "emit launch_open"`
    event launch_move ->
    event launch_pick ->
    event launch_pick_row ->
    event launch_scroll ->
    event launch_into ->
    event launch_up ->

    // ── notifications: the pill grows into a banner; the card keeps the rest ──
    fact banner = false       // a banner is showing
    //  The island is on one monitor at a time: the one in use (wsl.place in the logic, `screens.only`).
    //  Notifications stay on the laptop: with the island on the TV, the card comes as surface note_hud.
    fact isl_tv = false
    fact st_lap_w = 1600      // what each monitor measures, and the workspace it shows (the logic says)
    fact st_tv_w = 1920
    fact st_lap_ws = 1
    fact st_tv_ws = 7
    event isl_lap ->
    event isl_tv_here ->
    let ban_here = banner and not isl_tv
    fact banner_seq = 0       // one more each time a new one arrives
    text n_app = ""
    text n_title = ""
    text n_body = ""
    text n_pic_path = ""
    image n_pic = from n_pic_path, 44, 44
    fact n_is_pic = false     // the sender's picture, not the app's icon
    fact n_urgent = false
    model nacts max 3 { label: text }
    measure n_bm
    fact n_count = 0
    model notes max 4 { app: text; title: text; body: text; pic: image 40, 40; is_pic: bool; urgent: bool; ago: text }
    event note_open ->
    event note_dismiss ->
    event note_act ->
    event note_open_row ->
    event note_del_row ->
    event notes_clear ->
    event notes_scroll ->
    event open_notes
    fact n_more = 0           // how many more arrived while this banner showed
    fact dnd = false          // muted: no banners (urgent ones still come), all still listed
    event dnd_toggle ->

    // ── the tray: apps' status icons on the bar, a glass menu on right-click ──
    model trayi max 4 { icon: image 16, 16; title: text }
    fact tm_slot = 0          // which tray icon the menu belongs to
    fact tm_rows_h = 0        // its rows' height (a separator is thin)
    model trows max 10 { label: text; separator: bool; enabled: bool = true; checked: number = -1; children: number; back: bool }
    fact tmenu_open = false
    fact tray_cool = false    // a tray icon was just clicked: the next 450 ms are the same click
    on still tray_cool for 450ms while tray_cool { tray_cool = false }
    event tray_activate ->
    event tray_menu ->
    event tray_choose ->

    // ── emoji: the logic hands over the 32 in sight ──
    model emo max 56 { e: text; name: text; sel: bool }
    fact emo_q_empty = true
    //  Where the chosen one of each list is among those in sight (-1: none): its gliding glass (pages/glide.plm).
    fact clip_at = -1
    fact launch_at = -1
    fact proj_at = -1
    fact stor_at = -1
    fact act_at = -1
    fact emo_at = -1
    fact wall_at = -1
    fact win_at = -1
    fact fnd_at = -1
    fact emo_insert = false   // vim: searching (insert) or moving through the grid (normal)
    fact emo_from = false     // opened over a field being typed in (WhatsApp, a mail's reply): what is chosen goes
                              // into it at its cursor, the picker stays for more, and one Escape goes back to it
    fact emo_gg = false       // a first `g` waiting for its second
    event emo_q_clear ->
    event emo_cat_step ->     // [ ] : the category before or after the one in sight
    fact emo_cat_at = -1      // which category the rows in sight belong to (-1: recent)
    text emo_q = ""
    text emo_name = ""
    event emoji_open          // Super+E: `lumen --say island "emit emoji_open"`
    event emo_move ->
    event emo_pick ->
    event emo_pick_cell ->
    event emo_scroll ->
    event emo_cat ->

    // ── wallpapers: the logic hands over the nine in sight ──
    model walls max 9 { thumb: image 112, 70; name: text; sel: bool; cur: bool }
    fact wall_total = 0
    text wall_name = ""
    event wall_open           // Super+P: `lumen --say island "emit wall_open"`
    event wall_move ->
    event wall_pick ->
    event wall_pick_cell ->
    event wall_scroll ->

    // ── the window switcher: Alt+Tab (Hyprland's binds), or the header's bead ──
    model wins max 6 { picture: image 156, 88; icon: image 16, 16; has_icon: bool; title: text; app: text; ws: text; sel: bool; has_pic: bool }
    fact wins_total = 0
    event win_open            // `emit win_open 1` steps forward (Alt+Tab), -1 back; 0 just opens
    event win_commit          // Alt let go: focus the chosen one
    event win_cancel
    event win_step ->
    event win_pick ->
    event win_pick_cell ->
    event win_scroll ->
    event win_close_cell ->   // the × on a window's picture
    event win_look ->
    fact switching = false    // opened by Alt+Tab: letting go of Alt picks
    fact wv = false           // the left capsule grown into the window viewer

    // ── capture: screenshots and recordings ──
    fact cap_rec = false      // the page's mode: a screenshot or a recording
    fact cap_save = true      // screenshots also go to ~/Pictures/Screenshots
    fact recording = false
    text rec_time = "0:00"
    text rec_at = ""          // niri's screenshot UI: "at WxH+X+Y" or "output NAME" starts a recording
    event cap_take ->         // which: 0 region, 1 window, 2 screen
    event rec_stop ->
    event shot_open
    event rec_open

    // ── the mixer: where it plays, and each application's volume ──
    model outs max 3 { name: text; on: bool }
    model mixapps max 3 { name: text; title: text; volume: number; muted: bool; icon: image 16, 16 }
    fact mix_more = 0         // apps beyond the three in sight (the wheel scrolls them)
    event mix_scroll ->
    event mix_out ->
    event mix_set ->
    event mix_mute ->
    event mix_master ->

    // ── the colour picker: the pill shows what it picked ──
    fact picked = false
    fact pk_seq = 0
    fact pk_r = 1
    fact pk_g = 1
    fact pk_b = 1
    text pk_hex = ""
    event pick_color ->
    event open_mix
    // ── the Glass page (pages/glasstune.plm): live sliders over glass.plm ──
    //  Each slider's override of a saved glass value (-1: none, the saved one
    //  shows); set by the logic as a slider moves, read by glass.plm.
    fact lgo_readability = -1
    fact lgo_frost_strength = -1
    fact lgo_refraction = -1
    fact lgo_bevel = -1
    fact lgo_card_refraction = -1
    fact lgo_card_bevel = -1
    fact lgo_dispersion = -1
    fact lgo_specular = -1
    fact lgo_merge = -1
    fact lgo_tint = -1
    fact lgo_card_tint = -1
    fact lgo_prism = -1
    fact lgo_card_rim = -1
    fact lgo_magnify = -1
    fact lgo_glass_tint = -1
    fact lgo_rim_tint = -1
    fact lgo_milk = -1
    fact gl_dirty = false      // overrides not yet saved
    text gl_note = ""          // "Saved", briefly
    event open_gtune
    event gl_set ->            // slider index * 10000 + position (0..1000)
    event gl_save ->
    event gl_reset ->

    // ── a copy: the pill widens for a moment to show what was copied ──
    fact copied = false
    fact cp_seq = 0
    fact cp_kind = 0          // 0 text, 1 image, 2 text read off the screen (OCR), 3 OCR found nothing
    text cp_text = ""
    text cp_thumb_path = ""
    image cp_thumb = from cp_thumb_path, 48, 27
    //  A copied picture: the pill grows down over the windows into a card
    //  shaped like it (fitted in 300 × 170), so you can make out what it was.
    text cp_img_path = ""
    image cp_big = from cp_img_path, 300, 170
    fact cp_iw = 300          // the picture, fitted
    fact cp_ih = 170
    text cp_dims = ""
    measure cpm
    fact low_seq = 0          // one more each time the battery crosses 20 % or 10 %
    event copy_kind ->        // ocr-sel: `emit copy_kind 1` before it copies, `2` when it found nothing

    // ── the focused app: its icon right of the workspaces (waybar's front app) ──
    //  Two slots, so a change can crossfade: the new icon goes in the hidden one.
    text front_a = ""
    text front_b = ""
    text front_name = ""
    fact front_has = false
    fact front_on_b = false   // which slot shows the app in focus
    image front_ia = from front_a, 18, 18
    image front_ib = from front_b, 18, 18
    measure frm

    // ── going idle, and coming back (hypridle: `emit idle_warn` at 5 min, `emit idle_resume` on
    //  input): the pill widens and says so, instead of two notifications ──
    fact idle_on = false
    fact idle_back = false
    fact idle_left = 300      // seconds before the lock (hypridle's: 10 min idle, warned at 5)
    event idle_warn
    event idle_resume
    image ic_moon_i = file "icons/moon.svg", 18, 18
    image ic_check_i = file "icons/check.svg", 16, 16

    // ── a device connects: the pill shows it, with its battery (AirPods-style) ──
    fact dev_on = false
    fact dv_seq = 0
    fact dv_glyph = 0         // 0 headphones, 1 mouse, 2 keyboard, 3 phone, 4 anything else
    fact dv_bat = -1          // 0..1, or -1 when it doesn't say
    text dv_name = ""
    measure dvm

    // ── landing on another desktop (niri): its name, and the apps on it ──
    fact ld_on = false
    fact ld_seq = 0
    fact ld_n = 0             // app icons to show, most recently used first (at most four)
    text ld_name = ""
    text ld_a1 = ""
    text ld_a2 = ""
    text ld_a3 = ""
    text ld_a4 = ""
    image ld_i1 = from ld_a1, 20, 20
    image ld_i2 = from ld_a2, 20, 20
    image ld_i3 = from ld_a3, 20, 20
    image ld_i4 = from ld_a4, 20, 20
    measure ldm

    // ── a timer or a stopwatch: a Live Activity beside the island ──
    fact tmr_on = false       // running (or paused)
    fact tmr_paused = false
    fact tmr_mode: timer | watch = timer
    fact tmr_frac = 1         // a timer's part still to go
    text tmr_text = "0:00"
    text tmr_total = ""
    measure tbm
    event tmr_start ->        // a timer of so many seconds
    event watch_start ->
    event tmr_pause ->        // pause or resume
    event tmr_cancel ->
    event tmr_add ->          // seconds more
    event open_timer
    event open_watch

    // ── the camera: lumen's own (a live viewfinder, photos, videos) ──
    service camera as cam { present: bool; on: bool; picture: text; recording: bool; last: text; error: text }
    image cam_view = from cam.picture, 896, 504
    text cam_last_photo = ""
    image cam_last = from cam_last_photo, 71, 40
    text cam_rec_time = "0:00"
    fact cam_video = false
    fact cam_shots = 0        // one more each photo: the thumbnail pops
    fact cam_has_last = false
    event open_cam
    event cam_photo ->
    event cam_record ->
    event cam_record_stop ->
    event cam_open_last ->
    event cam_open_dir ->

    // ── files: the file manager (pages/finder.plm, finder.luau) ──
    //  A row of the folder or of a search (only those in sight): its picture (thumbnail or icon,
    //  `ar` its shape, 0 an icon), name, where (a search), size, age; marked, cut, its key
    //  (1–9 pinned, 'a marked), `hint` predicted, `head` a section's heading.
    model fhits max 48 { name: text; sub: text; ic: image 96, 96; ar: number; size: text; date: text; sel: bool; mark: bool; cut: bool; badge: text; hasb: bool; hint: bool; dir: bool; head: bool; link: bool; target: bool; drag: text }
    model fcarry max 3 { ic: image 96, 96 }   // what is carried (yy / dd), as a small stack
    fact fnd_carrying = false
    fact fnd_tgt_here = true   // …and p would drop it here (a file under the cursor), not into a folder
    text fnd_carry = ""
    fact fnd_rhover = -1       // the place, and the crumb, under the pointer (a drop lands there)
    fact fnd_chover = -1
    event fnd_carried ->       // a row dragged out of the files (let go on them again: moved)
    event fnd_spring ->        // a drag held over a folder row: it opens
    event fnd_rspring ->       // …or over a place on the left
    //  The places on the left: headings and folders; `kind` 0 a place, 1 suggested, 2 a drive.
    model frail max 30 { name: text; ic: image 18, 18; badge: text; hasb: bool; head: bool; at: bool; kind: number }
    model fcrumbs max 6 { name: text; last: bool }
    model pvd max 24 { name: text; dir: bool; ic: image 52, 52; hint: bool; sub: text }
    fact pvd_list = false     // a folder's preview lists its contents instead of icons
    fact pvd_more = 0
    fact fq_empty = true
    fact fnd_insert = false   // typing in the field: a search (fnd_qkind 1, i) or the folder's filter (2, /)
    fact fnd_qkind = 1
    fact fnd_filtering = false
    fact fnd_mode = 0         // 0 a folder · 1 a search's results · 2 Open With's applications
    fact fnd_grid = false     // the folder as a grid of thumbnails (w)
    fact fnd_cols = 4         // …its columns, for the room it has
    fact fnd_pv_on = true     // the preview showing (P)
    fact fnd_count = 0        // how many there are in all, and the first in sight
    fact fnd_first = 0
    fact fnd_hover = -1       // the row under the pointer (a drop on a folder goes into it)
    fact fnd_lw = 480         // the list's room, told by the copy showing (the card's or the window's)
    fact fnd_lh = 462
    fact fnd_pvh = 454
    fact fnd_pre = false      // a key waiting for its second (g, y, d, m, ', f, z): the foot says what can follow
    fact fnd_visual = false
    fact fnd_busy = false
    fact fnd_vplay = false    // a video playing in the preview
    fact fnd_isvid = false
    fact fnd_win = false      // the files in a window of their own (W, Super+R)
    fact fnd_kon = false      // the files have the keys: the logic takes them
    text fq = ""
    text fnd_title = "Files"
    text fnd_status = ""
    text fnd_pending = ""
    text fnd_busy_text = ""
    text fnd_ext = ""         // a folder or file from outside (xdg-open): `lumen --say island "text fnd_ext PATH"`
    fact pv_kind = 0          // 0 nothing, 1 text, 2 picture, 3 a list, 4 no preview, 5 the keys, 6 prose, 7 a folder, 8 an archive's contents
    text pv_name = ""
    text pv_meta = ""
    text pv_text = ""
    text pv_img_path = ""
    image pv_img = from pv_img_path, 1248, 800   // twice what it is drawn at whole: room to zoom in sharp
    image fnd_vid = from vid.picture, 1248, 800  // a video playing in the preview, on the same canvas
    image ic_pop = file "icons/external.svg", 14, 14
    fact fnd_view = false     // looking closer at the preview (K, or a click): its keys move and zoom it
    fact pv_z = 1             // its zoom: 1 is all of it in view
    fact pv_px = 0            // …and how far it is moved, from the middle
    fact pv_py = 0
    text pv_zoom = "100%"
    event pv_zoom ->          // by that factor
    event pv_grab ->
    event pv_drag_x ->
    event pv_drag_y ->
    event pv_click ->
    fact pv_iw = 312
    fact pv_cs = 1            // how much the preview's 624×400 canvas is scaled so the picture in it fills its frame exactly
    fact pv_ih = 200
    event find_open           // Super+Y: the files in the pill's card
    event files_win           // Super+R: the files in a window of their own
    event fnd_raise ->        // …already open: brought forward
    event fnd_search_click -> // the search button
    event fnd_view_as ->      // a folder's preview: 0 a list · 1 icons
    event fnd_grid_as ->      // the folder: 0 a list · 1 a grid
    event fnd_crumb ->
    event fnd_rail ->
    event fnd_eject ->
    event fnd_hbtn ->         // the header's buttons: 1 back · 2 up · 3 preview · 4 window · 5 keys
    event fnd_pick_row ->     // a click (twice: open)
    event fnd_mark_row ->     // a right click: marked
    event fnd_scroll ->
    event fnd_vseek ->
    event fnd_prompt_ok ->
    fact fnd_marks = 0        // how many are marked
    fact fnd_help_on = false  // the key list shows in the preview
    fact fnd_prompting = false
    fact fnd_toast_on = false
    fact fnd_toast_seq = 0
    text fnd_toast = ""
    text fnd_sort = "Name ↑"
    text fnd_in = ""
    text fnd_prompt_label = "Rename"
    text fnd_help_text = ""
    measure prlm

    // ── toggles ──
    fact night = false
    fact awake = false
    fact profile: saver | balanced | performance = balanced
    event night_toggle ->
    event awake_toggle ->
    //  Switching compositor (Hyprland <-> niri, scripts/switch-wm.sh): the bead left
    //  of Log out, held (every window closes and comes back).
    event wm_switch ->
    event awake_tap           // the Keep Awake button: off → choose how long; on → end it
    event awake_for ->        // minutes (0: until turned off)
    text awake_left = "On"    // what the button says while it runs: "1:42 left"
    //  The dial (Timer, Keep Awake): where its knob is (0..1), which step that is, and what it says.
    fact dial_f: number = 0.2
    fact dial_idx = 0
    text dial_label = "5 min"
    text dial_sub = "Let go to start"
    event dial_move ->
    event dial_go ->
    event dial_step ->
    event profile_next ->
    event profile_set ->      // the controls' segmented power mode: 0 saver, 1 balanced, 2 performance
    event cc_bright ->        // the controls' levels (0..1)
    event cc_vol ->
    event kbd_cycle ->        // the keyboard light: off, half, full (the launcher's search too)

    // ── privacy: what is listening or watching ──
    fact mic_on = false
    fact cam_on = false
    fact scr_on = false

    // ── polkit: the island is the session's password prompt ──
    service polkit as pk {
        pending: bool
        asking: bool
        message: text
        user: text
        prompt: text
        info: text
        error: none | wrong
    }
    text answer = ""
    event pk_send ->
    event pk_cancel ->

    event open_bt
    event go_home

    // ── holding AltGr peeks at the card: `emit peek 1` on press, `peek 0` on release ──
    //  (reserved for this: nothing else uses the key)
    event peek
    fact peek_held = false
    fact peeking = false      // the card is open because the key is held

    // ── volume and brightness: the pill becomes the gauge (pages/osd.plm) ──
    fact osd = false
    fact osd_kind: vol | bright | kbd = vol
    fact osd_seq = 0          // one more each change: the gauge stays while they keep coming
    fact osd_ready = false    // the logic says so once the services have spoken: no gauge at login
    fact bright = 0.5         // the screen, as the keys say it (the service only looks every 0.7 s)
    event vol_key             // the volume keys: `lumen --say island "emit vol_key 1"` (−1 down)
    event bright_up           // brightness.sh, with the new percent
    event bright_down
    fact kbd = 0              // the keyboard's backlight, as kbd-backlight.sh says it
    event kbd_up              // kbd-backlight.sh, with the new percent
    event kbd_down
    event kbd_step ->
    event osd_set ->
    event osd_mute ->
    event bright_step ->

    // ── state ────────────────────────────────────────────────────
    fact expanded = false
    fact hold_h: number = 0    // see `hit`: how far down the card still counts as under the pointer
    fact hold_w: number = 0    // …and how wide, when a press narrows it (the mail reader back to the inbox)
    //  Which face the open card shows: the home one, or a page that slides in over it.
    fact panel: home | ctl | timer | cam | awk | wifi | bt | clip | launch | notes | emoji | wall | cap | mix | auth | gtune | proj | fnds | stor | act = home
    //  The app on the stage (surface stage, under the bar): what you work in —WhatsApp, the mail,
    //  the files— in a card of its own. The pill's card (`panel`) opens over it like over a
    //  desktop, the app receding behind it, and the app has the keys back when the card closes.
    fact app: none | wa | mailx | fnd = none
    fact app_last: wa | mailx | fnd = wa      // …the one last up: its card keeps its size while it goes
    fact fnd_pvw = 660        // the files' preview, as wide as their room leaves it (for the logic's pictures)
    prop on_home = 1 ~280ms
    prop on_wifi = 0 ~280ms
    prop on_bt = 0 ~280ms
    follow on_home = if(panel == home, 1, 0)
    follow on_wifi = if(panel == wifi, 1, 0)
    follow on_bt = if(panel == bt, 1, 0)
    prop on_clip = 0 ~280ms
    follow on_clip = if(panel == clip or (side and side_k == 1), 1, 0)
    prop on_proj = 0 ~280ms
    follow on_proj = if(panel == proj, 1, 0)
    prop on_stor = 0 ~280ms
    follow on_stor = if(panel == stor, 1, 0)
    prop on_act = 0 ~280ms
    follow on_act = if(panel == act, 1, 0)
    prop on_launch = 0 ~280ms
    follow on_launch = if(panel == launch, 1, 0)
    prop on_notes = 0 ~280ms
    follow on_notes = if(panel == notes, 1, 0)
    prop on_mailx = 0 ~280ms
    follow on_mailx = if(app == mailx, 1, 0)
    prop on_wa = 0 ~280ms
    follow on_wa = if(app == wa, 1, 0)
    prop on_emoji = 0 ~280ms
    follow on_emoji = if(panel == emoji or (side and side_k == 2), 1, 0)
    prop on_wall = 0 ~280ms
    follow on_wall = if(panel == wall, 1, 0)
    prop on_cap = 0 ~280ms
    follow on_cap = if(panel == cap, 1, 0)
    prop on_mix = 0 ~280ms
    follow on_mix = if(panel == mix, 1, 0)
    prop on_gtune = 0 ~280ms
    follow on_gtune = if(panel == gtune, 1, 0)
    prop on_ctl = 0 ~300ms
    prop on_timer = 0 ~280ms
    prop on_cam = 0 ~280ms
    prop on_fnd = 0 ~280ms
    prop on_awk = 0 ~280ms
    follow on_awk = if(panel == awk, 1, 0)
    follow on_fnd = if(app == fnd or panel == fnds, 1, 0)
    follow on_cam = if(panel == cam, 1, 0)
    follow on_timer = if(panel == timer, 1, 0)
    //  Going idle, and back (see the idle pill, further down).
    prop ivv = 0 ~360ms
    follow ivv = if(idle_on and app == none and not expanded and not osd and not picked and not copied and not dev_on and not ban_here and not ld_on, 1, 0)
    prop ivb = 0 ~300ms
    follow ivb = if(idle_back, 1, 0)
    prop ivr = 1 ~900ms
    follow ivr = idle_left / 300
    prop dvv = 0 ~360ms
    follow dvv = if(dev_on and app == none and not expanded and not osd and not picked and not copied, 1, 0)
    //  [16][glyph 18][10][name][14][ring 22][6][84%][16]
    prop ldv = 0 ~360ms
    follow ldv = if(ld_on and app == none and not expanded and not osd and not picked and not copied and not dev_on and not ban_here, 1, 0)
    //  [16][icons, 15 apart, 20 wide][10][name][14][the time][16]
    let ld_iw = if(ld_n > 0, 20 + 15 * (ld_n - 1) + 10, 0)
    let ld_w = 16 + ld_iw + min(ldm.width, 200) + 14 + clockm.width + 16
    let dv_w = 16 + 18 + 10 + min(dvm.width, 180) + if(dv_bat >= 0, 14 + 22 + 6 + 32, 0) + 16
    follow on_ctl = if(panel == ctl, 1, 0)
    prop on_auth = 0 ~280ms
    follow on_auth = if(panel == auth, 1, 0)
    //  The colour picker's answer: the pill widens into a swatch and its code.
    prop pkv = 0 ~360ms
    follow pkv = if(picked and app == none and not expanded, 1, 0)
    prop cpv = 0 ~360ms
    follow cpv = if(copied and app == none and not expanded and not osd and not picked, 1, 0)
    //  [16][thumb 44 or icon 16][10][text, at most 230][12]["Copied"][16]
    let cp_lead = 16
    let cp_w = 16 + cp_lead + 10 + min(cpm.width, 230) + 12 + 46 + 16
    //  A picture's card: as wide as it (never narrower than its caption row), as tall as it plus the row.
    let cpi = cpv * if(cp_kind == 1, 1, 0)
    let cpb_w = max(250, cp_iw + 24)
    let cpb_h = 38 + cp_ih + 12
    let cp_tw = if(cp_kind == 1, cpb_w, cp_w)
    let cp_th = if(cp_kind == 1, cpb_h, 34)
    //  The banner: 0 the pill, 1 the pill grown into a notification.
    prop ban = 0 ~380ms
    follow ban = if(ban_here and app == none and not expanded and not osd and not picked and not copied and not dev_on, 1, 0)
    //  The level gauge: 0 the pill, 1 the pill grown into it.
    //  How far the pill has gone into its dark, smoked glass: the card and banners are.
    let dark = max(max(max(open, ban), cpi), aon)
    prop os = 0 ~360ms
    follow os = if(osd and app == none and not expanded, 1, 0)
    //  Over a fullscreen window the pill is under it: the gauge comes on its own
    //  (surface hud), dropping in from above and settling with a little give.
    fact fs = false           // the focused window is fullscreen (the logic says)
    fact fs_under = false     // …and a page over it hasn't changed that: taking the keyboard makes `fs` false
    //  Where the gauge and a banner show when the pill cannot (over a fullscreen window: top centre;
    //  the pill busy —its card open, an app up—: top right, under the date, as macOS's do).
    fact hud_at: top | top_right = top
    let pill_busy = expanded or app != none
    //  (The pill busy, the date capsule grows into them instead: see `ch`. These stay top centre.)
    spring hud_in = 300, 26
    prop fso = 0 ~hud_in
    follow fso = if(fs and osd, 1, 0)
    //  …and so does a notification's banner (surface note_hud), when the pill would show one.
    prop fsn = 0 ~hud_in
    prop rbv = 0 ~hud_in      // the recording bar (surface rec_bar)
    follow rbv = if(recording, 1, 0)
    follow fsn = if((fs or isl_tv) and banner and not osd and not picked and not copied and not dev_on, 1, 0)
    //  A page called up over a fullscreen window (Super+D, Super+C…): the island
    //  comes back for it, above fullscreen, and stays long enough to close properly.
    prop fsc = 0 ~500ms
    follow fsc = if(pill_busy or pw_open or pk.pending, 1, 0)
    prop lv = 0 ~240ms        // the level shown: it pours rather than jumps
    follow lv = clamp(if(osd_kind == vol, audio.volume, if(osd_kind == bright, bright, kbd)), 0, 1)
    prop trail = 0 ~700ms     // …and where it was, catching up slowly
    follow trail = clamp(if(osd_kind == vol, audio.volume, if(osd_kind == bright, bright, kbd)), 0, 1)
    prop mu = 0 ~260ms
    follow mu = if(osd_kind == vol and audio.muted, 1, 0)
    spring band = 420, 41     // critically damped: a kick out and straight back
    prop thump = 0 ~band
    prop swell = 0 ~band
    //  Flicking the banner up: it follows the finger (and goes on letting go past 28 px).
    prop bdrag = 0 ~180ms
    prop nswap = 1 ~260ms      // 0→1 each time a new one takes the banner
    let bpull = min(0, bdrag)
    //  Others behind it: thin layers of glass peeking out under it.
    prop stack = 0 ~300ms
    follow stack = if(ban_here and app == none and not expanded, min(n_more, 2), 0)
    prop dnd_s = 0 ~260ms
    follow dnd_s = if(dnd, 1, 0)
    let dnd_w = 20 * dnd_s
    prop pw_in = 0 ~260ms
    follow pw_in = if(pw_open, 1, 0)
    prop shake = 0 ~spring(520, 14)   // a wrong password: a short, settling shake
    prop turn = 0 ~300ms              // the spinners, a third of a turn a step

    measure clockm
    measure datem

    //  Muted: a speaker settles into the battery capsule and a slash cuts through it.
    prop mut = 0 ~460ms
    follow mut = if(audio.muted, 1, 0)
    let mute_w = 24 * mut
    //  The slash draws in the second half, opening its gap in the speaker as it goes.
    let slash = smooth(0.4, 1, mut)

    prop open  = 0 ~250ms     // 0 pill → 1 card
    prop live  = 0 ~420ms     // 0 clock only → 1 now-playing pill
    prop bloom = 0 ~420ms     // hover: the rim ignites
    prop media_in = 0 ~420ms  // the card's media row, there or not
    prop pw = 160 ~shape
    prop ph = 34  ~shape
    prop pr = 17  ~shape

    follow open  = if(expanded, 1, 0)
    follow live  = if(media.playing, 1, 0)
    follow bloom = hit.hover
    follow media_in = if(has_player, 1, 0)


    // A persistent numbered rail makes occupied desktops readable at a glance.
    // Reserve its full width even while layout springs settle.
    let pad = 16
    let rail_w = (14 + 8 * rh) * max(1, ws_count) + 24
    //  …and as it is drawn: a desktop coming or going slides what follows on the
    //  rail's own spring, not in one frame.
    prop rail_ws = 1 ~calm
    follow rail_ws = max(1, ws_count)
    //  The island holds only the time (and what is playing); the rest is the bar's.
    // ── what is playing: as the Dynamic Island shows it, compact ───
    //  The artwork leading, a live waveform trailing, the time between: no
    //  title, no progress (those are the card's, a hover away). Paused, the
    //  bars settle into dots and it stays two minutes, then leaves.
    prop mus_p = 0 ~460ms
    follow mus_p = if(media.playing and has_player, 1, 0)
    prop mus_keep = 0 ~460ms
    prop wb0 = 0
    prop wb1 = 0
    prop wb2 = 0
    prop wb3 = 0
    prop wb4 = 0
    //  Only while the bars are in sight: the pill's contents fade out under the card, an app, a banner,
    //  a gauge… and a fullscreen window covers the island altogether. A wave left running kept the
    //  whole island going round sixty times a second behind all of those, drawing nothing.
    let wseen = if(max(max(max(open, ban), max(aon, ivv)), max(max(os, dvv), max(pkv, cpv))) < 0.5 and ldv < 0.5 and (not fs or fsc > 0.002), 1, 0)
    wave wb0 = 3.6 * amp * wseen at 6.3
    wave wb1 = 4.4 * amp * wseen at 8.9
    wave wb2 = 3.8 * amp * wseen at 7.4
    wave wb3 = 4.6 * amp * wseen at 10.1
    wave wb4 = 3.4 * amp * wseen at 5.7
    //  A second rhythm under each bar, at unrelated speeds: uneven, like music.
    prop wc0 = 0
    prop wc1 = 0
    prop wc2 = 0
    prop wc3 = 0
    prop wc4 = 0
    wave wc0 = 2.2 * amp * wseen at 13.7
    wave wc1 = 1.8 * amp * wseen at 3.9
    wave wc2 = 2.6 * amp * wseen at 15.3
    wave wc3 = 1.6 * amp * wseen at 4.6
    wave wc4 = 2.4 * amp * wseen at 12.2
    on change media.playing while media.playing { mus_keep: 1 }
    on change media.playing while not media.playing { mus_keep: 0 after 120000ms }
    let mus = max(mus_p, mus_keep * if(has_player, 1, 0))
    prop amp = 0 ~520ms                       // the bars' life: dots while paused
    follow amp = if(media.playing, 1, 0)
    let mm = smooth(0, 1, mus)
    //  The bars take the artwork's colour, eased from one song's to the next.
    prop art_cr = 0.435 ~600ms
    prop art_cg = 0.827 ~600ms
    prop art_cb = 0.925 ~600ms
    follow art_cr = art_r
    follow art_cg = art_g
    follow art_cb = art_b
    prop tint_k = 0 ~500ms
    follow tint_k = if(art_tinted and has_art, 1, 0)
    let bar_c = mix(teal, mix(rgb(art_cr, art_cg, art_cb), pearl, 0.18), tint_k)
    //  A new song: the artwork gives a small pop, as the island acknowledges it.
    prop artpop = 0 ~spring(420, 24)
    on change media.length while media.playing { impulse artpop 7 }
    //  The artwork keeps its shape: as tall as it fits, as wide as it is (a
    //  square album cover, a 16:9 video's frame), only its corners rounded.
    prop art_k = 1 ~400ms
    follow art_k = if(has_art, clamp(art_aspect, 1, 1.78), 1)
    let art_w = 22 * art_k
    //  [7][art 22–39][10][time][10][bars 19][13] against [16][time][16] at rest.
    let mus_w = (49 + art_w - 22) * mm
    let rest_w = pad * 2 + clockm.width + mus_w
    let wx_h = 124            // the weather widget and the gap under it (the inbox left the card: Super+U has the mail)
    let card_h = 168 + wx_h + 140 * media_in
    //  The pages are as tall as their list (five rows show; more scroll).
    let wl_h = if(nets.count == 0, 48, min(wl.content, 218))
    let bl_h = if(devs.count == 0, 48, min(bl.content, 218))
    let eth_h = if(eth > 0, 82, 0)              // the cable's row and the Wi-Fi heading under it
    let wifi_h = 88 + eth_h + wl_h + 12 + 48 * pw_in
    let bt_h = 88 + bl_h + 12
    let clip_h = 88 + 366 + 16
    let ll_h = if(hits.count == 0, 52, hits.count * 54 - 2)
    let launch_h = if(launch_q_empty, 60, 68 + ll_h + 12)     // the search pill alone, until something is typed
    let pl_h = if(projs.count == 0, 46, projs.count * 48 - 2)
    let proj_h = 128 + 8 * 48 - 2 + 14       // eight rows, whatever is found: it does not jump while typing
    let stor_h = 186 + 7 * 48 - 2 + 36       // seven rows and the status line, on every tab: it does not jump
    let act_h = 226 + 7 * 48 - 2 + 36
    let nl_h = if(notes.count == 0, 48, notes.count * 62 - 2)
    let notes_h = 94 + nl_h + 12
    let wg_h = max(1, ceil(walls.count / 3)) * 78 - 8
    let wall_h = 88 + wg_h + 34
    let capt_h = 230
    let gtune_h = 88 + 17 * 32 + 3 * 18 + 6 + 34 + 16
    let mix_h = 88 + 36 + 14 + 46 * (mixapps.count + 1) + 16 + if(mix_more > 0, 14, 0)
    let auth_h = 262
    //  The mail reader: as tall as the mail, up to a point (then it scrolls), and the reply field under it.
    let mb_h = 840 - 182 - 14 - 54 * rep_in     // the reader (the large view): the card under its header, less the reply field
    prop wqp = 0 ~200ms         // the quote over the WhatsApp field coming in
    follow wqp = if(wa_quote, 1, 0)
    prop wap = 0 ~200ms         // …and files waiting to be sent, over it
    follow wap = if(wa_att, 1, 0)
    //  The WhatsApp chat's messages (pages/whatsapp.plm) run the whole height of the chat, under
    //  its floating header and field; what they show unhidden is from y 100 to just over the field.
    measure wa_in_m           // what the WhatsApp field takes up: it grows a line at a time, up to six
    prop wfx = 0 ~120ms         // …how much taller than one line it is, sprung: the capsule and all over it rise by that
    follow wfx = max(0, wa_in_m.height - 13.5 * 1.3)
    let wvh = 744 - 64 - 154 - 46 * wqp - 64 * wap - wfx   // from 134 to 662: clear of the fades at both ends of the chat
    measure wanm              // how wide the chat's name is: its glass pill fits it
    let wcw = 568               // the WhatsApp chat's column: its 600 less a margin each side
    prop wfb = 0 ~quick         // …scrolled up this far from its newest (0: at the bottom)
    prop wts = 0 ~260ms         // …its times out (t), as iMessage's swipe shows them
    follow wts = if(wa_times, 1, 0)
    let wmax = max(0, wml.height - wvh)   // …and as far as it goes
    let mzs = 1004 / 620      // how much larger the focused view draws a mail (the card's whole width)
    //  Reading (l) in the large view: the list slides away and the mail takes the whole card.
    prop mxf = 0 ~shape
    follow mxf = if(mx_focus and app == mailx and not mail_slim, 1, 0)   // folded, there is no room to widen into
    //  The inbox list folded away (s, or a tool beside the view): the card is the mail alone.
    prop mxs = 0 ~shape
    follow mxs = if(mail_slim, 1, 0)
    prop mxz = 1 ~shape
    follow mxz = if(app == mailx, mx_zoom, 1)
    //  The finer photograph of a focused mail coming in over the scaled one.
    prop zin = 0 ~220ms
    follow zin = if(mr_zoom_ok and mx_focus, 1, 0)
    //  How much larger the page is drawn: focused (wz), and with the zoom (wzz).
    let wz = 1 + (mzs - 1) * mxf
    let wzz = wz * mxz
    //  Only the part of the page in sight —and a tile's worth either side, so scrolling finds it
    //  there— is drawn: a tile out of sight drawn and clipped still holds its place in the atlas,
    //  and a long mail with GIFs came to more than the atlas holds (parts of it then went missing).
    prop msc = 0 ~1ms         // the reader's scroll (follows mrl.scroll, in pages/mail.plm)
    let mvt = msc / wzz - 300
    let mvb = (msc + mb_h) / wzz + 300
    prop rep_in = 0 ~shape
    follow rep_in = if(mr_rep, 1, 0)
    //  The card's second header row (the toggles and the tray) pushes every face down.
    let hdr2 = 0
    let ctl_h = 52 + 5 * 84 + 6
    let timer_h = if(tmr_on, 88 + 34 + 12 + 150 + 56, 88 + 34 + 14 + 132 + 22)
    let nb_text_h = max(66, 50 + n_bm.height + 14)
    let ban_h = nb_text_h + if(nacts.count > 0, 44, 0)
    let open_h = hdr2 + if(panel == wifi, wifi_h, if(panel == bt, bt_h, if(panel == clip, clip_h, if(panel == launch, launch_h, if(panel == fnds, 88 + 458 + 16, if(panel == proj, proj_h, if(panel == stor, stor_h, if(panel == act, act_h, if(panel == notes, notes_h, if(panel == emoji, 330, if(panel == wall, wall_h, if(panel == ctl, ctl_h, if(panel == timer, timer_h, if(panel == cam, 44 + 504 + 16, if(panel == awk, 116 + 132 + 26, if(panel == cap, capt_h, if(panel == mix, mix_h, if(panel == auth, auth_h, if(panel == gtune, gtune_h, card_h)))))))))))))))))))
    //  On its two Control Center pages the card is a little wider.
    //  WhatsApp with its list folded (s, or a tool beside it): the faces only, and the card that much narrower.
    //  …and folded (its list to faces; the mail's away) while the pill's card is open beside it.
    let wa_slim = app_last == wa and (wa_rail or (expanded and app == wa)) and not wa_search
    let mail_slim = app_last == mailx and (mx_rail or (expanded and app == mailx))
    //  With an app up, the card opens BESIDE it when the two fit: the pill glides right as it grows
    //  into the card, the app glides left on the same spring, and the pair sits centred, as an
    //  iPad's Split View (the clipboard as its list alone there). Too wide (the camera), over it.
    //  Where the pair (app and card) may go: from near the screen's left edge (the workspace rail
    //  rides into the app's corner) to just short of the date capsule on the right.
    //  A card grown from the date capsule (the calendar, a notification) is part of the row too:
    //  app, its card, then that one, side by side, never over each other.
    //  The capsule on the right grows into what the pill would say while the middle is taken (see `chk`):
    //  which, by the pill's own order of importance, and how big.
    let cap_want = if(osd, 1, if(picked, 6, if(copied, 3, if(dev_on, 4, if(ban_here, 2, if(ld_on, 7, if(idle_on, 5, 0)))))))
    let hud_w = if(chk == 1, 340, if(chk == 2, 384, if(chk == 3, cp_tw, if(chk == 4, dv_w, if(chk == 5, 290, if(chk == 6, 214, ld_w))))))
    let hud_h = if(chk == 2, ban_h, if(chk == 3, cp_th, 34))
    let cap_card_w = if(cal, 316, if(cap_want > 0 and not fs and (expanded or app != none), hud_w, 0))   // whatever the capsule grows into: the app makes room
    let pair_l = 16
    let pair_r = screen.width - 24 - max(190, cap_card_w + 14)
    //  …the room at rest (the date capsule, or the calendar opened from it): what decides whether a card
    //  fits beside the app. Something passing through the capsule (a copy, a notification, idle) may slide
    //  the row aside if there is room, but never puts the card over the app nor resizes the files.
    let pair_r0 = screen.width - 24 - max(190, if(cal, 316, 0) + 14)
    //  The files keep their whole layout while the card is out: only their preview narrows, by
    //  what the card needs (never below the list's own 300).
    let fnd_slim = app_last == fnd and expanded and app == fnd
    let fnd_bw = clamp(pair_r0 - pair_l - 14 - max(if(panel == clip, 404, if(panel == home or panel == ctl, 412, if(panel == cam, 928, 384))), rest_w), 760, 1120)
    let aw_t = if(app_last == fnd, if(fnd_slim, fnd_bw, 1120), if(app_last == wa, 940 - if(wa_slim, 240, 0), 1040 - if(mail_slim, 384, 0)))   // WhatsApp: a 340 list and a 600 chat
    let ah_t = if(app_last == mailx, 840, if(app_last == wa, 760, 88 + 458 + 16))
    //  The files beside an app: what room the row leaves them (their preview hidden below ~720).
    let fnds_room = pair_r0 - pair_l - 14 - aw_t
    let fnds_w = if(fnds_room >= 720, min(fnds_room, 1120), 452)     // the list and its preview, or the list alone (its 420 rows)
    let cw_c = if(panel == launch, 600, if(panel == home or panel == ctl, 412, if(panel == cam, 928, if(panel == clip or panel == proj, 780, if(panel == fnds, fnds_w, 384)))))
    let cw_b = if(panel == clip, 404, if(panel == proj, 412, cw_c))
    let beside_fits = app != none and aw_t + 14 + max(cw_b, rest_w) <= pair_r0 - pair_l
    let cw_t = if(beside_fits, cw_b, cw_c)
    let beside = beside_fits and expanded
    let proj_wide = not beside_fits           // the projects' preview: on their own only
    let pair_w = aw_t + 14 + max(cw_t, rest_w)
    prop cwp = 412 ~shape
    follow cwp = cw_t
    //  An app up: the pill IS the app, grown into it (as the large views were); the card buds off it.
    follow pw = if(app != none, aw_t, if(expanded, max(cw_t, rest_w), if(osd, 340, if(picked, 214, if(copied, cp_tw, if(dev_on, dv_w, if(ban_here, 384, if(ld_on, ld_w, if(idle_on, 290, rest_w)))))))))
    follow ph = if(app != none, ah_t, if(expanded, open_h, if(osd, 34, if(picked, 34, if(copied, cp_th, if(dev_on, 34, if(ban_here, ban_h, 34)))))))
    follow pr = if(app != none, 24, if(expanded, if(panel == launch, 30, 24), if(osd, 17, if(picked, 17, if(copied, if(cp_kind == 1, 22, 17), if(dev_on, 17, if(ban_here, 26, 17)))))))

    //  The views that fill the centre: beside them, a tool opens from the right capsule (the
    //  clipboard's list, twelve rows; the emoji, seven), and the card slides left just enough
    //  for the two to sit side by side.
    //  (Before the stage, the large views filled this card, and tools opened beside them from the
    //  right capsule: `big` is never so now. What hangs on it goes with step 3.)
    let big = false
    let side_w = if(side_k == 1, 404, if(side_k == 3, 760, 384))
    let side_h = if(side_k == 1, 88 + 12 * 46 - 2 + 16, if(side_k == 3, 88 + 458 + 16, 462))
    //  The calendar (the date hovered) makes room the same way: a card grown from the right capsule never covers the view.
    let side_room = if(side, side_w, 300)
    //  The app glides left as its card buds off to the right: the pair centred, or as far left as
    //  it takes to keep the card clear of the date capsule.
    let pair_x = max(pair_l, min(screen.width / 2 - pair_w / 2, pair_r - pair_w))
    //  …and no card grown from the date capsule (the calendar, a notification) ever covers it: it
    //  glides left just far enough, and back once the card is gone. (The gauge, a strip at the
    //  top, does not move it: its clock steps aside.)
    let clear_nudge = max(0, screen.width / 2 + aw_t / 2 - (screen.width - 24 - cap_card_w - 14))
    let nudge_t = if(beside, screen.width / 2 - (pair_x + aw_t / 2), if(app != none and cap_card_w > 0, clear_nudge, 0))
    prop nudge = 0 ~shape
    follow nudge = nudge_t
    let cx = screen.width / 2 - nudge
    let x0 = cx - pw / 2

    //  ── the card beside an app: it buds off the app's side ──
    //  One glass body with the app (they melt where they are closer than `lg_merge`): it starts
    //  inside the app's right edge, comes out of it as a swelling, pulls away on a neck of glass
    //  that thins and lets go, and settles beside it, level with its middle. Closing, the same
    //  backwards: it slides in, touches, melts and is gone into the app.
    let app_on = app != none
    prop bud = 0 ~shape
    follow bud = if(beside, 1, 0)
    let over = app_on and not beside_fits                  // too wide beside it: over it (the camera)
    let cdw = max(cwp, rest_w)
    let cdx = if(over, cx - cdw / 2, cx + pw / 2 - cdw + (cdw + 14) * bud)
    let ck_x = if(app_on, cdx, x0)                          // the card's shape: beside the app, or the pill itself
    let ck_y = if(app_on, if(over, 44, max(0, (ph - open_h) / 2)), cdy)
    //  The launcher's search pill sits a little lower than the bar, sinking there as it grows.
    prop cdy = 0 ~shape
    follow cdy = if(expanded and panel == launch and app == none, 18, 0)
    let ck_w = if(app_on, cdw, pw)
    let ck_h = if(app_on, open_h, ph)
    let ck_r = if(app_on, 24, pr)
    let ck_in = if(app_on and not over, bud, open)          // how far it has come
    let ex0 = if(app_on, cdx, cx - cdw / 2)     // the card's left edge once open
    let exr = ex0 + cdw                          // …and its right edge

    //  ── the app: the pill grown into it ──
    prop awp = 1040 ~shape
    follow awp = aw_t
    prop ahp = 760 ~shape
    follow ahp = ah_t
    let ax0 = cx - awp / 2                     // its left edge…
    let axr = ax0 + awp                        // …and right
    prop aon = 0 ~250ms                        // up, or going
    follow aon = if(app != none, 1, 0)
    let agp = clamp((ph - 34) / max(1, ah_t - 34), 0, 1)     // how far the pill has grown into it
    prop arec = 0 ~250ms                       // the pill's card open over it: it steps back, dimmed
    follow arec = if(app != none and expanded and not beside, 1, 0)
    //  (One rule a value: a rule reads the frame before, and `app_last = app` took the old app.)
    on change app while app == wa { app_last = wa }
    on change app while app == mailx { app_last = mailx }
    on change app while app == fnd { app_last = fnd }

    //  Telemetry colours, as indices: a colour choice has to sit in a `color:`.
    let cpu_i = floor(clamp(cpu / 20, 0, 4))
    let mem_i = floor(clamp(mem_frac * 5, 0, 4))
    let bat_i = if(battery.charging, 3, if(battery.percent <= 15, 2, if(battery.percent <= 30, 1, 0)))      // ink · amber · coral · charge

    prop bat_s = 1 ~420ms
    follow bat_s = battery.percent / 100

    // ── the glass ────────────────────────────────────────────────
    //  Changing workspace, niri slides the windows up or down under the bar,
    //  and the pills answer as iOS's tab bar does when content scrolls beneath
    //  it: they draw in to a compact size and their glass thickens (more frost,
    //  a little smoke) so what is on them stays readable over whatever passes.
    //  Once the windows have landed they swell back out, the centre first and
    //  the sides a beat later, with a soft liquid give. A run of switches keeps
    //  them compact until the last one has landed.
    prop ws_was = 1 ~280ms
    follow ws_was = ws_active
    fact ws_dir = 1           // +1 to a later workspace (the windows go up), −1 back: the rail's number rolls in from there
    prop k_mid = 0 ~150ms
    prop k_rail = 0 ~150ms
    //  The side pills each have a temper of their own around the centre's:
    //    the rail      light and quick: it is what you navigate with, so it
    //                  draws in furthest and comes back with the most spring;
    //    the capsule   its glass stays still: what moves is the battery's charge,
    //                  a liquid. The windows' rush jolts it: its surface tilts
    //                  and bulges, rocks a few times and settles (two modes
    //                  of a slosh, lightly damped, at different pitches).
    //                  The glass is gripped too, its own way: pinned to the
    //                  corner it hangs from, squeezed more in height than in
    //                  width, a beat after the others, letting go softly.
    prop k_cap = 0 ~150ms
    prop slosh = 0 ~spring(180, 4.5)
    prop slosh2 = 0 ~spring(420, 7)
    on change ws_active while ws_vertical and ws_active > ws_was { ws_dir = 1; k_rail: 1 ~110ms; k_mid: 1 ~150ms; impulse slosh 16; impulse slosh2 -18; k_cap: 1 ~180ms after 40ms }
    on change ws_active while ws_vertical and ws_active < ws_was { ws_dir = -1; k_rail: 1 ~110ms; k_mid: 1 ~150ms; impulse slosh -16; impulse slosh2 18; k_cap: 1 ~180ms after 40ms }
    on still ws_active for 260ms while ws_vertical { k_rail: 0 ~spring(340, 27); k_mid: 0 ~spring(260, 27); k_cap: 0 ~spring(200, 21) after 40ms }
    //  The centre pill opens into where you landed as it swells back: one gesture.
    on still ws_active for 260ms while ws_vertical and not expanded { ld_on = true }
    on still ws_active for 1260ms while ld_on { ld_on = false }      // about a second on screen
    let sb = max(34, ph + bpull)
    //  The pill itself: under everything else, so the card's controls stay on top.
    //  Its shape is the TARGET one, not the animating one: the instant the
    //  pointer arrives the whole card is "inside", so a quick move down into it
    //  can't outrun the spring, leave, and snap it shut.
    let tw = if(app != none, aw_t, if(expanded, max(max(cw_t, rest_w), hold_w), if(osd, 340, if(picked, 214, if(copied, cp_tw, if(dev_on, dv_w, if(ban_here, 384, if(ld_on, ld_w, if(idle_on, 290, rest_w)))))))))
    //  A page shorter than the one clicked from would leave the pointer below
    //  the card, which would close it: the zone reaches down to the pointer
    //  until it is back inside.
    let th = if(app != none, ah_t, if(expanded, max(open_h, hold_h), if(osd, 34, if(picked, 34, if(copied, cp_th, if(dev_on, 34, if(ban_here, ban_h, 34)))))))
    zone box hit { from: cx - tw / 2, cdy; size: tw, th; corner: pr continuous; cursor: pointer; label: "Island" }
    prop rec_pulse = 0 ~600ms
    every 1.2s while recording { rec_pulse: 0 ~1ms; rec_pulse: 1 after 20ms; rec_pulse: 0 after 640ms }
    //  Workspace compression belongs to the resting pill: never a notification or an
    //  app grown out of it (WhatsApp, the mail, the files), including their exits.
    let km = if(ban_here or ban > 0.001 or app != none or aon > 0.001, 0, k_mid * (1 - open))
    group {
        pivot: cx, 17
        scale: 1 - 0.12 * km
    //  The notifications behind the banner: up to two cards stacked under it,
    //  each narrower and dimmer, peeking out 8 px below the one in front.
    //  Only what shows below the banner is drawn: the banner is see-through.
    group {
        clip box { from: x0 - 4, sb - 2; size: pw + 8, 30 }
        body {
            gradient: x0, sb - 30 to x0, sb + 16, stack1_t, stack1_b
            opacity: 72% * clamp(stack - 1, 0, 1)
            shadow: 0, 3, 8, 18% * clamp(stack - 1, 0, 1)
            box { from: x0 + 34, sb - 30; size: pw - 68, 46 * clamp(stack - 1, 0, 1); corner: 18 continuous }
        }
        body {
            gradient: x0, sb - 30 to x0, sb + 8, stack2_t, stack2_b
            opacity: 85% * clamp(stack, 0, 1)
            shadow: 0, 3, 8, 22% * clamp(stack, 0, 1)
            box { from: x0 + 16, sb - 30; size: pw - 32, 38 * clamp(stack, 0, 1); corner: 20 continuous }
        }
        box { from: x0 + 16.5, sb - 29.5; size: pw - 33, 37 * clamp(stack, 0, 1); corner: 19.5 continuous; stroke: 0.7; color: rim_grey; opacity: 30% * clamp(stack, 0, 1) }
    }

    //  Clear pearl at rest; a restrained neutral tint behind cards and banners.
    //  Blur and the lit edge supply depth without a dense black veil.
    body {
        gradient: x0, 0 to x0 + pw, ph, mix(mix(pearl, lilac, 0.3), dusk, dark), mix(mix(pearl, sunset, 0.3), deep, dark)
        glass: 100%               // always: its lit, 3D edge is the glass's
        blur: lg_frost + (lg_card_frost - lg_frost) * dark; refraction: lg_refraction + (lg_card_refraction - lg_refraction) * dark; bevel: lg_bevel + (lg_card_bevel - lg_bevel) * dark; dispersion: lg_dispersion; specular: lg_specular; magnify: lg_magnify * (1 - dark); glass_tint: lg_glass_tint; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_c
        opacity: lg_tint + (card_alpha - lg_tint) * dark
        ripple: 0%            // no ring of light on click
        milk: (glass_milk + 1% * bloom) * (1 - dark) + lg_card_milk * dark + 2% * max(0, km)
        smoke: card_smoke * dark + 5% * max(0, km)
        rim: 0%
        light: 1%, 0, 12
        shadow: 0, 8 * dark, 22 * dark, 16% * dark
        box { from: x0, cdy; size: pw, max(34, ph + bpull); corner: pr continuous }
        //  The card beside an app: the same glass, melting into the app's where they are close.
        box { from: ck_x, ck_y; size: if(app_on and (bud > 0.002 or (over and open > 0.002)), ck_w, 0), ck_h; corner: ck_r continuous }
    }

    //  A faint colour accent; niri supplies the refracted, specular edge.
    body {
        gradient: x0, 0 to x0 + pw, 0, cool, ink 50%, warm
        opacity: (lg_prism + 3% * bloom) * (1 - open)    // as the capsules' rim
        box { from: x0 + 0.5, 0.5 + cdy; size: pw - 1, max(33, ph - 1 + bpull); corner: pr - 0.5 continuous; stroke: 1 }
    }

    //  Expanded: a plain grey rim instead of the prism.
    body {
        color: rim_grey
        opacity: lg_card_rim * open
        box { from: x0 + 0.5, 0.5 + cdy; size: pw - 1, max(33, ph - 1 + bpull); corner: pr - 0.5 continuous; stroke: 1 }
    }



    // ── how far into the song ────────────────────────────────────
    //  The player only says where it is on a new song, a pause or a seek;
    //  between, it is carried on here, four steps a second and only while
    //  playing (no `time`: a still island must be able to sleep). The spring
    //  turns the steps into a glide, rewinds it on a new song, and slides
    //  it on a seek.
    fact pos: number = 0
    on change media.position { pos = media.position }
    on change media.length { pos = media.position }
    every 250ms while media.playing { pos = min(pos + 0.25 * media.rate, media.length) }
    prop prog = 0 ~420ms
    follow prog = clamp(pos / max(media.length, 1), 0, 1)
    //  The card's scrubber: where it shows (the pointer's while dragged), the
    //  times under it, and how far it is pulled past an end.
    fact scrubbing = false
    fact scrub_f: number = 0
    fact scrub_over: number = 0
    fact cur: number = 0
    fact rem: number = 0
    on change pos while not scrubbing { cur = pos; rem = max(0, media.length - pos) }
    on change scrub_f while scrubbing { cur = scrub_f * media.length; rem = max(0, media.length - scrub_f * media.length) }
    on change media.length { cur = pos; rem = max(0, media.length - pos) }
    prop cprog = 0 ~120ms
    follow cprog = if(scrubbing, scrub_f, prog)
    prop scrub_s = 0 ~200ms
    follow scrub_s = if(scrubbing, 1, 0)
    //  Past an end: a little give, at most 7 px, and back when let go.
    prop stretch_l = 0 ~spring(420, 30)
    prop stretch_r = 0 ~spring(420, 30)
    follow stretch_l = if(scrubbing, min(7, max(0, -scrub_over) * 60), 0)
    follow stretch_r = if(scrubbing, min(7, max(0, scrub_over - 1) * 60), 0)

    // ── the pill's contents (rest + live) ────────────────────────
    let clock_live = x0 + pad + (23 + art_w - 22) * mm + clockm.width / 2
    let wbx = x0 + pw - 13 - 19.2             // the waveform's left edge

    group {
        opacity: 1 - smooth(0, 0.45, max(max(max(open, ban), max(aon, ivv)), max(max(os, dvv), max(pkv, cpv))))

        //  Landed on another desktop, the time stays: it slides to the right end
        //  to make room for where you are.
        text clock.time {
            at: mix(clock_live, x0 + pw - 16 - clockm.width / 2, ldv), 17; anchor: center
            size: 13; weight: 600; family: "SF Pro Display"; color: ink; shadow: 0, 1, 3, 35% * (1 - gl_cs)
            measure: clockm
        }

        group {
            opacity: 1 - smooth(0, 0.45, ldv)
            clip box { from: x0, 0; size: pw, 34; corner: pr continuous }
            //  The artwork, its own shape with rounded corners, growing out of a
            //  blur as the pill makes room. Without art, a note on teal.
            group {
                opacity: smooth(0.15, 0.6, mus)
                pivot: x0 + 7 + art_w / 2, 17
                scale: 0.6 + 0.4 * smooth(0.1, 0.8, mus) + 0.22 * artpop
                blur: 4 * (1 - smooth(0.1, 0.7, mus))
                box { from: x0 + 7, 6; size: 22, 22; corner: 7 continuous; color: teal; opacity: if(has_art, 0, 30%) }
                image ic_note { at: x0 + 11, 10; size: 14, 14; tint: ink; opacity: if(has_art, 0, 90%) }
                group {
                    clip box { from: x0 + 7, 6; size: art_w, 22; corner: 7 continuous }
                    image cover { at: x0 + 7 + art_w / 2 - 20, 6; size: 40, 22; show: has_art }
                }
                box { from: x0 + 7, 6; size: art_w, 22; corner: 7 continuous; stroke: 0.6; color: ink; opacity: 14%; show: has_art }
            }
            //  The waveform: five rounded bars, alive while it plays; dots when paused.
            group {
                opacity: smooth(0.3, 0.8, mus)
                box { at: wbx + 1.2, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb0 + wc0) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 5.4, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb1 + wc1) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 9.6, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb2 + wc2) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 13.8, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb3 + wc3) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
                box { at: wbx + 18, 17; size: 2.4, 2.4 + amp * max(0, 5.5 + wb4 + wc4) * smooth(0.2, 1, mus); corner: 1.2 continuous; color: bar_c }
            }
        }
    }

    // ── beside the pill: recording, and what is listening or watching ──
    //  A recording: a small coral capsule with its time (a click stops it).
    //  A timer or stopwatch: a small bubble of the bar's glass right of the
    //  island (as iOS shows a second activity), the time counting in it. A
    //  click opens its page.
    prop tbv = 0 ~320ms
    follow tbv = if(tmr_on, 1, 0)
    let tb_x = cx + pw / 2 + 8
    let tb_w = (tbm.width + 40) * tbv
    group {
        opacity: smooth(0.3, 1, tbv)
        body {
            gradient: tb_x, 3 to tb_x + tb_w, 31, mix(pearl, lilac, 0.3), mix(pearl, sunset, 0.3)
            glass: 100%; ripple: 0%; rim: 0%; milk: glass_milk + 1% * tb_z.hover
            blur: lg_frost; refraction: lg_refraction; bevel: lg_bevel; dispersion: lg_dispersion; specular: lg_specular; magnify: lg_magnify; glass_tint: lg_glass_tint; rim_tint: lg_rim_tint; merge: lg_merge
            opacity: lg_tint; light: 1%, 3, 10; shadow: 0, 1.5, 6, 18%
            box { from: tb_x, 3; size: max(0.1, tb_w), 28; corner: 14 continuous }
        }
        box { from: tb_x + 0.5, 3.5; size: max(0.1, tb_w - 1), 27; corner: 13.5 continuous; stroke: 1; color: ink; opacity: lg_card_rim }
        group {
            clip box { from: tb_x, 3; size: max(0, tb_w), 28; corner: 14 continuous }
            image ic_timer { at: tb_x + 11, 10; size: 14, 14; tint: warm; show: tmr_mode == timer }
            image ic_watch { at: tb_x + 11, 10; size: 14, 14; tint: warm; show: tmr_mode == watch }
            text tmr_text {
                at: tb_x + 30, 17; anchor: left center; size: 12.5; weight: 700; family: "SF Pro Display"
                color: ink; opacity: if(tmr_paused, 55%, 100%); shadow: 0, 1, 3, 35% * (1 - gl_cs); measure: tbm
            }
        }
    }
    zone box tb_z { from: tb_x, 3; size: max(0, tb_w), 28; corner: 14 continuous; cursor: pointer; label: "Timer"; active: tmr_on }
    on press tb_z { expanded = true; panel = timer }
    let pv_x = cx + pw / 2 + 8 + tb_w + 6 * tbv
    prop recv = 0 ~300ms
    follow recv = if(recording, 1, 0)
    measure recm
    let rec_w = (recm.width + 30) * recv
    group {
        opacity: smooth(0.3, 1, recv)
        clip box { from: pv_x, 0; size: max(0, rec_w), 34 }
        body {
            gradient: pv_x, 6 to pv_x + rec_w, 28, coral, #e85d72
            glass: 25%; blur: 0%; light: 6%, 6, 11; shadow: 0, 1.2, 4, 22%
            box { from: pv_x, 6; size: max(0.1, rec_w), 22; corner: 11 continuous }
        }
        ellipse { at: pv_x + 12, 17; radius: 3.4; color: #ffffff; opacity: 75% + 25% * rec_pulse }
        text rec_time { at: pv_x + 20, 17; anchor: left center; size: 11.5; weight: 700; family: "SF Pro Display"; color: #ffffff; measure: recm }
    }
    zone box rec_z { from: pv_x, 6; size: max(0, rec_w), 22; corner: 11 continuous; cursor: pointer; label: "Stop recording"; active: recording }
    on press rec_z { emit rec_stop }
    prop micv = 0 ~280ms
    prop camv = 0 ~280ms
    prop scrv = 0 ~280ms
    follow micv = if(mic_on, 1, 0)
    follow camv = if(cam_on, 1, 0)
    follow scrv = if(scr_on, 1, 0)

    // ── a copy, in the pill: a small picture or a symbol, the first line, "Copied" ──
    //  An image shows as a tiny squircle of itself; text read off the screen
    //  says "Scanned", and OCR that found nothing says so instead.
    text cp_text { at: 0, -40; size: 12.5; weight: 600; family: "SF Pro Display"; opacity: 0; measure: cpm }
    include "pages/states.plm"
    group {
        opacity: smooth(0.45, 1, cpv)
        move: 0, 2 * (1 - cpv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group { move: x0, 0; CopyState(pw, gl_cs) }
    }
    on change cp_seq { copied = true }
    on still cp_seq for 2400ms while copied and cp_kind != 1 and cp_kind != 4 and cp_kind != 5 { copied = false }
    on still cp_seq for 4000ms while copied and cp_kind == 4 { copied = false }
    on still cp_seq for 6000ms while copied and cp_kind == 5 { copied = false }
    on still cp_seq for 3200ms while copied and cp_kind == 1 { copied = false }

    // ── a device connected, in the pill: its symbol, its name, its battery ──
    //  The ring fills once the pill has opened, green, or coral when low.
    text dv_name { at: 0, -40; size: 12.5; weight: 600; family: "SF Pro Display"; opacity: 0; measure: dvm }
    prop dvr = 0 ~700ms
    prop dvo = 0              // …once it has come in (a moment after it is told), wherever it shows
    on change dv_seq { dvo: 0 ~1ms; dvo: 1 ~1ms after 350ms }
    follow dvr = if(dev_on and dvo > 0.5, max(dv_bat, 0), 0)
    group {
        opacity: smooth(0.45, 1, dvv)
        move: 0, 2 * (1 - dvv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group { move: x0, 0; DeviceState(pw, gl_cs) }
    }
    // ── idle: a moon and how long until the lock (its ring draining); back, a tick and how long
    //  you were away, for a moment. The least of the pill's states: anything else comes first.
    group {
        opacity: smooth(0.45, 1, ivv)
        move: 0, 2 * (1 - ivv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group { move: x0, 0; IdleState(pw, gl_cs) }
    }
    on idle_warn { idle_on = true; idle_back = false; idle_left = 300 }
    every 1s while idle_on and not idle_back { idle_left = max(0, idle_left - 1) }
    //  Locked (the countdown out): nothing to say; back before it, welcome back, then gone.
    on change idle_left while idle_left <= 0 { idle_on = false }
    on idle_resume while idle_on { idle_back = true }
    on still idle_back for 2600ms while idle_back { idle_on = false; idle_back = false }

    on change dv_seq { dev_on = true }
    on still dv_seq for 3600ms while dev_on { dev_on = false }

    // ── landed on another desktop: the pill says where, as the Dynamic Island
    //  says what is going on. It widens from the clock into the desktop's apps
    //  (their icons popping in one after another, the most recent in front)
    //  and its name, the time still at its end; then it settles back.
    text ld_name { at: 0, -40; size: 13; weight: 600; family: "SF Pro Display"; opacity: 0; measure: ldm }
    group {
        opacity: smooth(0.45, 1, ldv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group { move: x0, 0; LandState(pw, ldv, gl_cs) }
    }

    // ── the colour picker's answer, in the pill: a swatch, its code, "Copied" ──
    group {
        opacity: smooth(0.45, 1, pkv)
        move: 0, 2 * (1 - pkv)
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group { move: x0, 0; PickState(pw, gl_cs) }
    }
    }

    //  An app's tray icon: a small dark disc in a stack, which fans out into a
    //  row while the stack is under the pointer (or its menu is open).
    component TrayIcon(t: record) {
        size: 26, 26
        group {
            move: t.index * (14 + 16 * tfan), 0
            body {
                color: mix(well_t, chip_hi, z.hover * tfan); shadow: 0, 1, 4, 30% * (1 - tfan)
                ellipse { at: 13, 13; radius: 12 }
            }
            ellipse { at: 13, 13; radius: 12; stroke: 1; color: ink; opacity: 14% + 10% * z.hover }
            image t.icon { at: 5, 5; size: 16, 16 }
            zone ellipse z { at: 13, 13; radius: 13; cursor: pointer; label: "{t.title}" }
        }
        //  A double click is one: most apps show or hide their window on each
        //  activation, so a second within 450 ms would close what the first opened.
        on press z while not tray_cool { emit tray_activate(t.index); tray_cool = true }
        on press right z { emit tray_menu(t.index) }
    }

    // ── the bar's right side: battery and date, in a capsule of frosted glass ──
    //  The same glass as the workspace capsule on the left, so the bar is held
    //  between two of them: a battery drawn as iOS draws it, a hairline, the date.
    let cap_r = screen.width - 24
    let cap_h = 28
    let cap_y = 17 - cap_h / 2
    //  Charging: 0 on battery → 1 plugged in. The plug and the room it takes ride this.
    prop chg = 0 ~460ms
    follow chg = if(battery.charging, 1, 0)
    //  The plug slides down into place (and is wiped back up when unplugged).
    let strike = smooth(0.25, 0.85, chg)
    let bat_gw = 29 + 13 * chg  // the battery glyph and its nub, and the plug while charging
    //  The fill's colour on battery alone, then eased into green while charging.
    let bat_nc = if(battery.percent <= 15, 2, if(battery.percent <= 30, 1, 0))
    prop bat_was = 0 ~400ms
    follow bat_was = battery.percent
    prop bat_in = 1 ~spring(300, 30)
    //  Not on the first value it reports as the island starts: only real changes roll.
    prop booted = 0 ~1500ms
    follow booted = 1
    fact bat_dir = 1          // +1 filling (the new digit comes up from below), −1 draining
    on change battery.percent while booted > 0.99 and battery.percent > bat_was { bat_dir = 1; bat_in: 0 ~1ms; bat_in: 1 after 16ms }
    on change battery.percent while booted > 0.99 and battery.percent < bat_was { bat_dir = -1; bat_in: 0 ~1ms; bat_in: 1 after 16ms }
    //  Which digits changed: the last; the tens too when it crosses one; all at 100.
    let bat_from = if(battery.percent >= 99, 0, if(mod(battery.percent, 10) == if(bat_dir > 0, 0, 9), 0, 1) - if(battery.percent < 10, 1, 0))


    include "pages/notice.plm"
    include "pages/osd.plm"

    //  A dial to drag, as iOS's Control Center timer: a pressed-in track that
    //  fills with soft glass behind a white knob as it is dragged, the time
    //  above it, and the main ones marked under it. It snaps to sensible steps
    //  (fine at first, coarser further on), the knob ticking at each; letting
    //  go starts it. h l (← →) step it, Enter starts. mode 0: a timer (1 min to
    //  3 h); mode 1: Keep Awake (5 min to 8 h, then until turned off).
    component Dial(mode: number) {
        size: 352, 132
        prop dk = 0.2 ~70ms
        follow dk = dial_f
        spring dtick = 420, 41
        prop dpop = 0 ~dtick
        on change dial_idx { impulse dpop 6 }
        let kx = 22 + 308 * dk
        text dial_label { at: 176, 18; anchor: center; size: 34; weight: 600; family: "SF Pro Display"; color: ink }
        text dial_sub { at: 176, 46; anchor: center; size: 11.5; weight: 500; family: "SF Pro Display"; color: tint_ink }
        //  The track, pressed in; the part behind the knob filled with soft glass.
        box { from: 0, 64; size: 352, 44; corner: 22 continuous; color: well; opacity: 30% }
        body { color: well; opacity: 30%; box { from: 14, 64; size: 324, 2; corner: 1 continuous } }
        body {
            gradient: 0, 64 to 352, 108, soft_l, soft_s
            glass: 25%; blur: 0%; light: 6%, 64, 22; opacity: 85%
            box { from: 3, 67; size: max(38, kx + 19 - 3), 38; corner: 19 continuous }
        }
        //  The knob: white glass, swelling a touch under the finger and at each step.
        body {
            color: ink; glass: 25%; blur: 0%; light: 6%, 70, 16; shadow: 0, 1.5, 5, 30%
            ellipse { at: kx, 86; radius: 16 + 1.5 * dz.pressed + 0.25 * dpop }
        }
        //  The marks, under the track.
        group {
            opacity: if(mode == 0, 1, 0)
            text "1m" { at: 22, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "5m" { at: 22 + 308 * 4 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "15m" { at: 22 + 308 * 8 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "30m" { at: 22 + 308 * 11 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "1h" { at: 22 + 308 * 14 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "2h" { at: 22 + 308 * 17 / 19, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "3h" { at: 330, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
        }
        group {
            opacity: if(mode == 1, 1, 0)
            text "5m" { at: 22, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "30m" { at: 22 + 308 * 4 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "1h" { at: 22 + 308 * 6 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "2h" { at: 22 + 308 * 8 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "4h" { at: 22 + 308 * 10 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "8h" { at: 22 + 308 * 12 / 13, 124; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 45% }
            text "∞" { at: 330, 124; anchor: center; size: 11; weight: 700; family: "SF Pro Display"; color: ink; opacity: 55% }
        }
        zone box dz { from: -6, 56; size: 364, 60; corner: 30 continuous; cursor: pointer; label: "Drag to set how long" }
        on press dz { dial_f = clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1); emit dial_move(clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1)) }
        on drag dz { dial_f = clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1); emit dial_move(clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1)) }
        on release dz { emit dial_go(clamp((pointer.x - ex0 - 16 - 22) / 308, 0, 1)) }
    }

    //  The tiles of the home face: the round button switches the radio, the
    //  rest opens its page.
    //  One hour of the forecast: when, its symbol, how warm.
    component WxHour(h: record) {
        size: 57, 40
        text h.t { at: 28.5, 5; anchor: center; size: 10; weight: 600; family: "SF Pro Display"; color: tint_ink }
        group {
            move: 20.5, 12
            image wx_sun { at: 0, 0; size: 16, 16; show: h.ic == 0 }
            image wx_moon { at: 0, 0; size: 16, 16; show: h.ic == 1 }
            image wx_csun { at: 0, 0; size: 16, 16; show: h.ic == 2 }
            image wx_cmoon { at: 0, 0; size: 16, 16; show: h.ic == 3 }
            image wx_cloud { at: 0, 0; size: 16, 16; show: h.ic == 4 }
            image wx_rain { at: 0, 0; size: 16, 16; show: h.ic == 5 }
            image wx_snow { at: 0, 0; size: 16, 16; show: h.ic == 6 }
            image wx_storm { at: 0, 0; size: 16, 16; show: h.ic == 7 }
            image wx_fog { at: 0, 0; size: 16, 16; show: h.ic == 8 }
        }
        text h.temp { at: 28.5, 36; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink }
    }

    //  A reading, as the stats are drawn: a ring filled to its share, the value inside, its name below.
    //  Heat 1 turns it amber, 2 coral. With no share at all (a sleeping GPU) the ring stays empty, the value dim.
    component StatRing(share: number, value: text, name: text, heat: number) {
        size: 44, 48
        prop f = 0 ~420ms
        follow f = share
        ellipse { at: 14, 18; radius: 14; stroke: 2.6; color: ink; opacity: 9% }
        arc { at: 14, 18; radius: 14; span: clamp(f, 0.012, 1) * 360deg; rotate: clamp(f, 0.012, 1) * 180deg; width: 2.6; color: if(heat >= 2, coral, if(heat >= 1, amber, soft_l)); opacity: 95% * smooth(0, 0.012, f) }
        text value { at: 14, 18; anchor: center; size: 9.5; weight: 600; family: "SF Pro Display"; color: if(heat >= 2, coral, if(heat >= 1, amber, ink)); opacity: if(share > 0, 100%, 45%) }
        text name { at: 14, 42; anchor: center; width: 36; lines: 1; align: center; size: 7; weight: 600; family: "SF Pro Display"; color: ink; opacity: 42% }
    }

    //  A headline (in the calendar, so narrow): two lines of it, where it is from and how long ago; lit under the pointer.
    component NewsRow(n: record) {
        size: 284, 50
        zone box z { from: 0, 0; size: 284, 50; corner: 10 continuous; cursor: pointer; label: "{n.title}" }
        box { from: 0, 0; size: 284, 50; corner: 10 continuous; color: ink; opacity: 6% * z.hover + 4% * z.pressed }
        text n.title { at: 10, 5; anchor: left top; width: 264; lines: 2; line_height: 1.18; size: 12; weight: 600; family: "SF Pro Display"; color: ink }
        text n.meta { at: 10, 41; anchor: left center; width: 264; lines: 1; size: 9.5; weight: 600; family: "SF Pro Display"; color: tint_ink; opacity: 85% }
        on press z { emit news_open(n.index) }
    }

    //  A mail in the inbox: who, when, what about; unread ones bolder, with a bead of the island's light.
    //  Under the pointer, an archive button takes the place of the time.
    component MailRow(m: record) {
        size: 364, 42
        //  Let go (archived, binned): it slides away and fades, and the rows below close up after it.
        prop lv = 0 ~200ms
        follow lv = if(mx_leaving == m.index, 1, 0)
        group {
        opacity: 1 - lv
        move: -36 * lv, 0
        zone box z { from: 0, 0; size: 364, 42; corner: 12 continuous; cursor: pointer; label: "{m.from}: {m.subj}" }
        box { from: 0, 0; size: 364, 42; corner: 12 continuous; color: ink; opacity: 6% * max(z.hover, arc.hover) + 4% * z.pressed }
        body {
            gradient: 7, 17 to 15, 25, soft_l, soft_s; light: 7%, 17, 4
            opacity: if(m.unread, 100%, 0)
            ellipse { at: 11, 21; radius: 3.6 }
        }
        text m.from { at: 23, 13.5; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 700; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 100%, 0) }
        text m.from { at: 23, 13.5; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 0, 88%) }
        text m.subj { at: 23, 29.5; anchor: left center; width: 300; lines: 1; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 80%, 55%) }
        text m.ago { at: 354, 13.5; anchor: right center; size: 10; weight: 600; family: "SF Pro Display"; color: if(m.unread, tint_ink, ink); opacity: (if(m.unread, 95%, 45%)) * (1 - max(z.hover, arc.hover)) }
        group {
            opacity: max(z.hover, arc.hover)
            body {
                color: mix(chip, chip_hi, arc.hover); material: control
                ellipse { at: 343, 21; radius: 12 - 0.4 * arc.pressed }
            }
            image ic_archive_s { at: 337, 15; size: 12, 12; tint: ink; opacity: 85% }
        }
        zone ellipse arc { at: 343, 21; radius: 13; cursor: pointer; label: "Archive" }
        //  A short mail makes the card shorter than where the row was: it stays open until the pointer is back over it.
        }
        on press z { emit mail_open(m.index) }     // a mail: the large view, open on it
        on press arc { emit mail_arch(m.index) }
    }

    //  A row of the large view's list: who, when, what about; the chosen one a pane of the island's light.
    component MailRowX(m: record) {
        size: 364, 52
        prop lv = 0 ~200ms
        follow lv = if(mx_leaving == m.index, 1, 0)
        group {
        opacity: 1 - lv
        move: -36 * lv, 0
        zone box z { from: 0, 0; size: 364, 52; corner: 26 continuous; cursor: pointer; label: "{m.from}: {m.subj}" }
        body {
            color: ink; opacity: 6%; show: z.hover > 0.5 and mx_sel != m.index
            box { from: 0, 0; size: 364, 52; corner: 26 continuous }
        }
        //  (The chosen mail is the list's gliding glass: pages/glide.plm.)
        body {
            gradient: 7, 13 to 15, 21, soft_l, soft_s; light: 7%, 13, 4
            opacity: if(m.unread, 100%, 0)
            ellipse { at: 11, 17; radius: 3.6 }
        }
        text m.from { at: 23, 17; anchor: left center; width: 260; lines: 1; size: 13; weight: 700; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 100%, 0) }
        text m.from { at: 23, 17; anchor: left center; width: 260; lines: 1; size: 13; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 0, 90%) }
        text m.ago { at: 340, 17; anchor: right center; size: 10.5; weight: 600; family: "SF Pro Display"; color: if(m.unread, tint_ink, ink); opacity: if(m.unread, 95%, 45%) }
        text m.subj { at: 23, 35.5; anchor: left center; width: 316; lines: 1; size: 11.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(m.unread, 82%, 58%) }
        }
        on press z { emit mailx_pick(m.index) }
    }

    //  A chat in the WhatsApp list, as iOS's Messages lists them: its face, who, when, and what
    //  was said last over two lines; a bead of the island's light before it while it is unread,
    //  and the count under the time. Pinned and muted ones say so with a small symbol.
    component WaChat(c: record) {
        size: 320 - 240 * wcol, 66
        let rw = 320 - 240 * wcol         // folded: the face alone
        let wt = 1 - smooth(0, 0.6, wcol) // …its words fade first
        let bw = if(c.unread > 99, 28, if(c.unread > 9, 23, 18))
        let sel = if(wa_sel == wa_first + c.index, 1, 0)
        //  On the right, on the middle line where the pill's round end leaves the most room: the time
        //  (each row measures its own: "14:07", "Yesterday"), the unread count left of it, then pinned/muted.
        measure agm
        let unr = if(c.unread > 0, 1, 0)
        let bdx = 302 - agm.width - 7 - bw / 2          // the count's middle
        let mrk_x = 302 - agm.width - 7 - (bw + 6) * unr - 11   // pinned or muted, left of them
        let rcol = 302 - mrk_x + 8                       // how much the right column takes
        zone box z { from: 0, 0; size: rw, 66; corner: 33 continuous; cursor: pointer; label: "{c.name}" }
        //  Under the pointer a faint trace (one glass pill only: the chosen one); the chosen chat is a raised, lit one: a pill inset so the
        //  face has 11 on every side and sits in its round end. Folded, a circle around the face.
        body {
            color: ink; opacity: 6%; show: z.hover > 0.5 and sel < 0.5
            box { from: 7, 0; size: rw - 14, 66; corner: 33 continuous }
        }
        //  (The chosen chat's glass is the list's one `Glide`, pages/whatsapp.plm: it travels between rows.)
        //  Unread: a bead of light before the face (grey when it is muted). Not on the chosen chat: there
        //  it would sit on the glass pill's rim, and the count beside the time says it already.
        prop dsel = 0 ~160ms
        follow dsel = sel
        body {
            color: if(c.muted, im_gray2, im_blue); light: 7%, 29, 4
            opacity: if(c.unread > 0, 100%, 0) * wt * (1 - dsel)
            ellipse { at: 9, 33; radius: 3.8 }
        }
        body {
            gradient: 18, 11 to 62, 55, #7d7d85, #57575e; light: 4%, 11, 22
            ellipse { at: 40, 33; radius: 22 }
        }
        text c.init { at: 40, 33.5; anchor: center; size: 14; weight: 600; family: "SF Pro Display"; color: ink; opacity: 92% }
        group {
            clip ellipse { at: 40, 33; radius: 22 }
            image c.pic { at: 18, 11; size: 44, 44 }
        }
        ellipse { at: 40, 33; radius: 22; stroke: 0.6; color: ink; opacity: 10% }
        group {
        opacity: wt
        show: wcol < 0.98
        text c.name { at: 72, 19; anchor: left center; width: 230 - rcol; lines: 1; size: 13.5; weight: 700; family: "SF Pro Display"; color: ink; opacity: if(c.unread > 0, 100%, 0) }
        text c.name { at: 72, 19; anchor: left center; width: 230 - rcol; lines: 1; size: 13.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: if(c.unread > 0, 0, 94%) }
        text c.ago { at: 302, 33; measure: agm; anchor: right center; size: 10.5; weight: 500; family: "SF Pro Text"; color: if(c.unread > 0 and not c.muted, im_blue2, ink); opacity: if(c.unread > 0, 100%, 45%) }
        //  Pinned, muted: before the time.
        image ic_pin { at: mrk_x, 27.5; size: 11, 11; tint: ink; opacity: if(c.pinned and not c.muted, 40%, 0) }
        image ic_bellx { at: mrk_x, 27.5; size: 11, 11; tint: ink; opacity: if(c.muted, 40%, 0) }
        text c.last { at: 72, 29; anchor: left top; width: 230 - rcol; lines: 2; line_height: 1.22; size: 11.5; weight: 400; family: "SF Pro Text"; color: ink; opacity: if(c.typing, 0, if(c.unread > 0, 78%, 52%)) }
        text "typing…" { at: 72, 37; anchor: left center; size: 11.5; weight: 500; family: "SF Pro Text"; color: im_blue2; opacity: if(c.typing, 100%, 0) }
        }
        //  The unread count: under the time, or (folded) on the face's shoulder.
        let bcx = bdx + (58 - bdx) * wcol
        let bcy = 33 + (16 - 33) * wcol
        group {
            opacity: if(c.unread > 0, 1, 0)
            //  A soft solid bead (grey when muted): a gentle blue from top to bottom and a faint rim of light.
            //  Not glass (too much on something this small), not a flat disc (read as pasted on).
            body {
                gradient: 0, bcy - 8.5 to 0, bcy + 8.5, if(c.muted, mix(im_gray2, #ffffff, 0.08), im_blue2), if(c.muted, im_gray2, im_blue)
                opacity: 94%
                box { from: bcx - bw / 2, bcy - 8.5; size: bw, 17; corner: 8.5 continuous }
            }
            box { from: bcx - bw / 2 + 0.5, bcy - 8; size: bw - 1, 16; corner: 8 continuous; stroke: 0.6; color: #ffffff; opacity: 22% }
            text c.badge { at: bcx, bcy + 0.2; anchor: center; size: 10; weight: 700; family: "SF Pro Display"; color: #ffffff }
        }
        on press z { emit wa_pick(c.index) }
    }

    //  A message, as iOS's Messages draws them: a bubble as wide as what it says (up to 420),
    //  ours on the right in the island's light, theirs on the left in grey; messages that follow
    //  each other close up, and only the last of a run has a tail. No times in the bubbles: t
    //  brings them all out at the chat's right (ours sliding aside for them), and the pointer on
    //  one shows its own beside its bar. A picture is its own rounded shape, any caption in a
    //  bubble under it; one to three emoji alone are large, on nothing. Reactions sit on the
    //  bubble's top corner. Between days, the day; under the last one sent, whether it was read.
    component WaMsg(m: record) {
        let side = max(m.dw, m.dh)
        let so = if(m.stack > 1, 10, 0)     // a stack: room above for the cards tilted out behind
        let picked = if(wa_focus and not wa_typing and wa_cur == m.index, 1, 0)   // only while going through the messages
        let bubbled = not m.day and not m.jumbo and (m.has_text or m.file)
        //  Its slot takes its height on a spring: the words of a new message are measured a few
        //  frames after it is there, and this way it slides in instead of jumping as they come.
        //  Opening a chat (`wa_snap`), the height itself, at once. (Not with a `~1ms` rule: that
        //  would leave the follow travelling in 1 ms from then on.)
        prop hs = 0 ~200ms
        follow hs = if(m.index < wam.count, wmc.height, 0)   // an unused slot at nothing, so a new one grows from it
        //  …and comes with some weight: ours rises out of the field and settles to its size, as a
        //  message sent leaves it on iOS; theirs opens from its stem's corner, a touch past and back.
        prop born = 0 ~380ms
        follow born = if(m.index < wam.count, 1, 0)
        prop pop = 0 ~spring(260, 17)
        follow pop = if(m.index < wam.count, 1, 0)
        //  The stem: on the last of a run. When one more joins it, it draws back into this bubble's
        //  corner as it grows out of the new one's, instead of jumping down.
        prop stem = 0 ~220ms
        follow stem = if(m.tail, 1, 0)
        //  A voice note playing here: seconds since this run began (at its speed), and how far through it is.
        prop vpos = 0
        spin vpos by if(wa_vplay == m.index and wa_vgo, wa_vspeed, 0)
        on change wa_vseq while wa_vplay == m.index { vpos: 0 ~1ms }
        let vprog = if(wa_vplay == m.index, clamp((wa_vfrom + vpos) / max(1, m.vsecs), 0, 1), 0)
        //  …and whether it is the one playing, on a spring: its bubble widens for the speed pill and
        //  the light that fills it comes up.
        prop vsp = 0 ~220ms
        follow vsp = if(wa_vplay == m.index, 1, 0)
        let vww = m.vbars * 3                   // its waveform's width
        let vtw = if(m.vsecs >= 600, 36, 29)    // its time's
        let vtx = 40 + vww + 10                 // where the time starts
        //  With the times out (t), ours slide aside for theirs.
        let tsx = if(m.me and not m.day, 56 * wts, 0)
        let tmx = wcw - 4 + tsx - if(m.grp, 36, 0)   // …where the times end: the chat's right, whatever moved the row
        group {
        size: wcw, if(wa_snap, wmc.height, hs)
        //  In a group, what others say sits beside a column for their faces (iMessage's).
        move: if(m.grp, 36, 0) - tsx, if(wa_snap, 0, if(m.me, 44, 12) * (1 - born))
        pivot: if(m.me, wcw, 0), wmc.height
        scale: if(wa_snap or m.day, 1, if(m.me, 0.93 + 0.07 * born, 0.84 + 0.16 * pop))
        //  The whole row, under everything in it: the pointer over it brings the bar beside it, a
        //  right click its menu.
        zone box hz { from: 0, 0; size: wcw, wmc.height; label: "Message"; active: not m.day and m.index < wam.count }
        column wmc {
            //  The day, and the time of its first message: quiet, centred.
            group {
                show: m.day
                size: wcw, 38
                row {
                    at: 312, 20; anchor: center middle; gap: 5
                    text m.text { size: 10.5; weight: 700; family: "SF Pro Text"; color: ink; opacity: 50% }
                    text m.time { size: 10.5; weight: 400; family: "SF Pro Text"; color: ink; opacity: 42% }
                }
            }
            //  Who said it, over the first of their run (in a group).
            group {
                show: m.has_from
                size: wcw, 17
                text m.from { at: 14, 8; anchor: left center; size: 10.5; weight: 600; family: "SF Pro Text"; color: ink; opacity: 50% }
            }
            //  What it answers: not a pane inside the reply but the original itself, small and faded — a
            //  ghost of its own bubble (blue if it was ours, grey if theirs, lit and coloured as the real
            //  one is) above this one, set in from the side, and a fine thread curving from it down into
            //  the reply, as iMessage threads them. Pressed, the chat goes to the original.
            group {
                show: m.has_q and not m.day
                size: wcw, wqb.height + 6
                let qw = wqb.width
                let qh = wqb.height
                let qx = if(m.me, wcw - 22 - qw, 22)
                let tx = if(m.me, wcw - 12, 12)            // where the thread comes down, into the reply's top
                let gx = if(m.me, wcw - 22, 22)            // …from the ghost's side
                path {
                    stroke: 1.4; color: if(m.qme, im_blue2, ink); opacity: if(m.qme, 55%, 26%)
                    move gx, qh / 2
                    curve tx, qh / 2 + 10 via tx, qh / 2
                    line tx, qh + 26
                }
                body {
                    gradient: fixed 0, 130 to 0, 690, if(m.qme, im_deep, im_gray), if(m.qme, im_blue, im_gray) 62%, if(m.qme, im_blue2, im_gray)
                    light: 6%, 0, 12
                    rim: 12%
                    opacity: if(m.qme, 50%, 62%)
                    box { from: qx, 0; size: qw, qh; corner: min(16, qh / 2) continuous }
                }
                zone box wqz { from: qx, 0; size: qw, qh; corner: min(16, qh / 2) continuous; cursor: pointer; label: "Go to the message it answers"; active: m.has_q and m.index < wam.count }
                box { from: qx, 0; size: qw, qh; corner: min(16, qh / 2) continuous; color: #ffffff; opacity: 7% * wqz.hover }
                row wqb {
                    at: qx, 0; padding: 6; gap: 5
                    group { size: 1, 1 }
                    //  …its picture, small, when it was one.
                    group {
                        show: m.has_qpic
                        size: 30, 30
                        group {
                            clip box { from: 0, 0; size: 30, 30; corner: 9 continuous }
                            image m.qpic { at: 0, 0; size: 30, 30 }
                        }
                    }
                    column {
                        gap: 0
                        text m.qfrom { size: 9.5; weight: 700; family: "SF Pro Text"; color: if(m.qme, #ffffff, ink); opacity: if(m.qme, 72%, 50%) }
                        //  (`fit`: wrapped at 300, as wide as its widest line)
                        text m.qtext { width: 300; fit: true; lines: 2; line_height: 1.25; size: 12; weight: 400; family: "SF Pro Text"; color: if(m.qme, #ffffff, ink); opacity: if(m.qme, 82%, 70%); show: m.has_qtext and not m.has_qlt }
                        //  …a link with a card: the card's title (its picture is the thumbnail beside), and the site.
                        text m.qltitle { width: 300; fit: true; lines: 2; line_height: 1.25; size: 12; weight: 600; family: "SF Pro Text"; color: if(m.qme, #ffffff, ink); opacity: if(m.qme, 90%, 82%); show: m.has_qlt }
                        text m.qlsite { size: 10.5; weight: 500; family: "SF Pro Text"; color: if(m.qme, #ffffff, ink); opacity: if(m.qme, 65%, 50%); show: m.has_qlt }
                    }
                    group { size: 1, 1 }
                }
                on press wqz { emit wa_qjump(m.index) }
            }
            //  Room above it for its reactions, which sit on its top corner.
            group {
                show: m.has_react and not m.day
                size: wcw, 12
            }
            //  A picture: its own shape, rounded as the bubbles are. Several sent one after another are
            //  one stack, as iMessage's: the next two tilted out behind the first, how many on it.
            group {
                show: m.img
                size: wcw, m.dh + so + if(m.has_text or m.file, 3, 0)
                let px = if(m.me, wcw - m.dw, 0)
                group {
                    show: m.stack > 2
                    pivot: px + m.dw / 2, so + m.dh / 2
                    rotate: if(m.me, -6deg, 6deg)
                    move: if(m.me, -10, 10), 2
                    group {
                        clip box { from: px, so; size: m.dw, m.dh; corner: 18 continuous }
                        box { from: px, so; size: m.dw, m.dh; color: im_gray2 }
                        image m.pic3 { at: px + (m.dw - side) / 2, so + (m.dh - side) / 2; size: side, side; opacity: 70% }
                    }
                }
                group {
                    show: m.stack > 1
                    pivot: px + m.dw / 2, so + m.dh / 2
                    rotate: if(m.me, 3.5deg, -3.5deg)
                    move: if(m.me, 4, -4), -6
                    group {
                        clip box { from: px, so; size: m.dw, m.dh; corner: 18 continuous }
                        box { from: px, so; size: m.dw, m.dh; color: im_gray2 }
                        image m.pic2 { at: px + (m.dw - side) / 2, so + (m.dh - side) / 2; size: side, side; opacity: 85% }
                    }
                }
                zone box iz { from: px, so; size: m.dw, m.dh; corner: 18 continuous; cursor: pointer; label: "View the picture"; carries: "{m.full}" }
                group {
                    //  A sticker is cut out already: no ground behind it, no rounding.
                    clip box { from: px, so; size: m.dw, m.dh; corner: if(m.sticker, 0, 18) continuous }
                    box { from: px, so; size: m.dw, m.dh; color: if(m.stack > 1, im_gray2, ink); opacity: if(m.sticker, 0, if(m.stack > 1, 100%, 8%)) }
                    image m.pic { at: px + (m.dw - side) / 2, so + (m.dh - side) / 2; size: side, side }
                }
                //  A video: the play mark in its middle.
                //  A video: the play mark in its middle.
                group {
                    show: m.video
                    body {
                        color: #000000; opacity: 38%
                        ellipse { at: px + m.dw / 2, so + m.dh / 2; radius: 21 + 1.5 * iz.hover }
                    }
                    path { at: px + m.dw / 2 + 2, so + m.dh / 2; color: #ffffff; opacity: 95%; move -6, -9; line 9, 0; line -6, 9; close }
                }
                //  How many in the stack.
                group {
                    show: m.stack > 1
                    body {
                        color: #000000; opacity: 45%
                        box { from: px + 8, so + 8; size: 30, 18; corner: 9 continuous }
                    }
                    text m.stack_n { at: px + 23, so + 17.3; anchor: center; size: 10.5; weight: 700; family: "SF Pro Text"; color: #ffffff }
                }
                box { from: px - 1.5, so - 1.5; size: m.dw + 3, m.dh + 3; corner: 19.5 continuous; stroke: 2; color: im_blue2; opacity: 90% * picked }
                //  Its time, out at the right with the others (t), when no caption carries it.
                text m.clock { at: tmx, so + m.dh / 2; anchor: right center; size: 10; weight: 500; family: "SF Pro Text"; color: ink; opacity: 45% * wts; show: wts > 0.01 and not (m.has_text or m.file) }
                on press iz { emit wa_look_at(m.index) }
                on enter iz { emit wa_prefetch(m.index); wa_hov = m.index }
                on leave iz while wa_hov == m.index { wa_hov = -1 }
            }
            //  The bubble: drawn behind its words, as big as they come to.
            group {
                show: bubbled
                size: wcw, bub.height
                let bx = if(m.me, wcw - bub.width, 0)
                //  The bubble is one outline, not a box with a stem stuck on (that showed a step where
                //  they met): three soft corners, and on its own side the fourth is either a corner or,
                //  on the last of a run, iMessage's stem — the side running straight down into a fine
                //  tip and a concave sweep back into the bottom, every join tangent.
                let sx = if(m.me, bx + bub.width, bx)      // the stem's side…
                let ox = if(m.me, bx, bx + bub.width)      // …the other
                let sd = if(m.me, 1, -1)                   // outwards, on the stem's side
                let tl = if(wa_snap, if(m.tail, 1, 0), stem)
                let br = min(18, bub.height / 2)
                let bb = bub.height
                //  Drawn as a rounded box, and the stem as a small piece of its own over the corner it
                //  replaces (one silhouette, so no seam): a path the size of the whole bubble cost the card
                //  three times as much to paint, and a chat repaints every bubble whenever it moves.
                //  Without a stem that piece shrinks to a point in the middle (a hidden shape would still count).
                let scx = bx + bub.width / 2
                let scy = bb / 2
                let sin = sx - sd * min(br + 19, bub.width - br)   // how far in it reaches along the bottom
                //  Lit, not flat. Ours take their blue from where they are on the screen, not from
                //  themselves: brightest by the field, deepening towards indigo up the chat, so the whole
                //  conversation reads as one lit surface they scroll through (iMessage's). Each has a
                //  sheen along its top, light along its edge (`rim`, inside it: nothing behind is touched),
                //  and ours cast a little of their blue onto the card.
                body {
                    gradient: fixed 0, 130 to 0, 690, if(m.me, im_deep, im_gray), if(m.me, im_blue, im_gray) 62%, if(m.me, im_blue2, im_gray)
                    light: 6%, 0, 13
                    rim: 12%
                    shadow: 0, 2, if(m.me, 10, 0), if(m.me, 24%, 0), im_blue
                    opacity: if(m.ghost, 0, 1)
                    box { from: bx, 0; size: bub.width, bb; corner: br continuous }
                    path {
                        move scx + tl * (sx - scx), scy + tl * (bb - br - 1 - scy)
                        line scx + tl * (sx - scx), scy + tl * (bb - 10 - scy)
                        curve scx + tl * (sx + sd * 6.2 - scx), scy + tl * (bb + 0.2 - scy) via scx + tl * (sx + sd * 0.3 - scx), scy + tl * (bb - 2.5 - scy)
                        //  Back from the tip along the bottom, staying under the box's corner all the way (a sweep
                        //  rising above it left a sliver of the corner below the stem, which the lit edge showed).
                        curve scx + tl * (sx - sd * 12 - scx), scy + tl * (bb - scy) via scx + tl * (sx - sd * 2 - scx), scy + tl * (bb - 1 - scy)
                        line scx + tl * (sin - scx), scy + tl * (bb - scy)
                        line scx + tl * (sin - scx), scy + tl * (bb - br - 1 - scy)
                        close
                    }
                }
                //  What stands in for a message (deleted, still on its way, view once, a kind not shown here):
                //  not a bubble of words but its outline, empty, so it never reads as something said.
                box { from: bx + 0.5, 0.5; size: bub.width - 1, bb - 1; corner: br - 0.5 continuous; stroke: 1; color: ink; opacity: if(m.ghost, 24%, 0) }
                box { from: bx - 1.5, -1.5; size: bub.width + 3, bub.height + 3; corner: 19.5 continuous; stroke: 2; color: if(m.me, #ffffff, im_blue2); opacity: 85% * picked }
                column bub {
                    at: bx, 0; padding: 7, 13; gap: 2
                    //  Its link's card: the page's picture across the top, filling it (cropped, whatever its
                    //  shape), then its title, what it is and the site, big enough to read — on a darker pane of
                    //  the bubble's own colour. Pressed, the link opens.
                    group {
                        show: m.has_lp
                        let cw = if(m.long, 420, 340)
                        let bh = cw * clamp(m.lr, 0.42, 0.75)
                        //  The picture sits fitted in a square canvas: the square is drawn as big as it takes for
                        //  the picture in it to cover the band (iw, ih: how much of the square it fills each way).
                        let iw = min(1, 1 / max(m.lr, 0.01))
                        let ih = clamp(m.lr, 0.01, 1)
                        let sq = max(cw / iw, bh / ih)
                        size: if(m.long, 420, 340), wlc.height + 6
                        body {
                            gradient: fixed 0, 130 to 0, 690, if(m.me, mix(im_deep, #000000, 0.24), mix(im_gray, #000000, 0.28)), if(m.me, mix(im_blue, #000000, 0.24), mix(im_gray, #000000, 0.28)) 62%, if(m.me, mix(im_blue2, #000000, 0.24), mix(im_gray, #000000, 0.28))
                            box { from: 0, 0; size: cw, wlc.height; corner: 14 continuous }
                        }
                        zone box wlz { from: 0, 0; size: cw, wlc.height; corner: 14 continuous; cursor: pointer; label: "Open the link"; active: m.has_lp and m.index < wam.count }
                        column wlc {
                            at: 0, 0; gap: 0
                            group {
                                show: m.has_lpic
                                size: if(m.long, 420, 340), if(m.long, 420, 340) * clamp(m.lr, 0.42, 0.75)
                                group {
                                    clip box { from: 0, 0; size: cw, bh; corner: 14 continuous }
                                    image m.lpic { at: (cw - sq) / 2, (bh - sq) / 2; size: sq, sq }
                                }
                            }
                            row {
                                gap: 0
                                group { size: 12, 1 }
                                column {
                                    gap: 3
                                    group { size: 1, 8 }
                                    text m.ltitle { width: cw - 24; lines: 3; line_height: 1.22; size: 14; weight: 700; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); show: m.has_ltitle }
                                    text m.ldesc { width: cw - 24; lines: 3; line_height: 1.25; size: 12.5; weight: 400; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: 74%; show: m.has_ldesc }
                                    text m.lsite { width: cw - 24; lines: 1; size: 11.5; weight: 600; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: 55% }
                                    group { size: 1, 9 }
                                }
                            }
                        }
                        box { from: 0, 0; size: cw, wlc.height; corner: 14 continuous; color: #ffffff; opacity: 6% * wlz.hover }
                        on press wlz { emit wa_link_at(m.index) }
                    }
                    //  A voice note, played in its bubble: a round button (▶, ❚❚ while it plays), the note's own
                    //  waveform — as long as the note is (the helper gives a longer one more bars, `vbars`; 3 px
                    //  each) — and its length. Playing, the button's halo stretches into a capsule of light
                    //  that runs along the waveform with the playhead, so the bubble fills as it plays, the bars
                    //  lighting up under it; the time counts down and a 1× / 1.5× / 2× pill comes in at the end
                    //  (the bubble widening for it, not keeping room for it). A press on the waveform goes
                    //  there. At its end the next voice note from the same side plays.
                    group {
                        let vme = wa_vplay == m.index
                        let vrun = vme and wa_vgo
                        size: vtx + vtw + 50 * vsp, 34
                        show: m.voice
                        zone box vz { from: -6, -2; size: 40, 38; corner: 19; cursor: pointer; label: "Play the voice note"; carries: "{m.full}" }
                        zone box vwz { from: 36, 0; size: vww + 8, 34; cursor: pointer; label: "Go to there in the voice note"; active: m.voice }
                        //  The light filling it: a capsule from round the button to the playhead.
                        box { from: -3, -3; size: 39 + (vww + 5) * vprog, 40; corner: 20 continuous; color: if(m.me, #ffffff, ink); opacity: if(m.me, 15%, 8%) * vsp }
                        ellipse { at: 16, 17; radius: 15 + 0.6 * vz.pressed; color: if(m.me, #ffffff, ink); opacity: if(m.me, 24%, 13%) + 8% * vz.hover }
                        path { at: 17.5, 17; color: if(m.me, #ffffff, ink); opacity: if(vrun, 0, 95%); move -4.5, -6.5; line 6.5, 0; line -4.5, 6.5; close }
                        box { from: 11.5, 11; size: 3.6, 12; corner: 1.2; color: if(m.me, #ffffff, ink); opacity: if(vrun, 95%, 0) }
                        box { from: 17.4, 11; size: 3.6, 12; corner: 1.2; color: if(m.me, #ffffff, ink); opacity: if(vrun, 95%, 0) }
                        //  The bars sit centred in the helper's picture (64 bars' room): drawn centred on the waveform.
                        //  Played: bright up to where it is, with a soft lit edge; still to come: quiet.
                        image m.vwave { at: 40 + vww / 2 - 96, 5; size: 192, 24; tint: if(m.me, #ffffff, ink); opacity: if(vme, if(m.me, 40%, 28%), if(m.me, 88%, 62%)) + 8% * vwz.hover * (1 - vsp) }
                        group {
                            show: vme
                            clip box { from: 40, 0; size: vww * vprog, 34 }
                            image m.vwave { at: 40 + vww / 2 - 96, 5; size: 192, 24; tint: if(m.me, #ffffff, ink); opacity: 100% }
                        }
                        box { from: 40 + vww * vprog - 1, 3; size: 2, 28; corner: 1; color: if(m.me, #ffffff, ink); opacity: 70% * vsp * if(vprog > 0.005 and vprog < 0.995, 1, 0) }   // the playhead
                        box { from: 40, 16.25; size: vww, 1.5; corner: 0.75; color: if(m.me, #ffffff, ink); opacity: if(m.has_vwave, 0, 30%) }   // no waveform yet: a quiet line
                        text m.vtime { at: vtx, 17; anchor: left center; size: 12; weight: 600; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: 78% * (1 - vsp) }
                        text wa_vleft { at: vtx, 17; anchor: left center; size: 12; weight: 600; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: if(vme, 90%, 0) * vsp }
                        //  The speed, while it is the one playing.
                        group {
                            opacity: vsp
                            zone box vsz { from: vtx + vtw + 6, 7; size: 40, 20; corner: 10 continuous; cursor: pointer; label: "Play faster"; active: vme }
                            box { from: vtx + vtw + 6, 7; size: 40, 20; corner: 10 continuous; color: if(m.me, #ffffff, ink); opacity: 18% + 10% * vsz.hover }
                            text "{wa_vspeed}×" { at: vtx + vtw + 26, 17.3; anchor: center; size: 11; weight: 700; family: "SF Pro Text"; color: if(m.me, #ffffff, ink) }
                            on press vsz { emit wa_vspeed_cycle }
                        }
                        on press vz { emit wa_media(m.index) }
                        on enter vz { emit wa_prefetch(m.index) }
                        on enter vwz { emit wa_prefetch(m.index) }
                        on press vwz { emit wa_vseek(m.index * 1000 + floor(clamp((local.x - 40) / vww, 0, 0.999) * 1000)) }
                    }
                    //  A video or file: a line that opens it.
                    group {
                        size: 236, 22
                        show: m.file and not m.voice
                        zone box fz { from: -6, -3; size: 248, 28; cursor: pointer; label: "Open it"; carries: "{m.full}" }
                        text m.text { at: 0, 11; anchor: left center; width: 236; lines: 1; size: 13.5; weight: 600; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: 88% + 12% * fz.hover }
                        on press fz { emit wa_media(m.index) }
                        on enter fz { emit wa_prefetch(m.index) }
                    }
                    //  What stands in for a message: its symbol and what it means, quiet.
                    row {
                        show: m.ghost
                        gap: 6
                        group {
                            size: 13, 16
                            image ic_g_wait { at: 0, 1.5; size: 13, 13; tint: ink; opacity: if(m.gi == 1, 55%, 0) }
                            image ic_g_once { at: 0, 1.5; size: 13, 13; tint: ink; opacity: if(m.gi == 2, 55%, 0) }
                            image ic_g_phone { at: 0, 1.5; size: 13, 13; tint: ink; opacity: if(m.gi == 3, 55%, 0) }
                            image ic_g_del { at: 0, 1.5; size: 13, 13; tint: ink; opacity: if(m.gi == 4, 55%, 0) }
                        }
                        text m.text { size: 13; weight: 400; family: "SF Pro Text"; color: ink; opacity: 58% }
                    }
                    //  Wrapped at 420 and hugged by its bubble (`fit`): as wide as its widest line, however long.
                    text m.text { width: 420; fit: true; size: 13.5; weight: 400; line_height: 1.3; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: if(m.faint, 55%, 100%); selectable: true; show: m.has_text and not m.file and not m.ghost and not m.has_link }
                    //  …with a link in it: as markdown, so the link can be followed (`on("link")`), in a lighter tone.
                    text m.md { width: 420; fit: true; size: 13.5; weight: 400; line_height: 1.3; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: if(m.faint, 55%, 100%); selectable: true; markdown: true; link: if(m.me, #dce9ff, link_c); show: m.has_link }
                    //  The time is out at the side now (t); only an edit is still said in it.
                    text "Edited" { size: 9.5; weight: 500; family: "SF Pro Text"; color: if(m.me, #ffffff, ink); opacity: if(m.me, 70%, 42%); show: m.edited and m.has_text and not m.ghost }
                }
                text m.clock { at: tmx, bb / 2; anchor: right center; size: 10; weight: 500; family: "SF Pro Text"; color: ink; opacity: 45% * wts; show: wts > 0.01 }
            }
            //  One to three emoji and nothing else: large, on nothing (iMessage's).
            group {
                show: m.jumbo and not m.day
                size: wcw, wjb.height
                row wjb {
                    at: if(m.me, wcw - wjb.width, 0), 0; padding: 0, 2
                    text m.text { size: 40; family: "SF Pro Text"; color: ink; opacity: if(m.faint, 55%, 100%); selectable: true }
                }
                box { from: if(m.me, wcw - wjb.width, 0) - 4, -2; size: wjb.width + 8, wjb.height + 4; corner: 14 continuous; stroke: 2; color: im_blue2; opacity: 85% * picked }
                text m.clock { at: tmx, wjb.height / 2; anchor: right center; size: 10; weight: 500; family: "SF Pro Text"; color: ink; opacity: 45% * wts; show: wts > 0.01 }
            }
            //  Under the last one sent: Delivered, Read.
            group {
                show: m.has_status
                size: wcw, 17
                text m.status { at: wcw - 4, 9; anchor: right center; size: 10; weight: 600; family: "SF Pro Text"; color: if(m.faint, #ff453a, ink); opacity: if(m.faint, 100%, 45%) }
            }
            //  The room after it: close within a run, more between runs.
            group { size: wcw, if(m.day, 0, if(m.tail, 8, 2)) }
        }
        //  Whose it is, in a group: their face beside the last of their run, level with its bottom
        //  (under the room after it); their initials until the picture comes.
        group {
            show: m.has_face
            let fy = wmc.height - 28 - if(m.tail, 8, 2)
            ellipse { at: -18, fy + 14; radius: 14; color: #6e6e76 }
            text m.finit { at: -18, fy + 14.5; anchor: center; size: 10; weight: 600; family: "SF Pro Display"; color: #ffffff; opacity: 92% }
            group {
                clip ellipse { at: -18, fy + 14; radius: 14 }
                image m.face { at: -32, fy; size: 28, 28 }
            }
            ellipse { at: -18, fy + 14; radius: 14; stroke: 0.6; color: ink; opacity: 10% }
        }
        //  Beside it, on the side with room, while the pointer is on it: react, reply, more.
        let ew = max(if(m.img, m.dw, 0), if(bubbled, bub.width, 0), if(m.jumbo, wjb.width, 0))
        let bx0 = if(m.me, wcw - ew - 104, ew + 8)
        let by0 = max(0, (wmc.height - 30) / 2 - if(m.has_status, 8, 0) + if(m.has_react, 6, 0) + if(m.has_q, (wqb.height + 6) / 2, 0))
        prop hv = 0 ~120ms
        zone ellipse pb1 { at: bx0 + 16, by0 + 15; radius: 13; cursor: pointer; label: "React"; active: hv > 0.5 }
        zone ellipse pb2 { at: bx0 + 48, by0 + 15; radius: 13; cursor: pointer; label: "Reply"; active: hv > 0.5 }
        zone ellipse pb3 { at: bx0 + 80, by0 + 15; radius: 13; cursor: pointer; label: "More"; active: hv > 0.5 }
        follow hv = if(not m.day and not m.faint and m.index < wam.count and wa_menu < 0 and not wa_modal and abs(vel(wfb)) < 60 and (hz.hover or pb1.hover or pb2.hover or pb3.hover), 1, 0)
        group {
            show: hv > 0.01
            opacity: hv
            //  Three buttons of glass, each its own (glass on glass goes one level deep): the one
            //  under the pointer lighter and a touch larger.
            body {
                color: mix(im_gray, chip_hi, pb1.hover); material: control; opacity: lgb_fill + 10% * pb1.hover
                ellipse { at: bx0 + 16, by0 + 15; radius: 14 + pb1.hover }
            }
            body {
                color: mix(im_gray, chip_hi, pb2.hover); material: control; opacity: lgb_fill + 10% * pb2.hover
                ellipse { at: bx0 + 48, by0 + 15; radius: 14 + pb2.hover }
            }
            body {
                color: mix(im_gray, chip_hi, pb3.hover); material: control; opacity: lgb_fill + 10% * pb3.hover
                ellipse { at: bx0 + 80, by0 + 15; radius: 14 + pb3.hover }
            }
            image ic_smile_m { at: bx0 + 8.5, by0 + 7.5; size: 15, 15; tint: ink; opacity: 80% }
            image ic_reply { at: bx0 + 40.5, by0 + 7.5; size: 15, 15; tint: ink; opacity: 80% }
            image ic_more { at: bx0 + 72.5, by0 + 7.5; size: 15, 15; tint: ink; opacity: 80% }
            //  …and its time, past the bar (unless every time is out already).
            text m.clock { at: bx0 - 8, by0 + 15; anchor: right center; size: 10; weight: 500; family: "SF Pro Text"; color: ink; opacity: 45% * (1 - wts); show: m.me }
            text m.clock { at: bx0 + 104, by0 + 15; anchor: left center; size: 10; weight: 500; family: "SF Pro Text"; color: ink; opacity: 45% * (1 - wts); show: not m.me }
        }
        //  One that did not go (iMessage's): a red mark beside it, there until it is sent again or
        //  deleted. Pressed: sent again. Its menu (a right click) has both.
        let pfy = (wmc.height - if(m.has_status, 17, 0) - if(m.tail, 8, 2)) / 2 + if(m.has_q, (wqb.height + 6) / 2, 0)
        zone ellipse pfz { at: wcw - ew - 20, pfy; radius: 12; cursor: pointer; label: "Try again"; active: m.faint and m.index < wam.count and not wa_modal }
        group {
            show: m.faint
            ellipse { at: wcw - ew - 20, pfy; radius: 9 + pfz.hover; color: #ff453a }
            text "!" { at: wcw - ew - 20, pfy; anchor: center; size: 12.5; weight: 800; family: "SF Pro Text"; color: #ffffff }
        }
        on press pfz { emit wa_act(m.index * 10 + 9) }
        on press pb1 { emit wa_act(m.index * 10 + 1) }
        on press pb2 { emit wa_act(m.index * 10 + 2) }
        //  Its menu (… or a right click on it) opens over this bar, beside the bubble on the side with
        //  room, never over the messages: `wa_mx` from the row's left (the page adds where rows start).
        let menu_x = if(m.me, bx0 + 96 - 200, bx0)
        on press pb3 { wa_menu = m.index; wa_mx = menu_x; wa_my = pointer.y - 15; wa_m_edit = m.can_edit; wa_m_save = m.can_save; wa_m_fail = m.faint }
        on press right hz { wa_menu = m.index; wa_mx = menu_x; wa_my = pointer.y - 15; wa_m_edit = m.can_edit; wa_m_save = m.can_save; wa_m_fail = m.faint }
        //  Its reactions: a soft solid bead on its top corner, the inner one (iMessage's tapbacks),
        //  half over it, in the room left above it: blue when one of them is ours, as iMessage's. Its
        //  emoji have room round them (a layout's `padding` is one number: the sides are spacers).
        //  Pressed: who gave them (WhatsApp's sheet).
        group {
            show: m.has_react and not m.day
            let etw = if(m.img, m.dw, if(m.jumbo, wjb.width, bub.width))   // what is on top: the picture, or the bubble
            let ety = if(m.has_from, 17, 0) + if(m.has_q, wqb.height + 6, 0) + 12 + if(m.img, so, 0)
            let rw = max(28, wrb.width)
            let rx = if(m.me, wcw - etw + 14 - rw, etw - 14)
            let ry = ety - 12
            body {
                gradient: 0, ry to 0, ry + 24, if(m.rmine, im_blue2, mix(im_gray2, #ffffff, 0.08)), if(m.rmine, im_blue, im_gray2)
                light: 6%, ry, 10
                rim: 14%
                shadow: 0, 1.5, 6, 34%
                box { from: rx, ry; size: rw, 24; corner: 12 continuous }
            }
            box { from: rx + 0.3, ry + 0.3; size: rw - 0.6, 23.4; corner: 11.7 continuous; stroke: 0.6; color: #ffffff; opacity: 20% }
            row wrb {
                at: rx + (rw - wrb.width) / 2, ry + (24 - wrb.height) / 2; padding: 0; gap: 0
                group { size: 7, 1 }
                text m.react { size: 13; weight: 600; family: "SF Pro Text"; color: if(m.rmine, #ffffff, ink) }
                group { size: 7, 1 }
            }
            zone box rpz { from: rx, ry; size: rw, 24; corner: 12 continuous; cursor: pointer; label: "Who reacted"; active: m.has_react and m.index < wam.count }
            box { from: rx, ry; size: rw, 24; corner: 12 continuous; color: #ffffff; opacity: 8% * rpz.hover }
            on press rpz { emit wa_who_at(m.index) }
        }
        }
        //  The chat's cursor. Each step is worked out by the row it crosses, which knows its own
        //  height (`wa_cy` is the chosen row's top, from the chat's bottom); then the chosen one
        //  keeps itself in sight, and a day's row passes the cursor on.
        let sh = if(wa_snap, wmc.height, hs)
        on wa_k while wa_cur == m.index + 1 { wa_cy = wa_cy + sh; wa_cur = m.index; wa_dir = -1 }
        on wa_j while wa_cur == m.index and m.index + 1 < wam.count { wa_cy = wa_cy - sh; wa_cur = m.index + 1; wa_dir = 1 }
        on wa_last while m.index == wam.count - 1 { wa_cur = m.index; wa_cy = sh; wa_dir = 1; wfb: 0 ~quick }
        on wa_first while m.index == 0 and wam.count > 1 { wa_cur = 1; wa_cy = wml.height - sh; wa_dir = 1 }
        //  Reaching the newest, its place is known exactly: the bottom. (Counted row by row, a height
        //  that changed after it was counted — a picture, words measured late — left it short of there.)
        on change wa_cur while wa_cur == m.index and m.index == wam.count - 1 and wa_focus and not wa_typing { wa_cy = sh; wfb: 0 ~quick }
        on change wa_cur while wa_cur == m.index and m.day and wa_dir < 0 and m.index > 0 { emit wa_k }
        on change wa_cur while wa_cur == m.index and m.day and (wa_dir > 0 or m.index == 0) and m.index + 1 < wam.count { emit wa_j }
        on change wa_cy while wa_cur == m.index and not m.day and wa_focus and not wa_typing { wfb: clamp(max(min(wfb, wa_cy - sh - 30), wa_cy - wvh + 30), 0, wmax) ~quick }
        on wa_center while wa_cur == m.index { wfb: clamp(wa_cy - sh / 2 - wvh / 2, 0, wmax) ~quick }
        //  A message come at the bottom: the chosen one's top is that much further from it.
        on change wam.count while wa_cur >= 0 and m.index == wam.count - 1 and wa_cur < m.index { wa_cy = wa_cy + wmc.height }
    }

    //  The gallery's photos, videos and stickers: four to a row, each filling its square (a sticker
    //  fitted, on nothing), the row in sight gliding after the cursor (`wgbar`). Only the rows near
    //  it are records (`wa_gfirst` is the first one's place in the chat's whole gallery).
    component WaTile(t: record, x0: number, gt: number, y0: number) {
        let n = wa_gfirst + t.index
        let tx = x0 + mod(n, 4) * (gt + 6)
        let ty = y0 + (floor(n / 4) - wgbar) * (gt + 6)
        group {
            show: t.index < wag.count
            zone box tz { from: tx, ty; size: gt, gt; corner: 12 continuous; cursor: pointer; label: "Look at it" }
            group {
                clip box { from: tx, ty; size: gt, gt; corner: 12 continuous }
                box { from: tx, ty; size: gt, gt; color: ink; opacity: if(t.sticker, 3%, 8%) }
                image t.pic { at: tx + gt / 2 - gt * t.cw / 2, ty + gt / 2 - gt * t.ch / 2; size: gt * t.cw, gt * t.ch }
                box { from: tx, ty; size: gt, gt; color: #ffffff; opacity: 6% * tz.hover }
            }
            //  A video: how long, on a small dark pane.
            group {
                show: t.video
                body {
                    color: well; opacity: glass_alpha
                    box { from: tx + 6, ty + gt - 24; size: 54, 18; corner: 9 continuous }
                }
                text t.dur { at: tx + 33, ty + gt - 15; anchor: center; size: 9.5; weight: 600; family: "SF Pro Text"; color: #ffffff; opacity: 92% }
            }
            //  (Its ring is the gallery's, gliding: pages/glide.plm.)
            on press tz { emit wa_gpick(t.index) }
            //  Its own save button, in the corner, while the pointer is on it.
            zone ellipse ts { at: tx + gt - 18, ty + 18; radius: 13; cursor: pointer; label: "Save to Downloads"; active: tz.hover or ts.hover }
            group {
                opacity: max(tz.hover, ts.hover)
                body {
                    color: well; opacity: glass_alpha + 30% * ts.hover
                    ellipse { at: tx + gt - 18, ty + 18; radius: 13 }
                }
                image ic_dl { at: tx + gt - 25, ty + 11; size: 14, 14; tint: #ffffff; opacity: 92% }
            }
            on press ts { emit wa_gsave(t.index) }
        }
    }
    //  The gallery's documents and voice notes, one to a row.
    component WaFileRow(f: record, x0: number, fw: number, y0: number) {
        let n = wa_gfirst + f.index
        let fy = y0 + (n - wgbar) * 56
        let on = if(wa_gc == n, 1, 0)
        group {
            show: f.index < wagf.count
            zone box fz { from: x0, fy; size: fw, 50; corner: 16 continuous; cursor: pointer; label: "Open it" }
            body {
                color: mix(im_gray, im_gray2, max(on, 0.5 * fz.hover)); glass: 25%; blur: 0%; light: 4%, fy, 16
                box { from: x0, fy; size: fw, 50; corner: 16 continuous }
            }
            ellipse { at: x0 + 27, fy + 25; radius: 16; color: im_blue; opacity: 85% }
            image ic_doc { at: x0 + 19, fy + 17; size: 16, 16; tint: #ffffff; opacity: if(f.audio, 0, 95%) }
            path { at: x0 + 28, fy + 25; color: #ffffff; opacity: if(f.audio, 95%, 0); move -4, -6; line 6, 0; line -4, 6; close }
            text f.name { at: x0 + 54, fy + 18; anchor: left center; width: fw - 72; lines: 1; size: 12.5; weight: 600; family: "SF Pro Text"; color: ink }
            text f.sub { at: x0 + 54, fy + 35; anchor: left center; width: fw - 72; lines: 1; size: 11; weight: 500; family: "SF Pro Text"; color: ink; opacity: 55% }
            box { from: x0 - 1.5, fy - 1.5; size: fw + 3, 53; corner: 17.5 continuous; stroke: 2; color: im_blue2; opacity: on }
            on press fz { emit wa_gpick(f.index) }
            zone ellipse fs { at: x0 + fw - 26, fy + 25; radius: 14; cursor: pointer; label: "Save to Downloads" }
            ellipse { at: x0 + fw - 26, fy + 25; radius: 14; color: im_gray2; opacity: 40% + 60% * fs.hover }
            image ic_dl { at: x0 + fw - 33, fy + 18; size: 14, 14; tint: ink; opacity: 80% }
            on press fs { emit wa_gsave(f.index) }
        }
    }
    //  One line of a message's menu: what it does and its symbol; Delete in red.
    component WaMenuItem(label: text, icon: image, code: number, danger: bool) {
        size: 188, 32
        zone box iz { from: 0, 0; size: 188, 32; corner: 16 continuous; cursor: pointer; label: "{label}" }
        //  Inside the menu's glass (it goes one level deep): a soft, lit highlight, not a flat block.
        body {
            gradient: 0, 0 to 0, 32, mix(chip_hi, #ffffff, 0.10), chip_hi; light: 5%, 0, 16
            opacity: 70% * iz.hover
            box { from: 0, 0; size: 188, 32; corner: 16 continuous }
        }
        text label { at: 12, 16; anchor: left center; size: 12.5; weight: 500; family: "SF Pro Text"; color: if(danger, #ff6961, ink) }
        image icon { at: 162, 9; size: 15, 15; tint: if(danger, #ff6961, ink); opacity: 80% }
        on press iz { emit wa_act(wa_menu * 10 + code); wa_menu = -1 }
    }
    //  A chat to forward to: its face and name, the chosen one lit.
    //  Someone who reacted: their face, name and what they gave; ours can be taken back.
    component WaWhoRow(r: record, x0: number, fw: number, y0: number) {
        let ry = y0 + r.index * 44
        let on = if(wa_whi == r.index, 1, 0)
        group {
            show: r.index < wawho.count
            zone box rz { from: x0, ry; size: fw, 40; corner: 20 continuous; cursor: pointer; label: "{r.name}" }
            box { from: x0, ry; size: fw, 40; corner: 20 continuous; color: im_gray2; opacity: 50% * rz.hover * (1 - on) }
            ellipse { at: x0 + 22, ry + 20; radius: 15; color: #6e6e76 }
            text r.init { at: x0 + 22, ry + 20.5; anchor: center; size: 10.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 90% }
            group {
                clip ellipse { at: x0 + 22, ry + 20; radius: 15 }
                image r.pic { at: x0 + 6, ry + 4; size: 32, 32 }
            }
            text r.name { at: x0 + 46, ry + if(r.me, 13, 20); anchor: left center; width: fw - 100; lines: 1; size: 12.5; weight: 600; family: "SF Pro Text"; color: ink }
            text r.sub { at: x0 + 46, ry + 28; anchor: left center; width: fw - 100; lines: 1; size: 10.5; weight: 500; family: "SF Pro Text"; color: ink; opacity: 50% }
            text r.emoji { at: x0 + fw - 22, ry + 20.5; anchor: center; size: 19 }
            on press rz { emit wa_who_pick(r.index) }
        }
    }
    //  The sheet's tabs: everyone, then each emoji given, with how many.
    component WaWhoTab(t: record) {
        measure tl
        size: tl.width + 20, 26
        zone box tz { from: 0, 0; size: tl.width + 20, 26; corner: 13 continuous; cursor: pointer; label: "{t.label}" }
        box { from: 0, 0; size: tl.width + 20, 26; corner: 13 continuous; color: im_gray2; opacity: max(if(wa_who_tab == t.index, 1, 0), 0.5 * tz.hover) }
        text t.label { at: 10, 13.5; anchor: left center; size: 12; weight: 600; family: "SF Pro Text"; color: ink; measure: tl }
        on press tz { emit wa_who_tab_at(t.index) }
    }
    component WaFwdRow(r: record, x0: number, fw: number, y0: number) {
        let ry = y0 + r.index * 44
        let on = if(wa_fwi == r.index, 1, 0)
        group {
            show: r.index < wafw.count
            zone box rz { from: x0, ry; size: fw, 40; corner: 20 continuous; cursor: pointer; label: "Forward to {r.name}" }
            box { from: x0, ry; size: fw, 40; corner: 20 continuous; color: im_gray2; opacity: 50% * rz.hover * (1 - on) }
            ellipse { at: x0 + 22, ry + 20; radius: 15; color: #6e6e76 }
            text r.init { at: x0 + 22, ry + 20.5; anchor: center; size: 10.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 90% }
            group {
                clip ellipse { at: x0 + 22, ry + 20; radius: 15 }
                image r.pic { at: x0 + 6, ry + 4; size: 32, 32 }
            }
            text r.name { at: x0 + 46, ry + 20; anchor: left center; width: fw - 60; lines: 1; size: 12.5; weight: 600; family: "SF Pro Text"; color: ink }
            on press rz { emit wa_fwd_pick(r.index) }
        }
    }

    //  A tile of a mail as Gmail shows it, and a link on it: a zone over its words, lit faintly under the pointer.
    component WebTile(t: record) {
        //  Always drawn under the finer one too: hidden while that was still on its way, the page went blank.
        image t.pic { at: 0, t.index * 600; size: 620, 602; opacity: if(t.index * 600 > mvb or t.index * 600 + 602 < mvt, 0, 1) }
    }
    //  A GIF of the mail that moves, over the photograph: its 400 cell drawn so the picture fills its place.
    component WebAnim(a: record) {
        let wide = a.iw > a.ih
        let cs = if(wide, a.w, a.h)
        group {
            opacity: if(a.y > mvb or a.y + a.h < mvt, 0, 1)
            clip box { from: a.x, a.y; size: a.w, a.h }
            image a.pic { at: a.x + (a.w - cs) / 2, a.y + (a.h - cs) / 2; size: cs, cs }
        }
    }

    //  The same tile photographed finer, drawn at the focused view's size.
    component ZoomTile(t: record) {
        //  Shown once the view has settled; before that, drawn all but invisibly so it is already loaded then.
        image t.pic { at: 0, t.index * 600 * mzs; size: 620 * mzs, 602 * mzs; opacity: if(t.index * 600 > mvb or t.index * 600 + 602 < mvt, 0, if(zin > 0.98 and mxf > 0.98, 1, if(mxf > 0.5, 0.004, 0))) }
    }
    component WebLink(k: record) {
        zone box z { from: k.x - 2, k.y - 1; size: k.w + 4, k.h + 2; corner: 4 continuous; cursor: pointer; label: "Link" }
        box { from: k.x - 2, k.y - 1; size: k.w + 4, k.h + 2; corner: 4 continuous; color: link_c; opacity: 16% * z.hover + 10% * z.pressed }
        on press z { emit mail_wlink(k.index) }
    }

    //  A piece of a mail's body: a run of its words (markdown, so its links are links, in the
    //  island's blue), or one of its pictures, fitted to the width and no taller than 560.
    component MailBlock(b: record, bw: number) {
        let dw = min(min(b.iw, bw), b.iw * 560 / max(1, b.ih))
        let dh = dw * b.ih / max(1, b.iw)
        //  The cell (520:480) around the fitted picture: as wide as it, or as tall, centred on it.
        let wide = b.iw * 480 > b.ih * 520
        let cw = if(wide, dw, dh * 520 / 480)
        let chh = if(wide, dw * 480 / 520, dh)
        column {
            text b.md { width: bw; size: 12.5; weight: 500; line_height: 1.42; family: "SF Pro Display"; color: ink; markdown: true; selectable: true; link: link_c; show: not b.img }
            group {
                size: bw, if(b.img, dh, 0)
                show: b.img
                zone box pz { from: 0, 0; size: dw, dh; corner: 10 continuous; cursor: pointer; label: "Open the picture's link"; active: b.img and b.linked }
                group {
                    clip box { from: 0, 0; size: dw, dh; corner: 10 continuous }
                    image b.pic { at: (dw - cw) / 2, (dh - chh) / 2; size: cw, chh }
                }
                on press pz { emit mail_img(b.index) }
            }
        }
    }

    component Tile(title: text, sub: text, lit: bool, pick: event, power: event, glyph: number) {
        //  A slim pill: the radio's bead, its name, what it is on, a chevron to its page.
        size: 184, 34
        zone box t { from: 0, 0; size: 184, 34; corner: 17 continuous; cursor: pointer; label: "{title}" }
        prop lift = 0 ~160ms
        follow lift = t.hover - t.pressed
        body {
            color: mix(chip, chip_hi, max(lift, 0)); material: control; opacity: lgc_fill + 7% * max(lift, 0)
            box { from: 0, 0; size: 184, 34; corner: 17 continuous }
        }
        prop glow = 0 ~280ms
        follow glow = if(lit, 1, 0)
        //  The radio's button: a bead of softly tinted glass when on, a plain chip when off.
        body {
            gradient: 6, 6 to 28, 28, mix(chip_hi, soft_l, glow), mix(chip_hi, soft_s, glow)
            glass: 25%; blur: 0%; light: 7%, 5, 12; shadow: 0, 1 + 0.5 * p.hover, 3.5, 26%
            ellipse { at: 17, 17; radius: 12 + 0.3 * p.hover - 0.5 * p.pressed }
        }
        zone ellipse p { at: 17, 17; radius: 13; cursor: pointer; label: "{title} on or off"; role: toggle; checked: lit }
        group {
            show: glyph == 0
            opacity: 55% + 45% * glow
            ellipse { at: 17, 21; radius: 1.3; color: mix(ink, pearl_ink, glow) }
            arc { at: 17, 21; radius: 3.8; span: 90deg; width: 1.4; color: mix(ink, pearl_ink, glow) }
            arc { at: 17, 21; radius: 6.6; span: 90deg; width: 1.4; color: mix(ink, pearl_ink, glow) }
            arc { at: 17, 21; radius: 9.4; span: 90deg; width: 1.4; color: mix(ink, pearl_ink, glow) }
        }
        path {
            show: glyph == 1
            at: 17, 17; stroke: 1.4; color: mix(ink, pearl_ink, glow); opacity: 55% + 45% * glow
            move -3, -3; line 3, 3; line 0, 6; line 0, -6; line 3, -3; line -3, 3
        }
        //  The cable: a port's outline, its pins.
        group {
            show: glyph == 2
            opacity: 55% + 45% * glow
            path { at: 17, 17; stroke: 1.4; color: mix(ink, pearl_ink, glow); move -5, -2; line -5, 4; line 5, 4; line 5, -2; line 2.5, -2; line 2.5, -4.5; line -2.5, -4.5; line -2.5, -2; close }
            box { from: 14.6, 18; size: 0.9, 2; color: mix(ink, pearl_ink, glow) }
            box { from: 16.55, 18; size: 0.9, 2; color: mix(ink, pearl_ink, glow) }
            box { from: 18.5, 18; size: 0.9, 2; color: mix(ink, pearl_ink, glow) }
        }
        text title { at: 36, 17; anchor: left center; width: 80; lines: 1; size: 12; weight: 600; family: "SF Pro Display"; color: ink }
        text sub { at: 162, 17; anchor: right center; width: 66; lines: 1; align: right; size: 11; weight: 500; family: "SF Pro Display"; color: ink; opacity: 55% }
        path { at: 171, 17; stroke: 1.5; color: ink; opacity: 30% + 30% * t.hover; move -1.8, -4.5; line 2.7, 0; line -1.8, 4.5 }
        on press t { emit pick }
        on press p { emit power }
    }

    //  A page's header: back, its title, the scanning dots, and the radio's switch.
    component Header(title: text, lit: bool, busy: bool, back: event, power: event) {
        size: 352, 32
        zone ellipse b { at: 14, 16; radius: 14; cursor: pointer; label: "Back" }
        body {
            color: mix(chip, chip_hi, b.hover); material: control; opacity: lgc_fill + 7% * b.hover
            ellipse { at: 14, 16; radius: 14 - 0.6 * b.pressed }
        }
        path { at: 14, 16; stroke: 1.8; color: ink; opacity: 70% + 30% * b.hover; move 2, -5.5; line -3, 0; line 2, 5.5 }
        text title { at: 36, 16; anchor: left center; size: 15; weight: 600; family: "SF Pro Display"; color: ink }
        //  Searching: a sonar. Two rings keep leaving a small emitter beside the
        //  switch, and a beam of light glides along the hairline under the header.
        //  They only move while a scan is under way.
        prop scan = 0 ~280ms
        follow scan = if(busy, 1, 0)
        prop ping1 = 1 ~1100ms
        prop ping2 = 1 ~1100ms
        every 1.2s while busy and expanded { ping1: 0 ~1ms; ping1: 1 after 20ms; ping2: 0 ~1ms after 600ms; ping2: 1 after 620ms }
        fact beam_right = false
        prop beam = 0 ~1150ms
        follow beam = if(beam_right, 1, 0)
        every 1.2s while busy and expanded { toggle beam_right }
        group {
            opacity: scan
            ellipse { at: 292, 16; radius: 2.2; color: tint_ink }
            ellipse { at: 292, 16; radius: 3 + 11 * ping1; stroke: 1.2; color: tint_ink; opacity: 70% * (1 - ping1) }
            ellipse { at: 292, 16; radius: 3 + 11 * ping2; stroke: 1.2; color: tint_ink; opacity: 70% * (1 - ping2) }
        }
        group {
            opacity: scan
            blur: 3
            mode: screen
            ellipse { at: 8 + 328 * beam, 38; radius: 4; scale: 9, 0.45; color: soft_l }
        }

        //  The switch: a capsule track, and a capsule knob of white glass that
        //  stretches as it slides and swells under the finger.
        prop knob = 0 ~240ms
        follow knob = if(lit, 1, 0)
        prop kstretch = 0 ~120ms
        follow kstretch = clamp(abs(vel(knob)) / 5, 0, 1)
        zone box s { from: 308, 3; size: 48, 26; corner: 13 continuous; cursor: pointer; label: "{title} on or off"; role: toggle; checked: lit }
        //  Off, a groove pressed into the card; on, it fills with softly tinted glass.
        body {
            gradient: 308, 3 to 356, 29, mix(shade, mix(#b9bac4, lilac, 0.45), knob), mix(shade, mix(#9d9ea9, sunset, 0.42), knob)
            glass: 25% * knob; blur: 0%; light: 5%, 3, 13
            box { from: 308, 3; size: 48, 26; corner: 13 continuous }
        }
        body { color: well; opacity: 35% * (1 - knob); box { from: 314, 3; size: 36, 2; corner: 1 continuous } }
        let kw = 26 + 8 * kstretch + 4 * s.pressed
        let kh = 20 - 2 * kstretch + 2 * s.pressed
        body {
            color: ink; glass: 25%; blur: 0%; light: 6%, 6, 10; shadow: 0, 1, 3, 26%
            box { at: 324 + 16 * knob, 16; size: kw, kh; corner: kh / 2 continuous }
        }
        on press b { emit back }
        on press s { emit power }
    }

    //  Expanded rows: persistent workspace header, then the face that is showing.
    let row_tiles = 44
    let row_wx = 90           // under the slim Wi-Fi / Bluetooth pills
    let row_media = row_wx + wx_h
    let row_stats = row_wx + 8 + wx_h + 140 * media_in
    let tx = ex0 + 192
    let ty = row_media + 106
    //  The card's scrubber, as iOS draws Now Playing: a capsule of light that
    //  thickens under the pointer and more while held; the times underneath.
    let py = row_media + 66
    let cl_l = ex0 + 20
    let cl_w = 344
    let craw = (pointer.x - cl_l) / cl_w        // where the pointer is along it (only inside a rule)

    //  ── the app: the pill grown into it; what it holds comes in over the second half ──
    group {
        show: aon > 0.002 or agp > 0.002
        clip inset 1 box { from: x0, 0; size: pw, ph; corner: pr continuous }
        group {
            opacity: smooth(0.5, 1, agp)
            move: 0, 8 * (1 - agp)
            include "pages/mail.plm"
            include "pages/mailx.plm"
            include "pages/whatsapp.plm"
            text clock.time { at: axr - 20, 22; anchor: right center; size: 13; weight: 600; family: "SF Pro Display"; color: ink; opacity: if(app_last == fnd, 0, 1) * (1 - ch) }
        }
        //  The card over it (too wide beside it): it steps back, dimmed.
        box { from: x0, 0; size: pw, ph; color: #000000; opacity: 32% * arec }
    }

    //  The files: the pill grown into them (their app), or the card beside another app.
    let fin_card = panel == fnds and app != fnd
    let fx0 = if(fin_card, ex0, ax0)
    let fnd_w = if(fin_card, fnds_w, if(app_last == fnd, aw_t, 1120))
    //  ── the files: in the pill (their app), or in the card beside another app ──
    group {
        show: on_fnd > 0.002
        clip inset 1 box { from: if(fin_card, ck_x, x0), if(fin_card, ck_y, 0); size: if(fin_card, ck_w, pw), if(fin_card, ck_h, ph); corner: if(fin_card, ck_r, pr) continuous }
        group {
            opacity: if(fin_card, smooth(0.5, 1, ck_in), smooth(0.5, 1, agp))
            move: 0, if(fin_card, ck_y + 8 * (1 - ck_in), 8 * (1 - agp))
            FilesView(fx0, 32, fnd_w, 88 + 458 + 16 - 32, false, on_fnd > 0.5)
        }
    }

    //  The card's own zone beside an app: on it, then off it, closes it.
    zone box card_z { from: ck_x, ck_y; size: ck_w, ck_h; corner: 24 continuous; label: "Card"; active: app_on and expanded }
    group {
        clip inset 1 box { from: ck_x, ck_y; size: ck_w, ck_h; corner: ck_r continuous }
        //  Over the app, its glass melts into the app's: a backing so the app does not read through.
        box { from: ck_x, ck_y; size: ck_w, ck_h; corner: 24 continuous; color: deep; opacity: if(over, 92%, 0) * open }
        group {
            opacity: smooth(0.5, 1, ck_in) * (1 - 0.3 * cdim)
            move: 0, ck_y + 8 * (1 - ck_in)

            //  The header, one calm row: the apps' tray icons on the left (a click
            //  is the app's own, the right button opens its menu); the time on the
            //  right, and the notifications button beside it while some wait.
            text clock.time {
                at: exr - 20, 22; anchor: right center
                size: 13; weight: 600; family: "SF Pro Display"; color: ink; opacity: 1 - on_launch     // the search pill has only its field
            }
            let bell_w = 50
            let bell_x = exr - 20 - clockm.width - 12 - bell_w
            group {
            show: n_count > 0
            opacity: 1 - on_launch
            body {
                color: mix(mix(chip, chip_hi, bell_z.hover), lilac, 0.18 * (n_count > 0)); material: control; opacity: lgc_fill + 7% * bell_z.hover
                box { from: bell_x, 10; size: bell_w, 24; corner: 12 continuous }
            }
            image ic_bell { at: bell_x + 9, 15; size: 14, 14; tint: ink; opacity: 85% }
            text number(n_count, 0, "") { at: bell_x + 35, 22; anchor: center; size: 11.5; weight: 600; family: "SF Pro Display"; color: ink }
            }
            zone box bell_z { from: bell_x, 10; size: bell_w, 24; corner: 12 continuous; cursor: pointer; label: "Notifications"; active: expanded and n_count > 0 and panel != launch }
            //  Only on the home face: the other pages have their own business.
            prop tfan = 0 ~260ms
            group {
                opacity: smooth(0.5, 1, on_home)
                zone box tray_z { from: ex0 + 14, 7; size: 34 + max(0, trayi.count - 1) * 30, 30; corner: 15 continuous; label: "Background apps"; active: trayi.count > 0 and panel == home }
                group {
                    move: ex0 + 18, 9
                    for t in trayi { TrayIcon(t) }
                }
            }
            follow tfan = if(tray_z.hover or tmenu_open, 1, 0)

            //  The two Control Center pages, as iOS stacks them: a small column on
            //  the right edge says which one shows and switches; so does the wheel.
            zone box cc_z { from: ex0, 40; size: max(cwp, rest_w), max(0, ph - 40); label: "Control Center"; active: expanded and (panel == home or panel == ctl) }
            on press wx_z { emit wx_refresh }

            group {
            move: 0, hdr2
            //  ── the home face ──
            group {
                opacity: smooth(0.4, 1, on_home)
                move: -28 * max(0, 1 - on_home - on_ctl), -26 * on_ctl

                group {
                    move: ex0 + 16, row_tiles
                    Tile(net_title, wifi_label, if(eth_used, true, wifi_on), open_wifi, net_power, if(eth_used, 2, 0))
                    group {
                        move: 196, 0
                        Tile("Bluetooth", bt_label, bt_on, open_bt, bt_power, 1)
                    }
                }

                //  The widgets: the weather across with its next hours, the news under it. Each a pane of the card's
                //  own glass; the weather's sky only a wash in it.
                group {
                    move: ex0 + 16, row_wx

                    //  ── Weather: where, how warm, the sky, the day's high and low, the next hours ──
                    zone box wx_z { from: 0, 0; size: 380, 110; corner: 22 continuous; cursor: pointer; label: "Weather (click to refresh)"; active: expanded and panel == home }
                    prop wlift = 0 ~160ms
                    follow wlift = wx_z.hover - wx_z.pressed
                    body {
                        color: mix(chip, chip_hi, max(wlift, 0)); material: panel; opacity: lgc_fill + 7% * max(wlift, 0)
                        box { from: 0, 0; size: 380, 110; corner: 22 continuous }
                    }
                    prop sk0 = 1 ~600ms
                    prop sk1 = 0 ~600ms
                    prop sk2 = 0 ~600ms
                    prop sk3 = 0 ~600ms
                    follow sk0 = if(wx_sky == 0, 1, 0)
                    follow sk1 = if(wx_sky == 1, 1, 0)
                    follow sk2 = if(wx_sky == 2, 1, 0)
                    follow sk3 = if(wx_sky == 3, 1, 0)
                    body { gradient: 0, 0 to 380, 110, #5aa2ff, mix(#5aa2ff, lilac, 0.5); opacity: 26% * sk0; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    body { gradient: 0, 0 to 380, 110, #3a3f88, mix(#3a3f88, lilac, 0.35); opacity: 30% * sk1; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    body { gradient: 0, 0 to 380, 110, #8a97ab, #5d6880; opacity: 22% * sk2; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    body { gradient: 0, 0 to 380, 110, #56708f, #2f3d52; opacity: 28% * sk3; box { from: 0, 0; size: 380, 110; corner: 22 continuous } }
                    //  A clear day: the sun's warmth, softly, from its corner.
                    group {
                        opacity: sk0 * if(wx_ic == 0, 1, if(wx_ic == 2, 0.6, 0))
                        clip box { from: 0, 0; size: 380, 110; corner: 22 continuous }
                        repeat k in 0..5 { ellipse { at: 354, 22; radius: 16 + 11 * k; color: soft_s; opacity: 7% - k } }
                    }
                    //  One band: how warm, large, and beside it where and the sky in words;
                    //  on the right the sky's symbol over the day's high and low. An even
                    //  18 px inset at the sides, ~14 above and below, as iOS's widgets keep;
                    //  space, not a rule, between the band and the hours.
                    text wx_temp { at: 18, 31; anchor: left center; size: 32; weight: 300; family: "SF Pro Display"; color: ink; measure: wxtm }
                    let wtx = 18 + wxtm.width + 10
                    path { at: wtx, 17; color: ink; move 0, 3.8; line 8.6, 0; line 4.5, 8.6; line 3.8, 4.5; close }
                    text wx_city { at: wtx + 14, 21.5; anchor: left center; width: max(40, 326 - wtx - 14); lines: 1; size: 12.5; weight: 600; family: "SF Pro Display"; color: ink }
                    text wx_cond { at: wtx, 39; anchor: left center; width: max(40, 290 - wtx); lines: 1; size: 11.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: 72% }
                    group {
                        move: 342, 12
                        image wx_sun { at: 0, 0; size: 20, 20; show: wx_ic == 0 }
                        image wx_moon { at: 0, 0; size: 20, 20; show: wx_ic == 1 }
                        image wx_csun { at: 0, 0; size: 20, 20; show: wx_ic == 2 }
                        image wx_cmoon { at: 0, 0; size: 20, 20; show: wx_ic == 3 }
                        image wx_cloud { at: 0, 0; size: 20, 20; show: wx_ic == 4 }
                        image wx_rain { at: 0, 0; size: 20, 20; show: wx_ic == 5 }
                        image wx_snow { at: 0, 0; size: 20, 20; show: wx_ic == 6 }
                        image wx_storm { at: 0, 0; size: 20, 20; show: wx_ic == 7 }
                        image wx_fog { at: 0, 0; size: 20, 20; show: wx_ic == 8 }
                    }
                    text wx_hilo { at: 362, 39; anchor: right center; size: 11; weight: 600; family: "SF Pro Display"; color: tint_ink }
                    row {
                        at: 19, 56; gap: 0
                        for h in wxh { WxHour(h) }
                    }
                }

                // media: cover, track, transport
                group {
                    opacity: media_in
                    let cart_w = 48 * art_k
                    box { from: ex0 + 20, row_media; size: cart_w, 48; corner: 12 continuous; color: teal; opacity: if(has_art, 0, 22%) }
                    //  The art, its own shape (a square cover, a 16:9 frame), corners rounded.
                    group {
                        clip box { from: ex0 + 20, row_media; size: cart_w, 48; corner: 12 continuous }
                        image cover { at: ex0 + 20 + cart_w / 2 - 43, row_media; size: 86, 48; show: has_art }
                    }
                    box { from: ex0 + 20, row_media; size: cart_w, 48; corner: 12 continuous; stroke: 0.6; color: ink; opacity: 12%; show: has_art }
                    text media.title {
                        at: ex0 + 34 + cart_w, row_media + 14; anchor: left center; width: 328 - cart_w; lines: 1
                        size: 14.5; weight: 600; family: "SF Pro Display"; color: ink
                    }
                    text media.artist {
                        at: ex0 + 34 + cart_w, row_media + 35; anchor: left center; width: 328 - cart_w; lines: 1
                        size: 12.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: 62%
                    }

                    //  Where the song is. Dragged, it follows the pointer and the song
                    //  jumps on release; pulled past an end, it stretches a little.
                    group {
                        show: media.length > 0
                        let sk_h = 6 + 3 * cseek_z.hover + 3 * scrub_s          // thickens: hovered, then held
                        let sk_x = cl_l - stretch_l
                        let sk_w = cl_w + stretch_l + stretch_r
                        //  The groove, pressed into the glass.
                        box { from: sk_x, py - sk_h / 2; size: sk_w, sk_h; corner: sk_h / 2 continuous; color: well; opacity: 24% }
                        box { from: sk_x, py - sk_h / 2; size: sk_w, sk_h; corner: sk_h / 2 continuous; color: ink; opacity: 12% + 4% * cseek_z.hover }
                        //  What has played: bright glass.
                        group {
                            clip box { from: sk_x, py - sk_h / 2; size: sk_w, sk_h; corner: sk_h / 2 continuous }
                            body {
                                gradient: sk_x, py - sk_h / 2 to sk_x, py + sk_h / 2, #ffffff, mix(ink, pearl, 0.5)
                                opacity: 90% + 8% * scrub_s
                                box { from: sk_x - sk_h, py - sk_h / 2; size: max(0.01, sk_h + stretch_l + cl_w * cprog), sk_h; corner: sk_h / 2 continuous }
                            }
                        }
                        text "{cur, time}" { at: cl_l, py + 15; anchor: left center; size: 10.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 50% + 30% * max(cseek_z.hover, scrub_s) }
                        text "-{rem, time}" { at: cl_l + cl_w, py + 15; anchor: right center; size: 10.5; weight: 600; family: "SF Pro Display"; color: ink; opacity: 50% + 30% * max(cseek_z.hover, scrub_s) }
                        zone box cseek_z { from: cl_l - 6, py - 12; size: cl_w + 12, 24; cursor: pointer; label: "Seek"; active: has_player and expanded and media.length > 0 }
                    }

                    //  Transport: three beads of glass, the middle one larger.
                    body { color: mix(chip, chip_hi, prev_z.hover); material: control; opacity: lgc_fill + 7% * prev_z.hover
                           ellipse { at: tx - 46, ty; radius: 18 - 0.8 * prev_z.pressed } }
                    body { color: mix(chip_hi, #5a5a64, play_z.hover); material: control; opacity: lgc_fill + 7% * play_z.hover
                           ellipse { at: tx, ty; radius: 20 - 0.8 * play_z.pressed } }
                    body { color: mix(chip, chip_hi, next_z.hover); material: control; opacity: lgc_fill + 7% * next_z.hover
                           ellipse { at: tx + 46, ty; radius: 18 - 0.8 * next_z.pressed } }
                    box { at: tx - 53, ty; size: 2.6, 12; corner: 1.3 continuous; color: ink }
                    path { at: tx - 43, ty; color: ink; move 4.5, -6; line -5, 0; line 4.5, 6; close }
                    path { at: tx + 1.5, ty; color: ink; show: not media.playing; move -5, -7.5; line 7.5, 0; line -5, 7.5; close }
                    box { at: tx - 4, ty; size: 4, 14; corner: 2 continuous; color: ink; show: media.playing }
                    box { at: tx + 4, ty; size: 4, 14; corner: 2 continuous; color: ink; show: media.playing }
                    path { at: tx + 43, ty; color: ink; move -4.5, -6; line 5, 0; line -4.5, 6; close }
                    box { at: tx + 53, ty; size: 2.6, 12; corner: 1.3 continuous; color: ink }
                    zone ellipse prev_z { at: tx - 46, ty; radius: 18; cursor: pointer; label: "Previous"; active: has_player and expanded }
                    zone ellipse play_z { at: tx,      ty; radius: 20; cursor: pointer; label: "Play or pause"; active: has_player and expanded }
                    zone ellipse next_z { at: tx + 46, ty; radius: 18; cursor: pointer; label: "Next"; active: has_player and expanded }
                }

                //  The stats on the left, as one group: load and memory, then the two temperatures, and whatever
                //  is connected and has a battery (headphones, a mouse). The session on the right.
                group {
                    move: ex0 + 16, row_stats
                    row {
                        at: 6, 0; gap: if(bats.count >= 2, -7, 0)
                        StatRing(cpu / 100, "{cpu, 0}%", "CPU", cpu_i - 2)
                        StatRing(mem_frac, "{mem, 1}G", "MEMORY", mem_i - 2)
                        StatRing(cpu_t / 100, "{cpu_t, 0}°", "CPU TEMP", (cpu_t >= 85) + (cpu_t >= 95))
                        StatRing(max(gpu_t, 0) / 100, pick(gpu_t >= 0, "Off", "{gpu_t, 0}°"), "GPU TEMP", (gpu_t >= 78) + (gpu_t >= 87))
                        for b in bats { StatRing(b.pct / 100, "{b.pct, 0}%", b.name, 2 * (b.pct <= 20)) }
                    }

                    //  Switch compositor, log out, restart, power off: beads like the media buttons. They
                    //  cannot be undone, so they act on a hold: a red ring fills round
                    //  the button while it is held, and drains away if let go early.
                    //  Their right edge is the pills'.
                    let bead = cdw - 168
                    prop hold_sw = 0 ~700ms
                    prop hold_out = 0 ~700ms
                    prop hold_re = 0 ~700ms
                    prop hold_off = 0 ~700ms
                    follow hold_sw = sw_z.pressed
                    follow hold_out = out_z.pressed
                    follow hold_re = re_z.pressed
                    follow hold_off = off_z.pressed
                    body {
                        color: mix(chip, chip_hi, sw_z.hover); material: control; opacity: lgc_fill + 7% * sw_z.hover
                        ellipse { at: bead, 24; radius: 16 - 0.6 * sw_z.pressed }
                    }
                    arc { at: bead, 24; radius: 19.5; span: hold_sw * 360deg; rotate: hold_sw * 180deg; width: 2; color: coral; opacity: if(hold_sw > 0.02, 90%, 0%) }
                    body {
                        color: mix(chip, chip_hi, out_z.hover); material: control; opacity: lgc_fill + 7% * out_z.hover
                        ellipse { at: bead + 40, 24; radius: 16 - 0.6 * out_z.pressed }
                    }
                    arc { at: bead + 40, 24; radius: 19.5; span: hold_out * 360deg; rotate: hold_out * 180deg; width: 2; color: coral; opacity: if(hold_out > 0.02, 90%, 0%) }
                    body {
                        color: mix(chip, chip_hi, re_z.hover); material: control; opacity: lgc_fill + 7% * re_z.hover
                        ellipse { at: bead + 80, 24; radius: 16 - 0.6 * re_z.pressed }
                    }
                    arc { at: bead + 80, 24; radius: 19.5; span: hold_re * 360deg; rotate: hold_re * 180deg; width: 2; color: coral; opacity: if(hold_re > 0.02, 90%, 0%) }
                    body {
                        color: mix(chip, chip_hi, off_z.hover); material: control; opacity: lgc_fill + 7% * off_z.hover
                        ellipse { at: bead + 120, 24; radius: 16 - 0.6 * off_z.pressed }
                    }
                    arc { at: bead + 120, 24; radius: 19.5; span: hold_off * 360deg; rotate: hold_off * 180deg; width: 2; color: coral; opacity: if(hold_off > 0.02, 90%, 0%) }
                    //  Their symbols: SVGs with round caps and joins, as Apple draws them.
                    image cc_switch { at: bead - 9, 15; size: 18, 18; tint: ink; opacity: 88% }
                    image ic_out { at: bead + 31, 15; size: 18, 18; tint: ink; opacity: 88% }
                    image ic_re { at: bead + 71, 15; size: 18, 18; tint: ink; opacity: 88% }
                    image ic_off { at: bead + 111, 15; size: 18, 18; tint: ink; opacity: 88% }
                    zone ellipse sw_z { at: bead, 24; radius: 16; cursor: pointer; label: "Switch compositor (hold)"; active: expanded }
                    zone ellipse out_z { at: bead + 40, 24; radius: 16; cursor: pointer; label: "Log out (hold)"; active: expanded }
                    zone ellipse re_z { at: bead + 80, 24; radius: 16; cursor: pointer; label: "Restart (hold)"; active: expanded }
                    zone ellipse off_z { at: bead + 120, 24; radius: 16; cursor: pointer; label: "Power off (hold)"; active: expanded }
                }
            }

            //  ── the pages ──
            include "pages/wifi.plm"
            include "pages/bluetooth.plm"
            include "pages/launcher.plm"
            include "pages/projects.plm"
            include "pages/notes.plm"
            include "pages/undo.plm"
            //  (The Controls are the date capsule's card's now: pages/calendar.plm.)
            include "pages/timer.plm"
            include "pages/camera.plm"
            include "pages/awake.plm"
            include "pages/wall.plm"
            include "pages/capture.plm"
            include "pages/mixer.plm"
            include "pages/glasstune.plm"
            include "pages/auth.plm"
            include "pages/storage.plm"
            include "pages/activity.plm"
            }
        }
    }

    // A controlled glide with a small velocity-driven deformation.
    // No overshoot, vertical hop, or brightness pulse; circular at rest.
    // Slot coordinates keep sparse workspace IDs beside their actual labels.
    //  The workspaces, as a page control: the one you are on is a capsule of
    //  the pearl glass the switches use, with its number; the others are dots,
    //  which turn back into numbers while the pointer is on the rail.
    prop rh = 0 ~220ms
    follow rh = ws_z.hover
    let ws_s = 14 + 8 * rh            // a slot: a dot, or a number while hovered
    let ws_a = ws_s + 24              // the slot of the one you are on
    prop ws_position = 0 ~280ms
    follow ws_position = ws_slot
    prop ws_squash = 0 ~120ms
    follow ws_squash = clamp(abs(vel(ws_position)) / 14, 0, 1)
    let bubble = clamp(ws_squash, 0, 1)
    //  Slid aside for a tool beside it, a large view can reach the left of the bar: then the rail
    //  rides in its top-left corner, over it, instead of being covered.
    let card_l_t = screen.width / 2 - nudge_t - aw_t / 2
    prop ws_in = 0 ~shape
    follow ws_in = if(app != none and card_l_t < 23 + rail_w + 70, 1, 0)
    let lx = 23 + x0 * ws_in      // its capsule (drawn 1 px in) 24 from the edge, like the date capsule on the right (cap_r)
    let sel_cx = lx + ws_position * ws_s + ws_a / 2
    let wdy = 7 * max(wo, ws_in)      // open (or in a large view's corner), the rail sits inside the card, not on its edge
    let sel_cy = 17 + wdy
    let sel_w = ws_a - 2 + 10 * bubble    // it stretches as it glides
    let sel_h = 28 - 2 * bubble       // as tall as the battery and date capsule
    //  Hovering the one you are on: a card grows out from under it, in the
    //  dark glass the other cards use, with every window as a live picture.
    //  The rail stays on top as its header. Alt+Tab opens it too.
    prop wo = 0 ~280ms
    follow wo = if(wv, 1, 0)
    let wl = 18 + (lx - 23)                       // the card's left edge, once open
    let wv_w = 524
    let wn_h = max(1, ceil(wins.count / 3)) * 144 - 12
    let wv_th = 62 + if(wins.count == 0, 40, wn_h) + 18 - 3
    prop wv_hh = 200 ~shape
    follow wv_hh = wv_th
    let wcl = mix(sel_cx - sel_w / 2, wl, wo)
    let wcr = mix(sel_cx + sel_w / 2, wl + wv_w, wo)
    let wct = mix(sel_cy - sel_h / 2, 3, wo)
    let wch = mix(sel_h, wv_hh, wo)
    group {
        show: wo > 0.01
        body {
            gradient: wcl, wct to wcr, wct + wch, mix(mix(pearl, lilac, 0.3), dusk, wo), mix(mix(pearl, sunset, 0.3), deep, wo)
            glass: 100%; ripple: 0%; rim: 0%; milk: glass_milk * (1 - wo) + lg_card_milk * wo
            blur: lg_frost + (lg_card_frost - lg_frost) * wo; refraction: lg_refraction + (lg_card_refraction - lg_refraction) * wo; bevel: lg_bevel + (lg_card_bevel - lg_bevel) * wo; dispersion: lg_dispersion; specular: lg_specular; magnify: lg_magnify * (1 - wo); glass_tint: lg_glass_tint; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_l
            smoke: card_smoke * wo
            opacity: lg_tint + (card_alpha - lg_tint) * wo
            light: 1%, wct, 10
            shadow: 0, 1.5 + 6.5 * wo, 6 + 16 * wo, 18% - 2% * wo
            box { from: wcl, wct; size: wcr - wcl, wch; corner: 14 + 8 * wo continuous }
        }
        body {
            color: rim_grey
            opacity: lg_card_rim * wo
            box { from: wcl + 0.5, wct + 0.5; size: wcr - wcl - 1, wch - 1; corner: 13.5 + 8 * wo continuous; stroke: 1 }
        }
    }
    //  Its zone is its whole target shape, so moving down into it keeps it open.
    zone box wv_z { from: wl, 3; size: wv_w, wv_th; corner: 22 continuous; label: "Windows"; active: wv }
    //  Over a fullscreen window a page comes alone: not the rail, not the date capsule.
    let rail_here = not fs_under or wo > 0.002
    zone box wsel_z { at: sel_cx, sel_cy; size: sel_w, sel_h; corner: sel_h / 2 continuous; label: "Windows on this desktop"; active: rail_here }
    on enter wsel_z while not wv { wv = true; emit win_look(0) }
    on leave wv_z while wv and not switching { wv = false }

    zone box ws_z { from: lx - 4, 4 + wdy; size: rail_w + 8, 26; label: "Workspaces"; active: rail_here }
    let kr = k_rail * (1 - wo)
    group {
        show: rail_here
        pivot: lx + rail_w / 2, sel_cy
        scale: 1 - 0.14 * kr
    //  Clear glass, as the island is: the compositor frosts what is behind it,
    //  a faint pearl tint, its lit edge, and the island's prism for a rim.
    body {
        gradient: sel_cx - sel_w / 2, 6 to sel_cx + sel_w / 2, 28, mix(pearl, lilac, 0.3), mix(pearl, sunset, 0.3)
        glass: 100%; ripple: 0%; rim: 0%; milk: glass_milk + 2% * max(0, kr)
        blur: lg_frost; refraction: lg_refraction; bevel: lg_bevel; dispersion: lg_dispersion; specular: lg_specular; magnify: lg_magnify; glass_tint: lg_glass_tint; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_l
        smoke: 5% * max(0, kr)
        opacity: lg_tint
        light: 1%, 6, 10
        shadow: 0, 1.5, 6, 18%
        box { at: sel_cx, sel_cy; size: sel_w, sel_h; corner: sel_h / 2 continuous }
    }
    body {
        gradient: sel_cx - sel_w / 2, 0 to sel_cx + sel_w / 2, 0, cool, ink 50%, warm
        opacity: lg_prism
        box { at: sel_cx, sel_cy; size: sel_w - 1, sel_h - 1; corner: (sel_h - 1) / 2 continuous; stroke: 1 }
    }

    // The same rail stays visible through the entire morph, without a crossfade.
    component Desk(i, active: number) {
        size: 14 + 8 * rh + 24 * (active == i), 26
        prop on = 0 ~280ms
        follow on = if(active == i, 1, 0)
        let w = 14 + 8 * rh + 24 * on
        //  On niri the number rolls in from where the windows come from, and the
        //  one left rolls out the other way, as it fades back into a dot.
        let roll = if(ws_vertical, ws_dir * 6 * (1 - on) * if(active == i, 1, 0 - smooth(0, 0.4, on)), 0)
        zone box d { from: 0, 0; size: w, 26; corner: 13 continuous; cursor: pointer; label: "Workspace {if(i == 10, 0, i)}"; selected: active == i }
        //  Under the pointer (not the one you are on): a faint pill.
        box { from: 1, 3; size: w - 2, 20; corner: 10 continuous; color: ink_l; opacity: (10% * d.hover + 10% * d.pressed) * (1 - on) }
        ellipse { at: w / 2, 13; radius: 2.6 + 0.4 * d.hover; color: ink_l; opacity: (50% + 30% * d.hover) * (1 - max(on, rh)) }
        text "{if(i == 10, 0, i)}" {
            at: w / 2, 13 - 0.5 * d.pressed + roll; anchor: center; size: 12; weight: 600 + 100 * on; family: "SF Pro Display"
            color: ink_l; opacity: max(on, 75% * rh); shadow: 0, 1, 3, 35% * (1 - gl_ls)
        }
        on press d { emit go(i) }
    }
    row desks ~calm {
        at: lx, 4 + wdy
        repeat i in 1..15 { Desk(i, ws_active) { show: ws.$i.there or ws_active == i } }
    }

    //  The app you are in, right after the workspaces: its icon, as waybar
    //  showed it. A new app crossfades in, as iOS swaps a glyph: the old one
    //  softens and shrinks a touch as the new one settles in, critically
    //  damped, no bounce. Hovering it, the app's name slides out beside it,
    //  on the bar itself (no capsule), as the clock sits.
    let fx = lx + (14 + 8 * rh) * rail_ws + 24 + 8
    prop fab = 0 ~260ms
    follow fab = if(front_on_b, 1, 0)
    prop fh = 0 ~240ms
    follow fh = front_z.hover
    let fcap_w = 30 + (frm.width + 10) * fh
    group {
        opacity: (1 - smooth(0, 0.4, wo)) * if(front_has, 1, 0)
        group {
            pivot: fx + 9, 17
            scale: 0.9 + 0.1 * (1 - fab)
            opacity: smooth(0.15, 1, 1 - fab)
            blur: 2.5 * fab
            image front_ia { at: fx, 8; size: 18, 18 }
        }
        group {
            pivot: fx + 9, 17
            scale: 0.9 + 0.1 * fab
            opacity: smooth(0.15, 1, fab)
            blur: 2.5 * (1 - fab)
            image front_ib { at: fx, 8; size: 18, 18 }
        }
        group {
            clip box { from: fx + 20, 3; size: max(0, fcap_w - 26), 28 }
            text front_name {
                at: fx + 26 - 6 * (1 - fh), 17; anchor: left center; size: 12.5; weight: 600; family: "SF Pro Display"
                color: ink_l; opacity: fh; shadow: 0, 1, 3, 35% * (1 - gl_ls); measure: frm
            }
        }
    }
    zone box front_z { from: fx - 6, 3; size: fcap_w, 28; corner: 14 continuous; label: "{front_name}"; active: front_has and not wv }
    }

    include "pages/windows.plm"

    //  Hovering the battery: the capsule widens to the left with how long is
    //  left (or until full). Hovering the date: it drops into a calendar card.
    fact bat_peek = false
    fact bat_has = false      // the logic has an estimate to show
    text bat_tip = ""
    event bat_look ->
    measure tipm
    prop bh = 0 ~300ms
    follow bh = if((bat_peek or peek_held) and bat_has, 1, 0)     // hovered, or AltGr held
    let tip_w = (tipm.width + 12) * bh
    fact cal = false
    fact cal_weeks = 5
    fact cal_here = true      // the month shown is this one
    text cal_month = ""
    text cal_year = ""
    model cdays max 42 { d: text; inm: bool; today: bool; ev: bool }
    model upn max 3 { title: text; time: text; when: text; first: bool }
    text upn_empty = "Loading…"
    event cal_step ->
    event cal_look ->
    prop co = 0 ~280ms        // 0 the capsule → 1 the card it grows into (the calendar, or a tool beside a large view)
    follow co = if(cal or side or shf_on, 1, 0)
    //  The shelf (pages/shelf.plm): something dragged over the capsule makes it grow into a card
    //  that holds it; hovering the stack it leaves at the capsule's end opens it again.
    model shf max 12 { name: text; ic: image 96, 96; ar: number; path: text }
    text shf_all = ""          // every path held, one a line (dragged out all at once)
    text shf_top_path = ""     // the newest one's picture, for the stack on the capsule
    text shf_add = ""          // from outside: `lumen --say island "text shf_add PATH"` puts it on the shelf
    image shf_top = from shf_top_path, 36, 36
    fact shf_peek = false      // open to look (the stack hovered, or something just landed)
    fact shf_last = false      // the capsule's card was last the shelf (not the calendar): its size while it shrinks
    event shf_clear ->
    event shf_remove ->
    event shf_open_item ->
    let shf_w = 316
    fact cap_over = false      // the pointer over the capsule, and over the shelf's card (set where their zones are)
    fact shf_over = false
    let shf_hot = drag.over > 0.5 and (cap_over or shf_over)
    let shf_on = shf_hot or shf_peek
    let shf_th = 82 + max(1, floor((shf.count + 3) / 4)) * 92 + 6
    prop shf_hh = 180 ~shape
    follow shf_hh = shf_th
    on change shf_on while shf_on { shf_last = true; cal = false }
    on change cal while cal { shf_last = false; shf_peek = false }
    let cal_w = 316
    let upn_h = 32 + max(1, upn.count) * 42 + if(upn.count == 0, 14, 0) + 4   // the Up next module under the month
    let cal_th = 42 + (60 + cal_weeks * 34 + 6) + 6 - cap_y      // its height once open: the month
    let cal_gap = 20                       // between the islands under it: more than the glass's melting distance
    let cal_all = cal_th + cap_y + cal_gap + upn_h     // all of it, Up Next under it too
    prop cal_hh = 260 ~shape
    follow cal_hh = cal_th

    let shf_cw = 26 * shf_cs * (1 - co)       // the shelf's stack at the left end, while it holds something
    let cap_w = 16 + shf_cw + tip_w + dnd_w + mute_w + bat_gw + 12 + 1 + 12 + datem.width + 16
    let cap_l = cap_r - cap_w
    //  In the calendar the date is the card's: it fades, and the battery slides into its place.
    let cshift = (25 + datem.width) * co
    let bx = cap_l + 16 + shf_cw + tip_w + dnd_w + mute_w + cshift
    let mx = cap_l + 16 + shf_cw + tip_w + dnd_w + 7 + cshift     // the muted glyph's centre
    //  The capsule's drawn shape: the capsule, or the card it grows into.
    //  The other way round (the files fill the centre, then WhatsApp or the mail opens): the files'
    //  card itself slides right into this place (`inv` 1 → 0) instead of growing out of the capsule.
    prop inv = 0 ~shape
    let fl0 = screen.width / 2 - 560        // where the files' card was, in the centre
    //  The pill busy (its card open, an app up): the capsule grows into the level gauge or into a
    //  notification, as it grows into the calendar, and back. The gauge stays clear glass, a pill;
    //  a notification is a card of the dark glass.
    //  Whatever the pill would say, in the same order of importance: the middle taken never stops it.
    fact chk = 1                            // 1 the gauge, 2 a notification, 3 a copy, 4 a device, 5 idle, 6 a colour, 7 a desktop (kept while it shrinks back)
    let cap_hud = pill_busy and not fs and not cal and cap_want > 0
    on change cap_want while cap_want > 0 { chk = cap_want }
    prop ch = 0 ~shape
    follow ch = if(cap_hud, 1, 0)
    let cap_card = chk == 2 or (chk == 3 and cp_kind == 1)   // a notification or a copied picture: a card of the dark glass
    let cm = max(max(co, inv), if(cap_card, ch, 0))   // how much of a card it is: its glass, its corners
    let cg = max(co, if(inv > 0.002, 1, 0))   // sliding in, it is already its whole size: only where it is changes
    let ccw0 = cap_w + (if(ch > co, hud_w, if(side_k > 0, side_w, if(shf_last, max(shf_w, cap_w), max(cal_w, cap_w)))) - cap_w) * max(cg, ch)
    let cch0 = cap_h + (if(ch > co, hud_h, if(side_k > 0, side_h, if(shf_last, shf_hh, cal_hh))) - cap_h) * max(cg, ch)
    let ccw = ccw0 + (1120 - ccw0) * inv
    let cch = cch0 + (88 + 458 + 16 - cch0) * inv
    let ccl = cap_r - ccw0 + (fl0 - (cap_r - ccw0)) * inv
    let ccr = if(not cap_card and ch > co, cch0 / 2, 14 + 8 * cm)
    //  Plugged in: a sweep of light across the fill, and the rim warms to green.
    prop plug_sweep = 1 ~900ms
    prop plug_glow = 0 ~500ms
    on change battery.charging while battery.charging { plug_sweep: 0 ~1ms; plug_sweep: 1 after 180ms; plug_glow: 1 ~150ms; plug_glow: 0 after 900ms; impulse jolt 5 }
    //  Unplugged: the light runs back out the other way, the rim cools for a
    //  moment, and the battery gives a small settling dip.
    prop unplug_sweep = 1 ~800ms
    prop unplug_glow = 0 ~500ms
    on change battery.charging while not battery.charging { unplug_sweep: 0 ~1ms; unplug_sweep: 1 after 30ms; unplug_glow: 1 ~150ms; unplug_glow: 0 after 600ms; impulse jolt -4 }
    prop jolt = 0 ~band
    //  Low battery: the rim glows coral twice, as iOS warns, while the pill says so.
    prop low_glow = 0 ~260ms
    on change low_seq { low_glow: 1 ~200ms; low_glow: 0.15 after 450ms; low_glow: 1 after 800ms; low_glow: 0 ~700ms after 1500ms }
    //  Muting: the rim brightens for a moment, as it does for the charger.
    prop mute_glow = 0 ~400ms
    on change audio.muted while audio.muted { mute_glow: 1 ~140ms; mute_glow: 0 after 380ms }
    prop cap_hov = 0 ~180ms
    follow cap_hov = stat_z.hover
    let kc = k_cap * (1 - cm)
    let cap_here = not fs_under or max(cm, ch) > 0.002      // its cards still grow out of it
    group {
        show: cap_here
        pivot: cap_r, cap_y + cap_h / 2
        scale: 1 - 0.05 * kc, 1 - 0.07 * kc
    //  Grown into the calendar it smokes over into the centre card's dark plum
    //  glass, with its grey rim, so the days read over busy windows.
    body {
        gradient: ccl, cap_y to ccl + ccw, cap_y + cch, mix(mix(pearl, lilac, 0.3), dusk, cm), mix(mix(pearl, sunset, 0.3), deep, cm)
        //  Refraction and frost come directly from the compositor backdrop.
        glass: 100%; ripple: 0%; rim: 0%; milk: (glass_milk + 1% * cap_hov) * (1 - cm) + lg_card_milk * cm + 2% * max(0, kc)
        blur: lg_frost + (lg_card_frost - lg_frost) * cm; refraction: lg_refraction + (lg_card_refraction - lg_refraction) * cm; bevel: lg_bevel + (lg_card_bevel - lg_bevel) * cm; dispersion: lg_dispersion; specular: lg_specular; magnify: lg_magnify * (1 - cm); glass_tint: lg_glass_tint; rim_tint: lg_rim_tint; merge: lg_merge; adapt: gl_r
        smoke: card_smoke * cm + 5% * max(0, kc)
        opacity: lg_tint + (card_alpha - lg_tint) * cm
        light: 1%, cap_y, 10
        shadow: 0, 1.5 + 6.5 * cm, 6 + 16 * cm, 18% - 2% * cm
        box { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous }
    }
    body {
        gradient: ccl, 0 to cap_r, 0, mix(mix(mix(cool, charge, plug_glow), ink, unplug_glow), coral, low_glow), mix(ink, coral, low_glow) 50%, mix(mix(mix(warm, charge, plug_glow), ink, unplug_glow), coral, low_glow)
        opacity: (lg_prism + 18% * plug_glow + 12% * unplug_glow + 16% * mute_glow + 30% * low_glow) * (1 - cm)
        box { from: ccl + 0.5, cap_y + 0.5; size: ccw - 1, cch - 1; corner: ccr - 0.5 continuous; stroke: 1 }
    }
    body {
        color: rim_grey
        opacity: lg_card_rim * cm
        box { from: ccl + 0.5, cap_y + 0.5; size: ccw - 1, cch - 1; corner: ccr - 0.5 continuous; stroke: 1 }
    }
    //  The battery's estimate, sliding out of the capsule's left end.
    group {
        opacity: smooth(0.35, 1, bh)
        move: 6 * (1 - bh), 0
        clip box { from: cap_l + 2, cap_y; size: max(0, cap_w - 4), cap_h; corner: cap_h / 2 continuous }
        text bat_tip {
            at: cap_l + 16 + shf_cw + cshift, 17; anchor: left center; size: 12.5; weight: 600; family: "SF Pro Display"
            color: ink_r; shadow: 0, 1, 3, 35% * (1 - gl_rs); measure: tipm
        }
    }
    //  What is listening or watching: iOS's dots (green the camera, orange the
    //  microphone, violet the screen), on the bar just left of the capsule,
    //  following its edge as it widens.
    let pdots = camv + micv + scrv
    let dots_l = ccl - 9 - (11 * pdots - 5 * min(pdots, 1))
    group {
        opacity: 1 - smooth(0, 0.4, co)
        ellipse { at: dots_l + 3 * camv, 17; radius: 3 * camv; color: #30d158 }
        ellipse { at: dots_l + 11 * camv + 3 * micv, 17; radius: 3 * micv; color: #ff9f0a }
        ellipse { at: dots_l + 11 * (camv + micv) + 3 * scrv, 17; radius: 3 * scrv; color: #bf5af2 }
    }
    group {
    opacity: 1 - smooth(0, 0.5, ch)
    //  Notifications muted: a small moon first.
    image ic_moon { at: cap_l + 15 + shf_cw + tip_w + cshift, 11; size: 12, 12; tint: ink_r; opacity: 90% * dnd_s }
    //  Sound muted: the speaker grows out of a blur as the capsule makes room,
    //  then a slash draws across, cutting its gap, and the speaker gives a
    //  small flinch as it goes through. Still once it has settled.
    //  It is a button too: a click unmutes. Under the pointer, a pill lights behind it.
    prop mute_hov = 0 ~180ms
    follow mute_hov = mute_z.hover
    box { from: mx - 12, cap_y + 3; size: 24, cap_h - 6; corner: (cap_h - 6) / 2 continuous; color: ink_r; opacity: (12% * mute_hov + 8% * mute_z.pressed) * mut }
    group {
        opacity: smooth(0.15, 0.55, mut)
        pivot: mx, 17
        scale: 0.5 + 0.5 * smooth(0.1, 0.7, mut) - 0.09 * sin(slash * 3.14159) - 0.08 * mute_z.pressed
        blur: 4 * (1 - smooth(0.1, 0.65, mut))
        clip box { from: cap_l + 2, cap_y; size: max(0, cap_w - 4), cap_h; corner: cap_h / 2 continuous }
        image ic_mute { at: mx - 8, 9; size: 16, 16; tint: ink_r; opacity: 92% * (1 - smooth(0, 0.3, slash)) }
        image ic_mute_cut { at: mx - 8, 9; size: 16, 16; tint: ink_r; opacity: 92% * smooth(0, 0.3, slash) }
        group {
            pivot: mx, 17
            rotate: -45deg
            //  A rounded bar growing from its top end: the round caps of SF's slash.
            box { from: mx - 0.8, 17 - 8.5; size: 1.6, max(0.01, 17 * slash); corner: 0.8 continuous; color: ink_r; opacity: 95% * min(1, slash * 6) }
        }
    }
    group {
        move: bx, 0
        pivot: 14, 17
        scale: 1 + 0.45 * jolt
        //  The battery as iOS draws it with its percentage: a light track that
        //  fills up, and the number inside it in dark, readable at any level.
        box { from: 0, 10.5; size: 26, 13; corner: 4.2 continuous; color: ink_r; opacity: 38% }
        box { from: 26.8, 14.8; size: 1.8, 4.4; corner: 0.9 continuous; color: ink_r; opacity: 40% }
        group {
            clip box { from: 0, 10.5; size: 26, 13; corner: 4.2 continuous }
            //  The charge is a liquid: its surface (the fill's edge) tilts and
            //  bulges with the slosh, row by row; at rest, a straight edge.
            repeat j in 0..13 {
                box {
                    //  (each a touch taller than its step, so no seam shows where they meet)
                    from: 0, 10.5 + j; size: max(0.1, 26 * bat_s + 3 * clamp(slosh, -1.2, 1.2) * (j - 6) / 6 + 1.6 * clamp(slosh2, -1, 1) * sin(j * 15)), if(j == 12, 1, 1.6)
                    color: mix(pick(bat_nc, ink, amber, coral), mix(charge, pearl, 0.3), chg)
                }
            }
            box { at: 34 * plug_sweep - 4, 17; size: 6, 15; corner: 3 continuous; color: #ffffff; opacity: 70% * (1 - plug_sweep) }
            box { at: 30 - 34 * unplug_sweep, 17; size: 6, 15; corner: 3 continuous; color: #ffffff; opacity: 45% * (1 - unplug_sweep) }
        }
        //  Its digits roll as the clock's do: up as it fills, down as it drains.
        text number(battery.percent, 0, "") {
            at: 13, 17.2; anchor: center; size: 10; weight: 700; family: "SF Pro Display"
            color: pearl_ink
            letter_move: 0, 4 * bat_dir * (1 - bat_in) * if(letter >= bat_from, 1, 0)
            letter_opacity: if(letter >= bat_from, bat_in, 1)
        }
        //  The plug: out of a blur, revealed top to bottom like a strike, with a
        //  little kick as it lands. Unplugged, all of it runs backwards.
        group {
            opacity: smooth(0.2, 0.5, chg)
            pivot: 37, 17
            scale: 0.6 + 0.4 * smooth(0.15, 0.8, chg) + 0.9 * jolt
            blur: 3 * (1 - smooth(0.2, 0.75, chg))
            clip box { from: 29, 9.5; size: 17, 15 * strike }
            image ic_plug { at: 30.5, 10.5; size: 13, 13; tint: ink_r }
        }
        box { from: bat_gw + 12, 10; size: 1, 14; corner: 0.5 continuous; color: ink_r; opacity: 28% * (1 - smooth(0, 0.4, co)) }
    }
    text clock.date {
        at: cap_r - 16, 17; anchor: right center; size: 13; weight: 600; family: "SF Pro Display"
        color: ink_r; shadow: 0, 1, 3, 35% * (1 - gl_rs); measure: datem
        opacity: 1 - smooth(0, 0.4, co)
    }
    }
    //  …what it has grown into: the gauge, or the notification (its words in once it has the room).
    group {
        show: ch > 0.002
        clip inset 1 box { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous }
        group {
            show: chk == 1
            move: ccl, cap_y
            Gauge(340, 34, ch, gl_rs)
        }
        group {
            show: chk == 2
            //  A glass body's fill is drawn under everything lumen draws: if an app's card reaches under
            //  the capsule (it is nudged aside to leave the banner its room, so only while it slides), this
            //  plain one, the card's own dark, keeps it from reading through. Otherwise the banner is the
            //  capsule's glass, as the calendar and the pill's banners are (it used to be this solid dark
            //  whenever an app was up: not glass at all).
            body {
                gradient: ccl, cap_y to ccl + ccw, cap_y + cch, dusk, deep
                opacity: 94% * smooth(0, 0.6, ch) * if(app != none and axr > ccl + 2, 1, 0)
                box { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous }
            }
            group {
                move: ccl, cap_y
                NoteCard(ch, gl_rs, nswap, 0, cb_hit.hover, cb_x.hover, cb_x.pressed)
            }
        }
        //  …or what the pill would have said: a copy, a device, idle, a colour, a desktop.
        group {
            opacity: smooth(0.45, 1, ch)
            move: ccl, cap_y + 2 * (1 - ch)
            group { show: chk == 3; CopyState(ccw, gl_rs) }
            group { show: chk == 4; DeviceState(ccw, gl_rs) }
            group { show: chk == 5; IdleState(ccw, gl_rs) }
            group { show: chk == 6; PickState(ccw, gl_rs) }
            group { show: chk == 7; LandState(ccw, ch, gl_rs) }
        }
    }
    }
    zone box cb_hit { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous; cursor: pointer; label: "Notification"; active: chk == 2 and ch > 0.9 }
    zone ellipse cb_x { at: ccl + 360, cap_y + 23; radius: 12; cursor: pointer; label: "Dismiss"; active: chk == 2 and ch > 0.9 }
    on release cb_hit while banner and drag.dy < -28 { banner = false }
    on release cb_hit while banner and abs(drag.dy) < 6 and abs(drag.dx) < 6 { emit note_open }
    on press cb_x { emit note_dismiss }
    //  Only a hover: it brightens, but a click is not for it (the card is the centre pill's).
    zone box stat_z { from: cap_l, cap_y; size: cap_w, cap_h; corner: cap_h / 2 continuous; label: "Battery and date"; active: cap_here }
    include "pages/calendar.plm"
    include "pages/shelf.plm"
    on leave stat_z { cap_over = false }
    on enter stat_z { cap_over = true }
    zone box bat_z { from: cap_l, cap_y; size: bx + bat_gw + 6 - cap_l, cap_h; corner: cap_h / 2 continuous; label: "Battery"; active: cap_here }
    zone box date_z { from: bx + bat_gw + 6, cap_y; size: max(0, cap_r - bx - bat_gw - 6), cap_h; corner: cap_h / 2 continuous; label: "Date"; active: cap_here and not cal and not side }
    on enter bat_z { bat_peek = true; emit bat_look }
    on leave bat_z { bat_peek = false }
    every 15s while bat_peek or peek_held { emit bat_look }
    on peek(v) while v > 0 and not peek_held { emit bat_look }
    on enter date_z while drag.over < 0.5 { cal = true; side_k = 0 }
    on change cal while cal { emit cal_look; side_k = 0 }
    //  After the capsule's zone, so the click lands here.
    zone box mute_z { from: mx - 12, cap_y + 3; size: 24, cap_h - 6; corner: (cap_h - 6) / 2 continuous; cursor: pointer; label: "Unmute"; active: cap_here and audio.muted and mut > 0.6 }
    on press mute_z { emit osd_mute }

    //  ── a tool beside a large view ──
    //  While WhatsApp, the mail or the files fill the centre, the clipboard (Super+C) and the
    //  emoji (Super+E) open from the right capsule instead: it grows down into their card, over
    //  the view, which stays as it was. The same pages as in the centre card, drawn here or there.
    let tool_side = side_k > 0 and big
    prop cdim = 0 ~200ms          // …and the view, while the tool has them
    follow cdim = if(side and side_focus and big, 1, 0)
    prop sdim = 0 ~200ms          // the tool beside the view without the keys (Ctrl+h): a little dimmer
    follow sdim = if(side and not side_focus, 1, 0)
    let side_keys = side and side_focus                                      // the tool beside the view has the keys, not the view
    let clip_keys = expanded and (panel == clip or (side_keys and side_k == 1))   // whose keys: the clipboard's, wherever it shows
    let stor_keys = expanded and panel == stor
    let act_keys = expanded and panel == act
    let emo_keys = expanded and (panel == emoji or (side_keys and side_k == 2))
    let fnd_card = expanded and panel == fnds and app != fnd          // the files beside an app
    let fnd_keys = (app == fnd and not expanded) or fnd_card or (fnd_win and app == none and not expanded)
    let clx = ex0                                             // where the pages start
    let emx0 = ex0
    let emy = 0
    let clip_wide = not beside_fits                           // the clipboard's preview: not beside an app (no room)
    let clip_lh = 366                                         // its list: eight rows
    group {
        clip inset 1 box { from: ck_x, ck_y; size: ck_w, ck_h; corner: ck_r continuous }
        group {
            opacity: smooth(0.5, 1, ck_in)
            move: 0, ck_y + 8 * (1 - ck_in) + hdr2
            //  The card itself takes the pointer: nothing of the view under it is touched through it.
            zone box side_z { from: ccl, cap_y; size: ccw, cch; corner: ccr continuous; label: "Beside the view"; active: side }
            include "pages/clipboard.plm"
            include "pages/emoji.plm"
        }
    }
    // ── the stage: the app's own card, under the bar ───────────────
    //  WhatsApp, the mail and the files are apps: each in a card of its own on a surface of its own,
    //  put on the monitor before the bar's (`beneath`), so the compositor stacks it under it. The
    //  pill rests in its top edge; hovered, its card drops over the app as over the desktop, its
    //  glass on the app's, and the app steps back a little, dimmed, until the card goes. The app
    //  keeps the keys whenever the card is closed.

    //  Its menu: a small glass card dropping from its tray icon, over the open card.
    prop tm = 0 ~240ms
    follow tm = if(tmenu_open, 1, 0)
    let tm_w = 240
    let tm_h = 12 + tm_rows_h
    let tm_x = min(ex0 + 18 + 30 * tm_slot - 8, exr - tm_w - 12)
    let tm_y = 42 + ck_y
    component TrayRow(r: record) {
        size: 228, if(r.separator, 11, 32)
        zone box z { from: 0, 0; size: 228, 32; corner: 16 continuous; cursor: pointer; label: "{r.label}"; active: r.enabled and not r.separator }
        box { from: 0, 0; size: 228, 32; corner: 16 continuous; color: chip_hi; opacity: if(r.separator, 0, 70% * z.hover) }
        line { from: 14, 5.5; to: 214, 5.5; width: 0.7; color: ink; opacity: if(r.separator, 16%, 0) }
        text pick(r.back, r.label, "Back") {
            at: 16 + 14 * (r.checked >= 0), 16; anchor: left center; width: 180; lines: 1
            size: 12.5; weight: 500; family: "SF Pro Display"; color: ink; opacity: if(r.separator, 0, if(r.enabled, 92%, 38%))
        }
        ellipse { at: 15, 16; radius: 2.6; color: tint_ink; show: r.checked == 1 }
        path { at: 212, 16; stroke: 1.6; color: ink; opacity: 45%; show: r.children > 0; move -2, -4.5; line 2.5, 0; line -2, 4.5 }
        on press z { emit tray_choose(r.index) }
    }
    group {
        show: tm > 0.01
        opacity: smooth(0, 0.6, tm)
        move: 0, -6 * (1 - tm)
        body {
            gradient: tm_x, tm_y to tm_x, tm_y + tm_h, well_t, well_b
            opacity: 97%; light: 3%, 42, 20
            shadow: 0, 8, 22, 34%
            box { from: tm_x, tm_y; size: tm_w, tm_h; corner: 20 continuous }
        }
        box { from: tm_x + 0.5, tm_y + 0.5; size: tm_w - 1, tm_h - 1; corner: 19.5 continuous; stroke: 1; color: rim_grey; opacity: 22% }
        zone box tmenu_z { from: tm_x, tm_y; size: tm_w, tm_h; corner: 20 continuous; label: "Tray menu" }
        column tcol {
            at: tm_x + 6, tm_y + 6; gap: 0
            for r in trows { TrayRow(r) }
        }
    }
    //  It goes once the pointer has been away from it a moment.
    on away tmenu_z for 500ms while tmenu_open { tmenu_open = false }
    on change expanded while not expanded { tmenu_open = false }

    // ── rules ────────────────────────────────────────────────────
    //  Hover is the whole interaction: in, it opens; out, it closes. No delay
    //  either way (moving onto a button inside doesn't count as leaving: each
    //  zone checks the pointer against its own shape).
    //  With an app up, hovering the pill does not open it (it sits right over the app, where you
    //  work): AltGr or a key does, and its card buds off the app's side.
    on enter hit while not ban_here and not osd and app == none { expanded = true }

    //  Beside an app it stays until Escape, AltGr let go, or the pointer has been on it and left.
    fact card_in = false
    on enter card_z while beside { card_in = true }
    on leave card_z while beside and card_in and not pw_open and not tmenu_open and panel != clip and panel != launch and panel != emoji and panel != wall and panel != auth and panel != proj and panel != fnds and panel != stor and panel != act { expanded = false }
    on change expanded while not expanded { card_in = false }
    //  A banner: a click opens it; it goes by itself after six seconds out from
    //  under the pointer (an urgent one waits to be dealt with).
    on drag hit while ban_here and not expanded { bdrag: min(4, drag.dy) ~30ms }
    on release hit while ban_here and not expanded and drag.dy < -28 { banner = false; bdrag: 0 }
    on release hit while ban_here and not expanded and drag.dy >= -28 { bdrag: 0 }
    //  A click opens it; a right click (two fingers on a trackpad) tucks it away.
    on release hit while ban_here and not expanded and abs(drag.dy) < 6 and abs(drag.dx) < 6 { emit note_open }
    on press right hit while ban_here and not expanded { banner = false }
    on change banner_seq { nswap: 0 ~1ms; nswap: 1 after 30ms; impulse ph 70 }
    on press more_z { expanded = true; panel = notes; banner = false }
    on still banner_seq * 3 + hit.hover + nh_hit.hover for 6s while banner and not hit.hover and not nh_hit.hover and not n_urgent { banner = false }
    on press nx { emit note_dismiss }
    on change expanded while expanded and not isl_tv { banner = false }
    on press bell_z { panel = notes }
    on open_notes { expanded = true; panel = notes }
    //  Not while a password is being typed: the card holds until Join or Esc.
    on change pointer.y while hold_h > 0 and pointer.y < open_h - 6 { hold_h = 0 }
    on change expanded while not expanded { hold_h = 0 }
    on change pointer.x while hold_w > 0 and abs(pointer.x - cx) < cw_t / 2 - 6 { hold_w = 0 }
    on change expanded while not expanded { hold_w = 0 }
    on change expanded while not expanded { mpage = 0 }   // the inbox opens on its first page again
    on leave hit while not beside and not pw_open and not tmenu_open and panel != clip and panel != launch and panel != emoji and panel != wall and panel != auth and panel != proj and panel != fnds and panel != stor and panel != act { expanded = false }
    //  Closed, it comes back on its home face (once it has finished closing).
    on still expanded for 400ms while not expanded { panel = home }

    on open_wifi { panel = wifi }
    on open_bt { panel = bt }

    //  Super+C: open on the clipboard, in vim's normal mode; again, close.
    on clip_open while expanded and panel == clip { expanded = false }
    on clip_open while not (expanded and panel == clip) and not big { expanded = true; panel = clip; clip_insert = false }
    on clip_open while big and not (side and side_k == 1) { side = true; side_k = 1; cal = false; side_focus = true; clip_insert = false; blur }
    on clip_open while big and side and side_k == 1 { side = false }
    //  Normal mode: j k (and the arrows) move, gg G go to the ends, Ctrl+d Ctrl+u
    //  half a page, Enter y l copy, dd x forget, i searches (insert), q Esc close.
    on key j while clip_keys and not clip_insert { emit clip_move(1) }
    on key k while clip_keys and not clip_insert { emit clip_move(-1) }
    on key Down while clip_keys { emit clip_move(1) }
    on key Up while clip_keys { emit clip_move(-1) }
    //  Typing in the search: Ctrl with j k still moves through the list.
    on key Ctrl+j while clip_keys and clip_insert { emit clip_move(1) }
    on key Ctrl+k while clip_keys and clip_insert { emit clip_move(-1) }
    on key Ctrl+d while clip_keys { emit clip_move(3) }
    on key Ctrl+u while clip_keys { emit clip_move(-3) }
    on key G while clip_keys and not clip_insert { emit clip_move(100000) }
    on key g while clip_keys and not clip_insert and clip_gg { emit clip_move(-100000); clip_gg = false }
    on key g while clip_keys and not clip_insert and not clip_gg { clip_gg = true }
    on key d while clip_keys and not clip_insert and clip_dd { emit clip_del; clip_dd = false }
    on key d while clip_keys and not clip_insert and not clip_dd { clip_dd = true }
    on still clip_dd for 600ms while clip_dd { clip_dd = false }
    on still clip_gg for 600ms while clip_gg { clip_gg = false }
    on key x while clip_keys and not clip_insert { emit clip_del }
    on key Shift+Delete while clip_keys { emit clip_del }
    on key Return while clip_keys and not clip_insert { emit clip_pick }
    on key y while clip_keys and not clip_insert { emit clip_pick }
    on key l while clip_keys and not clip_insert { emit clip_pick }
    on key q while clip_keys and not side and not clip_insert { expanded = false }
    on key q while clip_keys and side and not clip_insert { side = false }
    //  Esc in normal mode: a filter kept is let go first (the field folds back into its button), then the page closes.
    on key Escape while clip_keys and not clip_insert and not clip_q_empty { emit clip_q_clear }
    on key Escape while clip_keys and not side and not clip_insert and clip_q_empty { expanded = false }
    on key Escape while clip_keys and side and not clip_insert and clip_q_empty { side = false }
    //  i searches (insert, as in vim); Esc goes back to normal, keeping what it found.
    on key i while clip_keys and not clip_insert { clip_insert = true; focus clip_q }
    on key Escape while clip_keys and clip_insert { clip_insert = false; blur }
    on submit clip_q { emit clip_pick }

    //  Mod+A: the projects, straight into their search; again, close. Typing filters, ↑ ↓ choose,
    //  Enter opens, Ctrl+a/t/g/x (or Tab) the kinds, Esc clears the search, then closes.
    on proj_open while expanded and panel == proj { expanded = false }
    //  Mod+B: the Storage page; again, close. Esc goes back up a folder, then closes.
    on stor_open while expanded and panel == stor { expanded = false }
    //  Mod+X: Activity, straight into its search; again, close. Esc clears, goes up out of an app, closes.
    on act_open while expanded and panel == act { expanded = false }
    on act_open while not (expanded and panel == act) { expanded = true; panel = act; act_ins = false; blur }
    //  Normal mode: j k gg G Ctrl+d Ctrl+u move, l Enter open an app, h BackSpace up, dd quit, D force
    //  quit, Tab 1 2 3 or s the sort, r the other way round, q close. i or / search; Esc back to normal.
    on key j while act_keys and not act_ins { emit act_move(1) }
    on key k while act_keys and not act_ins { emit act_move(-1) }
    on key Down while act_keys { emit act_move(1) }
    on key Up while act_keys { emit act_move(-1) }
    on key Ctrl+j while act_keys and act_ins { emit act_move(1) }
    on key Ctrl+k while act_keys and act_ins { emit act_move(-1) }
    on key Ctrl+d while act_keys { emit act_move(3) }
    on key Ctrl+u while act_keys { emit act_move(-3) }
    on key G while act_keys and not act_ins { emit act_move(100000) }
    on key g while act_keys and not act_ins and act_gg { emit act_move(-100000); act_gg = false }
    on key g while act_keys and not act_ins and not act_gg { act_gg = true }
    on key d while act_keys and not act_ins and act_dd { emit act_del(0); act_dd = false }
    on key d while act_keys and not act_ins and not act_dd { act_dd = true }
    on key D while act_keys and not act_ins { emit act_del(1) }
    on still act_dd for 600ms while act_dd { act_dd = false }
    on still act_gg for 600ms while act_gg { act_gg = false }
    on key Return while act_keys and not act_ins { emit act_pick }
    on key l while act_keys and not act_ins { emit act_pick }
    on key h while act_keys and not act_ins and act_depth > 0 { emit act_up }
    on key BackSpace while act_keys and not act_ins and act_depth > 0 { emit act_up }
    on key Tab while act_keys and not act_ins and act_depth == 0 { emit act_tab_step(1) }
    on key Shift+Tab while act_keys and not act_ins and act_depth == 0 { emit act_tab_step(-1) }
    on key s while act_keys and not act_ins and act_depth == 0 { emit act_tab_step(1) }
    on key 1 while act_keys and not act_ins and act_depth == 0 { emit act_tab_at(0) }
    on key 2 while act_keys and not act_ins and act_depth == 0 { emit act_tab_at(1) }
    on key 3 while act_keys and not act_ins and act_depth == 0 { emit act_tab_at(2) }
    on key r while act_keys and not act_ins { emit act_reverse }
    on key q while act_keys and not act_ins { expanded = false }
    on key i while act_keys and not act_ins { act_ins = true; focus act_q }
    on key slash while act_keys and not act_ins { act_ins = true; focus act_q }
    on key Escape while act_keys and act_ins { act_ins = false; blur }
    on submit act_q { act_ins = false; blur }
    on key Escape while act_keys and not act_ins and not act_q_empty { emit act_clear }
    on key Escape while act_keys and not act_ins and act_q_empty and act_depth > 0 { emit act_up }
    on key Escape while act_keys and not act_ins and act_q_empty and act_depth == 0 { expanded = false }
    on stor_open while not (expanded and panel == stor) { expanded = true; panel = stor; stor_ins = false; blur }
    //  Normal mode (as the clipboard): j k move, gg G the ends, Ctrl+d Ctrl+u half a page, l Enter open,
    //  h BackSpace up, Tab 1 2 3 the tabs, dd to the Trash, o in the file manager, r scan again, q close;
    //  in a review Enter cleans and h q Esc go back. i or / search (insert); Esc back to normal.
    on key j while stor_keys and not stor_ins { emit stor_move(1) }
    on key k while stor_keys and not stor_ins { emit stor_move(-1) }
    on key Down while stor_keys { emit stor_move(1) }
    on key Up while stor_keys { emit stor_move(-1) }
    on key Ctrl+j while stor_keys and stor_ins { emit stor_move(1) }
    on key Ctrl+k while stor_keys and stor_ins { emit stor_move(-1) }
    on key Ctrl+d while stor_keys { emit stor_move(3) }
    on key Ctrl+u while stor_keys { emit stor_move(-3) }
    on key G while stor_keys and not stor_ins { emit stor_move(100000) }
    on key g while stor_keys and not stor_ins and stor_gg { emit stor_move(-100000); stor_gg = false }
    on key g while stor_keys and not stor_ins and not stor_gg { stor_gg = true }
    on key d while stor_keys and not stor_ins and not stor_rev and stor_dd { emit stor_del; stor_dd = false }
    on key d while stor_keys and not stor_ins and not stor_rev and not stor_dd { stor_dd = true }
    on still stor_dd for 600ms while stor_dd { stor_dd = false }
    on still stor_gg for 600ms while stor_gg { stor_gg = false }
    on key Return while stor_keys and not stor_ins and not stor_rev { emit stor_pick }
    on key l while stor_keys and not stor_ins and not stor_rev { emit stor_pick }
    on key Return while stor_keys and not stor_ins and stor_rev and not stor_busy { emit stor_rev_go }
    on key h while stor_keys and not stor_ins and stor_rev and not stor_busy { emit stor_rev_cancel }
    on key h while stor_keys and not stor_ins and not stor_rev and stor_depth > 0 { emit stor_up }
    on key BackSpace while stor_keys and not stor_ins and not stor_rev and stor_depth > 0 { emit stor_up }
    on key Tab while stor_keys and not stor_ins and not stor_rev and stor_depth == 0 { emit stor_tab_step(1) }
    on key Shift+Tab while stor_keys and not stor_ins and not stor_rev and stor_depth == 0 { emit stor_tab_step(-1) }
    on key 1 while stor_keys and not stor_ins and not stor_rev and stor_depth == 0 { emit stor_tab_at(0) }
    on key 2 while stor_keys and not stor_ins and not stor_rev and stor_depth == 0 { emit stor_tab_at(1) }
    on key 3 while stor_keys and not stor_ins and not stor_rev and stor_depth == 0 { emit stor_tab_at(2) }
    on key o while stor_keys and not stor_ins and not stor_rev { emit stor_files }
    on key r while stor_keys and not stor_ins and not stor_busy { emit stor_rescan }
    on key q while stor_keys and not stor_ins and stor_rev and not stor_busy { emit stor_rev_cancel }
    on key q while stor_keys and not stor_ins and not stor_rev { expanded = false }
    on key i while stor_keys and not stor_ins and not stor_rev { stor_ins = true; focus stor_q }
    on key slash while stor_keys and not stor_ins and not stor_rev { stor_ins = true; focus stor_q }
    on key Escape while stor_keys and stor_ins { stor_ins = false; blur }
    on submit stor_q { stor_ins = false; blur }
    on key Escape while stor_keys and not stor_ins and not stor_q_empty { emit stor_clear }
    on key Escape while stor_keys and not stor_ins and stor_q_empty and stor_rev and not stor_busy { emit stor_rev_cancel }
    on key Escape while stor_keys and not stor_ins and stor_q_empty and not stor_rev and stor_depth > 0 { emit stor_up }
    on key Escape while stor_keys and not stor_ins and stor_q_empty and not stor_rev and stor_depth == 0 { expanded = false }
    on proj_open while not (expanded and panel == proj) { expanded = true; panel = proj; focus proj_q }
    on key Escape while expanded and panel == proj and not proj_q_empty { emit proj_clear }
    on key Escape while expanded and panel == proj and proj_q_empty { expanded = false }
    on key Down while expanded and panel == proj { emit proj_move(1) }
    on key Up while expanded and panel == proj { emit proj_move(-1) }
    on key Ctrl+j while expanded and panel == proj { emit proj_move(1) }
    on key Ctrl+k while expanded and panel == proj { emit proj_move(-1) }
    on key Ctrl+n while expanded and panel == proj { emit proj_move(1) }
    on key Ctrl+p while expanded and panel == proj { emit proj_move(-1) }
    on key Ctrl+a while expanded and panel == proj { emit proj_tab_at(0) }
    on key Ctrl+t while expanded and panel == proj { emit proj_tab_at(1) }
    on key Ctrl+g while expanded and panel == proj { emit proj_tab_at(2) }
    on key Ctrl+x while expanded and panel == proj { emit proj_tab_at(3) }
    on key Tab while expanded and panel == proj { emit proj_tab_step(1) }
    on key Shift+Tab while expanded and panel == proj { emit proj_tab_step(-1) }
    on submit proj_q { emit proj_pick }

    //  Super+D: open on the launcher, straight into its search; again, close.
    on launch_open while expanded and panel == launch { expanded = false }
    on launch_open while not (expanded and panel == launch) { expanded = true; panel = launch; focus launch_q }
    on key Escape while expanded and panel == launch { expanded = false }
    on key Down while expanded and panel == launch { emit launch_move(1) }
    on key Up while expanded and panel == launch { emit launch_move(-1) }
    on key Ctrl+j while expanded and panel == launch { emit launch_move(1) }
    on key Ctrl+k while expanded and panel == launch { emit launch_move(-1) }
    on key Ctrl+n while expanded and panel == launch { emit launch_move(1) }
    on key Ctrl+p while expanded and panel == launch { emit launch_move(-1) }
    on key Tab while expanded and panel == launch { emit launch_into }
    on key Shift+Tab while expanded and panel == launch { emit launch_up }
    on submit launch_q { emit launch_pick }

    //  Super+E: open on the emoji, straight into the search; again, close.
    on emoji_open while expanded and panel == emoji { expanded = false }
    on emoji_open while not (expanded and panel == emoji) and not big and not (app == wa and wa_typing) and not (app == mailx and mr_rep) { expanded = true; panel = emoji; emo_insert = false; emo_from = false }
    //  …from a field being typed in: onto the grid, the last one used chosen (Enter gives it again), the
    //  keys the picker's; the field keeps its place. Ctrl+. again closes it, as Super+E does.
    on emoji_open while not (expanded and panel == emoji) and not big and ((app == wa and wa_typing) or (app == mailx and mr_rep)) { expanded = true; panel = emoji; emo_from = true; emo_insert = false; blur }
    on key Ctrl+period while emo_keys and emo_from { expanded = false }
    on change expanded while not expanded { emo_from = false }
    on change expanded while not expanded and app == mailx and mr_rep { focus mr_in }
    //  Beside a large view (WhatsApp, the mail, the files) it opens from the right capsule instead; again, closes.
    on emoji_open while big and not (side and side_k == 2) { side = true; side_k = 2; cal = false; side_focus = true; emo_insert = false; blur }
    on emoji_open while big and side and side_k == 2 { side = false }
    //  Normal mode, as vim: h j k l move, gg G the ends, Ctrl+d Ctrl+u half a
    //  page, [ ] the categories, Enter y pick, i / search, q Esc close. Over a field being typed in,
    //  a pick goes into it and the picker closes; Shift+Enter puts one in and stays for more.
    on key h while emo_keys and not emo_insert { emit emo_move(-1) }
    on key l while emo_keys and not emo_insert { emit emo_move(1) }
    on key j while emo_keys and not emo_insert { emit emo_move(8) }
    on key k while emo_keys and not emo_insert { emit emo_move(-8) }
    on key G while emo_keys and not emo_insert { emit emo_move(100000) }
    on key g while emo_keys and not emo_insert and emo_gg { emit emo_move(-100000); emo_gg = false }
    on key g while emo_keys and not emo_insert and not emo_gg { emo_gg = true }
    on still emo_gg for 600ms while emo_gg { emo_gg = false }
    on key bracketright while emo_keys and not emo_insert { emit emo_cat_step(1) }
    on key bracketleft while emo_keys and not emo_insert { emit emo_cat_step(-1) }
    on key Return while emo_keys and not emo_insert { emit emo_pick }
    on key Shift+Return while emo_keys and not emo_insert { emit emo_pick(1) }
    on key y while emo_keys and not emo_insert { emit emo_pick }
    on key q while emo_keys and not side and not emo_insert { expanded = false }
    on key q while emo_keys and side and not emo_insert { side = false }
    on key i while emo_keys and not emo_insert { emo_insert = true; focus emo_q }
    on key slash while emo_keys and not emo_insert { emo_insert = true; focus emo_q }
    //  Escape: out of the search into the grid (h j k l, the arrows); from the grid, opened over a
    //  field, back to it; otherwise it clears what was searched, then closes.
    on key Escape while emo_keys and emo_insert { emo_insert = false; blur }
    on key Escape while emo_keys and not emo_insert and emo_from { expanded = false }
    on key Escape while emo_keys and not emo_insert and not emo_q_empty and not emo_from { emit emo_q_clear }
    on key Escape while emo_keys and not side and not emo_insert and emo_q_empty and not emo_from { expanded = false }
    on key Escape while emo_keys and side and not emo_insert and emo_q_empty { side = false }
    //  Typing in the search: Ctrl with h j k l still moves through the grid.
    on key Ctrl+h while emo_keys and emo_insert and not side { emit emo_move(-1) }
    on key Ctrl+l while emo_keys and emo_insert and not side { emit emo_move(1) }
    on key Ctrl+j while emo_keys and emo_insert { emit emo_move(8) }
    on key Ctrl+k while emo_keys and emo_insert { emit emo_move(-8) }
    //  Both modes: the arrows, Tab, and half a page.
    on key Right while emo_keys { emit emo_move(1) }
    on key Left while emo_keys { emit emo_move(-1) }
    on key Down while emo_keys { emit emo_move(8) }
    on key Up while emo_keys { emit emo_move(-8) }
    on key Tab while emo_keys { emit emo_move(1) }
    on key Shift+Tab while emo_keys { emit emo_move(-1) }
    on key Ctrl+d while emo_keys { emit emo_move(16) }
    on key Ctrl+u while emo_keys { emit emo_move(-16) }
    on submit emo_q { emit emo_pick }

    //  Super+P: open on the wallpapers; again, close. Enter puts the chosen one on.
    on wall_open while expanded and panel == wall { expanded = false }
    on wall_open while not (expanded and panel == wall) { expanded = true; panel = wall }
    on key Escape while expanded and panel == wall { expanded = false }
    on key q while expanded and panel == wall { expanded = false }
    on key Right while expanded and panel == wall { emit wall_move(1) }
    on key Left while expanded and panel == wall { emit wall_move(-1) }
    on key Down while expanded and panel == wall { emit wall_move(3) }
    on key Up while expanded and panel == wall { emit wall_move(-3) }
    on key l while expanded and panel == wall { emit wall_move(1) }
    on key h while expanded and panel == wall { emit wall_move(-1) }
    on key j while expanded and panel == wall { emit wall_move(3) }
    on key k while expanded and panel == wall { emit wall_move(-3) }
    on key Tab while expanded and panel == wall { emit wall_move(1) }
    on key Shift+Tab while expanded and panel == wall { emit wall_move(-1) }
    on key Return while expanded and panel == wall { emit wall_pick }

    //  Alt+Tab (Hyprland binds it: `emit win_open 1`, Shift −1, Alt let go
    //  `emit win_commit`): the card opens on the windows, most recent first,
    //  the one before this chosen; each Tab steps; letting go of Alt goes there.
    on win_open(v) while not wv { wv = true; switching = v != 0; expanded = false; emit win_look(v) }
    on win_open(v) while wv { emit win_step(v) }
    on win_commit while switching { emit win_pick; switching = false; wv = false }
    on win_cancel { switching = false; wv = false }
    on win_pick_cell { switching = false; wv = false }

    //  Capture: the card closes before anything is taken, so it is not in the picture.
    on shot_open { expanded = true; panel = cap; cap_rec = false }
    on rec_open while recording { emit rec_stop }
    on rec_open while not recording { expanded = true; panel = cap; cap_rec = true }
    on cap_take { expanded = false }
    on key Escape while expanded and panel == cap { expanded = false }
    on key Escape while expanded and panel == mix { expanded = false }
    on open_mix { panel = mix }
    on open_gtune { panel = gtune }
    on key Escape while expanded and panel == gtune { panel = ctl }
    on awake_tap while awake { emit awake_toggle }
    on awake_tap while not awake { panel = awk }
    on awake_for { panel = ctl }
    //  The dial: letting go (or Enter) starts; the timer's card goes, Keep Awake goes back to the controls.
    on dial_go while panel == timer { expanded = false }
    on dial_go while panel == awk { panel = ctl }
    on key Return while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_go(dial_f) }
    on key l while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(1) }
    on key Right while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(1) }
    on key h while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(-1) }
    on key Left while expanded and ((panel == timer and not tmr_on and tmr_mode == timer) or panel == awk) { emit dial_step(-1) }
    on key Escape while expanded and (panel == timer or panel == awk) { expanded = false }
    on open_cam { panel = cam; cam_video = false }
    on open_timer while not tmr_on { panel = timer; tmr_mode = timer }
    on open_watch while not tmr_on { panel = timer; tmr_mode = watch }
    on open_timer while tmr_on { panel = timer }
    on open_watch while tmr_on { panel = timer }
    on tmr_start { expanded = false }
    on watch_start { expanded = false }

    //  The colour picker: the card goes, hyprpicker takes the screen; then the pill says what it took.
    on pick_color { expanded = false }
    on change pk_seq { picked = true; osd = false }
    on still pk_seq for 2600ms while picked { picked = false }
    on change expanded while expanded { picked = false }

    //  Polkit: a program wants the password. The card opens on the prompt and
    //  holds the keyboard until it is answered or cancelled.
    on change pk.pending while pk.pending { expanded = true; panel = auth; focus answer }
    on change pk.asking while pk.asking { focus answer }
    on change pk.pending while not pk.pending and panel == auth and not stor_busy { expanded = false }
    //  A clean-up asked for the password: back to its review, which says how it went.
    on change pk.pending while not pk.pending and panel == auth and stor_busy { panel = stor }
    on submit answer { emit pk_send }
    on key Escape while expanded and panel == auth { emit pk_cancel }


    //  The files. Super+Y: in the pill's card, as an app (again: away); beside another app, as its
    //  card. Super+R: in a window of their own (Thunar's place), or that window brought forward.
    //  W moves them between the two, as they are. (finder.luau has their keys.)
    on find_open while fnd_win { fnd_win = false }
    on find_open while app == fnd and not expanded { app = none }
    on find_open while app == fnd and expanded { expanded = false }
    on find_open while app == none { app = fnd; expanded = false; fnd_insert = false }
    on find_open while app != none and app != fnd and fnd_card { expanded = false }
    on find_open while app != none and app != fnd and not fnd_card { expanded = true; panel = fnds; fnd_insert = false }
    on files_win while app == fnd { app = none }
    on files_win while fnd_card { expanded = false }
    on files_win while fnd_win { emit fnd_raise }
    on files_win while not fnd_win { fnd_win = true }
    //  The keys are the logic's while the files have them, but for `i` and `/`, which open the
    //  field at once so not a letter of a quick search is lost.
    on change fnd_keys { fnd_kon = fnd_keys }
    on key i while fnd_keys and not fnd_insert and not fnd_prompting and not fnd_pre and not fnd_view { fnd_qkind = 1; fnd_insert = true; focus fq }
    on key slash while fnd_keys and not fnd_insert and not fnd_prompting and not fnd_pre and not fnd_view { fnd_qkind = 2; fnd_insert = true; focus fq }
    //  A name being typed (rename, new, a zip's, a path to go to): Enter does it, Esc lets it go.
    on change fnd_prompting while fnd_prompting { fnd_insert = true; focus fnd_in }
    on submit fnd_in { emit fnd_prompt_ok; fnd_prompting = false; fnd_insert = false; blur }
    on key Escape while fnd_keys and fnd_prompting { fnd_prompting = false; fnd_insert = false; blur }
    on change fnd_toast_seq { fnd_toast_on = true }
    on still fnd_toast_seq for 2500ms while fnd_toast_on { fnd_toast_on = false }
    on go_home { panel = home }
    //  The mail reader's reply: the field takes the keys as it opens; Enter sends, Escape lets it go.
    on change mr_rep while mr_rep { focus mr_in }
    on submit mr_in { emit mail_send }
    on key Escape while app == mailx and not expanded and not side_keys and mr_rep { mr_rep = false; blur }
    //  The large mail view: Super+U opens it (and closes it); its keys, vim's, while no reply is being typed.
    on mail_big while app == mailx and not expanded { app = none }
    on mail_big while app == mailx and expanded { expanded = false }
    on mail_big while not (app == mailx) and app != fnd { app = mailx; expanded = false; mr_rep = false; mx_focus = false; blur }
    //  Over the files: the mail takes the pill, and the files go beside it.
    on mail_big while app == fnd { app = mailx; expanded = true; panel = fnds; mr_rep = false; mx_focus = false }
    on key j while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus { emit mailx_move(1) }
    on key k while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus { emit mailx_move(-1) }
    on key Down while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus { emit mailx_move(1) }
    on key Up while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus { emit mailx_move(-1) }
    on key G while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus { emit mailx_pick(100000) }
    on still mx_dd for 700ms while mx_dd { mx_dd = false }
    on still mx_gg for 700ms while mx_gg { mx_gg = false }
    on key g while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus and mx_gg { emit mailx_pick(0); mx_gg = false }
    on key g while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus and not mx_gg { mx_gg = true }
    //  l: into the mail; then vim's motions scroll it (j/k a few lines, Ctrl+d/u half a page, gg/G its ends), h or Esc come back.
    on key l while app == mailx and not expanded and not side_keys and not mr_rep and not mx_focus { mx_focus = true }
    on key Right while app == mailx and not expanded and not side_keys and not mr_rep { mx_focus = true }
    on key h while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus and 620 * wz * mx_zoom <= mrw - 35 { mx_focus = false }
    on key h while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus and 620 * wz * mx_zoom > mrw - 35 { mx_pan = clamp(mx_pan - 110, 0, max(0, 620 * wz * mx_zoom - (mrw - 36))) }
    on key l while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus and 620 * wz * mx_zoom > mrw - 35 { mx_pan = clamp(mx_pan + 110, 0, max(0, 620 * wz * mx_zoom - (mrw - 36))) }
    on key Left while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus { mx_focus = false }
    on key j while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus { mrl.scroll: min(mrl.scroll + 140, max(0, mrl.content - mb_h)) ~quick }
    on key k while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus { mrl.scroll: max(0, mrl.scroll - 140) ~quick }
    on key Down while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus { mrl.scroll: min(mrl.scroll + 140, max(0, mrl.content - mb_h)) ~quick }
    on key Up while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus { mrl.scroll: max(0, mrl.scroll - 140) ~quick }
    on key Ctrl+d while app == mailx and not expanded and not side_keys and not mr_rep { mrl.scroll: min(mrl.scroll + mb_h / 2, max(0, mrl.content - mb_h)) ~quick }
    on key Ctrl+u while app == mailx and not expanded and not side_keys and not mr_rep { mrl.scroll: max(0, mrl.scroll - mb_h / 2) ~quick }
    on key G while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus { mrl.scroll: max(0, mrl.content - mb_h) ~quick }
    on key g while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus and mx_gg { mrl.scroll: 0 ~quick; mx_gg = false }
    on key g while app == mailx and not expanded and not side_keys and not mr_rep and mx_focus and not mx_gg { mx_gg = true }
    on key v while app == mailx and not expanded and not side_keys and not mr_rep { mx_web = not mx_web }
    //  Zoom, as in a PDF viewer: Shift+K in, Shift+J out (into the mail first), about the middle of what shows;
    //  zoomed wider than the reader, h and l pan across it instead of leaving it.
    on key K while app == mailx and not expanded and not side_keys and not mr_rep and not mr_confirm and mx_zoom < 2.99 {
        mx_focus = true
        mx_zoom = min(3, mx_zoom * 1.25)
        mx_pan = clamp(mx_pan * 1.25 + (mrw - 36) * 0.125, 0, max(0, 620 * mzs * mx_zoom * 1.25 - (mrw - 36)))
        mrl.scroll: max(0, (mrl.scroll + mb_h / 2) * 1.25 - mb_h / 2) ~quick
    }
    on key J while app == mailx and not expanded and not side_keys and not mr_rep and not mr_confirm and mx_zoom > 0.61 {
        mx_focus = true
        mx_zoom = max(0.6, mx_zoom / 1.25)
        mx_pan = clamp(mx_pan / 1.25 - (mrw - 36) * 0.1, 0, max(0, 620 * mzs * mx_zoom / 1.25 - (mrw - 36)))
        mrl.scroll: max(0, (mrl.scroll + mb_h / 2) / 1.25 - mb_h / 2) ~quick
    }
    on key r while app == mailx and not expanded and not side_keys and not mr_rep { emit mail_do(0) }
    on key u while app == mailx and not expanded and not side_keys and not mr_rep and not mail_undo { emit mail_do(1) }
    on key u while app == mailx and not expanded and not side_keys and not mr_rep and mail_undo { emit mail_undo_do }
    on key e while app == mailx and not expanded and not side_keys and not mr_rep { emit mail_do(2) }
    on key d while app == mailx and not expanded and not side_keys and not mr_rep and mx_dd { mr_confirm = true; mx_dd = false }
    //  "Move to Bin?": Enter or y bins it, Esc or n keeps it.
    on key Return while app == mailx and not expanded and not side_keys and mr_confirm { emit mail_do(3); mr_confirm = false }
    on key y while app == mailx and not expanded and not side_keys and mr_confirm { emit mail_do(3); mr_confirm = false }
    on key n while app == mailx and not expanded and not side_keys and mr_confirm { mr_confirm = false }
    on key d while app == mailx and not expanded and not side_keys and not mr_rep and not mx_dd { mx_dd = true }
    on key o while app == mailx and not expanded and not side_keys and not mr_rep { emit mail_do(4) }
    on key space while app == mailx and not expanded and not side_keys and not mr_rep { mrl.scroll: min(mrl.scroll + mb_h - 48, max(0, mrl.content - mb_h)) ~quick }
    on key Shift+space while app == mailx and not expanded and not side_keys and not mr_rep { mrl.scroll: max(0, mrl.scroll - mb_h + 48) ~quick }
    on key Escape while app == mailx and not expanded and not side_keys and mr_confirm { mr_confirm = false }
    on key Escape while app == mailx and not expanded and not side_keys and not mr_rep and not mr_confirm and mx_focus { mx_focus = false }
    on key Escape while app == mailx and not expanded and not side_keys and not mr_rep and not mr_confirm and not mx_focus { app = none }
    on key q while app == mailx and not expanded and not side_keys and not mr_rep and not mr_confirm { app = none }
    //  WhatsApp: Super+W opens it (and closes it). The fields first: i (or Enter) writes, Enter
    //  sends, Escape lets the field go; i in the list searches it.
    on wa_big while app == wa and not expanded { app = none }
    on wa_big while app == wa and expanded { expanded = false }
    //  Opening it: on the list (Vim's keys), no field taking them: `blur` says so to the engine too, which
    //  otherwise gives the first field drawn (the search) the keyboard as it comes.
    on wa_big while not (app == wa) and app != fnd { app = wa; expanded = false; wa_focus = false; wa_typing = false; wa_search = false; blur }
    on wa_big while app == fnd { app = wa; expanded = true; panel = fnds; wa_focus = false; wa_typing = false; wa_search = false; blur }
    on change wa_typing while wa_typing { focus wa_in; wa_cur = -1 }   // writing: no message stays chosen (Esc comes back to the chat, none chosen)
    on change wa_search while wa_search { focus wa_find }
    on submit wa_in { emit wa_send }
    //  The command line: `:` (not while writing), Enter runs, Tab completes, ↑/↓ choose, Esc lets it go.
    on key colon while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql { wa_cmd = true }
    //  R: sync now (reconnect, catch up, reload the open chat) — when it has fallen behind.
    on key R while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql { emit wa_sync }
    on change wa_cmd while wa_cmd { focus wa_cmd_in }
    on change wa_cmd while not wa_cmd and not wa_typing and not wa_search and not wa_cs { blur }
    on submit wa_cmd_in { emit wa_cmd_run }
    on key Tab while app == wa and not expanded and wa_cmd { emit wa_cmd_tab }
    on key Down while app == wa and not expanded and wa_cmd { emit wa_cmd_move(1) }
    on key Up while app == wa and not expanded and wa_cmd { emit wa_cmd_move(-1) }
    on key Escape while app == wa and not expanded and wa_cmd { wa_cmd = false }
    on submit wa_find { wa_search = false; blur }
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and wa_typing { wa_typing = false; blur }
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and wa_search { wa_search = false; blur; emit wa_find_clear }
    on key Down while app == wa and not expanded and not side_keys and not wa_modal and wa_search { emit wa_move(1) }
    on key Up while app == wa and not expanded and not side_keys and not wa_modal and wa_search { emit wa_move(-1) }
    on press wa_in_z { wa_typing = true }
    //  Ctrl+V with a picture or files on the clipboard (words the field pastes itself); Ctrl+. the emoji.
    on key Ctrl+v while app == wa and not expanded and not side_keys and not wa_modal and wa_open and not wa_search { emit wa_paste }
    on key Ctrl+V while app == wa and not expanded and not side_keys and not wa_modal and wa_open and not wa_search { emit wa_paste }
    on key Ctrl+period while app == wa and not expanded and not side_keys and not wa_modal and wa_open and not wa_search { emit emoji_open }
    on press wa_find_z { wa_search = true }
    //  …and Vim's keys while neither has them: the list, or (l) the chat. A count first (5j, 12G).
    on still wa_cnt for 2s while wa_cnt > 0 { wa_cnt = 0 }
    on key 1 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 1) }
    on key 2 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 2) }
    on key 3 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 3) }
    on key 4 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 4) }
    on key 5 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 5) }
    on key 6 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 6) }
    on key 7 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 7) }
    on key 8 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 8) }
    on key 9 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_cnt = min(9999, wa_cnt * 10 + 9) }
    on key 0 while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_cnt > 0 { wa_cnt = min(9999, wa_cnt * 10) }
    on still wa_gg for 700ms while wa_gg { wa_gg = false }
    on still wa_yy for 700ms while wa_yy { wa_yy = false }
    on still wa_zz for 700ms while wa_zz { wa_zz = false }
    //  The list.
    on key j while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(max(1, wa_cnt)); wa_cnt = 0 }
    on key k while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(-max(1, wa_cnt)); wa_cnt = 0 }
    on key Down while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(max(1, wa_cnt)); wa_cnt = 0 }
    on key Up while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus { emit wa_move(-max(1, wa_cnt)); wa_cnt = 0 }
    on key G while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus and wa_cnt > 0 { emit wa_pick(wa_cnt - 1); wa_cnt = 0 }
    on key G while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus and wa_cnt == 0 { emit wa_pick(100000) }
    on key g while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus and wa_gg { emit wa_pick(0); wa_gg = false }
    on key g while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_focus and not wa_gg { wa_gg = true }
    on key Ctrl+d while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and not wa_focus { emit wa_move(5) }
    on key Ctrl+u while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and not wa_focus { emit wa_move(-5) }
    on key Ctrl+f while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and not wa_focus { emit wa_move(10) }
    on key Ctrl+b while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and not wa_focus { emit wa_move(-10) }
    on key Ctrl+e while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and not wa_focus { emit wa_wheel(-2) }
    on key Ctrl+y while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and not wa_focus { emit wa_wheel(2) }
    on key H while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus { emit wa_jump(0) }
    on key M while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus { emit wa_jump(1) }
    on key L while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus { emit wa_jump(2) }
    on key n while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus { emit wa_jump(3) }
    on key N while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus { emit wa_jump(4) }
    on key z while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus and wa_zz { emit wa_jump(5); wa_zz = false }
    on key z while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus and not wa_zz { wa_zz = true }
    on key i while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_focus and wa_linked { wa_search = true }
    on key s while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_rail = not wa_rail }
    on key t while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search { wa_times = not wa_times }
    on key Return while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_linked and not wa_ql and not (wa_focus and wa_cur >= 0 and (wa_cur_media or wa_cur_fail)) { wa_typing = true }
    on key Return while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql and wa_focus and wa_cur >= 0 and wa_cur_media and not wa_cur_fail { emit wa_look }
    on key Return while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql and wa_focus and wa_cur >= 0 and wa_cur_fail { emit wa_retry }
    on key l while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql and not wa_focus and wa_open { wa_focus = true; wa_typing = true }
    on key s while app == mailx and not expanded and not side_keys and not mr_rep and not mr_confirm { mx_rail = not mx_rail }
    on key Right while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql { wa_focus = true }
    //  The chat: a cursor on its messages; yy copies the one it is on, o opens it, r answers it.
    on key j while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus { emit wa_cmove(max(1, wa_cnt)); wa_cnt = 0 }
    on key k while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus { emit wa_cmove(-max(1, wa_cnt)); wa_cnt = 0 }
    on key Down while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus { emit wa_cmove(max(1, wa_cnt)); wa_cnt = 0 }
    on key Up while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus { emit wa_cmove(-max(1, wa_cnt)); wa_cnt = 0 }
    on key G while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and not wa_detached { emit wa_last; wa_cnt = 0 }
    on key g while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and wa_gg { emit wa_first; wfb: wmax ~quick; wa_gg = false }
    on key g while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and not wa_gg { wa_gg = true }
    on key z while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and wa_zz { emit wa_center; wa_zz = false }
    on key z while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and not wa_zz { wa_zz = true }
    on key y while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and wa_yy { emit wa_yank; wa_yy = false }
    on key y while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and not wa_yy { wa_yy = true }
    on key Y while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus { emit wa_yank }
    on key o while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus { emit wa_open }
    on key r while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus and wa_cur >= 0 { emit wa_reply; wa_ql = false }
    //  The field in normal mode: j and k step out of it onto the messages (a cursor there: r answers, Enter views).
    //  Enter: the picture or video under the cursor large (a click on it too); Escape, q or Enter close it.
    //  Over it: Space plays or stops a video (closes a picture), h/l go through a stack, ←/→ jump a video by 5 s.
    on key space while app == wa and not expanded and wa_ql { emit wa_ql_space }
    on key Return while app == wa and not expanded and wa_ql { wa_ql = false }
    on key h while app == wa and not expanded and wa_ql and not wa_gal { emit wa_ql_step(-1) }
    on key l while app == wa and not expanded and wa_ql and not wa_gal { emit wa_ql_step(1) }
    on key Left while app == wa and not expanded and wa_ql and wa_qlv { emit wa_ql_seek(vid.position - 5) }
    on key Right while app == wa and not expanded and wa_ql and wa_qlv { emit wa_ql_seek(vid.position + 5) }
    on key Escape while app == wa and not expanded and wa_ql { wa_ql = false }
    on key q while app == wa and not expanded and wa_ql { wa_ql = false }
    on change expanded while not expanded { wa_ql = false }
    on change panel while wa_ql { wa_ql = false }
    on key i while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus { wa_typing = true }
    on key h while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql and wa_focus { wa_focus = false; wa_cur = -1 }
    on key Left while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql and wa_focus { wa_focus = false; wa_cur = -1 }
    //  Ctrl+h j k l: between the three, as Vim's windows: the list on the left, the chat on the
    //  right, its field under it (from the list, l goes to the chat; past it, to a tool beside).
    on key Ctrl+h while app == wa and not expanded and not side_keys and not wa_modal and (wa_focus or wa_typing) { wa_typing = false; blur; wa_focus = false; wa_cur = -1 }
    on key Ctrl+l while app == wa and not expanded and not side_keys and not wa_modal and not wa_focus and not wa_typing and wa_open { wa_search = false; blur; wa_focus = true; emit wa_last }   // onto the messages, on the newest (l: into the field)
    on key Ctrl+j while app == wa and not expanded and not side_keys and not wa_modal and wa_focus and not wa_typing and not wa_search { wa_typing = true }
    on key Ctrl+k while app == wa and not expanded and not side_keys and not wa_modal and wa_typing { wa_typing = false; blur; wa_focus = true }
    //  Scrolling the chat (in the list too, and from the field's normal mode, which passes Ctrl on).
    on key Ctrl+d while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and (wa_focus or wa_typing) { wfb: max(0, wfb - wvh / 2) ~quick }
    on key Ctrl+u while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and (wa_focus or wa_typing) { wfb: min(wmax, wfb + wvh / 2) ~quick }
    on key Ctrl+f while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and (wa_focus or wa_typing) { wfb: max(0, wfb - wvh + 40) ~quick }
    on key Ctrl+b while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and (wa_focus or wa_typing) { wfb: min(wmax, wfb + wvh - 40) ~quick }
    on key Ctrl+e while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and (wa_focus or wa_typing) { wfb: max(0, wfb - 40) ~quick }
    on key Ctrl+y while app == wa and not expanded and not side_keys and not wa_modal and not wa_search and (wa_focus or wa_typing) { wfb: min(wmax, wfb + 40) ~quick }
    //  Escape, one thing at a time: the answer being written, the cursor, the chat, the view.
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_csr and wa_att { emit wa_att_clear }
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_csr and not wa_att and wa_quote { emit wa_quote_clear }
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_csr and not wa_att and not wa_quote and wa_focus and wa_cur >= 0 { wa_cur = -1; wa_typing = true }   // from the messages, back to writing
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_csr and not wa_att and not wa_quote and wa_focus and wa_cur < 0 { wa_focus = false }
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and not wa_csr and not wa_att and not wa_quote and not wa_focus { app = none }
    on key q while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search { app = none }
    //  More on the message under the cursor: e reacts, c edits one of ours, dd deletes, f forwards,
    //  Ctrl+S saves its file; m the chat's pictures and files; / searches the chat (n N through
    //  what it found); v records a voice note (the logic hears the key go down and up).
    let wa_chat_keys = app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and wa_focus
    on key m while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql and wa_open { emit wa_gal_open }
    on key e while wa_chat_keys and not wa_ql and wa_cur >= 0 { emit wa_rx_open }
    on key c while wa_chat_keys and not wa_ql and wa_cur >= 0 { emit wa_edit }
    on key d while wa_chat_keys and not wa_ql and wa_cur >= 0 and wa_dd { emit wa_del_ask; wa_dd = false }
    on key d while wa_chat_keys and not wa_ql and wa_cur >= 0 and not wa_dd { wa_dd = true }
    on still wa_dd for 700ms while wa_dd { wa_dd = false }
    on key f while wa_chat_keys and not wa_ql and wa_cur >= 0 { emit wa_fwd_open }
    on key slash while app == wa and not expanded and not side_keys and not wa_modal and not wa_typing and not wa_search and not wa_ql and wa_open { wa_focus = true; wa_cs = true }
    on key n while wa_chat_keys and wa_csr { emit wa_cs_go(1) }
    on key N while wa_chat_keys and wa_csr { emit wa_cs_go(-1) }
    on key G while wa_chat_keys and wa_detached { emit wa_newest; wa_cnt = 0 }
    on key Escape while app == wa and not expanded and not side_keys and not wa_modal and not wa_ql and not wa_typing and not wa_search and wa_csr { emit wa_cs_close }
    on key Ctrl+s while app == wa and not expanded and not side_keys and not wa_typing and not wa_search { emit wa_save }
    on key Ctrl+S while app == wa and not expanded and not side_keys and not wa_typing and not wa_search { emit wa_save }
    on change expanded while not expanded { wa_gal = false; wa_rx = false; wa_del = 0; wa_fwd = false; wa_cs = false; wa_menu = -1; wa_who = false }
    on key Escape while app == wa and not expanded and wa_menu >= 0 { wa_menu = -1 }
    on change wa_fwd while not wa_fwd { blur }
    on change wa_cs while not wa_cs { blur }
    //  The gallery: h l a tile, j k a row (in the files, a file), gg G, Space or Enter to look, o to
    //  open, s to save, Tab for the files, Escape (or m) to close. Quick Look over it follows the cursor.
    let wa_gal_keys = app == wa and not expanded and not side_keys and wa_gal
    on key h while wa_gal_keys { emit wa_gmove(-1) }
    on key Left while wa_gal_keys { emit wa_gmove(-1) }
    on key l while wa_gal_keys { emit wa_gmove(1) }
    on key Right while wa_gal_keys { emit wa_gmove(1) }
    on key j while wa_gal_keys { emit wa_gmove(100) }
    on key Down while wa_gal_keys { emit wa_gmove(100) }
    on key k while wa_gal_keys { emit wa_gmove(-100) }
    on key Up while wa_gal_keys { emit wa_gmove(-100) }
    on key Ctrl+d while wa_gal_keys { emit wa_gmove(400) }
    on key Ctrl+u while wa_gal_keys { emit wa_gmove(-400) }
    on key G while wa_gal_keys { emit wa_gmove(1000000) }
    on key g while wa_gal_keys and wa_gg { emit wa_gmove(-1000000); wa_gg = false }
    on key g while wa_gal_keys and not wa_gg { wa_gg = true }
    on key space while wa_gal_keys and not wa_ql { emit wa_gview }
    on key Return while wa_gal_keys and not wa_ql { emit wa_gview }
    on key o while wa_gal_keys { emit wa_gopen }
    on key s while wa_gal_keys { emit wa_save }
    on key Tab while wa_gal_keys and not wa_ql { emit wa_gtabs }
    on key Escape while wa_gal_keys and not wa_ql { wa_gal = false }
    on key q while wa_gal_keys and not wa_ql { wa_gal = false }
    on key m while wa_gal_keys and not wa_ql { wa_gal = false }
    //  The reactions: h l (or 1–6) choose, Enter gives it, x takes ours back, Escape lets it be.
    let wa_rx_keys = app == wa and not expanded and not side_keys and wa_rx
    on key h while wa_rx_keys { wa_rxi = max(0, wa_rxi - 1) }
    on key Left while wa_rx_keys { wa_rxi = max(0, wa_rxi - 1) }
    on key l while wa_rx_keys { wa_rxi = min(5, wa_rxi + 1) }
    on key Right while wa_rx_keys { wa_rxi = min(5, wa_rxi + 1) }
    on key 1 while wa_rx_keys { emit wa_react(0) }
    on key 2 while wa_rx_keys { emit wa_react(1) }
    on key 3 while wa_rx_keys { emit wa_react(2) }
    on key 4 while wa_rx_keys { emit wa_react(3) }
    on key 5 while wa_rx_keys { emit wa_react(4) }
    on key 6 while wa_rx_keys { emit wa_react(5) }
    on key Return while wa_rx_keys { emit wa_react(wa_rxi) }
    on key space while wa_rx_keys { emit wa_react(wa_rxi) }
    on key x while wa_rx_keys { emit wa_react(-1) }
    on key BackSpace while wa_rx_keys { emit wa_react(-1) }
    on key Escape while wa_rx_keys { wa_rx = false }
    on key q while wa_rx_keys { wa_rx = false }
    on key e while wa_rx_keys { wa_rx = false }
    //  Deleting: Enter (or y) does it —for everyone, when it is ours—, m only here, Escape doesn't.
    let wa_del_keys = app == wa and not expanded and not side_keys and wa_del > 0
    on key Return while wa_del_keys { emit wa_del_do(if(wa_del == 1, 1, 2)) }
    on key y while wa_del_keys { emit wa_del_do(if(wa_del == 1, 1, 2)) }
    on key m while wa_del_keys and wa_del == 1 { emit wa_del_do(2) }
    on key Escape while wa_del_keys { wa_del = 0 }
    on key q while wa_del_keys { wa_del = 0 }
    on key n while wa_del_keys { wa_del = 0 }
    //  Forwarding: what is written finds the chat, ↑ ↓ (Ctrl+j k, Tab) choose it, Enter sends.
    on change wa_fwd while wa_fwd { focus wa_fwd_q }
    on submit wa_fwd_q { emit wa_fwd_pick(wa_fwi) }
    let wa_who_keys = app == wa and not expanded and not side_keys and wa_who
    on key E while wa_chat_keys and not wa_ql and wa_cur >= 0 { emit wa_who_open }
    on key j while wa_who_keys { emit wa_who_move(1) }
    on key k while wa_who_keys { emit wa_who_move(-1) }
    on key Down while wa_who_keys { emit wa_who_move(1) }
    on key Up while wa_who_keys { emit wa_who_move(-1) }
    on key l while wa_who_keys { emit wa_who_tab(1) }
    on key h while wa_who_keys { emit wa_who_tab(-1) }
    on key Tab while wa_who_keys { emit wa_who_tab(1) }
    on key Shift+Tab while wa_who_keys { emit wa_who_tab(-1) }
    on key Return while wa_who_keys { emit wa_who_pick(wa_whi) }
    on key Escape while wa_who_keys { wa_who = false }
    on key q while wa_who_keys { wa_who = false }
    let wa_fwd_keys = app == wa and not expanded and not side_keys and wa_fwd
    on key Down while wa_fwd_keys { emit wa_fwd_move(1) }
    on key Up while wa_fwd_keys { emit wa_fwd_move(-1) }
    on key Ctrl+j while wa_fwd_keys { emit wa_fwd_move(1) }
    on key Ctrl+k while wa_fwd_keys { emit wa_fwd_move(-1) }
    on key Tab while wa_fwd_keys { emit wa_fwd_move(1) }
    on key Shift+Tab while wa_fwd_keys { emit wa_fwd_move(-1) }
    on key Escape while wa_fwd_keys { wa_fwd = false; blur }
    //  Searching the chat: Enter goes to the newest it says it (then n N), ↑ ↓ through them at once.
    on change wa_cs while wa_cs { focus wa_cq }
    on submit wa_cq { emit wa_cs_go(0); wa_cs = false; blur }
    let wa_cs_keys = app == wa and not expanded and not side_keys and wa_cs
    on key Up while wa_cs_keys { emit wa_cs_go(1) }
    on key Down while wa_cs_keys { emit wa_cs_go(-1) }
    on key Escape while wa_cs_keys { emit wa_cs_close; wa_cs = false; blur }
    //  A voice note: Enter sends it, Escape throws it away.
    let wa_rec_keys = app == wa and not expanded and not side_keys and wa_rec
    on key Return while wa_rec_keys { emit wa_rec_send }
    on key Escape while wa_rec_keys { emit wa_rec_cancel }
    on change expanded while not expanded { side = false }
    //  The pill's card over an app, on a face with no field of its own (home, controls): the app's
    //  field lets go of the keys, so Escape reaches the card and closes it, back to the app.
    on change expanded while expanded and app != none and (panel == home or panel == ctl) { blur }
    on key Escape while expanded and app != none and (panel == home or panel == ctl) { expanded = false }
    //  The pill's card gone from over an app: the keys go back to the field that had them.
    on change expanded while not expanded and app == wa and wa_typing { focus wa_in }
    on change expanded while not expanded and app == mailx and mr_rep { focus mr_in }
    on change expanded while not expanded and app == fnd and fnd_prompting { focus fnd_in }
    on change app while not (app == mailx) { mr_confirm = false }
    on change panel while panel == wifi { emit wifi_scan }
    every 12s while expanded and panel == wifi and wifi_on { emit wifi_scan }
    on change pw_open while pw_open { focus pass }
    on change pw_wrongs { impulse shake 260 }
    on key Escape while pw_open { emit wifi_cancel }
    on submit pass { emit wifi_join }
    //  The spinners step only while there is something to show.
    every 300ms while expanded and busy_any { turn: turn + 1 }

    on press prev_z { emit previous }
    on press play_z { emit toggle }
    //  Scrubbing the card's bar: it follows the pointer, the song jumps on release.
    on press cseek_z { scrubbing = true; scrub_f = clamp(craw, 0, 1); scrub_over = craw }
    on drag cseek_z while scrubbing { scrub_f = clamp(craw, 0, 1); scrub_over = craw }
    on release cseek_z while scrubbing { pos = scrub_f * media.length; emit seek_to(scrub_f * media.length); scrubbing = false; scrub_over = scrub_f }
    on change expanded while not expanded { scrubbing = false }
    on press next_z { emit next }
    on scroll ws_z while wheel.glide < 0.5 { emit ws_step(wheel) }
    on hold sw_z for 700ms { emit wm_switch }
    on hold out_z for 700ms { emit log_out }
    on hold re_z for 700ms { emit restart }
    on hold off_z for 700ms { emit power_off }

    //  AltGr held: the card, at once; let go, it closes, unless the pointer has gone into it.
    on peek(v) while v > 0 and not peek_held and not expanded { expanded = true; peeking = true; osd = false }
    on peek(v) while v > 0 and not peek_held { peek_held = true }
    on peek(v) while v <= 0 { peek_held = false }
    on change peek_held while not peek_held and peeking and not (hit.hover and app == none) and not (card_z.hover and app != none) { expanded = false }
    on change peek_held while not peek_held { peeking = false }
    on change expanded while not expanded { peeking = false }

    //  Volume and brightness: any change shows the gauge (not over the open
    //  card, which has its own); it goes 1.5 s after the last one, unless held.
    on change audio.volume while osd_ready { osd = true; osd_kind = vol; osd_seq = osd_seq + 1; impulse swell 40 }
    on vol_key(v) { osd = true; osd_kind = vol; osd_seq = osd_seq + 1; impulse thump 5 }
    //  Pushed past an end: the pill stretches like rubber and springs back.
    on vol_key(v) while v > 0 and audio.volume >= 0.995 { impulse pw 320 }
    on vol_key(v) while v < 0 and audio.volume <= 0.005 { impulse pw 320 }
    on bright_up(v) { bright = v / 100; osd = true; osd_kind = bright; osd_seq = osd_seq + 1; impulse swell 40 }
    on bright_down(v) { bright = v / 100; osd = true; osd_kind = bright; osd_seq = osd_seq + 1; impulse swell 40 }
    on bright_up(v) while v >= 100 and bright >= 0.995 { impulse pw 320 }
    on bright_down(v) while v <= 1 and bright <= 0.015 { impulse pw 320 }
    on kbd_up(v) { kbd = v / 100; osd = true; osd_kind = kbd; osd_seq = osd_seq + 1; impulse swell 40 }
    on kbd_down(v) { kbd = v / 100; osd = true; osd_kind = kbd; osd_seq = osd_seq + 1; impulse swell 40 }
    on kbd_up(v) while v >= 100 and kbd >= 0.995 { impulse pw 320 }
    on kbd_down(v) while v <= 0 and kbd <= 0.005 { impulse pw 320 }
    //  Brightness changed by something else (the service looks every 0.7 s).
    on change backlight.level while osd_ready and abs(backlight.level - bright) > 0.02 { bright = backlight.level }
    on still osd_seq * 2 + os_z.hover for 1500ms while osd and not os_z.hover { osd = false }
    //  (The card open, the gauge shows at the top right instead: see `hud_at`.)
    on press bead_z { emit osd_mute }
    on press track_z { emit osd_set(clamp((pointer.x - tl) / max(tlen, 1), 0, 1)) }
    on drag track_z { emit osd_set(clamp((pointer.x - tl) / max(tlen, 1), 0, 1)) }
    on scroll os_z while osd_kind == vol and wheel.glide < 0.5 { emit vol_step(wheel); osd_seq = osd_seq + 1 }
    on scroll os_z while osd_kind == bright and wheel.glide < 0.5 { emit bright_step(wheel); osd_seq = osd_seq + 1 }
    on scroll os_z while osd_kind == kbd and wheel.glide < 0.5 { emit kbd_step(wheel); osd_seq = osd_seq + 1 }
}
