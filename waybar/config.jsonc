// Waybar config — Catppuccin Mocha, styled after a macOS SketchyBar setup.
// Target: Hyprland on Arch.  Pair with style.css in this directory.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,

  "modules-left": ["hyprland/workspaces", "group/appdrawer"],
  // Right cluster consolidated into one continuous glass capsule.
  "modules-right": ["group/stats"],

  // Focused-window pill that reveals the tray on hover (drawer).
  "group/appdrawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 350,
      "transition-left-to-right": true,
      "children-class": "drawer-tray"
    },
    "modules": ["hyprland/window", "tray"]
  },

  "group/stats": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "battery", "clock"]
  },

  // --- Left: workspace pills (1..10) -------------------------------------
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-number": true,
    // Only show workspaces that are occupied (or currently focused) —
    // no persistent/empty placeholders.
    "show-special": false
  },

  // --- Left: focused app (sketchybar "front_app") ------------------------
  "hyprland/window": {
    "format": "{class}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "": "  Desktop",
      "zen.*": "  Zen",
      ".*ghostty.*": "  Ghostty",
      "kitty": "  Kitty",
      "[Aa]lacritty": "  Alacritty",
      "foot": "  Foot",
      "firefox.*": "  Firefox",
      "[Cc]hrom(e|ium).*": "  Chrome",
      "[Bb]rave.*": "  Brave",
      "[Cc]ode": "  Code",
      "[Cc]ursor": "  Cursor",
      "obsidian": "  Obsidian",
      "[Dd]iscord|vesktop|[Ww]ebCord": "  Discord",
      "[Ss]potify": "  Spotify",
      "org.telegram.desktop": "  Telegram",
      "[Ss]lack": "  Slack",
      "org.gnome.Nautilus|thunar|nemo|[Dd]olphin": "  Files",
      "[Ss]team": "  Steam",
      "mpv|vlc": "  Video",
      "org.pwmt.zathura|[Ee]vince|okular": "  PDF",
      "imv|org.gnome.Loupe|feh": "  Image",
      "pavucontrol": "  Audio"
    }
  },

  // --- Left: tray apps (Discord, etc.) ---------------------------------
  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "reverse-direction": false
  },

  // --- Center: now playing (sketchybar "media") -------------------------
  "mpris": {
    "format": "{player_icon}  {title}  ·  {artist}",
    "format-paused": "{status_icon}  {title}  ·  {artist}",
    "max-length": 50,
    "ellipsis": "…",
    "tooltip-format": "{title}\n{artist} — {album}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "chromium": ""
    },
    "status-icons": {
      "paused": ""
    }
  },

  // --- Right: volume (sketchybar "volume") -----------------------------
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc} — {volume}%"
  },

  // --- Right: battery (sketchybar "battery") ---------------------------
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": [""],
    "tooltip-format": "{capacity}% — {timeTo}"
  },

  // --- Right: clock (sketchybar "date") --------------------------------
  "clock": {
    "format": "  {:%a %d %b   %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "today": "<span color='#44d62c'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
