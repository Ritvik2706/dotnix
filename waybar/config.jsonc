// Waybar config — Catppuccin Mocha, styled after a macOS SketchyBar setup.
// Target: Hyprland on Arch.  Pair with style.css in this directory.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 6,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  // "modules-center": ["mpris"],
  "modules-right": ["pulseaudio", "battery", "clock"],

  // --- Left: workspace pills (1..10) -------------------------------------
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
    // Only show workspaces that are occupied (or currently focused) —
    // no persistent/empty placeholders.
    "show-special": false
  },

  // --- Left: focused app (sketchybar "front_app") ------------------------
  "hyprland/window": {
    "format": "{class}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "": "  Desktop",
      "zen.*": "  Zen",
      ".*ghostty.*": "  Ghostty",
      "kitty": "  Kitty",
      "[Aa]lacritty": "  Alacritty",
      "foot": "  Foot",
      "firefox.*": "  Firefox",
      "[Cc]hrom(e|ium).*": "  Chrome",
      "[Bb]rave.*": "  Brave",
      "[Cc]ode": "  Code",
      "[Cc]ursor": "  Cursor",
      "obsidian": "  Obsidian",
      "[Dd]iscord|vesktop|[Ww]ebCord": "  Discord",
      "[Ss]potify": "  Spotify",
      "org.telegram.desktop": "  Telegram",
      "[Ss]lack": "  Slack",
      "org.gnome.Nautilus|thunar|nemo|[Dd]olphin": "  Files",
      "[Ss]team": "  Steam",
      "mpv|vlc": "  Video",
      "org.pwmt.zathura|[Ee]vince|okular": "  PDF",
      "imv|org.gnome.Loupe|feh": "  Image",
      "pavucontrol": "  Audio"
    }
  },

  // --- Center: now playing (sketchybar "media") -------------------------
  "mpris": {
    "format": "{player_icon}  {artist} - {title}",
    "format-paused": "{status_icon}  {artist} - {title}",
    "max-length": 45,
    "tooltip-format": "{artist} - {title}\n{album}",
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "chromium": ""
    },
    "status-icons": {
      "paused": ""
    }
  },

  // --- Right: volume (sketchybar "volume") -----------------------------
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc} — {volume}%"
  },

  // --- Right: battery (sketchybar "battery") ---------------------------
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{capacity}% — {timeTo}"
  },

  // --- Right: clock (sketchybar "date") --------------------------------
  "clock": {
    "format": "  {:%a %d %b • %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#cba6f7'><b>{}</b></span>"
      }
    }
  }
}
